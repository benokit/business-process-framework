[
    {
        "id": "construction",
        "kind": "insurance-contract",
        "data": {
            "dataSchema": {
                "!policyholder": "string",
                "!project": "string",
                "!currency": "string",
                "!startDate": "@date",
                "!endDate": "@date"
            }
        }
    },
    {
        "id": "construction-business-key",
        "kind": "slot-fill",
        "data": {
            "target": "construction",
            "slot": "businessKey",
            "value": [
                { "outputKey": "seq", "nextFromSequence": "construction-seq" },
                { "outputKey": "now", "invoke": "clock", "operation": "now" },
                {
                    "set": {
                        "$join": {
                            "_strings": ["CON", { "$head": { "$split": { "_string": "#.now", "_separator": "-" } } }, { "$printf": { "_template": "%04d", "_args": ["#.seq"] } }],
                            "_separator": "-"
                        }
                    }
                }
            ]
        }
    },
    {
        "id": "construction-policyholder",
        "kind": "slot-fill",
        "data": {
            "target": "construction",
            "slot": "relations",
            "value": { "set": { "relations": [{ "targetEntityType": "party", "targetEntityBusinessKey": "#.input.data.policyholder", "relationType": "policyholder" }] } }
        }
    }
]
