[
    {
        "kind": "app-config",
        "data": { "authorization": { "jwtSecret": "default-secret-change-in-production" } }
    },
    {
        "id": "jwt-secret",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "string" },
            "implementation": { "$get": { "_object": { "$func/app-config-section": "authorization" }, "_path": "jwtSecret" } }
        }
    },
    {
        "id": "authenticate",
        "kind": "user-scope",
        "data": {
            "keyword": "authenticated",
            "implementation": [
                {
                    "outputKey": "principal",
                    "inputMap": { "header": "#.input.headers.authorization", "secret": { "$func/jwt-secret": null } },
                    "low": { "module": "@business-framework/authorization-basic", "functionName": "verifyToken" }
                },
                {
                    "if": "#.principal",
                    "then": { "withContext": { "user": "#.principal" }, "do": { "next": true } },
                    "else": { "next": true }
                }
            ]
        }
    },
    {
        "id": "authenticate-requests",
        "kind": "slot-fill",
        "data": {
            "target": "http-endpoint",
            "slot": "requestMiddleware",
            "position": "first",
            "value": { "authenticated": { "next": true } }
        }
    },
    {
        "id": "password-authentication",
        "kind": "kind",
        "data": {
            "operations": {
                "login": {
                    "input": { "!username": "string", "!password": "string" },
                    "output": { "!token": "string" },
                    "implementation": [
                        {
                            "outputKey": "user",
                            "try": { "inputMap": { "businessKey": "#.input.username" }, "invoke": "user", "operation": "read" },
                            "catch": { "if": { "$eq": ["#.error.code", "not-found"] }, "then": { "set": null }, "else": { "throw": "#.error" } }
                        },
                        {
                            "outputKey": "valid",
                            "if": "#.user",
                            "then": { "inputMap": { "password": "#.input.password", "hash": "#.user.data.passwordHash" }, "invoke": "password", "operation": "verify" },
                            "else": { "set": false }
                        },
                        { "if": { "$negate": "#.valid" }, "then": { "throw": { "code": "unauthorized", "message": "invalid credentials" } } },
                        {
                            "outputKey": "token",
                            "inputMap": {
                                "principal": { "userId": "#.user.businessKey", "username": "#.user.data.username", "email": "#.user.data.email", "roles": { "$coalesce": ["#.user.data.roles", []] } },
                                "secret": { "$func/jwt-secret": null }
                            },
                            "low": { "module": "@business-framework/authorization-basic", "functionName": "generateToken" }
                        },
                        { "set": { "token": "#.token" } }
                    ]
                }
            }
        }
    },
    {
        "id": "authentication",
        "kind": "password-authentication",
        "data": {}
    },
    {
        "id": "login-endpoint",
        "kind": "http-endpoint",
        "data": {
            "method": "POST",
            "path": "/login",
            "target": { "element": "authentication", "operation": "login" },
            "request": { "username": "#.body.username", "password": "#.body.password" }
        }
    }
]
