[
    {
        "kind": "app-config",
        "data": { "http": { "port": 3000 } }
    },
    {
        "id": "express-http-server",
        "kind": "kind",
        "data": {
            "shape": { "port": "number" },
            "operations": {
                "registerRoute": {
                    "input": { "!method": "string", "!path": "string", "!endpoint": "string" },
                    "implementation": { "low": { "module": "@business-framework/http-server", "functionName": "registerRoute" } }
                },
                "address": {
                    "input": "@any",
                    "output": { "!port": "number" },
                    "implementation": { "low": { "module": "@business-framework/http-server", "functionName": "address" } }
                }
            },
            "lifecycle": {
                "start": {
                    "inputMap": { "port": { "$coalesce": ["#.self.data.port", { "$get": { "_object": { "$func/app-config-section": "http" }, "_path": "port" } }] } },
                    "low": { "module": "@business-framework/http-server", "functionName": "listen" }
                },
                "stop": { "low": { "module": "@business-framework/http-server", "functionName": "close" } }
            }
        }
    },
    {
        "id": "http-server",
        "kind": "express-http-server",
        "data": {}
    }
]
