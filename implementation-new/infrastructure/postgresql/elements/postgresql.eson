[
    {
        "kind": "app-config",
        "data": { "postgresql": { "url": "postgresql://admin:password@localhost:5432/app" } }
    },
    {
        "id": "sql-command",
        "kind": "schema",
        "data": { "!command": "string", "parameters": { "$data#": ["[@any]", "object"] } }
    },
    {
        "id": "postgresql-database",
        "kind": "kind",
        "data": {
            "operations": {
                "execute": {
                    "input": "@sql-command",
                    "output": { "!rows[]": "object", "rowCount": { "$data#": ["number", "null"] } },
                    "implementation": [
                        { "outputKey": "result", "low": { "module": "@business-framework/postgresql", "functionName": "execute" } },
                        { "set": { "rows": "#.result.rows", "rowCount": "#.result.rowCount" } }
                    ]
                }
            },
            "lifecycle": {
                "start": { "inputMap": { "$func/app-config-section": "postgresql" }, "low": { "module": "@business-framework/postgresql", "functionName": "connect" } },
                "stop": { "low": { "module": "@business-framework/postgresql", "functionName": "disconnect" } }
            }
        }
    },
    {
        "id": "postgresql",
        "kind": "postgresql-database",
        "data": {}
    }
]
