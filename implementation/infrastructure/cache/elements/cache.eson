[
    {
        "id": "cache-key",
        "kind": "schema",
        "data": { "!key": "string" }
    },
    {
        "id": "cache-entry",
        "kind": "schema",
        "data": { "!key": "string", "value": "@any" }
    },
    {
        "id": "cache-lookup",
        "kind": "schema",
        "data": { "!found": "boolean", "value": "@any" }
    },
    {
        "id": "in-memory-cache",
        "kind": "kind",
        "data": {
            "shape": { "ttl": "number" },
            "operations": {
                "get": {
                    "input": "@cache-key",
                    "output": "@cache-lookup",
                    "implementation": {
                        "inputMap": { "cache": "#.self.id", "key": "#.input.key" },
                        "low": { "module": "@business-framework/cache", "functionName": "cacheGet" }
                    }
                },
                "set": {
                    "input": "@cache-entry",
                    "implementation": {
                        "inputMap": { "cache": "#.self.id", "key": "#.input.key", "value": "#.input.value", "ttl": "#.self.data.ttl" },
                        "low": { "module": "@business-framework/cache", "functionName": "cacheSet" }
                    }
                },
                "evict": {
                    "input": "@cache-key",
                    "implementation": {
                        "inputMap": { "cache": "#.self.id", "key": "#.input.key" },
                        "low": { "module": "@business-framework/cache", "functionName": "cacheEvict" }
                    }
                }
            }
        }
    },
    {
        "id": "with-cache",
        "kind": "execution-node-wrapper",
        "data": {
            "keyword": "withCache",
            "implementation": [
                { "outputKey": "key", "set": { "$func/apply-mapping": { "mapping": "#.node.key", "input": "#" } } },
                { "outputKey": "hit", "inputMap": { "key": "#.key" }, "invoke": "#.node.cache", "operation": "get" },
                { "if": "#.hit.found", "then": { "return": "#.hit.value" } },
                { "outputKey": "value", "next": true },
                { "inputMap": { "key": "#.key", "value": "#.value" }, "invoke": "#.node.cache", "operation": "set" },
                { "return": "#.value" }
            ]
        }
    }
]
