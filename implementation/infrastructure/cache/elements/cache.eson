[
    {
        "id": "cache-key",
        "kind": "schema",
        "data": { "!key": "string" }
    },
    {
        "id": "cache-entry",
        "kind": "schema",
        "data": { "!key": "string", "value": "@any" }
    },
    {
        "id": "cache-lookup",
        "kind": "schema",
        "data": { "!found": "boolean", "value": "@any" }
    },
    {
        "id": "in-memory-cache",
        "kind": "kind",
        "data": {
            "operations": {
                "get": {
                    "input": "@cache-key",
                    "output": "@cache-lookup",
                    "implementation": {
                        "inputMap": { "cache": "#.self.id", "key": "#.input.key" },
                        "low": { "module": "@business-framework/cache", "functionName": "cacheGet" }
                    }
                },
                "set": {
                    "input": "@cache-entry",
                    "implementation": {
                        "inputMap": { "cache": "#.self.id", "key": "#.input.key", "value": "#.input.value" },
                        "low": { "module": "@business-framework/cache", "functionName": "cacheSet" }
                    }
                }
            }
        }
    },
    {
        "id": "local-l1",
        "kind": "in-memory-cache",
        "data": {}
    },
    {
        "id": "with-cache",
        "kind": "execution-node-wrapper",
        "data": {
            "keyword": "withCache",
            "implementation": [
                { "outputKey": "key", "set": { "$func/apply-mapping": { "mapping": "#.node.key", "input": "#" } } },
                { "outputKey": "hit", "inputMap": { "key": "#.key" }, "invoke": "#.node.cache", "operation": "get" },
                {
                    "if": "#.hit.found",
                    "then": [
                        {
                            "outputKey": "isValid",
                            "if": "#.node.validate",
                            "then": { "set": { "$func/apply-mapping": { "mapping": "#.node.validate", "input": { "cached": "#.hit.value", "input": "#.input", "self": "#.self" } } } },
                            "else": { "set": true }
                        },
                        { "if": "#.isValid", "then": { "return": "#.hit.value" } }
                    ]
                },
                { "outputKey": "value", "next": true },
                { "inputMap": { "key": "#.key", "value": "#.value" }, "invoke": "#.node.cache", "operation": "set" },
                { "return": "#.value" }
            ]
        }
    }
]
