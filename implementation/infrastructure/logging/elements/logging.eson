[
    {
        "id": "log-entry",
        "kind": "schema",
        "data": { "!message": "string", "level=1": ["trace", "debug", "info", "warn", "error", "fatal"], "context": "object" }
    },
    {
        "id": "logger",
        "kind": "kind",
        "data": {
            "operations": {
                "log": {
                    "input": "@log-entry",
                    "implementation": { "low": { "module": "@business-framework/logging", "export": "log", "effects": ["trace"] } }
                }
            }
        }
    },
    {
        "id": "logging",
        "kind": "logger",
        "data": {}
    },
    {
        "id": "log",
        "kind": "execution-node-template",
        "data": {
            "keyword": "log",
            "node": { "!log": "@mapping", "level=1": ["trace", "debug", "info", "warn", "error", "fatal"], "context": "@mapping" },
            "implementation": {
                "inputMap": {
                    "message": { "$func/apply-mapping": { "mapping": "#.node.log", "input": "#" } },
                    "level": { "$coalesce": ["#.node.level", "info"] },
                    "context": { "$coalesce": [{ "$func/apply-mapping": { "mapping": "#.node.context", "input": "#" } }, {}] }
                },
                "invoke": "logging",
                "operation": "log"
            }
        }
    }
]
