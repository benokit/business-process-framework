[
    {
        "kind": "app-config",
        "data": { "nats": { "url": "nats://localhost:4222" } }
    },
    {
        "id": "nats-broker",
        "kind": "kind",
        "data": {
            "extends": "message-broker",
            "operations": {
                "publish": {
                    "implementation": [
                        { "outputKey": "url", "set": { "$get": { "_object": { "$func/app-config-section": "nats" }, "_path": "url" } } },
                        { "inputMap": { "$merge": ["#.input", { "url": "#.url" }] }, "low": { "module": "@business-framework/messaging-nats", "functionName": "publish" } }
                    ]
                },
                "subscribe": {
                    "implementation": [
                        { "outputKey": "url", "set": { "$get": { "_object": { "$func/app-config-section": "nats" }, "_path": "url" } } },
                        { "inputMap": { "$merge": ["#.input", { "url": "#.url" }] }, "low": { "module": "@business-framework/messaging-nats", "functionName": "subscribe" } }
                    ]
                },
                "unsubscribe": {
                    "implementation": { "low": { "module": "@business-framework/messaging-nats", "functionName": "unsubscribe" } }
                }
            },
            "lifecycle": {
                "stop": { "low": { "module": "@business-framework/messaging-nats", "functionName": "disconnect" } }
            }
        }
    },
    {
        "id": "nats",
        "kind": "nats-broker",
        "data": {}
    }
]
