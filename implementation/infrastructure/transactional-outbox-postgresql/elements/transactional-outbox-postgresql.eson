[
    {
        "id": "outbox-insert-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-insert",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "INSERT INTO transactional_outbox (channel, message_id, message_group, envelope, process_after_timestamp_utc) VALUES ($1, $2, $3, $4, $5) RETURNING message_id AS \"messageId\"",
                        "parameters": ["#.channel", "#.envelope.messageId", "#.envelope.group", "#.envelope", "#.now"]
                    },
                    { "set": { "$head": "#.rows" } }
                ]
            }
        }
    },
    {
        "id": "outbox-claim-postgresql",
        "kind": "slot-fill",
        "/data": {
            "target": "outbox-claim",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": { "/uri": "@business-framework/transactional-outbox-postgresql/sql/claim.sql" },
                        "parameters": ["#.messageId", "#.now", "#.lockedUntil", "#.pausedChannels"],
                        "irreversible": true
                    },
                    {
                        "set": { "$if": [{ "$head": "#.rows" }, { "$merge": [{ "claimed": true }, { "$head": "#.rows" }] }, { "claimed": false }] }
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-mark-delivered-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-mark-delivered",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "UPDATE transactional_outbox SET status = 1, processed_at = $1 WHERE message_id = $2 RETURNING channel",
                        "parameters": ["#.processedAt", "#.messageId"],
                        "irreversible": true
                    },
                    { "set": { "$head": "#.rows" } }
                ]
            }
        }
    },
    {
        "id": "outbox-entry-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-entry",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "SELECT id, channel, retry_count AS \"retryCount\" FROM transactional_outbox WHERE message_id = $1",
                        "parameters": ["#.messageId"],
                        "read": true
                    },
                    { "set": { "$head": "#.rows" } }
                ]
            }
        }
    },
    {
        "id": "outbox-retry-later-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-retry-later",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "statement": "UPDATE transactional_outbox SET process_after_timestamp_utc = $1, retry_count = retry_count + 1 WHERE id = $2",
                        "parameters": ["#.processAfter", "#.id"],
                        "irreversible": true
                    },
                    { "set": null }
                ]
            }
        }
    },
    {
        "id": "outbox-mark-failed-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-mark-failed",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    { "statement": "UPDATE transactional_outbox SET status = 2 WHERE id = $1", "parameters": ["#.id"], "irreversible": true },
                    { "set": null }
                ]
            }
        }
    },
    {
        "id": "outbox-release-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-release",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "statement": "UPDATE transactional_outbox SET process_after_timestamp_utc = $1 WHERE id = $2",
                        "parameters": ["#.processAfter", "#.id"],
                        "irreversible": true
                    },
                    { "set": null }
                ]
            }
        }
    },
    {
        "id": "outbox-lock-batch-postgresql",
        "kind": "slot-fill",
        "/data": {
            "target": "outbox-lock-batch",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": {
                    "statement": { "/uri": "@business-framework/transactional-outbox-postgresql/sql/lock-batch.sql" },
                    "parameters": ["#.now", "#.lockedUntil", "#.pausedChannels", "#.batchSize"],
                    "irreversible": true
                }
            }
        }
    },
    {
        "id": "outbox-replay-postgresql",
        "kind": "slot-fill",
        "/data": {
            "target": "outbox-replay",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": { "/uri": "@business-framework/transactional-outbox-postgresql/sql/replay.sql" },
                        "parameters": ["#.now", "#.messageIds", "#.channel", "#.from", "#.to"],
                        "irreversible": true
                    },
                    { "set": { "$head": "#.rows" } }
                ]
            }
        }
    },
    {
        "id": "outbox-skip-failed-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-skip-failed",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "WITH changed AS (UPDATE transactional_outbox SET status = 3 WHERE status = 2 AND message_id = ANY($1) RETURNING 1) SELECT COUNT(*)::int AS count FROM changed",
                        "parameters": ["#.messageIds"],
                        "irreversible": true
                    },
                    { "set": { "$head": "#.rows" } }
                ]
            }
        }
    },
    {
        "id": "outbox-purge-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-purge",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "WITH changed AS (DELETE FROM transactional_outbox WHERE status = 1 AND processed_at < $1 RETURNING 1) SELECT COUNT(*)::int AS count FROM changed",
                        "parameters": ["#.deliveredBefore"],
                        "irreversible": true
                    },
                    { "set": { "$head": "#.rows" } }
                ]
            }
        }
    },
    {
        "id": "transactional-outbox-table",
        "kind": "slot-fill",
        "/data": {
            "target": "postgresql-database",
            "slot": "models",
            "value": { "command": { "/uri": "@business-framework/transactional-outbox-postgresql/sql/transactional-outbox-table.sql" } }
        }
    },
    {
        "id": "transactional-outbox-pending-index",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "after": ["transactional-outbox-table"],
            "value": { "command": "CREATE INDEX IF NOT EXISTS outbox_pending ON transactional_outbox (process_after_timestamp_utc) WHERE status = 0" }
        }
    },
    {
        "id": "transactional-outbox-group-head-index",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "after": ["transactional-outbox-table"],
            "value": { "command": "CREATE INDEX IF NOT EXISTS outbox_group_head ON transactional_outbox (message_group, position) WHERE status IN (0, 2)" }
        }
    }
]
