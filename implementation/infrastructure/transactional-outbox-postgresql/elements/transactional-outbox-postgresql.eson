[
    {
        "id": "outbox-insert-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-insert",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "INSERT INTO transactional_outbox (channel, message_id, message_group, envelope, process_after_timestamp_utc) VALUES ($1, $2, $3, $4, $5) RETURNING message_id AS \"messageId\"",
                        "parameters": [
                            "#.channel",
                            "#.envelope.messageId",
                            "#.envelope.group",
                            "#.envelope",
                            "#.now"
                        ]
                    },
                    {
                        "set": {
                            "$head": "#.rows"
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-claim-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-claim",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "UPDATE transactional_outbox claimed SET process_after_timestamp_utc = $3 WHERE message_id = $1 AND status = 0 AND process_after_timestamp_utc <= $2 AND channel <> ALL($4) AND NOT EXISTS (SELECT 1 FROM transactional_outbox earlier WHERE earlier.message_group = claimed.message_group AND earlier.status IN (0, 2) AND earlier.position < claimed.position) RETURNING channel, envelope",
                        "parameters": [
                            "#.messageId",
                            "#.now",
                            "#.lockedUntil",
                            "#.pausedChannels"
                        ],
                        "irreversible": true
                    },
                    {
                        "set": {
                            "$conditional": {
                                "_if": {
                                    "$head": "#.rows"
                                },
                                "_then": {
                                    "$merge": [
                                        {
                                            "claimed": true
                                        },
                                        {
                                            "$head": "#.rows"
                                        }
                                    ]
                                },
                                "_else": {
                                    "claimed": false
                                }
                            }
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-mark-delivered-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-mark-delivered",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "UPDATE transactional_outbox SET status = 1, processed_at = $1 WHERE message_id = $2 RETURNING channel",
                        "parameters": [
                            "#.processedAt",
                            "#.messageId"
                        ],
                        "irreversible": true
                    },
                    {
                        "set": {
                            "$head": "#.rows"
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-entry-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-entry",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "SELECT id, channel, retry_count AS \"retryCount\" FROM transactional_outbox WHERE message_id = $1",
                        "parameters": [
                            "#.messageId"
                        ],
                        "read": true
                    },
                    {
                        "set": {
                            "$head": "#.rows"
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-retry-later-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-retry-later",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "statement": "UPDATE transactional_outbox SET process_after_timestamp_utc = $1, retry_count = retry_count + 1 WHERE id = $2",
                        "parameters": [
                            "#.processAfter",
                            "#.id"
                        ],
                        "irreversible": true
                    },
                    {
                        "set": null
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-mark-failed-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-mark-failed",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "statement": "UPDATE transactional_outbox SET status = 2 WHERE id = $1",
                        "parameters": [
                            "#.id"
                        ],
                        "irreversible": true
                    },
                    {
                        "set": null
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-release-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-release",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "statement": "UPDATE transactional_outbox SET process_after_timestamp_utc = $1 WHERE id = $2",
                        "parameters": [
                            "#.processAfter",
                            "#.id"
                        ],
                        "irreversible": true
                    },
                    {
                        "set": null
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-lock-batch-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-lock-batch",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": {
                    "statement": "WITH group_heads AS (SELECT DISTINCT ON (message_group) id, status, channel, process_after_timestamp_utc FROM transactional_outbox WHERE status IN (0, 2) ORDER BY message_group, position), candidates AS (SELECT id FROM group_heads WHERE status = 0 AND process_after_timestamp_utc <= $1 AND channel <> ALL($3) ORDER BY process_after_timestamp_utc ASC LIMIT $4) UPDATE transactional_outbox SET process_after_timestamp_utc = $2 WHERE id IN (SELECT id FROM candidates) AND status = 0 AND process_after_timestamp_utc <= $1 RETURNING id, message_id AS \"messageId\", channel, envelope, retry_count AS \"retryCount\"",
                    "parameters": [
                        "#.now",
                        "#.lockedUntil",
                        "#.pausedChannels",
                        "#.batchSize"
                    ],
                    "irreversible": true
                }
            }
        }
    },
    {
        "id": "outbox-replay-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-replay",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "WITH changed AS (UPDATE transactional_outbox SET status = 0, retry_count = 0, process_after_timestamp_utc = $1 WHERE status IN (1, 2, 3) AND ($2::text[] IS NULL OR message_id = ANY($2::text[])) AND ($3::text IS NULL OR channel = $3) AND ($4::timestamptz IS NULL OR created_at >= $4) AND ($5::timestamptz IS NULL OR created_at < $5) RETURNING 1) SELECT COUNT(*)::int AS count FROM changed",
                        "parameters": [
                            "#.now",
                            "#.messageIds",
                            "#.channel",
                            "#.from",
                            "#.to"
                        ],
                        "irreversible": true
                    },
                    {
                        "set": {
                            "$head": "#.rows"
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-skip-failed-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-skip-failed",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "WITH changed AS (UPDATE transactional_outbox SET status = 3 WHERE status = 2 AND message_id = ANY($1) RETURNING 1) SELECT COUNT(*)::int AS count FROM changed",
                        "parameters": [
                            "#.messageIds"
                        ],
                        "irreversible": true
                    },
                    {
                        "set": {
                            "$head": "#.rows"
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "outbox-purge-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "outbox-purge",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "rows",
                        "statement": "WITH changed AS (DELETE FROM transactional_outbox WHERE status = 1 AND processed_at < $1 RETURNING 1) SELECT COUNT(*)::int AS count FROM changed",
                        "parameters": [
                            "#.deliveredBefore"
                        ],
                        "irreversible": true
                    },
                    {
                        "set": {
                            "$head": "#.rows"
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "transactional-outbox-table",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "value": {
                "command": "CREATE TABLE IF NOT EXISTS transactional_outbox (id UUID PRIMARY KEY DEFAULT gen_random_uuid(), channel TEXT NOT NULL, message_id TEXT NOT NULL UNIQUE, message_group TEXT NOT NULL, position BIGSERIAL, envelope JSONB NOT NULL, status INTEGER NOT NULL DEFAULT 0, retry_count INTEGER NOT NULL DEFAULT 0, process_after_timestamp_utc TEXT NOT NULL, processed_at TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())"
            }
        }
    },
    {
        "id": "transactional-outbox-pending-index",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "after": [
                "transactional-outbox-table"
            ],
            "value": {
                "command": "CREATE INDEX IF NOT EXISTS outbox_pending ON transactional_outbox (process_after_timestamp_utc) WHERE status = 0"
            }
        }
    },
    {
        "id": "transactional-outbox-group-head-index",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "after": [
                "transactional-outbox-table"
            ],
            "value": {
                "command": "CREATE INDEX IF NOT EXISTS outbox_group_head ON transactional_outbox (message_group, position) WHERE status IN (0, 2)"
            }
        }
    }
]
