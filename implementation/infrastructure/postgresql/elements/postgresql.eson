[
    {
        "kind": "app-config",
        "data": { "postgresql": { "url": "postgresql://admin:password@localhost:5432/app" } }
    },
    {
        "id": "postgresql-database",
        "kind": "kind",
        "data": {
            "extends": "database",
            "operations": {
                "execute": {
                    "implementation": [
                        { "outputKey": "result", "low": { "module": "@business-framework/postgresql", "functionName": "execute" } },
                        { "set": { "rows": "#.result.rows", "rowCount": "#.result.rowCount" } }
                    ]
                }
            },
            "lifecycle": {
                "start": [
                    { "inputMap": { "$func/app-config-section": "postgresql" }, "low": { "module": "@business-framework/postgresql", "functionName": "connect" } },
                    {
                        "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "models" } },
                        "forEach": { "inputMap": "#.item", "invoke": "#.self.id", "operation": "execute" }
                    }
                ],
                "stop": { "low": { "module": "@business-framework/postgresql", "functionName": "disconnect" } }
            }
        }
    },
    {
        "id": "postgresql",
        "kind": "postgresql-database",
        "data": {}
    }
]
