[
    {
        "id": "transaction-session",
        "kind": "schema",
        "data": { "!sessionId": "number" }
    },
    {
        "id": "transaction-manager",
        "kind": "kind",
        "data": {
            "shape": { "!isolation=1": ["read committed", "repeatable read", "serializable"] },
            "operations": {
                "begin": {
                    "input": "@any",
                    "output": "@transaction-session",
                    "implementation": {
                        "inputMap": { "isolation": "#.self.data.isolation" },
                        "low": { "module": "@business-framework/transaction", "export": "beginTransaction" }
                    }
                },
                "commit": {
                    "input": "@transaction-session",
                    "implementation": { "low": { "module": "@business-framework/transaction", "export": "commitTransaction" } }
                },
                "rollback": {
                    "input": "@transaction-session",
                    "implementation": { "low": { "module": "@business-framework/transaction", "export": "rollbackTransaction" } }
                }
            }
        }
    },
    {
        "id": "transaction",
        "kind": "transaction-manager",
        "data": { "isolation": "read committed" }
    },
    {
        "id": "transaction-execution-node-wrapper",
        "kind": "kind",
        "data": {
            "extends": "execution-node-wrapper",
            "context": { "manages": { "transaction": "@transaction-session" } }
        }
    },
    {
        "id": "in-transaction",
        "kind": "transaction-execution-node-wrapper",
        "data": {
            "keyword": "inTransaction",
            "implementation": {
                "if": "#._ctx.transaction",
                "then": { "next": true },
                "else": [
                    { "outputKey": "session", "invoke": "transaction", "operation": "begin" },
                    {
                        "try": [
                            { "outputKey": "result", "withContext": { "transaction": "#.session" }, "do": { "next": true } },
                            { "inputMap": "#.session", "invoke": "transaction", "operation": "commit" },
                            { "return": "#.result" }
                        ],
                        "catch": [
                            { "inputMap": "#.session", "invoke": "transaction", "operation": "rollback" },
                            { "throw": "#.error" }
                        ]
                    }
                ]
            }
        }
    }
]
