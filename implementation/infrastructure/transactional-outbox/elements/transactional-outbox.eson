[
    {
        "kind": "app-config",
        "data": { "outbox": { "lockIntervalInMilliseconds": 30000, "idleIntervalInMilliseconds": 1000, "maxBackoffInMilliseconds": 60000, "batchSize": 10, "retry": { "attempts": 3, "backoff": 1000 } } }
    },
    {
        "id": "transactional-outbox",
        "kind": "kind",
        "data": {
            "extends": "message-outbox",
            "operations": {
                "put": {
                    "implementation": [
                        { "outputKey": "put", "low": { "module": "@business-framework/transactional-outbox", "export": "put" } },
                        { "inputMap": { "messageId": "#.put.messageId" }, "afterCommit": { "invoke": "#.self.id", "operation": "deliverNow" } },
                        { "set": "#.put" }
                    ]
                },
                "claim": {
                    "input": { "!messageId": "string" },
                    "output": { "!claimed": "boolean", "channel": "string", "envelope": "@message-envelope" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "claim" } }
                },
                "markDelivered": {
                    "input": { "!messageId": "string" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "markDelivered" } }
                },
                "recordFailure": {
                    "input": { "!messageId": "string", "error": "object" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "recordFailure" } }
                },
                "deliverNow": {
                    "input": { "!messageId": "string" },
                    "implementation": [
                        { "outputKey": "claim", "invoke": "#.self.id", "operation": "claim" },
                        {
                            "if": "#.claim.claimed",
                            "then": {
                                "try": [
                                    { "inputMap": "#.claim.envelope", "invoke": "#.claim.channel", "operation": "deliver" },
                                    { "invoke": "#.self.id", "operation": "markDelivered" }
                                ],
                                "catch": { "inputMap": { "messageId": "#.input.messageId", "error": "#.error" }, "invoke": "#.self.id", "operation": "recordFailure" }
                            }
                        }
                    ]
                },
                "replay": {
                    "input": { "messageIds[]": "string", "channel": "string", "from": "string", "to": "string" },
                    "output": { "!count": "number" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "replay" } }
                },
                "skip": {
                    "input": { "!messageIds[]": "string" },
                    "output": { "!count": "number" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "skip" } }
                },
                "purge": {
                    "input": { "!deliveredBefore": "string" },
                    "output": { "!count": "number" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "purge" } }
                }
            },
            "lifecycle": {
                "start": { "inputMap": { "$func/app-config-section": "outbox" }, "low": { "module": "@business-framework/transactional-outbox", "export": "startProcessor" } },
                "stop": { "low": { "module": "@business-framework/transactional-outbox", "export": "stopProcessor" } },
                "startAfter": ["database", "message-broker"]
            }
        }
    },
    {
        "id": "outbox",
        "kind": "transactional-outbox",
        "data": {}
    },
    {
        "id": "transactional-outbox-table",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "value": {
                "command": "CREATE TABLE IF NOT EXISTS transactional_outbox (id UUID PRIMARY KEY DEFAULT gen_random_uuid(), channel TEXT NOT NULL, message_id TEXT NOT NULL UNIQUE, message_group TEXT NOT NULL, position BIGSERIAL, envelope JSONB NOT NULL, status INTEGER NOT NULL DEFAULT 0, retry_count INTEGER NOT NULL DEFAULT 0, process_after_timestamp_utc TEXT NOT NULL, processed_at TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())"
            }
        }
    },
    {
        "id": "transactional-outbox-pending-index",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "after": ["transactional-outbox-table"],
            "value": { "command": "CREATE INDEX IF NOT EXISTS outbox_pending ON transactional_outbox (process_after_timestamp_utc) WHERE status = 0" }
        }
    },
    {
        "id": "transactional-outbox-group-head-index",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "after": ["transactional-outbox-table"],
            "value": { "command": "CREATE INDEX IF NOT EXISTS outbox_group_head ON transactional_outbox (message_group, position) WHERE status IN (0, 2)" }
        }
    }
]
