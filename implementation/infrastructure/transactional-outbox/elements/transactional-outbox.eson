[
    {
        "kind": "app-config",
        "data": { "outbox": { "lockIntervalInMilliseconds": 30000, "idleIntervalInMilliseconds": 1000, "maxBackoffInMilliseconds": 60000, "batchSize": 10, "retry": { "attempts": 3, "backoff": 1000 } } }
    },
    {
        "id": "transactional-outbox",
        "kind": "kind",
        "data": {
            "extends": "message-outbox",
            "operations": {
                "put": {
                    "implementation": [
                        { "outputKey": "now", "invoke": "clock", "operation": "now" },
                        { "outputKey": "put", "inputMap": { "$merge": ["#.input", { "now": "#.now" }] }, "invoke": "outbox-insert", "operation": "run" },
                        { "inputMap": { "messageId": "#.put.messageId" }, "afterCommit": { "invoke": "#.self.id", "operation": "deliverNow" } },
                        { "set": "#.put" }
                    ]
                },
                "claim": {
                    "input": { "!messageId": "string" },
                    "output": { "!claimed": "boolean", "channel": "@ref/message-channel", "envelope": "@message-envelope" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "claim", "effects": ["irreversible"] } }
                },
                "markDelivered": {
                    "input": { "!messageId": "string" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "markDelivered", "effects": ["irreversible"] } }
                },
                "recordFailure": {
                    "input": { "!messageId": "string", "error": "object" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "recordFailure", "effects": ["irreversible"] } }
                },
                "deliverNow": {
                    "input": { "!messageId": "string" },
                    "implementation": [
                        { "outputKey": "claim", "invoke": "#.self.id", "operation": "claim" },
                        {
                            "if": "#.claim.claimed",
                            "then": {
                                "try": [
                                    { "inputMap": "#.claim.envelope", "invoke": "#.claim.channel", "operation": "deliver" },
                                    { "invoke": "#.self.id", "operation": "markDelivered" }
                                ],
                                "catch": { "inputMap": { "messageId": "#.input.messageId", "error": "#.error" }, "invoke": "#.self.id", "operation": "recordFailure" }
                            }
                        }
                    ]
                },
                "replay": {
                    "input": { "messageIds[]": "string", "channel": "string", "from": "string", "to": "string" },
                    "output": { "!count": "number" },
                    "implementation": { "low": { "module": "@business-framework/transactional-outbox", "export": "replay", "effects": ["irreversible"] } }
                },
                "skip": {
                    "input": { "!messageIds[]": "string" },
                    "output": { "!count": "number" },
                    "implementation": { "invoke": "outbox-skip-failed", "operation": "run" }
                },
                "purge": {
                    "input": { "!deliveredBefore": "string" },
                    "output": { "!count": "number" },
                    "implementation": { "invoke": "outbox-purge", "operation": "run" }
                }
            },
            "lifecycle": {
                "start": { "inputMap": { "$func/app-config-section": "outbox" }, "low": { "module": "@business-framework/transactional-outbox", "export": "startProcessor", "effects": ["irreversible"] } },
                "stop": { "low": { "module": "@business-framework/transactional-outbox", "export": "stopProcessor", "effects": ["irreversible"] } },
                "startAfter": ["database", "message-broker"]
            }
        }
    },
    {
        "id": "default-transactional-outbox",
        "kind": "transactional-outbox",
        "data": {}
    },
    { "id": "outbox-item", "kind": "schema", "data": { "!id": "string", "!messageId": "string", "!channel": "string", "!envelope": "@message-envelope", "!retryCount": "number" } },
    { "id": "outbox-insert", "kind": "query", "data": { "input": { "!channel": "string", "!envelope": "@message-envelope", "!now": "string" }, "output": { "!messageId": "string" } } },
    { "id": "outbox-claim", "kind": "query", "data": { "input": { "!messageId": "string", "!now": "string", "!lockedUntil": "string", "!pausedChannels[]": "string" }, "output": { "!claimed": "boolean", "channel": "string", "envelope": "@message-envelope" } } },
    { "id": "outbox-mark-delivered", "kind": "query", "data": { "input": { "!messageId": "string", "!processedAt": "string" }, "output": { "!channel": "string" } } },
    { "id": "outbox-entry", "kind": "query", "data": { "input": { "!messageId": "string" }, "output": { "!id": "string", "!channel": "string", "!retryCount": "number" } } },
    { "id": "outbox-retry-later", "kind": "query", "data": { "input": { "!id": "string", "!processAfter": "string" }, "output": "@any" } },
    { "id": "outbox-mark-failed", "kind": "query", "data": { "input": { "!id": "string" }, "output": "@any" } },
    { "id": "outbox-release", "kind": "query", "data": { "input": { "!id": "string", "!processAfter": "string" }, "output": "@any" } },
    { "id": "outbox-lock-batch", "kind": "query", "data": { "input": { "!now": "string", "!lockedUntil": "string", "!pausedChannels[]": "string", "!batchSize": "number" }, "output": "[@outbox-item]" } },
    { "id": "outbox-replay", "kind": "query", "data": { "input": { "messageIds[]": "string", "channel": "string", "from": "string", "to": "string", "!now": "string" }, "output": { "!count": "number" } } },
    { "id": "outbox-skip-failed", "kind": "query", "data": { "input": { "!messageIds[]": "string" }, "output": { "!count": "number" } } },
    { "id": "outbox-purge", "kind": "query", "data": { "input": { "!deliveredBefore": "string" }, "output": { "!count": "number" } } }
]
