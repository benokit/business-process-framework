[
    {
        "kind": "app-config",
        "data": { "meilisearch": { "url": "http://localhost:7700", "apiKey": "" } }
    },
    {
        "id": "meilisearch-engine",
        "kind": "kind",
        "data": {
            "extends": "search-engine",
            "operations": {
                "configureIndex": {
                    "implementation": { "low": { "module": "@business-framework/meilisearch", "functionName": "configureIndex" } }
                },
                "deleteIndex": {
                    "implementation": { "low": { "module": "@business-framework/meilisearch", "functionName": "deleteIndex" } }
                },
                "insertDocument": {
                    "implementation": { "low": { "module": "@business-framework/meilisearch", "functionName": "insertDocument" } }
                },
                "removeDocument": {
                    "implementation": { "low": { "module": "@business-framework/meilisearch", "functionName": "removeDocument" } }
                },
                "search": {
                    "implementation": { "low": { "module": "@business-framework/meilisearch", "functionName": "search" } }
                }
            },
            "lifecycle": {
                "start": { "inputMap": { "$func/app-config-section": "meilisearch" }, "low": { "module": "@business-framework/meilisearch", "functionName": "connect" } }
            }
        }
    },
    {
        "id": "meilisearch",
        "kind": "meilisearch-engine",
        "data": {}
    }
]
