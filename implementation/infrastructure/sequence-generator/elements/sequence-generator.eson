                    "output": { "!value": "number" },
                    "implementation": { "low": { "module": "@business-framework/sequence-generator", "export": "next" } }
                }
            }
        }
    },
    {
        "id": "sequences",
        "kind": "sequence-generator",
        "data": {}
    },
    {
        "id": "next-from-sequence",
