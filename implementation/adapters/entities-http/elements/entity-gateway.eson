[
    {
        "id": "entity-request",
        "kind": "schema",
        "data": { "!entityType": "@ref/entity-type", "!request": "object" }
    },
    {
        "id": "entity-gateway",
        "kind": "kind",
        "data": {
            "operations": {
                "assertEntityType": {
                    "input": "@entity-request",
                    "implementation": {
                        "if": { "$negate": { "$func/is-instance-of": { "element": "#.input.entityType", "kind": "entity-type" } } },
                        "then": { "throw": { "code": "not-found", "message": { "$str": ["no entity type ", "#.input.entityType"] } } }
                    }
                },
                "create": {
                    "input": "@entity-request",
                    "implementation": [
                        { "inputMap": "#.input", "invoke": "#.self.id", "operation": "assertEntityType" },
                        { "inputMap": "#.input.request", "invoke": "#.input.entityType", "operation": "create" }
                    ]
                },
                "read": {
                    "input": "@entity-request",
                    "implementation": [
                        { "inputMap": "#.input", "invoke": "#.self.id", "operation": "assertEntityType" },
                        { "inputMap": "#.input.request", "invoke": "#.input.entityType", "operation": "read" }
                    ]
                },
                "update": {
                    "input": "@entity-request",
                    "implementation": [
                        { "inputMap": "#.input", "invoke": "#.self.id", "operation": "assertEntityType" },
                        {
                            "inputMap": { "businessKey": "#.input.request.businessKey", "revision": "#.input.request.revision", "value": "#.input.request.body" },
                            "invoke": "#.input.entityType",
                            "operation": "update"
                        }
                    ]
                },
                "delete": {
                    "input": "@entity-request",
                    "implementation": [
                        { "inputMap": "#.input", "invoke": "#.self.id", "operation": "assertEntityType" },
                        { "inputMap": "#.input.request", "invoke": "#.input.entityType", "operation": "delete" }
                    ]
                },
                "types": {
                    "input": "@any",
                    "output": { "!items[]": { "!id": "string", "!kind": "string", "!traits": "object" } },
                    "implementation": {
                        "set": {
                            "items": {
                                "$map": {
                                    "over": { "$func/instances-of": "entity-type" },
                                    "fn": { "id": "#.id", "kind": "#.kind", "traits": { "$func/entity-traits": "#.id" } }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    {
        "id": "entities",
        "kind": "entity-gateway",
        "data": {}
    },
    {
        "id": "if-match-revision",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "@any" },
            "mapping": { "$parseInt": { "$replace": { "regex": "\"", "substitute": "", "string": { "$coalesce": ["#", ""] }, "global": true } } }
        }
    },
    {
        "id": "revision-etag",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "number", "output": "string" },
            "mapping": { "$str": ["\"", "#", "\""] }
        }
    }
]
