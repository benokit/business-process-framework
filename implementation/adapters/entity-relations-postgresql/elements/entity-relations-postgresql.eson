[
    {
        "id": "set-entity-relations-postgresql",
        "kind": "slot-fill",
        "/data": {
            "target": "set-entity-relations",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "missing",
                        "statement": { "/uri": "@business-framework/entity-relations-postgresql/sql/missing-target.sql" },
                        "read": true,
                        "parameters": [{ "relations": "#.relations" }]
                    },
                    { "outputKey": "target", "set": { "$head": "#.missing" } },
                    {
                        "if": "#.target",
                        "then": {
                            "throw": {
                                "code": "not-found",
                                "message": {
                                    "$str": ["related ", "#.target.targetEntityType", " '", "#.target.targetEntityBusinessKey", "' doesn't exist"]
                                },
                                "data": "#.target"
                            }
                        }
                    },
                    {
                        "statement": { "/uri": "@business-framework/entity-relations-postgresql/sql/set-relations.sql" },
                        "parameters": ["#.sourceEntityId", { "relations": "#.relations" }]
                    },
                    { "set": null }
                ]
            }
        }
    },
    {
        "id": "entity-relations-of-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "entity-relations-of",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": {
                    "statement": "SELECT target_entity_id AS \"targetEntityId\", relation_type AS \"relationType\" FROM entity_relations WHERE source_entity_id = $1",
                    "read": true,
                    "parameters": ["#.sourceEntityId"]
                }
            }
        }
    },
    {
        "id": "entity-relations-table",
        "kind": "slot-fill",
        "/data": {
            "target": "postgresql-database",
            "slot": "migrations",
            "after": ["entities-table"],
            "value": { "command": { "/uri": "@business-framework/entity-relations-postgresql/sql/entity-relations-table.sql" } }
        }
    }
]
