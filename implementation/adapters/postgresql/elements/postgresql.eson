[
    {
        "id": "postgresql-database",
        "kind": "kind",
        "data": {
            "extends": "database",
            "settings": { "shape": { "!url": "string" }, "defaults": { "url": "postgresql://admin:password@localhost:5432/app" } },
            "operations": {
                "execute": {
                    "implementation": [
                        { "outputKey": "result", "low": { "module": "@business-framework/postgresql", "export": "execute", "effects": ["write"] } },
                        { "set": { "rows": "#.result.rows", "rowCount": "#.result.rowCount" } }
                    ]
                },
                "read": {
                    "implementation": [
                        { "outputKey": "result", "low": { "module": "@business-framework/postgresql", "export": "execute", "effects": ["read"] } },
                        { "set": { "rows": "#.result.rows", "rowCount": "#.result.rowCount" } }
                    ]
                },
                "executeIrreversible": {
                    "implementation": [
                        { "outputKey": "result", "low": { "module": "@business-framework/postgresql", "export": "execute", "effects": ["irreversible"] } },
                        { "set": { "rows": "#.result.rows", "rowCount": "#.result.rowCount" } }
                    ]
                },
                "begin": { "implementation": { "low": { "module": "@business-framework/postgresql", "export": "begin", "effects": ["write"] } } },
                "commit": { "implementation": { "low": { "module": "@business-framework/postgresql", "export": "commit", "effects": ["write"] } } },
                "rollback": { "implementation": { "low": { "module": "@business-framework/postgresql", "export": "rollback", "effects": ["write"] } } }
            },
            "lifecycle": {
                "start": { "inputMap": { "$func/settings": "#.self.id" }, "low": { "module": "@business-framework/postgresql", "export": "connect", "effects": ["irreversible"] } },
                "stop": { "low": { "module": "@business-framework/postgresql", "export": "disconnect", "effects": ["irreversible"] } }
            }
        }
    },
    {
        "id": "default-postgresql-database",
        "kind": "postgresql-database",
        "data": {}
    }
]
