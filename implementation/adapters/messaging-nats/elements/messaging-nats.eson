[
    {
        "id": "nats-broker",
        "kind": "kind",
        "data": {
            "extends": "message-broker",
            "settings": { "shape": { "!url": "string" }, "defaults": { "url": "nats://localhost:4222" } },
            "operations": {
                "publish": {
                    "implementation": [
                        { "outputKey": "url", "set": { "$get": { "object": { "$func/settings": "#.self.id" }, "path": "url" } } },
                        { "inputMap": { "$merge": ["#.input", { "url": "#.url" }] }, "low": { "module": "@business-framework/messaging-nats", "export": "publish", "effects": ["irreversible"] } }
                    ]
                },
                "subscribe": {
                    "implementation": [
                        { "outputKey": "url", "set": { "$get": { "object": { "$func/settings": "#.self.id" }, "path": "url" } } },
                        { "inputMap": { "$merge": ["#.input", { "url": "#.url" }] }, "low": { "module": "@business-framework/messaging-nats", "export": "subscribe", "effects": ["irreversible"] } }
                    ]
                },
                "unsubscribe": {
                    "implementation": { "low": { "module": "@business-framework/messaging-nats", "export": "unsubscribe", "effects": ["irreversible"] } }
                }
            },
            "lifecycle": {
                "stop": { "low": { "module": "@business-framework/messaging-nats", "export": "disconnect", "effects": ["irreversible"] } }
            }
        }
    },
    {
        "id": "default-nats-broker",
        "kind": "nats-broker",
        "data": {}
    }
]
