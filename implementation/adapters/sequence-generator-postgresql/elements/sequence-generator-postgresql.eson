[
    {
        "id": "next-sequence-value-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "next-sequence-value",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    { "outputKey": "name", "set": { "$str": ["seq_", { "$replace": { "regex": "-", "substitute": "_", "string": "#.input.sequence", "global": true } }] } },
                    { "inputMap": "#.name", "statement": { "$str": ["CREATE SEQUENCE IF NOT EXISTS ", "#", " START 1"] } },
                    { "outputKey": "rows", "inputMap": "#.name", "statement": { "$str": ["SELECT nextval('", "#", "') AS value"] }, "irreversible": true, "row": { "value": { "$parseInt": "#.value" } } },
                    { "set": { "$head": "#.rows" } }
                ]
            }
        }
    }
]
