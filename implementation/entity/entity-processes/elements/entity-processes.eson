[
    {
        "id": "process-role",
        "kind": "schema",
        "data": { "!entityType": "@ref/entity-type", "late": "boolean", "many": "boolean", "*": "never" }
    },
    {
        "id": "process-task",
        "kind": "schema",
        "data": { "!type": "@ref/entity-type", "about[]": "string", "*": "never" }
    },
    {
        "id": "process-opening",
        "kind": "schema",
        "data": { "body": "@mapping", "dueOn": "@mapping", "assignTo": "@mapping", "*": "never" }
    },
    {
        "id": "process-signal",
        "kind": "schema",
        "data": { "!to": "string", "!by": "string", "payload": "@schema", "*": "never" }
    },
    {
        "id": "process-duration",
        "kind": "schema",
        "data": { "days": "integer", "hours": "integer", "minutes": "integer", "*": "never" }
    },
    {
        "id": "process-until",
        "kind": "schema",
        "data": { "at": "@mapping", "after": "@process-duration", "!then": "string", "*": "never" }
    },
    {
        "id": "process-condition",
        "kind": "schema",
        "data": { "!test": "@mapping", "resolve{}": "string", "!then": "string", "*": "never" }
    },
    {
        "id": "process-wait",
        "kind": "schema",
        "data": { "when[]": "@process-condition", "signals{}": "@process-signal", "until": "@process-until", "*": "never" }
    },
    {
        "id": "process-error-exit",
        "kind": "schema",
        "data": { "!catches[]": "string", "set": "@mapping", "!then": "string", "*": "never" }
    },
    {
        "id": "process-step",
        "kind": "schema",
        "data": {
            "do": "@method",
            "transition{}": "string",
            "open{}": "@process-opening",
            "set": "@mapping",
            "next": "string",
            "choose[]": "@any",
            "wait": "@process-wait",
            "end": "boolean",
            "onError[]": "@process-error-exit",
            "extensible": "boolean",
            "*": "never"
        }
    },
    {
        "id": "process-step-extension",
        "kind": "schema",
        "data": { "!step": "string", "!do": "@method", "*": "never" }
    },
    {
        "id": "process-step-extensions-slot",
        "kind": "slot-declaration",
        "data": { "target": "process-definition", "slot": "stepExtensions", "cardinality": "many", "value": "@process-step-extension" }
    },
    {
        "id": "process-step-extensions-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "string", "!step": "string" }, "output": "@any" },
            "mapping": {"$let": {"data": {"$func/process-definition-of": "#.definition"}, "declared": {"$get": {"object": "@data.steps", "path": "#.step"}}}, "$in": {"$if": ["@declared.extensible", {"$filter": {"collection": {"$func/slot-values": {"element": "#.definition", "slot": "stepExtensions"}}, "as": "extension", "predicate": {"$eq": ["@extension.step", "#.step"]}}}, []]}}
        }
    },
    {
        "id": "process-definition-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-processes/definitions",
            "export": "processDefinitionProblems"
        }
    },
    {
        "id": "process-definition",
        "kind": "kind",
        "data": {
            "shape": {
                "!entities{}": "@process-role",
                "tasks{}": "@process-task",
                "input": "@schema",
                "variables": "@schema",
                "key": "@mapping",
                "!start": "string",
                "!steps{}": "@process-step"
            },
            "lifecycle": { "validate": { "$func/process-definition-problems": "#.self.id" } }
        }
    },
    {
        "id": "process-configuration",
        "kind": "schema",
        "data": { "!definition": "@ref/process-definition" }
    },
    {
        "id": "process-binding",
        "kind": "schema",
        "data": { "!entityType": "string", "!businessKey": "string" }
    },
    {
        "id": "process-start-input",
        "kind": "schema",
        "data": { "!entities{}": "@any", "input": "@any" }
    },
    {
        "id": "initial-process-value",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "string", "!entities{}": "@any" }, "output": { "!value": { "!definition": "string", "!step": "string", "!entities{}": "@any" }, "!problems[]": "string" } },
            "mapping": {"$let": {"data": {"$func/process-definition-of": "#.definition"}, "roles": {"$func/process-roles-of": "@data"}}, "$in": {"value": {"definition": "#.definition", "step": "@data.start", "entities": {"$mapValues": {"of": "#.entities", "as": ["keys", "role"], "fn": {"$let": {"declared": {"$get": {"object": "@roles", "path": "@role"}}}, "$in": {"$if": ["@declared.many", {"$map": {"over": {"$concat": [[], "@keys"]}, "as": "key", "fn": {"entityType": "@declared.entityType", "businessKey": "@key"}}}, {"entityType": "@declared.entityType", "businessKey": "@keys"}]}}}}}, "problems": {"$concat": [{"$map": {"over": {"$filter": {"collection": {"$keys": "@roles"}, "as": "role", "predicate": {"$and": [{"$not": {"$let": {"declared": {"$get": {"object": "@roles", "path": "@role"}}}, "$in": "@declared.late"}}, {"$not": {"$not": {"$isNil": {"$get": {"object": "#.entities", "path": "@role"}}}}}]}}}, "as": "role", "fn": {"$str": ["the role '", "@role", "' must be bound to start ", "#.definition"]}}}, {"$map": {"over": {"$filter": {"collection": {"$keys": "@roles"}, "as": "role", "predicate": {"$and": [{"$let": {"declared": {"$get": {"object": "@roles", "path": "@role"}}}, "$in": "@declared.late"}, {"$not": {"$isNil": {"$get": {"object": "#.entities", "path": "@role"}}}}]}}}, "as": "role", "fn": {"$str": ["the role '", "@role", "' is late: a step binds it, not the start"]}}}, {"$map": {"over": {"$filter": {"collection": {"$keys": "#.entities"}, "as": "role", "predicate": {"$isNil": {"$get": {"object": "@roles", "path": "@role"}}}}}, "as": "role", "fn": {"$str": ["#.definition", " has no role '", "@role", "'"]}}}]}}}
        }
    },
    {
        "id": "process-step-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "string", "!step": "string" }, "output": "@any" },
            "module": "@business-framework/entity-processes/process",
            "export": "processStepOf"
        }
    },
    {
        "id": "process-exit",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!name": "string", "!step": "@any", "!scope": "@any", "!revision": "integer", "!bindings": "@any" }, "output": "@any" },
            "mapping": {"$let": {"definition": "#.scope.process.data.process.definition", "variables": {"$merge": ["#.scope.process.data.body", {"$if": [{"$isNil": "#.step.set"}, {}, {"$func/apply-mapping": {"mapping": "#.step.set", "input": "#.scope"}}]}]}, "roles": {"$func/process-roles-of": {"$func/process-definition-of": "@definition"}}, "bind": {"$coalesce": ["#.scope.output.bind", {}]}, "inscope": {"$merge": ["#.scope", {"process": {"$merge": ["#.scope.process", {"data": {"$merge": ["#.scope.process.data", {"body": "@variables"}]}}]}}]}, "found": {"$head": {"$filter": {"collection": {"$map": {"over": {"$keys": "@bind"}, "as": "role", "fn": {"$let": {"declared": {"$get": {"object": "@roles", "path": "@role"}}}, "$in": {"$cond": [[{"$isNil": "@declared"}, {"code": "invalid", "message": {"$str": ["@definition", " has no role '", "@role", "'"]}, "data": {"definition": "@definition", "role": "@role"}}], [{"$not": "@declared.late"}, {"code": "conflict", "message": {"$str": ["the role '", "@role", "' is bound at the start and never rebound"]}, "data": {"definition": "@definition", "role": "@role"}}], [{"$and": [{"$not": "@declared.many"}, {"$not": {"$isNil": {"$get": {"object": "#.bindings", "path": "@role"}}}}]}, {"code": "conflict", "message": {"$str": ["the role '", "@role", "' is already bound"]}, "data": {"definition": "@definition", "role": "@role"}}], ["else", null]]}}}}, "as": "found", "predicate": {"$not": {"$isNil": "@found"}}}}}, "exit": {"$cond": [["#.step.end", {"kind": "end"}], [{"$not": {"$isNil": "#.step.next"}}, {"kind": "next", "step": "#.step.next"}], [{"$not": {"$isNil": "#.step.choose"}}, {"$let": {"chosen": {"$find": {"collection": "#.step.choose", "as": "entry", "predicate": {"$or": [{"$eq": ["@entry.0", "else"]}, {"$func/apply-mapping": {"mapping": "@entry.0", "input": "@inscope"}}]}}}}, "$in": {"$if": [{"$isNil": "@chosen"}, {"problem": {"code": "invalid", "message": {"$str": ["no choose entry of the step '", "#.name", "' holds"]}, "data": {"step": "#.name"}}}, {"kind": "next", "step": "@chosen.1"}]}}], ["else", {"kind": "wait", "wait": {"$merge": [{"token": {"$sum": ["#.revision", 1]}, "signals": {"$keys": {"$coalesce": ["#.step.wait.signals", {}]}}}, {"$if": [{"$isNil": "#.step.wait.until"}, {}, {"until": {"$merge": [{"then": "#.step.wait.until.then"}, {"$if": [{"$isNil": "#.step.wait.until.at"}, {"after": "#.step.wait.until.after"}, {"at": {"$func/apply-mapping": {"mapping": "#.step.wait.until.at", "input": "@inscope"}}}]}]}}]}]}}]]}}, "$in": {"$merge": [{"variables": "@variables", "entities": {"$merge": ["#.bindings", {"$mapValues": {"of": "@bind", "as": ["keys", "role"], "fn": {"$let": {"declared": {"$get": {"object": "@roles", "path": "@role"}}}, "$in": {"$if": ["@declared.many", {"$concat": [{"$coalesce": [{"$get": {"object": "#.bindings", "path": "@role"}}, []]}, {"$map": {"over": {"$concat": [[], "@keys"]}, "as": "key", "fn": {"entityType": "@declared.entityType", "businessKey": "@key"}}}]}, {"entityType": "@declared.entityType", "businessKey": "@keys"}]}}}}]}}, "@exit", {"$if": [{"$not": {"$isNil": "@found"}}, {"problem": "@found"}, {}]}]}}
        }
    },
    {
        "id": "process-recovery",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!name": "string", "!step": "@any", "!scope": "@any", "!error": "@any", "!bindings": "@any" }, "output": "@any" },
            "module": "@business-framework/entity-processes/process",
            "export": "processErrorExit"
        }
    },
    {
        "id": "process-position",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!process": "@any", "!step": "string", "wait": "@any", "entities": "@any" }, "output": "@any" },
            "mapping": {"$merge": [{"definition": "#.process.definition", "step": "#.step", "entities": {"$coalesce": ["#.entities", "#.process.entities"]}}, {"$if": ["#.wait", {"wait": "#.wait"}, {}]}]}
        }
    },
    {
        "id": "process-verdict",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!process": "@any", "!wakeup": "@any", "!error": "@any", "!attempts": "integer", "target": "@any" }, "output": { "!action=1": ["rethrow", "count", "suspend", "drop"], "!operations[]": "@any" } },
            "mapping": {"$let": {"type": {"$func/error-type-lookup": "#.error.code"}, "step": {"$coalesce": ["#.target.step", "#.process.data.process.step"]}, "count": {"$sum": [{"$if": [{"$eq": ["#.process.data.process.failures.step", "@step"]}, {"$coalesce": ["#.process.data.process.failures.count", 0]}, 0]}, 1]}}, "$in": {"$cond": [[{"$or": ["@type.outage", {"$eq": ["#.wakeup.kind", "start"]}]}, {"action": "rethrow", "operations": []}], [{"$neq": ["#.process.data.state.status", "running"]}, {"action": "drop", "operations": []}], [{"$or": [{"$not": "@type.transient"}, {"$gte": ["@count", "#.attempts"]}]}, {"action": "suspend", "operations": [{"key": "process", "operation": "move", "input": {"process": {"$merge": ["#.process.data.process", {"fault": {"step": "@step", "code": "#.error.code", "message": "#.error.message", "attempts": "@count", "wakeup": "#.wakeup"}}]}}}, {"key": "state", "operation": "transition", "input": {"transition": "suspend"}}]}], ["else", {"action": "count", "operations": [{"key": "process", "operation": "move", "input": {"process": {"$merge": ["#.process.data.process", {"failures": {"step": "@step", "count": "@count"}}]}}}]}]]}}
        }
    },
    {
        "id": "process-relations-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[@entity-relation]" },
            "mapping": {"$if": [{"$includes": {"collection": ["ended", "aborted"], "value": "#.data.state.status"}}, [], {"$concat": {"$values": {"$mapValues": {"of": "#.data.process.entities", "as": ["binding", "role"], "fn": {"$map": {"over": {"$concat": [[], "@binding"]}, "as": "bound", "fn": {"targetEntityType": "@bound.entityType", "targetEntityBusinessKey": "@bound.businessKey", "relationType": "@role"}}}}}}}]}
        }
    },
    {
        "id": "process-relations",
        "kind": "slot-fill",
        "data": { "target": "process-entity-type", "slot": "relations", "value": { "set": { "relations": { "$func/process-relations-of": "#.input" } } } }
    },
    {
        "id": "process-footprint-allows",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!process": "@any", "!change": "@any", "!entityType": "string" }, "output": "boolean" },
            "mapping": {"$if": [{"$eq": ["#.change.operation", "create"]}, {"$any": {"collection": {"$values": {"$func/process-roles-of": {"$func/process-definition-of": "#.process.definition"}}}, "as": "role", "predicate": {"$eq": ["@role.entityType", "#.entityType"]}}}, {"$any": {"collection": {"$concat": {"$values": "#.process.entities"}}, "as": "bound", "predicate": {"$and": [{"$eq": ["@bound.entityType", "#.change.before.entityType"]}, {"$eq": ["@bound.businessKey", "#.change.before.businessKey"]}]}}}]}
        }
    },
    { "id": "outside-process-footprint-error", "kind": "slot-fill", "data": { "target": "error-registry", "slot": "errorTypes", "value": { "code": "outside-process-footprint", "extends": "forbidden" } } },
    {
        "id": "process-footprint-guard",
        "kind": "slot-fill",
        "data": {
            "target": "entity-type",
            "slot": "requestGuards",
            "on": ["create", "trait", "delete"],
            "value": {
                "if": "#._ctx.process",
                "then": {
                    "if": { "$not": { "$func/process-footprint-allows": { "process": "#._ctx.process", "change": "#.input", "entityType": "#.self.id" } } },
                    "then": {
                        "throw": {
                            "code": "outside-process-footprint",
                            "message": { "$str": ["the process ", "#._ctx.process.businessKey", " (", "#._ctx.process.definition", ") may not ", { "$coalesce": ["#.input.entityOperation", "#.input.operation"] }, " ", "#.self.id", " '", { "$coalesce": ["#.input.before.businessKey", "#.input.after.businessKey"] }, "': it isn't one of its participants"] }
                        }
                    }
                }
            }
        }
    },
    {
        "id": "resolved-wait",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!wait": "@any", "!now": "string" }, "output": "@any" },
            "module": "@business-framework/entity-processes/process",
            "export": "resolvedWait"
        }
    },
    {
        "id": "process-held-exit",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!step": "@any", "!exit": "@any", "entities": "@any", "!scope": "@any" }, "output": "@any" },
            "mapping": {"$let": {"held": {"$if": [{"$and": [{"$eq": ["#.exit.kind", "wait"]}, {"$not": {"$isNil": "#.entities"}}]}, {"$find": {"collection": {"$coalesce": ["#.step.wait.when", []]}, "as": "entry", "predicate": {"$func/apply-mapping": {"mapping": "@entry.test", "input": {"$func/process-scope": {"definition": "#.scope.process.data.process.definition", "scope": "#.scope", "participants": "#.entities"}}}}}}, null]}}, "$in": {"$if": [{"$isNil": "@held"}, "#.exit", {"kind": "next", "step": "@held.then", "variables": "#.exit.variables", "entities": "#.exit.entities", "resolve": {"$coalesce": ["@held.resolve", {}]}}]}}
        }
    },
    {
        "id": "process-changed-views",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "before": "@any", "after": "@any" }, "output": "@any" },
            "module": "@business-framework/entity-processes/process",
            "export": "changedViews"
        }
    },
    {
        "id": "process-view-roles",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "@any" },
            "mapping": {"$map": {"over": "#.changed", "as": "name", "fn": {"definition": {"$head": {"$split": {"separator": "/", "string": "@name"}}}, "role": {"$join": {"separator": "/", "strings": {"$tail": {"$split": {"separator": "/", "string": "@name"}}}}}}}}
        }
    },
    {
        "id": "process-checks-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!message": "@any", "!view": "@any", "!sources": "@any" }, "output": "@any" },
            "mapping": {"$let": {"types": {"$map": {"over": {"$filter": {"collection": {"$func/instances-of": "process-entity-type"}, "as": "element", "predicate": {"$eq": ["@element.data.definition", "#.view.definition"]}}}, "as": "element", "fn": "@element.id"}}}, "$in": {"$map": {"over": {"$filter": {"collection": "#.sources", "as": "source", "predicate": {"$and": [{"$includes": {"collection": "@types", "value": "@source.sourceEntityType"}}, {"$not": {"$and": [{"$eq": ["#.message.via.definition", "#.view.definition"]}, {"$eq": ["#.message.via.businessKey", "@source.sourceEntityBusinessKey"]}]}}]}}}, "as": "source", "fn": {"message": {"kind": "check", "entityType": "@source.sourceEntityType", "businessKey": "@source.sourceEntityBusinessKey", "role": "#.view.role", "revision": "#.message.revision"}, "group": {"$str": ["@source.sourceEntityType", "/", "@source.sourceEntityBusinessKey"]}}}}}
        }
    },
    {
        "id": "process-view-change",
        "kind": "schema",
        "data": { "!entityType": "string", "!id": "string", "!businessKey": "string", "!revision": "integer", "!changed[]": "string", "via": "@any" }
    },
    {
        "id": "entity-view-changes",
        "kind": "message-channel",
        "data": {
            "broker": { "instanceOf": "message-broker" },
            "topology": "topic",
            "name": "entity-view-changes",
            "publisher": { "transactionalOutbox": true, "retry": { "attempts": 5, "backoff": 500 } },
            "consumer": { "retry": { "attempts": 5, "backoff": 500 } }
        }
    },
    {
        "id": "publish-process-view-changes",
        "kind": "slot-fill",
        "data": {
            "target": "entity-type",
            "slot": "reactions",
            "value": [
                { "outputKey": "record", "set": { "$coalesce": ["#.input.after", "#.input.before"] } },
                { "outputKey": "changed", "set": { "$func/process-changed-views": { "entityType": "#.record.entityType", "before": "#.input.before", "after": "#.input.after" } } },
                {
                    "if": "#.changed",
                    "then": {
                        "inputMap": {
                            "message": {
                                "entityType": "#.record.entityType",
                                "id": "#.record.id",
                                "businessKey": "#.record.businessKey",
                                "revision": "#.record.revision",
                                "changed": "#.changed",
                                "via": { "$if": ["#._ctx.process", { "definition": "#._ctx.process.definition", "businessKey": "#._ctx.process.businessKey" }, null] }
                            },
                            "subject": "#.record.entityType",
                            "messageId": { "$join": { "strings": ["#.record.id", "#.record.revision", "#.input.operation", "views"], "separator": "-" } },
                            "group": { "$join": { "strings": ["#.record.entityType", "#.record.businessKey"], "separator": "/" } }
                        },
                        "publish": "entity-view-changes"
                    }
                }
            ]
        }
    },
    {
        "id": "process-watcher",
        "kind": "message-consumer",
        "data": {
            "channel": "entity-view-changes",
            "handler": {
                "asSystem": {
                    "forEach": [
                        {
                            "outputKey": "sources",
                            "inputMap": { "targetEntityId": "#.input.id", "relationType": "#.item.role" },
                            "invoke": "entity-relations-to",
                            "operation": "run"
                        },
                        {
                            "outputKey": "checks",
                            "set": { "$func/process-checks-of": { "message": "#.input", "view": "#.item", "sources": "#.sources" } }
                        },
                        { "inputMap": "#.checks", "forEach": { "inputMap": "#.item", "publish": "process-wakeups" } }
                    ],
                    "inputMap": { "$func/process-view-roles": "#.input" }
                }
            }
        }
    },
    {
        "id": "process-definition-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "@any" },
            "module": "@business-framework/entity-processes/process",
            "export": "definitionOf"
        }
    },
    {
        "id": "process-roles-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "@any" },
            "module": "@business-framework/entity-processes/process",
            "export": "rolesOf"
        }
    },
    {
        "id": "process-definition-of-type",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "string" },
            "mapping": {"$let": {"type": {"$find": {"collection": {"$func/instances-of": "process-entity-type"}, "as": "element", "predicate": {"$eq": ["@element.id", "#"]}}}}, "$in": "@type.data.definition"}
        }
    },
    {
        "id": "process-scope",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "string", "!scope": "@any", "!participants": "@any" }, "output": "@any" },
            "mapping": {"$let": {"roles": {"$func/process-roles-of": {"$func/process-definition-of": "#.definition"}}}, "$in": {"$merge": ["#.scope", {"entities": {"$pick": {"keys": {"$filter": {"collection": {"$keys": "#.participants"}, "as": "role", "predicate": {"$not": {"$let": {"declared": {"$get": {"object": "@roles", "path": "@role"}}}, "$in": "@declared.task"}}}}, "object": "#.participants"}}, "tasks": {"$pick": {"keys": {"$filter": {"collection": {"$keys": "#.participants"}, "as": "role", "predicate": {"$let": {"declared": {"$get": {"object": "@roles", "path": "@role"}}}, "$in": "@declared.task"}}}, "object": "#.participants"}}}]}}
        }
    },
    {
        "id": "process-task-openings",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "string", "!name": "string", "!step": "@any", "!scope": "@any" }, "output": "@any" },
            "mapping": {"$let": {"tasks": {"$coalesce": [{"$get": {"object": {"$func/process-definition-of": "#.definition"}, "path": "tasks"}}, {}]}, "entries": {"$values": {"$mapValues": {"of": {"$coalesce": ["#.step.open", {}]}, "as": ["opening", "task"], "fn": {"task": "@task", "opening": "@opening", "current": {"$get": {"object": "#.scope.tasks", "path": "@task"}}, "declared": {"$get": {"object": "@tasks", "path": "@task"}}}}}}, "closed": {"$find": {"collection": "@entries", "as": "entry", "predicate": {"$and": [{"$not": {"$isNil": "@entry.current"}}, {"$neq": ["@entry.current.data.task.status", "open"]}]}}}, "pairs": {"$map": {"over": {"$filter": {"collection": "@entries", "as": "entry", "predicate": {"$isNil": "@entry.current"}}}, "as": "entry", "fn": {"task": "@entry.task", "opening": {"entityType": "@entry.declared.type", "businessKey": {"$str": [{"$replace": {"regex": "/", "substitute": ".", "global": true, "string": "#.scope.process.businessKey"}}, ".", "@entry.task"]}, "traits": {"task": {"$merge": [{"origin": {"process": "#.scope.process.businessKey", "step": "#.name"}, "about": {"$concat": {"$map": {"over": {"$coalesce": ["@entry.declared.about", []]}, "as": "role", "fn": {"$map": {"over": {"$filter": {"collection": {"$concat": [[], {"$get": {"object": "#.scope.entities", "path": "@role"}}]}, "as": "record", "predicate": {"$not": {"$isNil": "@record"}}}}, "as": "record", "fn": {"entityType": "@record.entityType", "businessKey": "@record.businessKey"}}}}}}}, {"$if": [{"$isNil": "@entry.opening.dueOn"}, {}, {"dueOn": {"$func/apply-mapping": {"mapping": "@entry.opening.dueOn", "input": {"$merge": ["#.scope", {"step": "#.name"}]}}}}]}, {"$if": [{"$isNil": "@entry.opening.assignTo"}, {}, {"assignedTo": {"$func/apply-mapping": {"mapping": "@entry.opening.assignTo", "input": {"$merge": ["#.scope", {"step": "#.name"}]}}}}]}]}, "body": {"$if": [{"$isNil": "@entry.opening.body"}, {}, {"$func/apply-mapping": {"mapping": "@entry.opening.body", "input": {"$merge": ["#.scope", {"step": "#.name"}]}}}]}}}}}}}, "$in": {"openings": {"$map": {"over": "@pairs", "as": "pair", "fn": "@pair.opening"}}, "bind": {"$mapValues": {"of": {"$toDictionary": {"by": "@pair.task", "as": "pair", "collection": "@pairs"}}, "as": "pair", "fn": "@pair.opening.businessKey"}}, "conflict": {"$if": [{"$isNil": "@closed"}, null, {"code": "conflict", "message": {"$str": ["the task '", "@closed.task", "' of ", "#.definition", " is ", "@closed.current.data.task.status", ", and a task is opened once"]}, "data": {"definition": "#.definition", "task": "@closed.task"}}]}}}
        }
    },
    {
        "id": "process-transitions",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!step": "@any", "!scope": "@any" }, "output": "@any" },
            "mapping": {"$values": {"$mapValues": {"of": {"$coalesce": ["#.step.transition", {}]}, "as": ["transition", "role"], "fn": {"$let": {"participant": {"$get": {"object": "#.scope.entities", "path": "@role"}}}, "$in": {"entityType": "@participant.entityType", "businessKey": "@participant.businessKey", "transition": "@transition"}}}}}
        }
    },
    {
        "id": "process-task-closures",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!step": "@any", "!entities": "@any", "!resolve": "@any" }, "output": "@any" },
            "mapping": {"$let": {"roles": {"$if": [{"$eq": ["#.step", null]}, {"$keys": "#.entities"}, {"$unique": {"$concat": {"$map": {"over": {"$coalesce": ["#.step.wait.when", []]}, "as": "entry", "fn": {"$keys": {"$coalesce": ["@entry.resolve", {}]}}}}}}]}}, "$in": {"$concat": {"$map": {"over": "@roles", "as": "role", "fn": {"$let": {"outcome": {"$get": {"object": "#.resolve", "path": "@role"}}}, "$in": {"$map": {"over": {"$filter": {"collection": {"$concat": [[], {"$get": {"object": "#.entities", "path": "@role"}}]}, "as": "record", "predicate": {"$eq": ["@record.data.task.status", "open"]}}}, "as": "record", "fn": {"$merge": [{"entityType": "@record.entityType", "businessKey": "@record.businessKey", "revision": "@record.revision"}, {"$if": [{"$isNil": "@outcome"}, {"operation": "cancel"}, {"operation": "resolve", "input": {"outcome": "@outcome"}}]}]}}}}}}}}
        }
    },
    {
        "id": "process-business-key",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!entities": "@any", "input": "@any" }, "output": "string" },
            "mapping": {"$let": {"definition": {"$func/process-definition-of-type": "#.entityType"}, "data": {"$func/process-definition-of": "@definition"}, "roles": {"$func/process-roles-of": "@data"}}, "$in": {"$join": {"separator": "/", "strings": {"$concat": [["@definition"], {"$concat": {"$map": {"over": {"$filter": {"collection": {"$keys": "@roles"}, "as": "role", "predicate": {"$not": {"$let": {"declared": {"$get": {"object": "@roles", "path": "@role"}}}, "$in": "@declared.late"}}}}, "as": "role", "fn": {"$concat": [[], {"$get": {"object": "#.entities", "path": "@role"}}]}}}}, {"$if": [{"$isNil": "@data.key"}, [], {"$func/apply-mapping": {"mapping": "@data.key", "input": {"entities": "#.entities", "input": {"$coalesce": ["#.input", null]}}}}]}]}}}}
        }
    },
    {
        "id": "process-signal-role",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!name": "string" }, "output": "@any" },
            "mapping": {"$let": {"data": {"$func/process-definition-of": {"$func/process-definition-of-type": "#.entityType"}}, "signals": {"$find": {"collection": {"$map": {"over": {"$values": "@data.steps"}, "as": "step", "fn": {"$coalesce": ["@step.wait.signals", {}]}}}, "as": "declared", "predicate": {"$not": {"$isNil": {"$get": {"object": "@declared", "path": "#.name"}}}}}}, "declared": {"$get": {"object": "@signals", "path": "#.name"}}}, "$in": "@declared.by"}
        }
    },
    {
        "id": "process-signal-wakeups",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!name": "string", "payload": "@any", "!sources": "@any" }, "output": "@any" },
            "mapping": {"$map": {"over": {"$filter": {"collection": "#.sources", "as": "source", "predicate": {"$eq": ["@source.sourceEntityType", "#.entityType"]}}}, "as": "source", "fn": {"message": {"$merge": [{"kind": "signal", "entityType": "#.entityType", "businessKey": "@source.sourceEntityBusinessKey", "name": "#.name"}, {"$if": [{"$isNil": "#.payload"}, {}, {"payload": "#.payload"}]}]}, "group": {"$str": ["#.entityType", "/", "@source.sourceEntityBusinessKey"]}}}}
        }
    },
    {
        "id": "process-trigger-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-processes/definitions",
            "export": "processTriggerProblems"
        }
    },
    {
        "id": "process-trigger-start",
        "kind": "schema",
        "data": { "!process": "string", "!entities": "@mapping", "input": "@mapping", "*": "never" }
    },
    {
        "id": "process-trigger-signal",
        "kind": "schema",
        "data": { "!process": "string", "!name": "string", "!entity": "@mapping", "payload": "@mapping", "*": "never" }
    },
    {
        "id": "process-trigger-on",
        "kind": "schema",
        "data": { "!channel": "@ref/message-channel", "subject": "@message-subject", "test": "@mapping", "*": "never" }
    },
    {
        "id": "state-process-trigger",
        "kind": "kind",
        "data": {
            "extends": "process-trigger",
            "shape": { "!entityType": "@ref/entity-type", "!transition": "string", "!process": "string", "!role": "string", "*": "never" },
            "mapping": {
                "on": {
                    "channel": "entity-events",
                    "subject": "#.data.entityType",
                    "test": {
                        "$template": {
                            "with": { "transition": "#.data.transition" },
                            "mapping": {
                                "$any": {
                                    "collection": "#.commands",
                                    "as": "command",
                                    "predicate": { "$eq": ["@command", { "$literal": { "key": "state", "command": "@transition" } }] }
                                }
                            }
                        }
                    }
                },
                "start": {
                    "process": "#.data.process",
                    "entities": { "$template": { "with": { "role": "#.data.role" }, "mapping": { "@role": "#.businessKey" } } }
                }
            }
        }
    },
    {
        "id": "process-trigger",
        "kind": "kind",
        "data": {
            "extends": "message-consumer",
            "shape": { "!on": "@process-trigger-on", "start": "@process-trigger-start", "signal": "@process-trigger-signal" },
            "mapping": {
                "channel": "#.data.on.channel",
                "filter": { "$if": ["#.data.on.subject", ["#.data.on.subject"], []] },
                "handler": { "asSystem": { "inputMap": "\\#.input", "invoke": "\\#.self.id", "operation": "convert" } }
            },
            "operations": {
                "convert": {
                    "input": "@any",
                    "output": "@any",
                    "implementation": [
                        {
                            "outputKey": "applies",
                            "set": { "$if": ["#.self.data.on.test", { "$func/apply-mapping": { "mapping": "#.self.data.on.test", "input": "#.input" } }, true] }
                        },
                        {
                            "if": "#.applies",
                            "then": {
                                "if": "#.self.data.start",
                                "then": [
                                    { "outputKey": "entities", "set": { "$func/apply-mapping": { "mapping": "#.self.data.start.entities", "input": "#.input" } } },
                                    { "outputKey": "startInput", "set": { "$if": ["#.self.data.start.input", { "$func/apply-mapping": { "mapping": "#.self.data.start.input", "input": "#.input" } }, null] } },
                                    { "outputKey": "key", "set": { "$func/process-business-key": { "entityType": "#.self.data.start.process", "entities": "#.entities", "input": "#.startInput" } } },
                                    {
                                        "inputMap": {
                                            "message": { "kind": "start", "entityType": "#.self.data.start.process", "businessKey": "#.key", "entities": "#.entities", "input": "#.startInput" },
                                            "group": { "$str": ["#.self.data.start.process", "/", "#.key"] }
                                        },
                                        "publish": "process-wakeups"
                                    }
                                ],
                                "else": [
                                    { "outputKey": "entity", "set": { "$func/apply-mapping": { "mapping": "#.self.data.signal.entity", "input": "#.input" } } },
                                    { "outputKey": "payload", "set": { "$if": ["#.self.data.signal.payload", { "$func/apply-mapping": { "mapping": "#.self.data.signal.payload", "input": "#.input" } }, null] } },
                                    { "outputKey": "domain", "inputMap": { "businessKey": "#.entity.businessKey" }, "invoke": "#.entity.entityType", "operation": "read" },
                                    { "outputKey": "role", "set": { "$func/process-signal-role": { "entityType": "#.self.data.signal.process", "name": "#.self.data.signal.name" } } },
                                    { "outputKey": "sources", "inputMap": { "targetEntityId": "#.domain.id", "relationType": "#.role" }, "invoke": "entity-relations-to", "operation": "run" },
                                    {
                                        "outputKey": "wakeups",
                                        "set": { "$func/process-signal-wakeups": { "entityType": "#.self.data.signal.process", "name": "#.self.data.signal.name", "payload": "#.payload", "sources": "#.sources" } }
                                    },
                                    { "inputMap": "#.wakeups", "forEach": { "inputMap": "#.item", "publish": "process-wakeups" } }
                                ]
                            }
                        }
                    ]
                }
            },
            "lifecycle": { "validate": { "$func/process-trigger-problems": "#.self.id" } }
        }
    },
    {
        "id": "process-search-document",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "module": "@business-framework/entity-processes/process",
            "export": "searchDocument"
        }
    },
    {
        "id": "process-wakeup-target",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!process": "@any", "!wakeup": "@any", "entities": "@any" }, "output": "@any" },
            "mapping": {"$cond": [[{"$neq": ["#.process.data.state.status", "running"]}, null], [{"$eq": ["#.wakeup.kind", "signal"]}, {"$if": [{"$includes": {"collection": {"$coalesce": ["#.process.data.process.wait.signals", []]}, "value": "#.wakeup.name"}}, {"$let": {"declared": {"$get": {"object": {"$let": {"definition": {"$func/process-step-of": {"definition": "#.process.data.process.definition", "step": "#.process.data.process.step"}}}, "$in": "@definition.wait.signals"}, "path": "#.wakeup.name"}}}, "$in": {"step": "@declared.to", "signal": {"$coalesce": ["#.wakeup.payload", null]}}}, null]}], [{"$eq": ["#.wakeup.kind", "timer"]}, {"$if": [{"$and": [{"$eq": ["#.process.data.process.wait.token", "#.wakeup.token"]}, {"$eq": ["#.process.data.process.wait.until.then", "#.wakeup.step"]}]}, {"step": "#.wakeup.step", "signal": null}, null]}], ["else", {"$if": [{"$isNil": "#.process.data.process.wait"}, null, {"$let": {"held": {"$find": {"collection": {"$coalesce": [{"$let": {"definition": {"$func/process-step-of": {"definition": "#.process.data.process.definition", "step": "#.process.data.process.step"}}}, "$in": "@definition.wait.when"}, []]}, "as": "entry", "predicate": {"$func/apply-mapping": {"mapping": "@entry.test", "input": {"$func/process-scope": {"definition": "#.process.data.process.definition", "scope": {"process": "#.process"}, "participants": "#.entities"}}}}}}}, "$in": {"$if": [{"$isNil": "@held"}, null, {"step": "@held.then", "signal": null, "resolve": {"$coalesce": ["@held.resolve", {}]}}]}}]}]]}
        }
    },
    {
        "id": "process-wakeup",
        "kind": "schema",
        "data": {
            "!kind=1": ["start", "signal", "timer", "check"],
            "!entityType": "string",
            "businessKey": "string",
            "entities": "@any",
            "input": "@any",
            "name": "string",
            "payload": "@any",
            "token": "integer",
            "step": "string",
            "role": "string",
            "revision": "integer",
            "*": "never"
        }
    },
    {
        "id": "process-wakeups",
        "kind": "message-channel",
        "data": {
            "broker": { "instanceOf": "message-broker" },
            "topology": "topic",
            "name": "process-wakeups",
            "publisher": { "transactionalOutbox": true, "retry": { "attempts": 5, "backoff": 500 } },
            "consumer": { "retry": { "attempts": 5, "backoff": 500 } }
        }
    },
    {
        "id": "process-runner",
        "kind": "message-consumer",
        "data": {
            "channel": "process-wakeups",
            "handler": { "asSystem": { "inputMap": "#.input", "invoke": "#.input.entityType", "operation": "wake" } }
        }
    },
    {
        "id": "process-context",
        "kind": "schema",
        "data": { "!definition": "string", "!businessKey": "string", "!step": "string", "!token": "integer", "!entities": "@any" }
    },
    { "id": "unknown-definition-error", "kind": "slot-fill", "data": { "target": "error-registry", "slot": "errorTypes", "value": { "code": "unknown-definition" } } },
    { "id": "process-chain-limit-error", "kind": "slot-fill", "data": { "target": "error-registry", "slot": "errorTypes", "value": { "code": "process-chain-limit" } } },
    {
        "id": "process-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": [
                        { "outputKey": "initial", "set": { "$func/initial-process-value": { "definition": "#.input.configuration.definition", "entities": { "$coalesce": ["#.input.input.entities", {}] } } } },
                        { "if": "#.initial.problems.0", "then": { "throw": { "code": "invalid", "message": { "$join": { "separator": "; ", "strings": "#.initial.problems" } }, "data": { "definition": "#.input.configuration.definition" } } } },
                        { "set": "#.initial.value" }
                    ]
                },
                "move": {
                    "input": { "$data#&": ["@trait-operation-input", { "!input": { "!process{}": "@any" } }] },
                    "output": "@trait-command",
                    "implementation": { "set": { "command": "move", "value": "#.input.input.process" } }
                }
            }
        }
    },
    {
        "id": "process",
        "kind": "process-trait",
        "data": {
            "configuration": "@process-configuration",
            "react": [
                {
                    "outputKey": "resumed",
                    "set": { "$func/state-moved": { "before": "#.input.change.before", "after": "#.input.change.after", "dimension": "status", "from": "suspended", "to": "running" } }
                },
                {
                    "outputKey": "aborted",
                    "set": {
                        "$and": [
                            { "$eq": ["#.input.change.after.data.state.status", "aborted"] },
                            { "$neq": ["#.input.change.before.data.state.status", "aborted"] }
                        ]
                    }
                },
                { "outputKey": "position", "set": "#.input.change.after.data.process" },
                {
                    "if": { "$and": ["#.resumed", "#.position.fault"] },
                    "then": {
                        "inputMap": { "message": "#.position.fault.wakeup", "group": { "$str": ["#.self.id", "/", "#.input.change.after.businessKey"] } },
                        "publish": "process-wakeups"
                    }
                },
                {
                    "if": { "$and": ["#.resumed", "#.position.wait.until"] },
                    "then": {
                        "inputMap": {
                            "message": { "kind": "timer", "entityType": "#.self.id", "businessKey": "#.input.change.after.businessKey", "token": "#.position.wait.token", "step": "#.position.wait.until.then" },
                            "group": { "$str": ["#.self.id", "/", "#.input.change.after.businessKey", "/timer/", "#.position.wait.token"] },
                            "deliverAt": "#.position.wait.until.at"
                        },
                        "publish": "process-wakeups"
                    }
                },
                {
                    "if": "#.aborted",
                    "then": { "inputMap": { "step": null, "bindings": "#.position.entities", "resolve": {} }, "invoke": "#.self.id", "operation": "closeTasks" }
                },
                {
                    "if": { "$and": [{ "$or": ["#.resumed", "#.aborted"] }, { "$or": ["#.position.fault", "#.position.failures"] }] },
                    "then": {
                        "inputMap": {
                            "businessKey": "#.input.change.after.businessKey",
                            "revision": "#.input.change.after.revision",
                            "entityOperation": "settle",
                            "operations": [{ "key": "process", "operation": "move", "input": { "process": { "$func/process-position": { "process": "#.position", "step": "#.position.step", "wait": "#.position.wait" } } } }]
                        },
                        "invoke": "#.self.id",
                        "operation": "writeTraitOperationsAsOneChange"
                    }
                }
            ]
        }
    },
    {
        "id": "process-entity-type",
        "kind": "kind",
        "data": {
            "extends": "entity-type",
            "shape": { "!definition": "@ref/process-definition", "traits{}": "@entity-trait-entry" },
            "mapping": {"traits": {"$merge": ["#.data.traits", {"process": {"configuration": {"definition": "#.data.definition"}}}]}},
            "settings": { "shape": { "!maxChain": "integer", "!breaker": { "!attempts": "integer" } }, "defaults": { "maxChain": 100, "breaker": { "attempts": 3 } } },
            "context": { "manages": { "process": "@process-context" } },
            "operations": {
                "start": {
                    "input": { "businessKey": "string", "!entities": "object", "input": "@any" },
                    "output": "@viewed-entity-record",
                    "implementation": {
                        "inTransaction": [
                            { "outputKey": "key", "set": { "$coalesce": ["#.input.businessKey", { "$func/process-business-key": { "entityType": "#.self.id", "entities": "#.input.entities", "input": "#.input.input" } }] } },
                            {
                                "outputKey": "created",
                                "inputMap": { "businessKey": "#.key", "traits": { "process": { "entities": "#.input.entities" }, "body": {} } },
                                "invoke": "#.self.id",
                                "operation": "create"
                            },
                            {
                                "inputMap": { "businessKey": "#.key", "step": "#.created.data.process.step", "variables": {}, "entities": "#.created.data.process.entities", "input": "#.input.input", "depth": 0 },
                                "invoke": "#.self.id",
                                "operation": "advance"
                            }
                        ]
                    }
                },
                "readEach": {
                    "private": true,
                    "input": { "!items[]": { "!entityType": "@ref/entity-type", "!businessKey": "string" } },
                    "output": "@any",
                    "implementation": { "inputMap": "#.input.items", "forEach": { "inputMap": { "businessKey": "#.item.businessKey" }, "invoke": "#.item.entityType", "operation": "read" } }
                },
                "loadParticipants": {
                    "private": true,
                    "input": "@any",
                    "output": "@any",
                    "implementation": [
                        { "outputKey": "items", "set": {"$concat": {"$values": {"$mapValues": {"of": "#.input", "as": ["binding", "role"], "fn": {"$map": {"over": {"$concat": [[], "@binding"]}, "as": "bound", "fn": {"role": "@role", "many": {"$isNil": "@binding.entityType"}, "entityType": "@bound.entityType", "businessKey": "@bound.businessKey"}}}}}}} },
                        { "outputKey": "records", "inputMap": { "items": "#.items" }, "invoke": "#.self.id", "operation": "readEach" },
                        { "set": {"$mapValues": {"of": {"$group": {"by": "@pair.role", "as": "pair", "collection": {"$zip": {"sequences": ["#.items", "#.records"], "as": ["item", "record"], "with": {"role": "@item.role", "many": "@item.many", "record": "@record"}}}}}, "as": "group", "fn": {"$if": ["@group.0.many", {"$map": {"over": "@group", "as": "pair", "fn": "@pair.record"}}, "@group.0.record"]}}} }
                    ]
                },
                "closeTasks": {
                    "private": true,
                    "input": { "!step": "@any", "!bindings": "@any", "!resolve": "@any" },
                    "output": "@any",
                    "implementation": [
                        {
                            "outputKey": "entities",
                            "if": { "$or": [{ "$eq": ["#.input.step", null] }, "#.input.step.wait.when"] },
                            "then": { "inputMap": "#.input.bindings", "invoke": "#.self.id", "operation": "loadParticipants" }
                        },
                        { "outputKey": "closures", "set": { "$func/process-task-closures": { "step": "#.input.step", "entities": { "$coalesce": ["#.entities", {}] }, "resolve": "#.input.resolve" } } },
                        {
                            "asSystem": { "inputMap": { "items": "#.closures" }, "invoke": "#.self.id", "operation": "applyClosures" }
                        }
                    ]
                },
                "applyOpenings": {
                    "private": true,
                    "input": { "!items[]": { "!entityType": "@ref/entity-type", "!businessKey": "string", "traits": "@any" } },
                    "output": "@any",
                    "implementation": { "inputMap": "#.input.items", "forEach": { "inputMap": { "businessKey": "#.item.businessKey", "traits": "#.item.traits" }, "invoke": "#.item.entityType", "operation": "create" } }
                },
                "applyTransitions": {
                    "private": true,
                    "input": { "!items[]": { "!entityType": "@ref/entity-type", "!businessKey": "string", "!transition": "string" } },
                    "output": "@any",
                    "implementation": {
                        "inputMap": "#.input.items",
                        "forEach": [
                            { "outputKey": "current", "inputMap": { "businessKey": "#.item.businessKey" }, "invoke": "#.item.entityType", "operation": "read" },
                            { "inputMap": { "businessKey": "#.item.businessKey", "revision": "#.current.revision", "trait": "state", "operation": "transition", "input": { "transition": "#.item.transition" } }, "invoke": "#.item.entityType", "operation": "run" }
                        ]
                    }
                },
                "applyClosures": {
                    "private": true,
                    "input": { "!items[]": { "!entityType": "@ref/entity-type", "!businessKey": "string", "!revision": "integer", "!operation": "string", "input": "@any" } },
                    "output": "@any",
                    "implementation": { "inputMap": "#.input.items", "forEach": { "inputMap": { "businessKey": "#.item.businessKey", "revision": "#.item.revision", "trait": "task", "operation": "#.item.operation", "input": "#.item.input" }, "invoke": "#.item.entityType", "operation": "run" } }
                },
                "advance": {
                    "private": true,
                    "input": { "!businessKey": "string", "!step": "string", "!variables": "object", "entities": "@any", "input": "@any", "signal": "@any", "!depth": "integer" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "settings", "set": { "$func/settings": "#.self.id" } },
                        {
                            "if": { "$gt": ["#.input.depth", "#.settings.maxChain"] },
                            "then": { "throw": { "code": "process-chain-limit", "message": { "$str": ["#.self.id", " ran more than ", "#.settings.maxChain", " steps in a row"] } } }
                        },
                        { "outputKey": "process", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        { "outputKey": "step", "set": { "$func/process-step-of": { "definition": "#.process.data.process.definition", "step": "#.input.step" } } },
                        { "outputKey": "bindings", "set": { "$coalesce": ["#.input.entities", "#.process.data.process.entities"] } },
                        { "outputKey": "entities", "inputMap": "#.bindings", "invoke": "#.self.id", "operation": "loadParticipants" },
                        {
                            "outputKey": "scope",
                            "set": {
                                "$func/process-scope": {
                                    "definition": "#.process.data.process.definition",
                                    "scope": {
                                        "process": { "$merge": ["#.process", { "data": { "$merge": ["#.process.data", { "body": "#.input.variables" }] } }] },
                                        "input": "#.input.input",
                                        "signal": "#.input.signal"
                                    },
                                    "participants": "#.entities"
                                }
                            }
                        },
                        { "outputKey": "extensions", "set": { "$func/process-step-extensions-of": { "definition": "#.process.data.process.definition", "step": "#.input.step" } } },
                        {
                            "outputKey": "attempt",
                            "try": [
                                {
                                    "outputKey": "output",
                                    "inSavepoint": {
                                        "withContext": { "process": { "definition": "#.process.data.process.definition", "businessKey": "#.input.businessKey", "step": "#.input.step", "token": "#.process.revision", "entities": "#.bindings" } },
                                        "do": [
                                            { "outputKey": "result", "if": "#.step.do", "then": { "inputMap": "#.scope", "execute": "#.step.do" } },
                                            { "inputMap": "#.extensions", "forEach": { "inputMap": "#.scope", "execute": "#.item.do" } },
                                            { "asSystem": { "inputMap": { "items": { "$func/process-transitions": { "step": "#.step", "scope": "#.scope" } } }, "invoke": "#.self.id", "operation": "applyTransitions" } },
                                            { "outputKey": "opened", "set": { "$func/process-task-openings": { "definition": "#.process.data.process.definition", "name": "#.input.step", "step": "#.step", "scope": "#.scope" } } },
                                            { "if": "#.opened.conflict", "then": { "throw": { "code": "#.opened.conflict.code", "message": "#.opened.conflict.message", "data": "#.opened.conflict.data" } } },
                                            { "asSystem": { "inputMap": { "items": "#.opened.openings" }, "invoke": "#.self.id", "operation": "applyOpenings" } },
                                            { "set": { "$merge": [{ "$coalesce": ["#.result", {}] }, { "bind": { "$merge": [{ "$coalesce": ["#.result.bind", {}] }, "#.opened.bind"] } }] } }
                                        ]
                                    }
                                },
                                { "set": { "output": "#.output", "error": null } }
                            ],
                            "catch": { "set": { "output": null, "error": "#.error" } }
                        },
                        {
                            "outputKey": "exit",
                            "set": {
                                "$if": [
                                    "#.attempt.error",
                                    { "$func/process-recovery": { "name": "#.input.step", "step": "#.step", "scope": "#.scope", "error": "#.attempt.error", "bindings": "#.bindings" } },
                                    {
                                        "$func/process-exit": {
                                            "name": "#.input.step",
                                            "step": "#.step",
                                            "scope": { "$merge": ["#.scope", { "output": "#.attempt.output" }] },
                                            "revision": "#.process.revision",
                                            "bindings": "#.bindings"
                                        }
                                    }
                                ]
                            }
                        },
                        { "if": "#.exit.problem", "then": { "throw": { "code": "#.exit.problem.code", "message": "#.exit.problem.message", "data": "#.exit.problem.data" } } },
                        {
                            "outputKey": "fresh",
                            "if": { "$and": [{ "$eq": ["#.exit.kind", "wait"] }, "#.step.wait.when"] },
                            "then": { "inputMap": "#.exit.entities", "invoke": "#.self.id", "operation": "loadParticipants" }
                        },
                        {
                            "outputKey": "settled",
                            "set": {
                                "$func/process-held-exit": {
                                    "step": "#.step",
                                    "exit": "#.exit",
                                    "entities": "#.fresh",
                                    "scope": { "$merge": ["#.scope", { "process": { "$merge": ["#.scope.process", { "data": { "$merge": ["#.scope.process.data", { "body": "#.exit.variables" }] } }] } }] }
                                }
                            }
                        },
                        {
                            "if": { "$or": [{ "$eq": ["#.settled.kind", "end"] }, { "$and": [{ "$eq": ["#.exit.kind", "wait"] }, { "$eq": ["#.settled.kind", "next"] }] }] },
                            "then": {
                                "inputMap": { "step": { "$if": [{ "$eq": ["#.settled.kind", "end"] }, null, "#.step"] }, "bindings": "#.settled.entities", "resolve": { "$coalesce": ["#.settled.resolve", {}] } },
                                "invoke": "#.self.id",
                                "operation": "closeTasks"
                            }
                        },
                        {
                            "if": { "$eq": ["#.settled.kind", "next"] },
                            "then": {
                                "inputMap": { "businessKey": "#.input.businessKey", "step": "#.settled.step", "variables": "#.settled.variables", "entities": "#.settled.entities", "input": "#.input.input", "depth": { "$sum": ["#.input.depth", 1] } },
                                "invoke": "#.self.id",
                                "operation": "advance"
                            },
                            "else": {
                                "inputMap": { "businessKey": "#.input.businessKey", "process": "#.process", "step": "#.input.step", "exit": "#.settled" },
                                "invoke": "#.self.id",
                                "operation": "settle"
                            }
                        }
                    ]
                },
                "settle": {
                    "private": true,
                    "input": { "!businessKey": "string", "!process": "@any", "!step": "string", "!exit": "@any" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "now", "invoke": "clock", "operation": "now" },
                        {
                            "outputKey": "wait",
                            "if": { "$eq": ["#.input.exit.kind", "wait"] },
                            "then": { "set": { "$func/resolved-wait": { "wait": "#.input.exit.wait", "now": "#.now" } } }
                        },
                        {
                            "outputKey": "written",
                            "inputMap": {
                                "businessKey": "#.input.businessKey",
                                "revision": "#.input.process.revision",
                                "entityOperation": "advance",
                                "operations": {
                                    "$concat": [
                                        [
                                            { "key": "body", "operation": "update", "input": { "value": "#.input.exit.variables" } },
                                            {
                                                "key": "process",
                                                "operation": "move",
                                                "input": { "process": { "$func/process-position": { "process": "#.input.process.data.process", "step": "#.input.step", "wait": "#.wait", "entities": "#.input.exit.entities" } } }
                                            }
                                        ],
                                        { "$if": [{ "$eq": ["#.input.exit.kind", "end"] }, [{ "key": "state", "operation": "transition", "input": { "transition": "end" } }], []] }
                                    ]
                                }
                            },
                            "invoke": "#.self.id",
                            "operation": "writeTraitOperationsAsOneChange"
                        },
                        {
                            "if": "#.wait.until",
                            "then": {
                                "inputMap": {
                                    "message": { "kind": "timer", "entityType": "#.self.id", "businessKey": "#.input.businessKey", "token": "#.wait.token", "step": "#.wait.until.then" },
                                    "group": { "$str": ["#.self.id", "/", "#.input.businessKey", "/timer/", "#.wait.token"] },
                                    "deliverAt": "#.wait.until.at"
                                },
                                "publish": "process-wakeups"
                            }
                        },
                        { "set": "#.written" }
                    ]
                },
                "handle": {
                    "private": true,
                    "input": "@process-wakeup",
                    "output": "@any",
                    "implementation": {
                        "inTransaction": {
                            "if": { "$eq": ["#.input.kind", "start"] },
                            "then": {
                                "try": {
                                    "inSavepoint": { "inputMap": { "businessKey": "#.input.businessKey", "entities": "#.input.entities", "input": "#.input.input" }, "invoke": "#.self.id", "operation": "start" }
                                },
                                "catch": { "if": { "$neq": ["#.error.code", "duplicate"] }, "then": { "throw": "#.error" } }
                            },
                            "else": [
                                { "outputKey": "process", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                                {
                                    "outputKey": "entities",
                                    "if": { "$eq": ["#.input.kind", "check"] },
                                    "then": { "inputMap": "#.process.data.process.entities", "invoke": "#.self.id", "operation": "loadParticipants" }
                                },
                                { "outputKey": "target", "set": { "$func/process-wakeup-target": { "process": "#.process", "wakeup": "#.input", "entities": "#.entities" } } },
                                {
                                    "if": "#.target",
                                    "then": [
                                        {
                                            "inputMap": { "step": { "$func/process-step-of": { "definition": "#.process.data.process.definition", "step": "#.process.data.process.step" } }, "bindings": "#.process.data.process.entities", "resolve": { "$coalesce": ["#.target.resolve", {}] } },
                                            "invoke": "#.self.id",
                                            "operation": "closeTasks"
                                        },
                                        {
                                            "inputMap": { "businessKey": "#.input.businessKey", "step": "#.target.step", "variables": "#.process.data.body", "signal": "#.target.signal", "depth": 0 },
                                            "invoke": "#.self.id",
                                            "operation": "advance"
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                },
                "wake": {
                    "input": "@process-wakeup",
                    "output": "@any",
                    "implementation": [
                        {
                            "outputKey": "outcome",
                            "try": [
                                { "inputMap": "#.input", "invoke": "#.self.id", "operation": "handle" },
                                { "set": { "rethrow": false } }
                            ],
                            "catch": [
                                { "outputKey": "verdict", "inputMap": { "businessKey": "#.input.businessKey", "wakeup": "#.input", "error": "#.error" }, "invoke": "#.self.id", "operation": "failed" },
                                { "set": { "rethrow": "#.verdict.rethrow", "error": "#.error" } }
                            ]
                        },
                        { "if": "#.outcome.rethrow", "then": { "throw": "#.outcome.error" } }
                    ]
                },
                "failed": {
                    "private": true,
                    "input": { "!businessKey": "string", "!wakeup": "@process-wakeup", "!error": "@any" },
                    "output": { "!rethrow": "boolean" },
                    "implementation": {
                        "if": { "$eq": ["#.input.wakeup.kind", "start"] },
                        "then": { "set": { "rethrow": true } },
                        "else": {
                            "inTransaction": [
                                { "outputKey": "process", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                                { "outputKey": "settings", "set": { "$func/settings": "#.self.id" } },
                                {
                                    "outputKey": "target",
                                    "try": { "set": { "$func/process-wakeup-target": { "process": "#.process", "wakeup": "#.input.wakeup" } } },
                                    "catch": { "set": null }
                                },
                                {
                                    "outputKey": "verdict",
                                    "set": { "$func/process-verdict": { "process": "#.process", "wakeup": "#.input.wakeup", "error": "#.input.error", "attempts": "#.settings.breaker.attempts", "target": "#.target" } }
                                },
                                {
                                    "if": { "$not": { "$or": [{ "$eq": ["#.verdict.action", "rethrow"] }, { "$eq": ["#.verdict.action", "drop"] }] } },
                                    "then": {
                                        "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.process.revision", "entityOperation": "fail", "operations": "#.verdict.operations" },
                                        "invoke": "#.self.id",
                                        "operation": "writeTraitOperationsAsOneChange"
                                    }
                                },
                                { "set": { "rethrow": { "$not": { "$or": [{ "$eq": ["#.verdict.action", "suspend"] }, { "$eq": ["#.verdict.action", "drop"] }] } } } }
                            ]
                        }
                    }
                }
            },
            "fixed": {
                "traits": {
                    "body": { "configuration": { "schema": { "*": "@any" } } },
                    "state": {
                        "configuration": {
                            "states": {
                                "status": {
                                    "running": { "initial": true, "to": ["suspended", "aborted", "ended"] },
                                    "suspended": { "to": ["running", "aborted"] },
                                    "aborted": { "to": [] },
                                    "ended": { "to": [] }
                                }
                            },
                            "transitions": {
                                "suspend": { "status": { "running": "suspended" } },
                                "resume": { "status": { "suspended": "running" } },
                                "abort": { "status": { "running": "aborted", "suspended": "aborted" } },
                                "end": { "status": { "running": "ended" } }
                            },
                            "initialStates": { "default": { "status": "running" } }
                        }
                    }
                }
            }
        }
    }
]
