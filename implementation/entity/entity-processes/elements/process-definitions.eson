[
    {
        "id": "process-role",
        "kind": "schema",
        "data": { "!entityType": "@ref/entity-type", "late": "boolean", "many": "boolean", "*": "never" }
    },
    {
        "id": "process-task",
        "kind": "schema",
        "data": { "!type": "@ref/entity-type", "about[]": "string", "*": "never" }
    },
    {
        "id": "process-opening",
        "kind": "schema",
        "data": { "body": "@mapping/step-code", "dueOn": "@mapping/step-code", "assignTo": "@mapping/step-code", "*": "never" }
    },
    {
        "id": "process-signal",
        "kind": "schema",
        "data": { "!to": "string", "!by": "string", "payload": "@schema", "*": "never" }
    },
    {
        "id": "process-duration",
        "kind": "schema",
        "data": { "days": "integer", "hours": "integer", "minutes": "integer", "*": "never" }
    },
    {
        "id": "process-until",
        "kind": "schema",
        "data": { "at": "@mapping/step-code", "after": "@process-duration", "!then": "string", "*": "never" }
    },
    {
        "id": "process-condition",
        "kind": "schema",
        "data": { "!test": "@mapping/step-code", "resolve{}": "string", "!then": "string", "*": "never" }
    },
    {
        "id": "process-wait",
        "kind": "schema",
        "data": { "when[]": "@process-condition", "signals{}": "@process-signal", "until": "@process-until", "*": "never" }
    },
    {
        "id": "process-error-exit",
        "kind": "schema",
        "data": { "!catches[]": "string", "set": "@mapping/error-code", "!then": "string", "*": "never" }
    },
    {
        "id": "process-choice",
        "kind": "schema",
        "data": {
            "$data#1": [
                { "!test": "@mapping/step-code", "!then": "string", "*": "never" },
                { "!else": "string", "*": "never" }
            ]
        }
    },
    {
        "id": "process-step",
        "kind": "schema",
        "data": {
            "do": "@method/step-method",
            "transition{}": "string",
            "open{}": "@process-opening",
            "set": "@mapping/step-code",
            "next": "string",
            "choose[]": "@process-choice",
            "wait": "@process-wait",
            "end": "boolean",
            "onError[]": "@process-error-exit",
            "extensible": "boolean",
            "*": "never"
        }
    },
    {
        "id": "process-step-extension",
        "kind": "schema",
        "data": { "!step": "string", "!do": "@method", "*": "never" }
    },
    {
        "id": "process-step-extensions-slot",
        "kind": "slot-declaration",
        "data": { "target": "process-definition", "slot": "stepExtensions", "cardinality": "many", "value": "@process-step-extension" }
    },
    {
        "id": "process-step-extensions-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "string", "!step": "string" }, "output": "@any" },
            "mapping": {
                "$let": {
                    "data": { "$func/process-definition-of": "#.definition" },
                    "declared": { "$get": { "object": "@data.steps", "path": "#.step" } }
                },
                "$in": {
                    "$if": [
                        "@declared.extensible",
                        {
                            "$filter": {
                                "collection": { "$func/slot-values": { "element": "#.definition", "slot": "stepExtensions" } },
                                "as": "extension",
                                "predicate": { "$eq": ["@extension.step", "#.step"] }
                            }
                        },
                        []
                    ]
                }
            }
        }
    },
    {
        "id": "process-scope-schema",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "object", "!position=1": ["step", "method", "error"] }, "output": "@schema" },
            "module": "@business-framework/entity-processes/scopes",
            "export": "scopeSchema"
        }
    },
    {
        "id": "process-definition-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-processes/definitions",
            "export": "processDefinitionProblems"
        }
    },
    {
        "id": "process-definition",
        "kind": "kind",
        "data": {
            "shape": {
                "!entities{}": "@process-role",
                "tasks{}": "@process-task",
                "input": "@schema",
                "variables": "@schema",
                "key": "@mapping",
                "!start": "string",
                "!steps{}": "@process-step"
            },
            "templates": {
                "step-code": { "input": { "$func/process-scope-schema": { "definition": "#.data", "position": "step" } } },
                "step-method": { "input": { "$func/process-scope-schema": { "definition": "#.data", "position": "method" } } },
                "error-code": { "input": { "$func/process-scope-schema": { "definition": "#.data", "position": "error" } } }
            },
            "lifecycle": { "validate": { "$func/process-definition-problems": "#.self.id" } }
        }
    }
]
