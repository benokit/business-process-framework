[
    {
        "id": "process-definition-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "@any" },
            "mapping": {
                "$let": {
                    "found": {
                        "$find": {
                            "collection": { "$func/instances-of": "process-definition" },
                            "as": "element",
                            "predicate": { "$eq": ["@element.id", "#"] }
                        }
                    }
                },
                "$in": {
                    "$if": [
                        { "$isNil": "@found" },
                        {
                            "$throw": {
                                "code": "unknown-definition",
                                "message": { "$str": ["the process definition '", "#", "' isn't loaded"] },
                                "data": { "definition": "#" }
                            }
                        },
                        "@found.data"
                    ]
                }
            }
        }
    },
    {
        "id": "process-roles-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "@any" },
            "module": "@business-framework/entity-processes/process",
            "export": "rolesOf"
        }
    },
    {
        "id": "process-definition-of-type",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "string" },
            "mapping": {
                "$let": {
                    "type": {
                        "$find": {
                            "collection": { "$func/instances-of": "process-entity-type" },
                            "as": "element",
                            "predicate": { "$eq": ["@element.id", "#"] }
                        }
                    }
                },
                "$in": "@type.data.definition"
            }
        }
    },
    {
        "id": "process-scope",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "string", "!scope": "@any", "!participants": "@any" }, "output": "@any" },
            "mapping": {
                "$let": {
                    "roles": { "$func/process-roles-of": { "$func/process-definition-of": "#.definition" } },
                    "names": { "$keys": "#.participants" },
                    "entityRoles": {
                        "$filter": {
                            "collection": "@names",
                            "as": "role",
                            "predicate": { "$not": { "$get": { "object": "@roles", "path": ["@role", "task"] } } }
                        }
                    },
                    "taskRoles": {
                        "$filter": {
                            "collection": "@names",
                            "as": "role",
                            "predicate": { "$get": { "object": "@roles", "path": ["@role", "task"] } }
                        }
                    }
                },
                "$in": {
                    "$merge": [
                        "#.scope",
                        {
                            "entities": { "$pick": { "keys": "@entityRoles", "object": "#.participants" } },
                            "tasks": { "$pick": { "keys": "@taskRoles", "object": "#.participants" } }
                        }
                    ]
                }
            }
        }
    },
    {
        "id": "process-task-openings",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!definition": "string", "!name": "string", "!step": "@any", "!scope": "@any" }, "output": "@any" },
            "mapping": {
                "$let": {
                    "tasks": {
                        "$coalesce": [{ "$get": { "object": { "$func/process-definition-of": "#.definition" }, "path": "tasks" } }, {}]
                    },
                    "processKey": "#.scope.process.businessKey",
                    "keyPrefix": { "$replace": { "regex": "/", "substitute": ".", "global": true, "string": "@processKey" } },
                    "stepScope": { "$merge": ["#.scope", { "step": "#.name" }] },
                    "references": {
                        "$mapValues": {
                            "of": "#.scope.entities",
                            "as": ["records", "role"],
                            "fn": {
                                "$map": {
                                    "over": { "$toList": "@records" },
                                    "as": "record",
                                    "fn": { "entityType": "@record.entityType", "businessKey": "@record.businessKey" }
                                }
                            }
                        }
                    },
                    "$evaluated": {
                        "$fn": { "as": "mapping", "body": { "$func/apply-mapping": { "mapping": "@mapping", "input": "@stepScope" } } }
                    },
                    "$pairOf": {
                        "$fn": {
                            "as": "entry",
                            "body": {
                                "$let": {
                                    "task": "@entry.task",
                                    "opening": "@entry.opening",
                                    "declared": "@entry.declared",
                                    "about": {
                                        "$concat": {
                                            "$map": {
                                                "over": { "$coalesce": ["@declared.about", []] },
                                                "as": "role",
                                                "fn": { "$coalesce": [{ "$get": { "object": "@references", "path": "@role" } }, []] }
                                            }
                                        }
                                    },
                                    "due": { "$if": [{ "$isNil": "@opening.dueOn" }, {}, { "dueOn": { "$evaluated": "@opening.dueOn" } }] },
                                    "assigned": {
                                        "$if": [
                                            { "$isNil": "@opening.assignTo" },
                                            {},
                                            { "assignedTo": { "$evaluated": "@opening.assignTo" } }
                                        ]
                                    },
                                    "body": { "$if": [{ "$isNil": "@opening.body" }, {}, { "$evaluated": "@opening.body" }] }
                                },
                                "$in": {
                                    "task": "@task",
                                    "opening": {
                                        "entityType": "@declared.type",
                                        "businessKey": { "$str": ["@keyPrefix", ".", "@task"] },
                                        "traits": {
                                            "task": {
                                                "$merge": [
                                                    { "origin": { "process": "@processKey", "step": "#.name" }, "about": "@about" },
                                                    "@due",
                                                    "@assigned"
                                                ]
                                            },
                                            "body": "@body"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "entries": {
                        "$map": {
                            "over": { "$coalesce": ["#.step.open", {}] },
                            "as": ["opening", "task"],
                            "fn": {
                                "task": "@task",
                                "opening": "@opening",
                                "current": { "$get": { "object": "#.scope.tasks", "path": "@task" } },
                                "declared": { "$get": { "object": "@tasks", "path": "@task" } }
                            }
                        }
                    },
                    "closed": {
                        "$find": {
                            "collection": "@entries",
                            "as": "entry",
                            "predicate": {
                                "$and": [
                                    { "$not": { "$isNil": "@entry.current" } },
                                    { "$neq": ["@entry.current.data.task.status", "open"] }
                                ]
                            }
                        }
                    },
                    "pairs": {
                        "$map": {
                            "over": { "$filter": { "collection": "@entries", "as": "entry", "predicate": { "$isNil": "@entry.current" } } },
                            "as": "entry",
                            "fn": { "$pairOf": "@entry" }
                        }
                    },
                    "openings": { "$map": { "over": "@pairs", "as": "pair", "fn": "@pair.opening" } },
                    "bind": {
                        "$mapValues": {
                            "of": { "$toDictionary": { "by": "@pair.task", "as": "pair", "collection": "@pairs" } },
                            "as": "pair",
                            "fn": "@pair.opening.businessKey"
                        }
                    }
                },
                "$in": {
                    "$if": [
                        { "$isNil": "@closed" },
                        { "openings": "@openings", "bind": "@bind" },
                        {
                            "$throw": {
                                "code": "conflict",
                                "message": {
                                    "$str": [
                                        "the task '",
                                        "@closed.task",
                                        "' of ",
                                        "#.definition",
                                        " is ",
                                        "@closed.current.data.task.status",
                                        ", and a task is opened once"
                                    ]
                                },
                                "data": { "definition": "#.definition", "task": "@closed.task" }
                            }
                        }
                    ]
                }
            }
        }
    },
    {
        "id": "process-transitions",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!step": "@any", "!scope": "@any" }, "output": "@any" },
            "mapping": {
                "$map": {
                    "over": { "$coalesce": ["#.step.transition", {}] },
                    "as": ["transition", "role"],
                    "fn": {
                        "$let": { "participant": { "$get": { "object": "#.scope.entities", "path": "@role" } } },
                        "$in": {
                            "entityType": "@participant.entityType",
                            "businessKey": "@participant.businessKey",
                            "transition": "@transition"
                        }
                    }
                }
            }
        }
    },
    {
        "id": "process-task-closures",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!step": "@any", "!entities": "@any", "!resolve": "@any" }, "output": "@any" },
            "mapping": {
                "$let": {
                    "roles": {
                        "$if": [
                            { "$eq": ["#.step", null] },
                            { "$keys": "#.entities" },
                            {
                                "$unique": {
                                    "$concat": {
                                        "$map": {
                                            "over": { "$coalesce": ["#.step.wait.when", []] },
                                            "as": "entry",
                                            "fn": { "$keys": { "$coalesce": ["@entry.resolve", {}] } }
                                        }
                                    }
                                }
                            }
                        ]
                    },
                    "$closuresOf": {
                        "$fn": {
                            "as": "role",
                            "body": {
                                "$let": {
                                    "outcome": { "$get": { "object": "#.resolve", "path": "@role" } },
                                    "records": {
                                        "$filter": {
                                            "collection": { "$toList": { "$get": { "object": "#.entities", "path": "@role" } } },
                                            "as": "record",
                                            "predicate": { "$eq": ["@record.data.task.status", "open"] }
                                        }
                                    },
                                    "operation": {
                                        "$if": [
                                            { "$isNil": "@outcome" },
                                            { "operation": "cancel" },
                                            { "operation": "resolve", "input": { "outcome": "@outcome" } }
                                        ]
                                    }
                                },
                                "$in": {
                                    "$map": {
                                        "over": "@records",
                                        "as": "record",
                                        "fn": {
                                            "$merge": [
                                                {
                                                    "entityType": "@record.entityType",
                                                    "businessKey": "@record.businessKey",
                                                    "revision": "@record.revision"
                                                },
                                                "@operation"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "closures": { "$map": { "over": "@roles", "as": "role", "fn": { "$closuresOf": "@role" } } }
                },
                "$in": { "$concat": "@closures" }
            }
        }
    },
    {
        "id": "process-business-key",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!entities": "@any", "input": "@any" }, "output": "string" },
            "mapping": {
                "$let": {
                    "definition": { "$func/process-definition-of-type": "#.entityType" },
                    "data": { "$func/process-definition-of": "@definition" },
                    "roles": { "$func/process-roles-of": "@data" },
                    "startRoles": {
                        "$filter": {
                            "collection": { "$keys": "@roles" },
                            "as": "role",
                            "predicate": {
                                "$not": {
                                    "$let": { "declared": { "$get": { "object": "@roles", "path": "@role" } } },
                                    "$in": "@declared.late"
                                }
                            }
                        }
                    },
                    "participants": {
                        "$concat": {
                            "$map": {
                                "over": "@startRoles",
                                "as": "role",
                                "fn": { "$toList": { "$get": { "object": "#.entities", "path": "@role" } } }
                            }
                        }
                    },
                    "custom": {
                        "$if": [
                            { "$isNil": "@data.key" },
                            [],
                            {
                                "$func/apply-mapping": {
                                    "mapping": "@data.key",
                                    "input": { "entities": "#.entities", "input": { "$coalesce": ["#.input", null] } }
                                }
                            }
                        ]
                    }
                },
                "$in": { "$join": { "separator": "/", "strings": { "$concat": [["@definition"], "@participants", "@custom"] } } }
            }
        }
    },
    {
        "id": "process-signal-role",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!name": "string" }, "output": "@any" },
            "mapping": {
                "$let": {
                    "data": { "$func/process-definition-of": { "$func/process-definition-of-type": "#.entityType" } },
                    "signals": {
                        "$find": {
                            "collection": {
                                "$map": {
                                    "over": { "$values": "@data.steps" },
                                    "as": "step",
                                    "fn": { "$coalesce": ["@step.wait.signals", {}] }
                                }
                            },
                            "as": "declared",
                            "predicate": { "$not": { "$isNil": { "$get": { "object": "@declared", "path": "#.name" } } } }
                        }
                    },
                    "declared": { "$get": { "object": "@signals", "path": "#.name" } }
                },
                "$in": "@declared.by"
            }
        }
    },
    {
        "id": "process-signal-wakeups",
        "kind": "pure-function",
        "data": {
            "signature": {
                "input": { "!entityType": "string", "!name": "string", "payload": "@any", "!sources": "@any" },
                "output": "@any"
            },
            "mapping": {
                "$map": {
                    "over": {
                        "$filter": {
                            "collection": "#.sources",
                            "as": "source",
                            "predicate": { "$eq": ["@source.sourceEntityType", "#.entityType"] }
                        }
                    },
                    "as": "source",
                    "fn": {
                        "message": {
                            "$merge": [
                                {
                                    "kind": "signal",
                                    "entityType": "#.entityType",
                                    "businessKey": "@source.sourceEntityBusinessKey",
                                    "name": "#.name"
                                },
                                { "$if": [{ "$isNil": "#.payload" }, {}, { "payload": "#.payload" }] }
                            ]
                        },
                        "group": { "$str": ["#.entityType", "/", "@source.sourceEntityBusinessKey"] }
                    }
                }
            }
        }
    }
]
