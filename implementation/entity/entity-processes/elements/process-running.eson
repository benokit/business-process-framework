[
    {
        "id": "process-search-document",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "module": "@business-framework/entity-processes/process",
            "export": "searchDocument"
        }
    },
    {
        "id": "process-wakeup-target",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!process": "@any", "!wakeup": "@any", "entities": "@any" }, "output": "@any" },
            "mapping": {
                "$if": [
                    { "$neq": ["#.process.data.state.status", "running"] },
                    null,
                    {
                        "$let": {
                            "current": "#.process.data.process",
                            "signalled": {
                                "$includes": { "collection": { "$coalesce": ["@current.wait.signals", []] }, "value": "#.wakeup.name" }
                            },
                            "timerHolds": {
                                "$and": [
                                    { "$eq": ["@current.wait.token", "#.wakeup.token"] },
                                    { "$eq": ["@current.wait.until.then", "#.wakeup.step"] }
                                ]
                            },
                            "$declaredSignal": {
                                "$fn": {
                                    "as": "current",
                                    "body": {
                                        "$let": {
                                            "step": {
                                                "$func/process-step-of": { "definition": "@current.definition", "step": "@current.step" }
                                            }
                                        },
                                        "$in": { "$get": { "object": "@step.wait.signals", "path": ["#.wakeup.name"] } }
                                    }
                                }
                            },
                            "$heldEntry": {
                                "$fn": {
                                    "as": "current",
                                    "body": {
                                        "$let": {
                                            "step": {
                                                "$func/process-step-of": { "definition": "@current.definition", "step": "@current.step" }
                                            },
                                            "scope": {
                                                "$func/process-scope": {
                                                    "definition": "@current.definition",
                                                    "scope": { "process": "#.process" },
                                                    "participants": "#.entities"
                                                }
                                            }
                                        },
                                        "$in": {
                                            "$find": {
                                                "collection": { "$coalesce": ["@step.wait.when", []] },
                                                "as": "entry",
                                                "predicate": { "$func/apply-mapping": { "mapping": "@entry.test", "input": "@scope" } }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "$in": {
                            "$cond": [
                                [
                                    { "$eq": ["#.wakeup.kind", "signal"] },
                                    {
                                        "$if": [
                                            "@signalled",
                                            {
                                                "$let": { "declared": { "$declaredSignal": "@current" } },
                                                "$in": { "step": "@declared.to", "signal": { "$coalesce": ["#.wakeup.payload", null] } }
                                            },
                                            null
                                        ]
                                    }
                                ],
                                [
                                    { "$eq": ["#.wakeup.kind", "timer"] },
                                    { "$if": ["@timerHolds", { "step": "#.wakeup.step", "signal": null }, null] }
                                ],
                                [
                                    "else",
                                    {
                                        "$if": [
                                            { "$isNil": "@current.wait" },
                                            null,
                                            {
                                                "$let": { "held": { "$heldEntry": "@current" } },
                                                "$in": {
                                                    "$if": [
                                                        { "$isNil": "@held" },
                                                        null,
                                                        {
                                                            "step": "@held.then",
                                                            "signal": null,
                                                            "resolve": { "$coalesce": ["@held.resolve", {}] }
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                ]
                            ]
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "process-wakeup",
        "kind": "schema",
        "data": {
            "!kind=1": ["start", "signal", "timer", "check"],
            "!entityType": "string",
            "businessKey": "string",
            "entities": "@any",
            "input": "@any",
            "name": "string",
            "payload": "@any",
            "token": "integer",
            "step": "string",
            "role": "string",
            "revision": "integer",
            "*": "never"
        }
    },
    {
        "id": "process-wakeups",
        "kind": "message-channel",
        "data": {
            "broker": { "instanceOf": "message-broker" },
            "topology": "topic",
            "name": "process-wakeups",
            "publisher": { "transactionalOutbox": true, "retry": { "attempts": 5, "backoff": 500 } },
            "consumer": { "retry": { "attempts": 5, "backoff": 500 } }
        }
    },
    {
        "id": "process-runner",
        "kind": "message-consumer",
        "data": {
            "channel": "process-wakeups",
            "handler": { "asSystem": { "inputMap": "#.input", "invoke": "#.input.entityType", "operation": "wake" } }
        }
    },
    {
        "id": "process-context",
        "kind": "schema",
        "data": { "!definition": "string", "!businessKey": "string", "!step": "string", "!token": "integer", "!entities": "@any" }
    },
    {
        "id": "unknown-definition-error",
        "kind": "slot-fill",
        "data": { "target": "error-registry", "slot": "errorTypes", "value": { "code": "unknown-definition" } }
    },
    {
        "id": "process-chain-limit-error",
        "kind": "slot-fill",
        "data": { "target": "error-registry", "slot": "errorTypes", "value": { "code": "process-chain-limit" } }
    }
]
