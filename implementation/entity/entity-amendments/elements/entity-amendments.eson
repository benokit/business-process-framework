[
    {
        "id": "amendment-context",
        "kind": "schema",
        "data": { "!effectiveFrom": "@date", "*": "never" }
    },
    {
        "id": "amendment-ledger-value",
        "kind": "schema",
        "data": { "!last": "integer", "!open": { "$data#": ["string", "null"] } }
    },
    {
        "id": "amendment-ledger-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": { "set": { "last": 0, "open": null } }
                },
                "open": {
                    "input": { "$data#&": ["@trait-operation-input", { "!input": { "!source": "string", "!amendment": "string" } }] },
                    "output": "@trait-command",
                    "implementation": [
                        {
                            "if": "#.input.value.open",
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["#.input.entityType", " ", "#.input.input.source", " has the open amendment ", "#.input.value.open"] } } }
                        },
                        { "set": { "command": "open", "value": { "last": { "$sum": ["#.input.value.last", 1] }, "open": "#.input.input.amendment" } } }
                    ]
                },
                "close": {
                    "input": { "$data#&": ["@trait-operation-input", { "!input": { "!source": "string", "!amendment": "string", "revision": "integer", "proposedAt": "integer" } }] },
                    "output": "@trait-command",
                    "implementation": [
                        {
                            "if": { "$and": ["#.input.input.proposedAt", { "$neq": ["#.input.input.revision", "#.input.input.proposedAt"] }] },
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["#.input.entityType", " ", "#.input.input.source", " has changed since the amendment ", "#.input.input.amendment", " was proposed"] } } }
                        },
                        {
                            "if": { "$neq": ["#.input.value.open", "#.input.input.amendment"] },
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["amendment ", "#.input.input.amendment", " isn't the open amendment of ", "#.input.input.source"] } } }
                        },
                        { "set": { "command": "close", "value": { "last": "#.input.value.last", "open": null } } }
                    ]
                }
            }
        }
    },
    { "id": "amendment-ledger", "kind": "amendment-ledger-trait", "data": { "configuration": {} } },
    {
        "id": "amendment-effect-operations",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "object", "output": "[@trait-operation-use]" },
            "mapping": {
                "$cond": [
                    [
                        { "$eq": ["#.effect", "generate"] },
                        [{
                            "key": "amendment-ledger",
                            "operation": "open",
                            "input": {
                                "source": "#.source.businessKey",
                                "amendment": { "$str": ["#.source.businessKey", "-", { "$printf": { "template": "%03d", "args": [{ "$sum": ["#.source.data.amendment-ledger.last", 1] }] } }] }
                            }
                        }]
                    ],
                    [
                        { "$eq": ["#.effect", "apply"] },
                        {
                            "$concat": [
                                { "$if": [{ "$gt": [{ "$count": { "collection": "#.declared" } }, 0] }, "#.declared", [{ "key": "body", "operation": "amend", "input": { "validFrom": "#.link.context.effectiveFrom", "ref": "#.generated.businessKey", "body": "#.generated.data.body" } }]] },
                                [{
                                    "key": "amendment-ledger",
                                    "operation": "close",
                                    "input": { "source": "#.source.businessKey", "amendment": "#.generated.businessKey", "revision": "#.source.revision", "proposedAt": "#.link.sourceRevision" }
                                }]
                            ]
                        }
                    ],
                    [
                        { "$eq": ["#.effect", "revert"] },
                        { "$if": [{ "$gt": [{ "$count": { "collection": "#.declared" } }, 0] }, "#.declared", [{ "key": "body", "operation": "remove", "input": { "validFrom": "#.link.context.effectiveFrom", "ref": "#.generated.businessKey" } }]] }
                    ],
                    [
                        { "$eq": ["#.effect", "close"] },
                        {
                            "$concat": [
                                "#.declared",
                                [{ "key": "amendment-ledger", "operation": "close", "input": { "source": "#.source.businessKey", "amendment": "#.generated.businessKey" } }]
                            ]
                        }
                    ],
                    ["else", { "$literal": [] }]
                ]
            }
        }
    },
    {
        "id": "amendment-generator",
        "kind": "generator-trait",
        "data": { "key": "generator", "pairs": [{ "changes": "apply", "undoneBy": "revert", "defaultKeys": ["body"] }], "configuration": "@generator-configuration" }
    },
    {
        "id": "versioned-entity-type",
        "kind": "kind",
        "data": {
            "extends": "generating-entity-type",
            "fixed": {
                "traits": {
                    "generator": {
                        "trait": "amendment-generator",
                        "configuration": {
                            "key": "#.source.data.amendment-ledger.open",
                            "context": "amendment-context",
                            "effects": { "$func/amendment-effect-operations": "#" }
                        }
                    },
                    "amendment-ledger": { "configuration": {} }
                }
            }
        }
    },
    {
        "id": "amendment-entity-type",
        "kind": "kind",
        "data": {
            "extends": "generated-entity-type",
            "fixed": {
                "traits": {
                    "generated": {
                        "configuration": {
                            "apply": { "versionStatus": { "pending": "applied" } },
                            "revert": { "versionStatus": { "applied": "discarded" } },
                            "close": { "versionStatus": { "pending": "discarded" } }
                        }
                    },
                    "state": {
                        "configuration": {
                            "states": {
                                "versionStatus": {
                                    "pending": { "initial": true, "to": ["applied", "discarded"] },
                                    "applied": { "to": ["discarded"] },
                                    "discarded": { "to": [] }
                                }
                            },
                            "initialStates": { "default": { "versionStatus": "pending" } }
                        }
                    }
                }
            }
        }
    }
]
