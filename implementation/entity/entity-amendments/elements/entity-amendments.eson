[
    {
        "id": "amendment-kind",
        "kind": "schema",
        "data": { "mapping": "@mapping", "apply": "@mapping", "revert": "@mapping", "*": "never" }
    },
    {
        "id": "amendable-configuration",
        "kind": "schema",
        "data": { "*": "@amendment-kind" }
    },
    {
        "id": "amendment-operations",
        "kind": "pure-function",
        "data": {
            "signature": {
                "input": { "!kind": "object", "!effect=1": ["apply", "revert", "discard"], "!scope": "object" },
                "output": "[@trait-operation-use]"
            },
            "mapping": {
                "$func/apply-mapping": {
                    "mapping": {
                        "$coalesce": [
                            { "$get": { "object": "#.kind", "path": "#.effect" } },
                            {
                                "$get": {
                                    "object": {
                                        "$literal": {
                                            "apply": [{ "key": "body", "operation": "amend", "input": { "validFrom": "#.effectiveFrom", "ref": "#.amendment.businessKey", "body": "#.amendment.data.body" } }],
                                            "revert": [{ "key": "body", "operation": "remove", "input": { "validFrom": "#.effectiveFrom", "ref": "#.amendment.businessKey" } }],
                                            "discard": []
                                        }
                                    },
                                    "path": "#.effect"
                                }
                            }
                        ]
                    },
                    "input": "#.scope"
                }
            }
        }
    },
    {
        "id": "amendable-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-amendments/amendments",
            "export": "amendableProblems"
        }
    },
    {
        "id": "amendable-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "lifecycle": { "validate": { "$func/amendable-problems": "#.self.id" } },
            "operations": {
                "initialize": {
                    "implementation": { "set": { "last": 0, "entries": [] } }
                },
                "open": {
                    "input": { "$data#&": ["@trait-operation-input", { "!input": { "!amendment": "string", "!type": "string", "!effectiveFrom": "@date", "!proposedAt": "integer" } }] },
                    "output": "@trait-command",
                    "implementation": [
                        { "outputKey": "pending", "set": { "$find": { "collection": "#.input.value.entries", "predicate": { "$eq": ["@entry.status", "pending"] }, "as": "entry" } } },
                        {
                            "if": "#.pending",
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["#.input.entityType", " has the open amendment ", "#.pending.key"] } } }
                        },
                        {
                            "set": {
                                "command": "open",
                                "value": {
                                    "last": { "$sum": ["#.input.value.last", 1] },
                                    "entries": {
                                        "$concat": [
                                            "#.input.value.entries",
                                            [{ "key": "#.input.input.amendment", "type": "#.input.input.type", "effectiveFrom": "#.input.input.effectiveFrom", "proposedAt": "#.input.input.proposedAt", "status": "pending" }]
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                },
                "settle": {
                    "input": { "$data#&": ["@trait-operation-input", { "!input": { "!amendment": "string", "!from=1": ["pending", "applied"], "!to=1": ["applied", "discarded"], "revision": "integer" } }] },
                    "output": "@trait-command",
                    "implementation": [
                        { "outputKey": "entry", "set": { "$find": { "collection": "#.input.value.entries", "predicate": { "$eq": ["@entry.key", "#.input.input.amendment"] }, "as": "entry" } } },
                        {
                            "if": { "$or": [{ "$isNil": "#.entry" }, { "$neq": ["#.entry.status", "#.input.input.from"] }] },
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["amendment ", "#.input.input.amendment", " of ", "#.input.entityType", " isn't ", "#.input.input.from"] } } }
                        },
                        {
                            "if": { "$and": ["#.input.input.revision", { "$neq": ["#.input.input.revision", "#.entry.proposedAt"] }] },
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["#.input.entityType", " has changed since the amendment ", "#.input.input.amendment", " was proposed"] } } }
                        },
                        {
                            "set": {
                                "command": "#.input.input.to",
                                "value": {
                                    "last": "#.input.value.last",
                                    "entries": {
                                        "$map": {
                                            "over": "#.input.value.entries",
                                            "as": "entry",
                                            "fn": { "$if": [{ "$eq": ["@entry.key", "#.input.input.amendment"] }, { "$merge": ["@entry", { "status": "#.input.input.to" }] }, "@entry"] }
                                        }
                                    }
                                }
                            }
                        }
                    ]
                },
                "propose": {
                    "public": true,
                    "input": { "$data#&": ["@trait-process-input", { "!input": { "!amendmentType": "@ref/entity-type", "!effectiveFrom": "@date", "input": "@any" } }] },
                    "output": "@trait-plan",
                    "implementation": [
                        { "outputKey": "kind", "set": { "$get": { "object": "#.input.configuration", "path": "#.input.input.amendmentType" } } },
                        {
                            "if": { "$isNil": "#.kind" },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " has no amendment ", "#.input.input.amendmentType"] } } }
                        },
                        { "outputKey": "ledger", "set": { "$get": { "object": "#.input.record.data", "path": "#.input.key" } } },
                        { "outputKey": "amendment", "set": { "$str": ["#.input.businessKey", "-", { "$printf": { "template": "%03d", "args": [{ "$sum": ["#.ledger.last", 1] }] } }] } },
                        {
                            "outputKey": "body",
                            "set": { "$func/apply-mapping": { "mapping": { "$coalesce": ["#.kind.mapping", { "$literal": "#.input" }] }, "input": { "entity": "#.input.record", "input": "#.input.input.input" } } }
                        },
                        { "outputKey": "created", "inputMap": { "businessKey": "#.amendment", "traits": { "body": "#.body" } }, "invoke": "#.input.input.amendmentType", "operation": "create" },
                        {
                            "set": {
                                "operations": [{
                                    "key": "#.input.key",
                                    "operation": "open",
                                    "input": { "amendment": "#.amendment", "type": "#.input.input.amendmentType", "effectiveFrom": "#.input.input.effectiveFrom", "proposedAt": { "$sum": ["#.input.record.revision", 1] } }
                                }],
                                "output": "#.created"
                            }
                        }
                    ]
                },
                "apply": {
                    "public": true,
                    "input": { "$data#&": ["@trait-process-input", { "!input": { "!amendment": "string" } }] },
                    "output": "@trait-plan",
                    "implementation": { "inputMap": { "$merge": ["#.input", { "input": { "amendment": "#.input.input.amendment", "effect": "apply" } }] }, "invoke": "#.self.id", "operation": "plan" }
                },
                "revert": {
                    "public": true,
                    "input": { "$data#&": ["@trait-process-input", { "!input": { "!amendment": "string" } }] },
                    "output": "@trait-plan",
                    "implementation": { "inputMap": { "$merge": ["#.input", { "input": { "amendment": "#.input.input.amendment", "effect": "revert" } }] }, "invoke": "#.self.id", "operation": "plan" }
                },
                "discard": {
                    "public": true,
                    "input": { "$data#&": ["@trait-process-input", { "!input": { "!amendment": "string" } }] },
                    "output": "@trait-plan",
                    "implementation": { "inputMap": { "$merge": ["#.input", { "input": { "amendment": "#.input.input.amendment", "effect": "discard" } }] }, "invoke": "#.self.id", "operation": "plan" }
                },
                "preview": {
                    "public": true,
                    "input": { "$data#&": ["@trait-process-input", { "!input": { "!amendment": "string", "!effect=1": ["apply", "revert"] } }] },
                    "output": "@trait-plan",
                    "implementation": [
                        { "outputKey": "planned", "inputMap": "#.input", "invoke": "#.self.id", "operation": "plan" },
                        { "set": { "operations": "#.planned.operations", "commit": false } }
                    ]
                },
                "plan": {
                    "private": true,
                    "input": { "$data#&": ["@trait-process-input", { "!input": { "!amendment": "string", "!effect=1": ["apply", "revert", "discard"] } }] },
                    "output": { "!operations[]": "@trait-operation-use" },
                    "implementation": [
                        { "outputKey": "ledger", "set": { "$get": { "object": "#.input.record.data", "path": "#.input.key" } } },
                        { "outputKey": "entry", "set": { "$find": { "collection": "#.ledger.entries", "predicate": { "$eq": ["@entry.key", "#.input.input.amendment"] }, "as": "entry" } } },
                        {
                            "if": { "$isNil": "#.entry" },
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["#.input.entityType", " '", "#.input.businessKey", "' has no amendment ", "#.input.input.amendment"] } } }
                        },
                        { "outputKey": "stored", "inputMap": { "entityType": "#.entry.type", "businessKey": "#.input.input.amendment" }, "invoke": "entity-database", "operation": "read" },
                        { "outputKey": "amended", "set": { "$func/viewed-record": { "record": "#.stored", "entityType": "#.entry.type" } } },
                        { "outputKey": "kind", "set": { "$coalesce": [{ "$get": { "object": "#.input.configuration", "path": "#.entry.type" } }, {}] } },
                        { "outputKey": "scope", "set": { "entity": "#.input.record", "amendment": "#.amended", "effectiveFrom": "#.entry.effectiveFrom" } },
                        { "outputKey": "declared", "set": { "$func/amendment-operations": { "kind": "#.kind", "effect": "#.input.input.effect", "scope": "#.scope" } } },
                        {
                            "outputKey": "settle",
                            "set": {
                                "$cond": [
                                    [{ "$eq": ["#.input.input.effect", "apply"] }, { "amendment": "#.input.input.amendment", "from": "pending", "to": "applied", "revision": "#.input.record.revision" }],
                                    [{ "$eq": ["#.input.input.effect", "revert"] }, { "amendment": "#.input.input.amendment", "from": "applied", "to": "discarded" }],
                                    ["else", { "amendment": "#.input.input.amendment", "from": "pending", "to": "discarded" }]
                                ]
                            }
                        },
                        { "set": { "operations": { "$concat": ["#.declared", [{ "key": "#.input.key", "operation": "settle", "input": "#.settle" }]] } } }
                    ]
                }
            }
        }
    },
    {
        "id": "amending-move",
        "kind": "schema",
        "data": { "!dimension": "string", "!from": "string", "!to": "string", "*": "never" }
    },
    {
        "id": "amending-configuration",
        "kind": "schema",
        "data": { "!target": "@mapping", "apply": "@amending-move", "revert": "@amending-move", "*": "never" }
    },
    {
        "id": "amending-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait"
        }
    },
    {
        "id": "amending",
        "kind": "amending-trait",
        "data": {
            "configuration": "@amending-configuration",
            "react": {
                "if": { "$eq": ["#.input.change.operation", "trait"] },
                "then": {
                    "inputMap": ["apply", "revert"],
                    "forEach": [
                        { "outputKey": "move", "set": { "$get": { "object": "#.input.configuration", "path": "#.item" } } },
                        {
                            "outputKey": "moved",
                            "if": { "$isNil": "#.move" },
                            "then": { "set": false },
                            "else": { "set": { "$func/state-moved": { "before": "#.input.change.before", "after": "#.input.change.after", "dimension": "#.move.dimension", "from": "#.move.from", "to": "#.move.to" } } }
                        },
                        {
                            "if": "#.moved",
                            "then": [
                                { "outputKey": "target", "set": { "$func/apply-mapping": { "mapping": "#.input.configuration.target", "input": "#.input.change.after" } } },
                                {
                                    "inputMap": { "entityType": "#.target.entityType", "businessKey": "#.target.businessKey", "amendment": "#.input.change.after.businessKey" },
                                    "invoke": "entity-amendment-gateway",
                                    "operation": "#.item"
                                }
                            ]
                        }
                    ]
                }
            }
        }
    },
    { "id": "amendable", "kind": "amendable-trait", "data": { "configuration": "@amendable-configuration" } },
    {
        "id": "amendment-gateway-kind",
        "kind": "kind",
        "data": {
            "operations": {
                "propose": {
                    "input": { "!entityType": "@ref/entity-type", "!businessKey": "string", "revision": "number", "!amendmentType": "@ref/entity-type", "!effectiveFrom": "@date", "input": "@any" },
                    "output": "@any",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision",
                            "trait": "amendable",
                            "operation": "propose",
                            "input": { "$pick": { "keys": ["amendmentType", "effectiveFrom", "input"], "object": "#.input" } }
                        },
                        "invoke": "#.input.entityType",
                        "operation": "run"
                    }
                },
                "apply": {
                    "input": { "!entityType": "@ref/entity-type", "!businessKey": "string", "revision": "number", "!amendment": "string" },
                    "output": "@viewed-entity-record",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision",
                            "trait": "amendable",
                            "operation": "apply",
                            "input": { "amendment": "#.input.amendment" }
                        },
                        "invoke": "#.input.entityType",
                        "operation": "run"
                    }
                },
                "revert": {
                    "input": { "!entityType": "@ref/entity-type", "!businessKey": "string", "revision": "number", "!amendment": "string" },
                    "output": "@viewed-entity-record",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision",
                            "trait": "amendable",
                            "operation": "revert",
                            "input": { "amendment": "#.input.amendment" }
                        },
                        "invoke": "#.input.entityType",
                        "operation": "run"
                    }
                },
                "discard": {
                    "input": { "!entityType": "@ref/entity-type", "!businessKey": "string", "revision": "number", "!amendment": "string" },
                    "output": "@viewed-entity-record",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision",
                            "trait": "amendable",
                            "operation": "discard",
                            "input": { "amendment": "#.input.amendment" }
                        },
                        "invoke": "#.input.entityType",
                        "operation": "run"
                    }
                }
            }
        }
    },
    { "id": "entity-amendment-gateway", "kind": "amendment-gateway-kind", "data": {} }
]
