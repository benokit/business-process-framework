[
    {
        "id": "entity-record",
        "kind": "schema",
        "data": {
            "!id": "string",
            "!entityType": "string",
            "!businessKey": "string",
            "!revision": "number",
            "!data": "object",
            "!timestampUtc": "string"
        }
    },
    {
        "id": "viewed-entity-record",
        "kind": "schema",
        "data": {
            "!id": "string",
            "!entityType": "string",
            "!businessKey": "string",
            "!revision": "number",
            "!data": "object",
            "!timestampUtc": "string"
        }
    },
    {
        "id": "viewed-record",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!record": "@entity-record", "entityType": "string", "at": "@any" }, "output": "@viewed-entity-record" },
            "module": "@business-framework/entities/views",
            "export": "viewedRecord"
        }
    },
    {
        "id": "viewed-change",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "@viewed-entity-change" },
            "module": "@business-framework/entities/views",
            "export": "viewedChange"
        }
    },
    {
        "id": "change-command",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "commands[]": { "!key": "string", "!command": "string", "!value": "@any" }, "!key": "string" }, "output": "@any" },
            "mapping": { "$find": { "collection": { "$coalesce": ["#.commands", []] }, "as": "command", "predicate": { "$eq": ["@command.key", "#.key"] } } }
        }
    },
    {
        "id": "derived-data",
        "kind": "schema",
        "data": { "!data": "object", "!commands[]": { "!key": "string", "!command": "string", "!value": "@any" } }
    },
    {
        "id": "command-values",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "[@any]", "output": "object" },
            "mapping": { "$mapValues": { "of": { "$toDictionary": { "by": "#.key", "collection": "#" } }, "fn": "#.value" } }
        }
    },
    {
        "id": "entity-change",
        "kind": "schema",
        "data": {
            "$data#1": [
                { "!operation=": "create", "entityOperation": "string", "!after": "object" },
                { "!operation=": "trait", "entityOperation": "string", "!before": "@entity-record", "!commands[]": { "!key": "string", "!command": "string", "!value": "@any" }, "after": "object" },
                { "!operation=": "delete", "entityOperation": "string", "!before": "@entity-record" },
                { "!operation=": "read", "entityOperation": "string", "!before": "@entity-record" }
            ]
        }
    },
    {
        "id": "viewed-entity-change",
        "kind": "schema",
        "data": {
            "$data#1": [
                { "!operation=": "create", "entityOperation": "string", "!after": "object" },
                { "!operation=": "trait", "entityOperation": "string", "!before": "@viewed-entity-record", "!commands[]": { "!key": "string", "!command": "string", "!value": "@any" }, "after": "object" },
                { "!operation=": "delete", "entityOperation": "string", "!before": "@viewed-entity-record" },
                { "!operation=": "read", "entityOperation": "string", "!before": "@viewed-entity-record" }
            ]
        }
    }
]
