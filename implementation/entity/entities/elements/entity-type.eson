[
    {
        "id": "entity-type",
        "kind": "kind",
        "data": {
            "extends": "trait-container",
            "fixed": { "traits": { "business-key": { "configuration": {} } } },
            "slots": {
                "guards": { "cardinality": "many", "value": "@method", "effects": ["read", "trace"], "input": "@viewed-entity-change", "discriminator": "operation" },
                "reactions": { "cardinality": "many", "value": "@method", "input": "@viewed-entity-change" }
            },
            "operations": {
                "load": {
                    "private": true,
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "outputKey": "record",
                            "inputMap": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "revision": "#.input.revision" },
                            "invoke": "entity-database",
                            "operation": "read"
                        },
                        { "inputMap": { "change": { "operation": "read", "before": "#.record" } }, "invoke": "#.self.id", "operation": "guardTraits" },
                        {
                            "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "guards", "on": "read" } },
                            "forEach": {
                                "inputMap": { "$func/viewed-change": { "change": { "operation": "read", "before": "#.record" }, "entityType": "#.self.id" } },
                                "execute": "#.item"
                            }
                        },
                        { "set": "#.record" }
                    ]
                },
                "read": {
                    "input": { "!businessKey": "string", "revision": "number", "at": "string" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "record", "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision" }, "invoke": "#.self.id", "operation": "load" },
                        { "set": { "$func/viewed-record": { "record": "#.record", "entityType": "#.self.id", "at": "#.input.at" } } }
                    ]
                },
                "applyChange": {
                    "private": true,
                    "input": { "!change": "@entity-change", "revision": "number" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        {
                            "if": { "$and": ["#.input.revision", { "$neq": ["#.input.revision", "#.input.change.before.revision"] }] },
                            "then": {
                                "throw": {
                                    "code": "conflict",
                                    "message": { "$str": ["#.self.id", " '", "#.input.change.before.businessKey", "' is not at revision ", "#.input.revision"] }
                                }
                            }
                        },
                        { "inputMap": { "change": "#.input.change" }, "invoke": "#.self.id", "operation": "guardTraits" },
                        {
                            "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "guards", "on": "#.input.change.operation" } },
                            "forEach": { "inputMap": { "$func/viewed-change": { "change": "#.input.change", "entityType": "#.self.id" } }, "execute": "#.item" }
                        },
                        {
                            "outputKey": "derivation",
                            "if": { "$neq": ["#.input.change.operation", "delete"] },
                            "then": {
                                "inputMap": {
                                    "seeds": {
                                        "$if": [
                                            { "$eq": ["#.input.change.operation", "create"] },
                                            { "$map": { "over": { "$keys": "#.input.change.after.data" }, "as": "key", "fn": { "key": "@key" } } },
                                            "#.input.change.commands"
                                        ]
                                    },
                                    "businessKey": { "$if": [{ "$eq": ["#.input.change.operation", "create"] }, "#.input.change.after.businessKey", "#.input.change.before.businessKey"] },
                                    "data": {
                                        "$if": [
                                            { "$eq": ["#.input.change.operation", "create"] },
                                            "#.input.change.after.data",
                                            { "$func/data-with-commands": { "data": "#.input.change.before.data", "commands": "#.input.change.commands" } }
                                        ]
                                    }
                                },
                                "invoke": "#.self.id",
                                "operation": "deriveData"
                            }
                        },
                        {
                            "outputKey": "store",
                            "set": {
                                "$cond": [
                                    [{ "$eq": ["#.input.change.operation", "create"] }, { "operation": "create", "input": { "entityType": "#.self.id", "businessKey": "#.input.change.after.businessKey", "data": "#.derivation.data" } }],
                                    [{ "$eq": ["#.input.change.operation", "delete"] }, { "operation": "delete", "input": { "before": "#.input.change.before" } }],
                                    ["else", { "operation": "update", "input": { "before": "#.input.change.before", "values": { "$func/command-values": { "$concat": ["#.input.change.commands", "#.derivation.commands"] } } } }]
                                ]
                            }
                        },
                        {
                            "inTransaction": [
                                {
                                    "outputKey": "record",
                                    "inputMap": "#.store.input",
                                    "invoke": "entity-database",
                                    "operation": "#.store.operation"
                                },
                                {
                                    "outputKey": "written",
                                    "set": {
                                        "$func/viewed-change": {
                                            "change": { "$if": [{ "$eq": ["#.input.change.operation", "delete"] }, "#.input.change", { "$merge": ["#.input.change", { "after": "#.record" }, { "$if": [{ "$eq": ["#.input.change.operation", "trait"] }, { "commands": { "$concat": ["#.input.change.commands", "#.derivation.commands"] } }, {}] }] }] },
                                            "entityType": "#.self.id"
                                        }
                                    }
                                },
                                { "inputMap": { "change": "#.written" }, "invoke": "#.self.id", "operation": "reactTraits" },
                                {
                                    "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "reactions" } },
                                    "forEach": { "inputMap": "#.written", "execute": "#.item" }
                                },
                                { "return": { "$func/viewed-record": { "record": "#.record", "entityType": "#.self.id" } } }
                            ]
                        }
                    ]
                },
                "derive": {
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision" }, "invoke": "#.self.id", "operation": "load" },
                        { "outputKey": "derivation", "inputMap": { "businessKey": "#.input.businessKey", "data": "#.before.data" }, "invoke": "#.self.id", "operation": "deriveData" },
                        {
                            "if": { "$eq": [{ "$count": { "collection": "#.derivation.commands" } }, 0] },
                            "then": { "set": { "$func/viewed-record": { "record": "#.before", "entityType": "#.self.id" } } },
                            "else": {
                                "inputMap": {
                                    "change": { "operation": "trait", "entityOperation": "#.operation", "commands": "#.derivation.commands", "before": "#.before" },
                                    "revision": "#.input.revision"
                                },
                                "invoke": "#.self.id",
                                "operation": "applyChange"
                            }
                        }
                    ]
                },
                "run": {
                    "input": { "!businessKey": "string", "revision": "number", "!trait": "string", "!operation": "string", "input": "@any" },
                    "output": "@any",
                    "implementation": [
                        { "outputKey": "public", "set": { "$func/entity-public-operation": { "entityType": "#.self.id", "key": "#.input.trait", "operation": "#.input.operation" } } },
                        {
                            "if": { "$negate": "#.public" },
                            "then": { "throw": { "code": "private-operation", "message": { "$str": ["#.self.id", " has no public operation ", "#.input.operation", " of the trait ", "#.input.trait"] } } }
                        },
                        {
                            "if": { "$eq": ["#.public.form", "command"] },
                            "then": [
                                {
                                    "if": { "$negate": "#.input.revision" },
                                    "then": { "throw": { "code": "invalid", "message": { "$str": [ "#.input.operation", " of ", "#.self.id", " needs the revision it applies to"] } } }
                                },
                                {
                                    "inputMap": {
                                        "businessKey": "#.input.businessKey",
                                        "revision": "#.input.revision",
                                        "entityOperation": "#.input.operation",
                                        "operations": [{ "key": "#.input.trait", "operation": "#.input.operation", "input": "#.input.input" }]
                                    },
                                    "invoke": "#.self.id",
                                    "operation": "applyTraitOperations"
                                }
                            ],
                            "else": { "inputMap": "#.input", "invoke": "#.self.id", "operation": "process" }
                        }
                    ]
                },
                "process": {
                    "private": true,
                    "input": { "!businessKey": "string", "revision": "number", "!trait": "string", "!operation": "string", "input": "@any" },
                    "output": "@any",
                    "implementation": {
                        "inTransaction": [
                            { "outputKey": "stored", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "load" },
                            { "outputKey": "record", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                            {
                                "if": { "$and": ["#.input.revision", { "$neq": ["#.input.revision", "#.record.revision"] }] },
                                "then": { "throw": { "code": "conflict", "message": { "$str": ["#.self.id", " '", "#.input.businessKey", "' is not at revision ", "#.input.revision"] } } }
                            },
                            {
                                "inputMap": { "change": { "operation": "trait", "entityOperation": "#.input.operation", "commands": { "$literal": [] }, "before": "#.stored" } },
                                "invoke": "#.self.id",
                                "operation": "guardTraits"
                            },
                            { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.input.trait" } } },
                            {
                                "outputKey": "plan",
                                "inputMap": {
                                    "entityType": "#.self.id",
                                    "key": "#.input.trait",
                                    "configuration": "#.use.configuration",
                                    "businessKey": "#.input.businessKey",
                                    "input": "#.input.input",
                                    "record": "#.record"
                                },
                                "invoke": "#.use.trait",
                                "operation": "#.input.operation"
                            },
                            { "outputKey": "operations", "set": { "$coalesce": ["#.plan.operations", []] } },
                            {
                                "if": { "$eq": ["#.plan.commit", false] },
                                "then": [
                                    { "outputKey": "commands", "inputMap": { "data": "#.stored.data", "operations": "#.operations" }, "invoke": "#.self.id", "operation": "traitCommands" },
                                    {
                                        "set": {
                                            "commands": "#.commands",
                                            "entity": { "$func/viewed-record": { "record": { "$merge": ["#.record", { "data": { "$func/data-with-commands": { "data": "#.stored.data", "commands": "#.commands" } } }] }, "entityType": "#.self.id" } }
                                        }
                                    }
                                ],
                                "else": [
                                    {
                                        "outputKey": "written",
                                        "if": { "$gt": [{ "$count": { "collection": "#.operations" } }, 0] },
                                        "then": {
                                            "inputMap": {
                                                "businessKey": "#.input.businessKey",
                                                "revision": "#.record.revision",
                                                "entityOperation": "#.input.operation",
                                                "operations": "#.operations"
                                            },
                                            "invoke": "#.self.id",
                                            "operation": "applyTraitOperations"
                                        },
                                        "else": { "set": "#.record" }
                                    },
                                    { "set": { "$coalesce": ["#.plan.output", "#.written"] } }
                                ]
                            }
                        ]
                    }
                },
                "applyTraitOperations": {
                    "private": true,
                    "input": {
                        "!businessKey": "string",
                        "revision": "number",
                        "!entityOperation": "string",
                        "!operations[]": { "!key": "string", "!operation": "string", "input": "@any" }
                    },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "keys", "set": { "$map": { "over": "#.input.operations", "fn": "#.key" } } },
                        {
                            "if": { "$not": "#.keys" },
                            "then": { "throw": { "code": "invalid", "message": "a write needs a trait operation" } }
                        },
                        {
                            "if": { "$neq": [{ "$count": { "collection": "#.keys" } }, { "$count": { "collection": { "$unique": "#.keys" } } }] },
                            "then": { "throw": { "code": "invalid", "message": "a write changes a trait once" } }
                        },
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "load" },
                        {
                            "outputKey": "commands",
                            "inputMap": { "data": "#.before.data", "operations": "#.input.operations" },
                            "invoke": "#.self.id",
                            "operation": "traitCommands"
                        },
                        {
                            "inputMap": {
                                "change": { "operation": "trait", "entityOperation": "#.input.entityOperation", "commands": "#.commands", "before": "#.before" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "traitCommands": {
                    "private": true,
                    "input": { "!data": "object", "!operations[]": { "!key": "string", "!operation": "string", "input": "@any" } },
                    "output": "[@any]",
                    "implementation": {
                        "inputMap": "#.input.operations",
                        "forEach": [
                            { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item.key" } } },
                            {
                                "if": { "$negate": "#.use" },
                                "then": { "throw": { "code": "invalid", "message": { "$str": ["#.self.id", " has no trait under the key ", "#.item.key"] } } }
                            },
                            {
                                "if": { "$negate": { "$func/has-operation": { "element": "#.use.trait", "operation": "#.item.operation" } } },
                                "then": { "throw": { "code": "invalid", "message": { "$str": ["the trait under ", "#.item.key", " of ", "#.self.id", " has no operation ", "#.item.operation"] } } }
                            },
                            {
                                "outputKey": "command",
                                "inputMap": {
                                    "entityType": "#.self.id",
                                    "key": "#.item.key",
                                    "configuration": "#.use.configuration",
                                    "value": { "$get": { "object": "#.input.data", "path": "#.item.key" } },
                                    "input": "#.item.input"
                                },
                                "invoke": "#.use.trait",
                                "operation": "#.item.operation"
                            },
                            { "set": { "key": "#.item.key", "command": "#.command.command", "value": "#.command.value" } }
                        ]
                    }
                },
                "create": {
                    "input": { "businessKey": "string", "traits": "object" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        {
                            "outputKey": "traits",
                            "inputMap": { "traits": { "$coalesce": ["#.input.traits", {}] }, "create": "#.input" },
                            "invoke": "#.self.id",
                            "operation": "initialTraitValues"
                        },
                        { "outputKey": "identityKey", "set": { "$func/entity-identity-key": "#.self.id" } },
                        {
                            "outputKey": "businessKey",
                            "if": "#.identityKey",
                            "then": { "set": { "$get": { "object": "#.traits", "path": "#.identityKey" } } },
                            "else": { "throw": { "code": "invalid", "message": "businessKey is required" } }
                        },
                        {
                            "inputMap": {
                                "change": { "operation": "create", "after": { "businessKey": "#.businessKey", "data": "#.traits" } }
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "delete": {
                    "input": { "!businessKey": "string", "!revision": "number" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "load" },
                        {
                            "inputMap": {
                                "change": { "operation": "delete", "entityOperation": "#.operation", "before": "#.before" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                }
            },
            "lifecycle": {
                "validate": { "$func/entity-trait-problems": "#.self.id" }
            }
        }
    },
    {
        "id": "entity-operation-names",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entities/operations",
            "export": "entityOperationNames"
        }
    },
    {
        "id": "entity-operation-registry",
        "kind": "kind",
        "data": {
            "lifecycle": {
                "load": {
                    "inputMap": { "id": "entity-operation", "schema": { "\\$data=1": { "$func/entity-operation-names": null } } },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "entities-operation-registry",
        "kind": "entity-operation-registry",
        "data": {}
    }
]
