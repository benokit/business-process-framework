[
    {
        "id": "entity-type",
        "kind": "kind",
        "data": {
            "shape": { "traits{}": "@entity-trait-entry" },
            "fixed": { "traits": { "body": {} } },
            "slots": {
                "traits": { "cardinality": "many", "value": "@entity-trait-use" },
                "businessKey": { "cardinality": "one", "value": "@method", "input": "@entity-type/create/input" },
                "guards": { "cardinality": "many", "value": "@method", "effects": ["read", "trace"], "input": "@entity-change" },
                "interceptors": { "cardinality": "many", "value": "@method", "input": { "!operation": "string", "!input": "object" } },
                "reactions": { "cardinality": "many", "value": "@method", "input": "@entity-change" }
            },
            "operations": {
                "load": {
                    "private": true,
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "outputKey": "record",
                            "inputMap": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "revision": "#.input.revision" },
                            "invoke": "entity-database",
                            "operation": "read"
                        },
                        {
                            "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "guards" } },
                            "forEach": {
                                "inputMap": { "$func/resolved-change": { "change": { "operation": "read", "before": "#.record" }, "entityType": "#.self.id" } },
                                "execute": "#.item"
                            }
                        },
                        { "set": "#.record" }
                    ]
                },
                "read": {
                    "input": { "!businessKey": "string", "revision": "number", "at": "string" },
                    "output": "@entity-record",
                    "implementation": [
                        { "outputKey": "record", "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision" }, "invoke": "#.self.id", "operation": "load" },
                        { "set": { "$func/resolved-record": { "record": "#.record", "at": "#.input.at" } } }
                    ]
                },
                "initialTraitValues": {
                    "input": { "!traits": "object" },
                    "output": "object",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "outputKey": "values",
                            "inputMap": { "$keys": "#.traits" },
                            "forEach": [
                                { "outputKey": "use", "set": { "$get": { "object": "#.traits", "path": "#.item" } } },
                                {
                                    "outputKey": "value",
                                    "inputMap": {
                                        "trait": "#.use.trait",
                                        "entityType": "#.self.id",
                                        "key": "#.item",
                                        "configuration": "#.use.configuration",
                                        "input": { "$get": { "object": "#.input.traits", "path": "#.item" } }
                                    },
                                    "invoke": "entity-trait-initializer",
                                    "operation": "initialize"
                                },
                                { "set": { "key": "#.item", "value": "#.value" } }
                            ]
                        },
                        { "set": { "$mapValues": { "of": { "$toDictionary": { "by": "#.key", "collection": "#.values" } }, "fn": "#.value" } } }
                    ]
                },
                "applyChange": {
                    "private": true,
                    "input": { "!change": "@entity-change", "revision": "number" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "if": { "$and": ["#.input.revision", { "$neq": ["#.input.revision", "#.input.change.before.revision"] }] },
                            "then": {
                                "throw": {
                                    "code": "conflict",
                                    "message": { "$str": ["#.self.id", " '", "#.input.change.before.businessKey", "' is not at revision ", "#.input.revision"] }
                                }
                            }
                        },
                        {
                            "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "guards" } },
                            "forEach": { "inputMap": { "$func/resolved-change": { "change": "#.input.change", "entityType": "#.self.id" } }, "execute": "#.item" }
                        },
                        {
                            "outputKey": "store",
                            "set": {
                                "$cond": [
                                    [{ "$eq": ["#.input.change.operation", "create"] }, { "operation": "create", "input": { "entityType": "#.self.id", "businessKey": "#.input.change.after.businessKey", "data": "#.input.change.after.data" } }],
                                    [{ "$eq": ["#.input.change.operation", "delete"] }, { "operation": "delete", "input": { "before": "#.input.change.before" } }],
                                    ["else", { "operation": "update", "input": { "before": "#.input.change.before", "values": { "$mapValues": { "of": { "$toDictionary": { "by": "#.key", "collection": "#.input.change.commands" } }, "fn": "#.value" } } } }]
                                ]
                            }
                        },
                        {
                            "inTransaction": [
                                {
                                    "outputKey": "record",
                                    "inputMap": "#.store",
                                    "middleware": { "$func/slot-values": { "element": "#.self.id", "slot": "interceptors" } },
                                    "action": { "inputMap": "#.input.input", "invoke": "entity-database", "operation": "#.store.operation" }
                                },
                                {
                                    "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "reactions" } },
                                    "forEach": {
                                        "inputMap": {
                                            "$func/resolved-change": {
                                                "change": { "$if": [{ "$eq": ["#.input.change.operation", "delete"] }, "#.input.change", { "$merge": ["#.input.change", { "after": "#.record", "versions": { "$func/record-versions": { "record": "#.record" } } }] }] },
                                                "entityType": "#.self.id"
                                            }
                                        },
                                        "execute": "#.item"
                                    }
                                },
                                { "return": { "$func/resolved-record": { "record": "#.record" } } }
                            ]
                        }
                    ]
                },
                "applyTraitOperations": {
                    "private": true,
                    "input": {
                        "!businessKey": "string",
                        "revision": "number",
                        "!entityOperation": "string",
                        "!operations[]": { "!key": "string", "!operation": "string", "input": "@any" }
                    },
                    "output": "@entity-record",
                    "implementation": [
                        { "outputKey": "keys", "set": { "$map": { "over": "#.input.operations", "fn": "#.key" } } },
                        {
                            "if": { "$not": "#.keys" },
                            "then": { "throw": { "code": "invalid", "message": "a write needs a trait operation" } }
                        },
                        {
                            "if": { "$neq": [{ "$count": { "collection": "#.keys" } }, { "$count": { "collection": { "$unique": "#.keys" } } }] },
                            "then": { "throw": { "code": "invalid", "message": "a write changes a trait once" } }
                        },
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "load" },
                        {
                            "outputKey": "commands",
                            "inputMap": "#.input.operations",
                            "forEach": [
                                { "outputKey": "use", "set": { "$get": { "object": "#.traits", "path": "#.item.key" } } },
                                {
                                    "if": { "$negate": "#.use" },
                                    "then": { "throw": { "code": "invalid", "message": { "$str": ["#.self.id", " has no trait under the key ", "#.item.key"] } } }
                                },
                                {
                                    "if": { "$negate": { "$func/has-operation": { "element": "#.use.trait", "operation": "#.item.operation" } } },
                                    "then": { "throw": { "code": "invalid", "message": { "$str": ["the trait under ", "#.item.key", " of ", "#.self.id", " has no operation ", "#.item.operation"] } } }
                                },
                                {
                                    "outputKey": "command",
                                    "inputMap": {
                                        "trait": "#.use.trait",
                                        "operation": "#.item.operation",
                                        "request": {
                                            "entityType": "#.self.id",
                                            "key": "#.item.key",
                                            "configuration": "#.use.configuration",
                                            "value": { "$get": { "object": "#.before.data", "path": "#.item.key" } },
                                            "input": "#.item.input"
                                        }
                                    },
                                    "invoke": "entity-trait-operator",
                                    "operation": "run"
                                },
                                { "set": { "key": "#.item.key", "command": "#.command.command", "value": "#.command.value" } }
                            ]
                        },
                        {
                            "inputMap": {
                                "change": { "operation": "trait", "entityOperation": "#.input.entityOperation", "commands": "#.commands", "before": "#.before" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "create": {
                    "input": { "businessKey": "string", "traits": "object" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "outputKey": "traits",
                            "inputMap": { "traits": { "$coalesce": ["#.input.traits", {}] } },
                            "invoke": "#.self.id",
                            "operation": "initialTraitValues"
                        },
                        { "outputKey": "businessKeyRule", "set": { "$func/slot-values": { "element": "#.self.id", "slot": "businessKey" } } },
                        {
                            "outputKey": "businessKey",
                            "if": "#.input.businessKey",
                            "then": { "set": "#.input.businessKey" },
                            "else": {
                                "if": "#.businessKeyRule",
                                "then": { "execute": "#.businessKeyRule" },
                                "else": { "throw": { "code": "invalid", "message": "businessKey is required" } }
                            }
                        },
                        {
                            "inputMap": {
                                "change": { "operation": "create", "after": { "businessKey": "#.businessKey", "data": "#.traits" } }
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "update": {
                    "input": { "!businessKey": "string", "!revision": "number", "!value": "object" },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "input": { "value": "#.input.value" } },
                        "traitOperation": { "key": "body", "operation": "put" }
                    }
                },
                "delete": {
                    "input": { "!businessKey": "string", "!revision": "number" },
                    "output": "@entity-record",
                    "implementation": [
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "load" },
                        {
                            "inputMap": {
                                "change": { "operation": "delete", "entityOperation": "#.operation", "before": "#.before" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                }
            },
            "lifecycle": {
                "validate": { "$func/entity-trait-problems": "#.self.id" }
            }
        }
    }
]
