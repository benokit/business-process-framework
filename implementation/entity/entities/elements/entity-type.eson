[
    {
        "id": "entity-type",
        "kind": "kind",
        "data": {
            "extends": "trait-container",
            "fixed": { "traits": { "business-key": { "configuration": {} } } },
            "slots": {
                "requestGuards": { "cardinality": "many", "value": "@method", "effects": ["read", "trace"], "input": "@viewed-entity-change", "discriminator": "operation" },
                "resultGuards": { "cardinality": "many", "value": "@method", "effects": ["read", "trace"], "input": "@viewed-entity-change", "discriminator": "operation" },
                "reactions": { "cardinality": "many", "value": "@method", "input": "@viewed-entity-change" }
            },
            "operations": {
                "loadReadableRecord": {
                    "private": true,
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "outputKey": "storedRecord",
                            "inputMap": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "revision": "#.input.revision" },
                            "invoke": "entity-database",
                            "operation": "read"
                        },
                        { "inputMap": { "change": { "operation": "read", "before": "#.storedRecord" } }, "invoke": "#.self.id", "operation": "runTraitGuards" },
                        {
                            "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "requestGuards", "on": "read" } },
                            "forEach": {
                                "inputMap": { "$func/viewed-change": { "change": { "operation": "read", "before": "#.storedRecord" }, "entityType": "#.self.id" } },
                                "execute": "#.item"
                            }
                        },
                        { "set": "#.storedRecord" }
                    ]
                },
                "read": {
                    "input": { "!businessKey": "string", "revision": "number", "at": "string" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "readableRecord", "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision" }, "invoke": "#.self.id", "operation": "loadReadableRecord" },
                        { "set": { "$func/viewed-record": { "record": "#.readableRecord", "entityType": "#.self.id", "at": "#.input.at" } } }
                    ]
                },
                "applyChange": {
                    "private": true,
                    "input": { "!change": "@entity-change", "revision": "number" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        {
                            "if": { "$and": ["#.input.revision", { "$neq": ["#.input.revision", "#.input.change.before.revision"] }] },
                            "then": {
                                "throw": {
                                    "code": "conflict",
                                    "message": { "$str": ["#.self.id", " '", "#.input.change.before.businessKey", "' is not at revision ", "#.input.revision"] }
                                }
                            }
                        },
                        { "inputMap": { "change": "#.input.change" }, "invoke": "#.self.id", "operation": "runRequestGuards" },
                        {
                            "outputKey": "derivation",
                            "if": { "$neq": ["#.input.change.operation", "delete"] },
                            "then": {
                                "inputMap": {
                                    "seeds": {
                                        "$if": [
                                            { "$eq": ["#.input.change.operation", "create"] },
                                            { "$map": { "over": { "$keys": "#.input.change.after.data" }, "as": "key", "fn": { "key": "@key" } } },
                                            "#.input.change.commands"
                                        ]
                                    },
                                    "businessKey": { "$if": [{ "$eq": ["#.input.change.operation", "create"] }, "#.input.change.after.businessKey", "#.input.change.before.businessKey"] },
                                    "data": {
                                        "$if": [
                                            { "$eq": ["#.input.change.operation", "create"] },
                                            "#.input.change.after.data",
                                            { "$func/data-with-commands": { "data": "#.input.change.before.data", "commands": "#.input.change.commands" } }
                                        ]
                                    }
                                },
                                "invoke": "#.self.id",
                                "operation": "deriveTraitValues"
                            }
                        },
                        {
                            "if": { "$neq": ["#.input.change.operation", "delete"] },
                            "then": { "inputMap": { "change": "#.input.change", "derivation": "#.derivation" }, "invoke": "#.self.id", "operation": "runResultGuards" }
                        },
                        {
                            "outputKey": "databaseWrite",
                            "set": {
                                "$cond": [
                                    [{ "$eq": ["#.input.change.operation", "create"] }, { "operation": "create", "input": { "entityType": "#.self.id", "businessKey": "#.input.change.after.businessKey", "data": "#.derivation.data" } }],
                                    [{ "$eq": ["#.input.change.operation", "delete"] }, { "operation": "delete", "input": { "before": "#.input.change.before" } }],
                                    ["else", { "operation": "update", "input": { "before": "#.input.change.before", "values": { "$func/command-values": { "$concat": ["#.input.change.commands", "#.derivation.commands"] } } } }]
                                ]
                            }
                        },
                        {
                            "inTransaction": [
                                {
                                    "outputKey": "writtenRecord",
                                    "inputMap": "#.databaseWrite.input",
                                    "invoke": "entity-database",
                                    "operation": "#.databaseWrite.operation"
                                },
                                {
                                    "outputKey": "writtenChange",
                                    "set": {
                                        "$func/viewed-change": {
                                            "change": { "$if": [{ "$eq": ["#.input.change.operation", "delete"] }, "#.input.change", { "$merge": ["#.input.change", { "after": "#.writtenRecord" }, { "$if": [{ "$eq": ["#.input.change.operation", "trait"] }, { "commands": { "$concat": ["#.input.change.commands", "#.derivation.commands"] } }, {}] }] }] },
                                            "entityType": "#.self.id"
                                        }
                                    }
                                },
                                { "inputMap": { "change": "#.writtenChange" }, "invoke": "#.self.id", "operation": "runTraitReactions" },
                                {
                                    "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "reactions" } },
                                    "forEach": { "inputMap": "#.writtenChange", "execute": "#.item" }
                                },
                                { "return": { "$func/viewed-record": { "record": "#.writtenRecord", "entityType": "#.self.id" } } }
                            ]
                        }
                    ]
                },
                "derive": {
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "storedRecord", "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision" }, "invoke": "#.self.id", "operation": "loadReadableRecord" },
                        { "outputKey": "derivation", "inputMap": { "businessKey": "#.input.businessKey", "data": "#.storedRecord.data" }, "invoke": "#.self.id", "operation": "deriveTraitValues" },
                        {
                            "if": { "$eq": [{ "$count": { "collection": "#.derivation.commands" } }, 0] },
                            "then": { "set": { "$func/viewed-record": { "record": "#.storedRecord", "entityType": "#.self.id" } } },
                            "else": {
                                "inputMap": {
                                    "change": { "operation": "trait", "entityOperation": "#.operation", "commands": "#.derivation.commands", "before": "#.storedRecord" },
                                    "revision": "#.input.revision"
                                },
                                "invoke": "#.self.id",
                                "operation": "applyChange"
                            }
                        }
                    ]
                },
                "run": {
                    "input": { "!businessKey": "string", "revision": "number", "!trait": "string", "!operation": "string", "input": "@any" },
                    "output": "@any",
                    "implementation": [
                        { "outputKey": "publicOperation", "set": { "$func/entity-public-operation": { "entityType": "#.self.id", "key": "#.input.trait", "operation": "#.input.operation" } } },
                        {
                            "if": { "$negate": "#.publicOperation" },
                            "then": { "throw": { "code": "private-operation", "message": { "$str": ["#.self.id", " has no public operation ", "#.input.operation", " of the trait ", "#.input.trait"] } } }
                        },
                        {
                            "if": { "$eq": ["#.publicOperation.form", "command"] },
                            "then": [
                                {
                                    "if": { "$negate": "#.input.revision" },
                                    "then": { "throw": { "code": "invalid", "message": { "$str": [ "#.input.operation", " of ", "#.self.id", " needs the revision it applies to"] } } }
                                },
                                {
                                    "inputMap": {
                                        "businessKey": "#.input.businessKey",
                                        "revision": "#.input.revision",
                                        "entityOperation": "#.input.operation",
                                        "operations": [{ "key": "#.input.trait", "operation": "#.input.operation", "input": "#.input.input" }]
                                    },
                                    "invoke": "#.self.id",
                                    "operation": "writeTraitOperationsAsOneChange"
                                }
                            ],
                            "else": { "inputMap": "#.input", "invoke": "#.self.id", "operation": "runTraitPlan" }
                        }
                    ]
                },
                "runRequestGuards": {
                    "private": true,
                    "input": { "!change": "@entity-change" },
                    "implementation": [
                        { "inputMap": { "change": "#.input.change" }, "invoke": "#.self.id", "operation": "runTraitGuards" },
                        {
                            "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "requestGuards", "on": "#.input.change.operation" } },
                            "forEach": { "inputMap": { "$func/viewed-change": { "change": "#.input.change", "entityType": "#.self.id" } }, "execute": "#.item" }
                        }
                    ]
                },
                "runResultGuards": {
                    "private": true,
                    "input": { "!change": "@entity-change", "!derivation": "@derived-data" },
                    "implementation": {
                                "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "resultGuards", "on": "#.input.change.operation" } },
                                "forEach": {
                                    "inputMap": {
                                        "$func/viewed-change": {
                                            "change": {
                                                "$if": [
                                                    { "$eq": ["#.input.change.operation", "create"] },
                                                    { "$merge": ["#.input.change", { "after": { "$merge": ["#.input.change.after", { "data": "#.input.derivation.data" }] } }] },
                                                    { "$merge": ["#.input.change", { "commands": { "$concat": ["#.input.change.commands", "#.input.derivation.commands"] }, "after": { "$merge": ["#.input.change.before", { "data": "#.input.derivation.data" }] } }] }
                                                ]
                                            },
                                            "entityType": "#.self.id"
                                        }
                                    },
                                    "execute": "#.item"
                                }
                            }
                },
                "runTraitPlan": {
                    "private": true,
                    "input": { "!businessKey": "string", "revision": "number", "!trait": "string", "!operation": "string", "input": "@any" },
                    "output": "@any",
                    "implementation": {
                        "inTransaction": [
                            { "outputKey": "storedRecord", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "loadReadableRecord" },
                            { "outputKey": "viewedRecord", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                            {
                                "if": { "$and": ["#.input.revision", { "$neq": ["#.input.revision", "#.viewedRecord.revision"] }] },
                                "then": { "throw": { "code": "conflict", "message": { "$str": ["#.self.id", " '", "#.input.businessKey", "' is not at revision ", "#.input.revision"] } } }
                            },
                            {
                                "inputMap": { "change": { "operation": "trait", "entityOperation": "#.input.operation", "commands": { "$literal": [] }, "before": "#.storedRecord" } },
                                "invoke": "#.self.id",
                                "operation": "runTraitGuards"
                            },
                            { "outputKey": "appliedTrait", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.input.trait" } } },
                            {
                                "outputKey": "plan",
                                "inputMap": {
                                    "entityType": "#.self.id",
                                    "key": "#.input.trait",
                                    "configuration": "#.appliedTrait.configuration",
                                    "businessKey": "#.input.businessKey",
                                    "input": "#.input.input",
                                    "record": "#.viewedRecord"
                                },
                                "invoke": "#.appliedTrait.trait",
                                "operation": "#.input.operation"
                            },
                            { "outputKey": "plannedOperations", "set": { "$coalesce": ["#.plan.operations", []] } },
                            {
                                "if": { "$eq": ["#.plan.commit", false] },
                                "then": [
                                    { "outputKey": "requestedCommands", "inputMap": { "data": "#.storedRecord.data", "operations": "#.plannedOperations" }, "invoke": "#.self.id", "operation": "commandsOfTraitOperations" },
                                    { "outputKey": "requestChange", "set": { "operation": "trait", "entityOperation": "#.input.operation", "commands": "#.requestedCommands", "before": "#.storedRecord" } },
                                    { "inputMap": { "change": "#.requestChange" }, "invoke": "#.self.id", "operation": "runRequestGuards" },
                                    {
                                        "outputKey": "derivation",
                                        "inputMap": {
                                            "seeds": "#.requestedCommands",
                                            "businessKey": "#.storedRecord.businessKey",
                                            "data": { "$func/data-with-commands": { "data": "#.storedRecord.data", "commands": "#.requestedCommands" } }
                                        },
                                        "invoke": "#.self.id",
                                        "operation": "deriveTraitValues"
                                    },
                                    { "inputMap": { "change": "#.requestChange", "derivation": "#.derivation" }, "invoke": "#.self.id", "operation": "runResultGuards" },
                                    {
                                        "set": {
                                            "commands": { "$concat": ["#.requestedCommands", "#.derivation.commands"] },
                                            "entity": { "$func/viewed-record": { "record": { "$merge": ["#.viewedRecord", { "data": "#.derivation.data" }] }, "entityType": "#.self.id" } }
                                        }
                                    }
                                ],
                                "else": [
                                    {
                                        "outputKey": "writtenRecord",
                                        "if": { "$gt": [{ "$count": { "collection": "#.plannedOperations" } }, 0] },
                                        "then": {
                                            "inputMap": {
                                                "businessKey": "#.input.businessKey",
                                                "revision": "#.viewedRecord.revision",
                                                "entityOperation": "#.input.operation",
                                                "operations": "#.plannedOperations"
                                            },
                                            "invoke": "#.self.id",
                                            "operation": "writeTraitOperationsAsOneChange"
                                        },
                                        "else": { "set": "#.viewedRecord" }
                                    },
                                    { "set": { "$coalesce": ["#.plan.output", "#.writtenRecord"] } }
                                ]
                            }
                        ]
                    }
                },
                "writeTraitOperationsAsOneChange": {
                    "private": true,
                    "input": {
                        "!businessKey": "string",
                        "revision": "number",
                        "!entityOperation": "string",
                        "!operations[]": { "!key": "string", "!operation": "string", "input": "@any" }
                    },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "traitKeys", "set": { "$map": { "over": "#.input.operations", "fn": "#.key" } } },
                        {
                            "if": { "$not": "#.traitKeys" },
                            "then": { "throw": { "code": "invalid", "message": "a write needs a trait operation" } }
                        },
                        {
                            "if": { "$neq": [{ "$count": { "collection": "#.traitKeys" } }, { "$count": { "collection": { "$unique": "#.traitKeys" } } }] },
                            "then": { "throw": { "code": "invalid", "message": "a write changes a trait once" } }
                        },
                        { "outputKey": "storedRecord", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "loadReadableRecord" },
                        {
                            "outputKey": "requestedCommands",
                            "inputMap": { "data": "#.storedRecord.data", "operations": "#.input.operations" },
                            "invoke": "#.self.id",
                            "operation": "commandsOfTraitOperations"
                        },
                        {
                            "inputMap": {
                                "change": { "operation": "trait", "entityOperation": "#.input.entityOperation", "commands": "#.requestedCommands", "before": "#.storedRecord" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "commandsOfTraitOperations": {
                    "private": true,
                    "input": { "!data": "object", "!operations[]": { "!key": "string", "!operation": "string", "input": "@any" } },
                    "output": "[@any]",
                    "implementation": {
                        "inputMap": "#.input.operations",
                        "forEach": [
                            { "outputKey": "appliedTrait", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item.key" } } },
                            {
                                "if": { "$negate": "#.appliedTrait" },
                                "then": { "throw": { "code": "invalid", "message": { "$str": ["#.self.id", " has no trait under the key ", "#.item.key"] } } }
                            },
                            {
                                "if": { "$negate": { "$func/has-operation": { "element": "#.appliedTrait.trait", "operation": "#.item.operation" } } },
                                "then": { "throw": { "code": "invalid", "message": { "$str": ["the trait under ", "#.item.key", " of ", "#.self.id", " has no operation ", "#.item.operation"] } } }
                            },
                            {
                                "outputKey": "traitCommand",
                                "inputMap": {
                                    "entityType": "#.self.id",
                                    "key": "#.item.key",
                                    "configuration": "#.appliedTrait.configuration",
                                    "value": { "$get": { "object": "#.input.data", "path": "#.item.key" } },
                                    "input": "#.item.input"
                                },
                                "invoke": "#.appliedTrait.trait",
                                "operation": "#.item.operation"
                            },
                            { "set": { "key": "#.item.key", "command": "#.traitCommand.command", "value": "#.traitCommand.value" } }
                        ]
                    }
                },
                "create": {
                    "input": { "businessKey": "string", "traits": "object" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        {
                            "outputKey": "initialValues",
                            "inputMap": { "traits": { "$coalesce": ["#.input.traits", {}] }, "create": "#.input" },
                            "invoke": "#.self.id",
                            "operation": "initialValuesOfTraits"
                        },
                        { "outputKey": "identityKey", "set": { "$func/entity-identity-key": "#.self.id" } },
                        {
                            "outputKey": "businessKey",
                            "if": "#.identityKey",
                            "then": { "set": { "$get": { "object": "#.initialValues", "path": "#.identityKey" } } },
                            "else": { "throw": { "code": "invalid", "message": "businessKey is required" } }
                        },
                        {
                            "inputMap": {
                                "change": { "operation": "create", "after": { "businessKey": "#.businessKey", "data": "#.initialValues" } }
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "delete": {
                    "input": { "!businessKey": "string", "!revision": "number" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        { "outputKey": "storedRecord", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "loadReadableRecord" },
                        {
                            "inputMap": {
                                "change": { "operation": "delete", "entityOperation": "#.operation", "before": "#.storedRecord" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                }
            },
            "lifecycle": {
                "validate": { "$func/entity-trait-problems": "#.self.id" }
            }
        }
    },
    {
        "id": "entity-operation-names",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entities/operations",
            "export": "entityOperationNames"
        }
    },
    {
        "id": "entity-operation-registry",
        "kind": "kind",
        "data": {
            "lifecycle": {
                "load": {
                    "inputMap": { "id": "entity-operation", "schema": { "\\$data=1": { "$func/entity-operation-names": null } } },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "entities-operation-registry",
        "kind": "entity-operation-registry",
        "data": {}
    }
]
