[
    {
        "id": "entity-trait-use",
        "kind": "schema",
        "data": { "trait": "@ref/entity-trait", "key": "string", "!configuration": "@any" }
    },
    {
        "id": "entity-trait-entry",
        "kind": "schema",
        "data": { "trait": "@ref/entity-trait", "configuration": "@any" }
    },
    {
        "id": "entity-trait",
        "kind": "kind",
        "data": {
            "shape": { "!configuration": "@schema", "cardinality=1": ["one", "many"], "key": "string", "view": "@mapping", "identity": "boolean", "entries[]": "string" },
            "lifecycle": {
                "load": {
                    "inputMap": { "id": { "$str": ["#.self.id", "/configuration"] }, "schema": "#.self.data.configuration" },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "valued-entity-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait",
            "operations": {
                "initialize": { "input": { "!entityType": "string", "!key": "string", "!configuration": "@any", "input": "@any", "create": "@any" }, "output": "@any" }
            }
        }
    },
    {
        "id": "entity-trait-use-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!key": "string" }, "output": { "$data#": ["@entity-trait-use", "null"] } },
            "module": "@business-framework/entities/traits",
            "export": "traitUseOf"
        }
    },
    {
        "id": "entity-traits",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": { "*": { "!trait": "@ref/entity-trait", "!configuration": "@any" } } },
            "module": "@business-framework/entities/traits",
            "export": "traitsOf"
        }
    },
    {
        "id": "entity-trait-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entities/traits",
            "export": "traitProblems"
        }
    },
    {
        "id": "entity-valued-keys",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entities/traits",
            "export": "valuedKeysOf"
        }
    },
    {
        "id": "entity-identity-key",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "string" },
            "module": "@business-framework/entities/traits",
            "export": "identityKeyOf"
        }
    },
    {
        "id": "entity-trait-key",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!kind": "string" }, "output": "string" },
            "module": "@business-framework/entities/traits",
            "export": "traitKeyOf"
        }
    },
    {
        "id": "entity-trait-value",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!record": "@any", "!kind": "string" }, "output": "@any" },
            "module": "@business-framework/entities/traits",
            "export": "traitValueOf"
        }
    },
    {
        "id": "entity-trait-entries",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!key": "string" }, "output": "[string]" },
            "module": "@business-framework/entities/traits",
            "export": "traitEntriesOf"
        }
    },
    {
        "id": "entity-hooked-keys",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!operation": "string" }, "output": "[string]" },
            "module": "@business-framework/entities/traits",
            "export": "hookedKeysOf"
        }
    }
]
