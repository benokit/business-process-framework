[
    {
        "id": "entity-trait-use",
        "kind": "schema",
        "data": { "trait": "@ref/entity-trait", "key": "string", "!configuration": "@any", "dependsOn[]": "string" }
    },
    {
        "id": "entity-trait-entry",
        "kind": "schema",
        "data": { "trait": "@ref/entity-trait", "configuration": "@any", "dependsOn[]": "string" }
    },
    {
        "id": "entity-trait",
        "kind": "kind",
        "data": {
            "shape": { "!configuration": "@schema", "key": "string", "view": "@mapping/trait-view", "identity": "boolean", "guard": "@method/trait-change", "react": "@method/trait-change", "derive": "@method/trait-derivation", "value": "@mapping/trait-value" },
            "templates": {
                "trait-view": { "input": { "!entityType": "string", "!key": "string", "!configuration": "#.data.configuration", "value": "\\@any", "at": "\\@any" } },
                "trait-change": { "input": { "!entityType": "string", "!key": "string", "!configuration": "#.data.configuration", "!change": "\\@viewed-entity-change" } },
                "trait-value": { "input": { "!entityType": "string", "!key": "string", "!configuration": "#.data.configuration" } },
                "trait-derivation": {
                    "input": {
                        "!entityType": "string",
                        "!key": "string",
                        "!configuration": "#.data.configuration",
                        "!record": { "!entityType": "string", "!businessKey": "string", "!data": "object" },
                        "command": "\\@any"
                    }
                }
            },
            "lifecycle": {
                "load": {
                    "inputMap": { "id": { "$str": ["#.self.id", "/configuration"] }, "schema": "#.self.data.configuration" },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "valued-entity-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait",
            "operations": {
                "initialize": { "input": { "!entityType": "string", "!key": "string", "!configuration": "@any", "input": "@any", "create": "@any" }, "output": "@any" }
            }
        }
    },
    {
        "id": "entity-trait-use-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!key": "string" }, "output": { "$data#": ["@entity-trait-use", "null"] } },
            "module": "@business-framework/entities/traits",
            "export": "traitUseOf"
        }
    },
    {
        "id": "entity-public-operation",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!key": "string", "!operation": "string" }, "output": { "$data#": [{ "!form=1": ["command", "plan"] }, "null"] } },
            "module": "@business-framework/entities/traits",
            "export": "publicOperationOf"
        }
    },
    {
        "id": "trait-value-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!data": "object" }, "output": "[string]" },
            "module": "@business-framework/entities/records",
            "export": "traitValueProblems"
        }
    },
    {
        "id": "trait-value-schemas",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[object]" },
            "module": "@business-framework/entities/records",
            "export": "traitValueSchemas"
        }
    },
    {
        "id": "entity-trait-value-writer",
        "kind": "kind",
        "data": {
            "lifecycle": {
                "load": {
                    "inputMap": { "$func/trait-value-schemas": null },
                    "forEach": { "inputMap": "#.item", "invoke": "ajv", "operation": "add" }
                }
            }
        }
    },
    {
        "id": "entity-trait-values",
        "kind": "entity-trait-value-writer",
        "data": {}
    },
    {
        "id": "record-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "@ref/entity-type" }, "output": "@schema" },
            "module": "@business-framework/entities/records",
            "export": "recordSchemaOf"
        }
    },
    {
        "id": "viewed-data-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "@ref/entity-type" }, "output": "@schema" },
            "module": "@business-framework/entities/records",
            "export": "dataSchemaOf"
        }
    },
    {
        "id": "entity-traits",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": { "*": { "!trait": "@ref/entity-trait", "!configuration": "@any", "dependsOn[]": "string" } } },
            "module": "@business-framework/entities/traits",
            "export": "traitsOf"
        }
    },
    {
        "id": "entity-trait-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entities/traits",
            "export": "traitProblems"
        }
    },
    {
        "id": "entity-valued-keys",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entities/traits",
            "export": "valuedKeysOf"
        }
    },
    {
        "id": "entity-identity-key",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "string" },
            "module": "@business-framework/entities/traits",
            "export": "identityKeyOf"
        }
    },
    {
        "id": "entity-trait-key",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!kind": "string" }, "output": "string" },
            "module": "@business-framework/entities/traits",
            "export": "traitKeyOf"
        }
    },
    {
        "id": "entity-trait-value",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!record": "@any", "!kind": "string" }, "output": "@any" },
            "module": "@business-framework/entities/traits",
            "export": "traitValueOf"
        }
    }
]
