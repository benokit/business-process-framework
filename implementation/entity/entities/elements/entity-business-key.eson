[
    {
        "id": "business-key-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": [
                        {
                            "if": "#.input.create.businessKey",
                            "then": { "set": "#.input.create.businessKey" },
                            "else": {
                                "if": "#.input.configuration.rule",
                                "then": { "inputMap": "#.input.create", "execute": "#.input.configuration.rule" },
                                "else": { "throw": { "code": "invalid", "message": "businessKey is required" } }
                            }
                        }
                    ]
                }
            }
        }
    },
    {
        "id": "business-key",
        "kind": "business-key-trait",
        "data": { "identity": true, "configuration": { "rule": "@method" } }
    }
]
