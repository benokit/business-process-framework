[
    {
        "id": "body-schemas",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[object]" },
            "module": "@business-framework/entities/body",
            "export": "bodySchemas"
        }
    },
    {
        "id": "body-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait",
            "operations": {
                "initialize": {
                    "implementation": [
                        {
                            "if": { "$negate": "#.input.input" },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " needs a ", "#.input.key"] } } }
                        },
                        { "inputMap": { "schemaId": { "$str": ["#.input.entityType", "/", "#.input.key", "/schema"] }, "value": "#.input.input" }, "invoke": "ajv", "operation": "assert" },
                        { "set": "#.input.input" }
                    ]
                },
                "put": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": [
                        { "inputMap": { "schemaId": { "$str": ["#.input.entityType", "/", "#.input.key", "/schema"] }, "value": "#.input.input.value" }, "invoke": "ajv", "operation": "assert" },
                        { "set": { "command": "put", "value": "#.input.input.value" } }
                    ]
                }
            }
        }
    },
    {
        "id": "body",
        "kind": "body-trait",
        "data": { "cardinality": "one", "configuration": { "!schema": "@schema" } }
    },
    {
        "id": "entity-body-writer",
        "kind": "kind",
        "data": {
            "lifecycle": {
                "load": {
                    "inputMap": { "$func/body-schemas": null },
                    "forEach": { "inputMap": "#.item", "invoke": "ajv", "operation": "add" }
                }
            }
        }
    },
    {
        "id": "entity-bodies",
        "kind": "entity-body-writer",
        "data": {}
    }
]
