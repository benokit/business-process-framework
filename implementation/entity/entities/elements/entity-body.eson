[
    {
        "id": "date",
        "kind": "schema",
        "data": "string:^\\d{4}-\\d{2}-\\d{2}$"
    },
    {
        "id": "body-schemas",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[object]" },
            "module": "@business-framework/entities/body",
            "export": "bodySchemas"
        }
    },
    {
        "id": "start-body-versions",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "module": "@business-framework/entities/versions",
            "export": "startVersions"
        }
    },
    {
        "id": "replace-body-versions",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "module": "@business-framework/entities/versions",
            "export": "replaceVersions"
        }
    },
    {
        "id": "amended-body",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "module": "@business-framework/entities/versions",
            "export": "amendedBody"
        }
    },
    {
        "id": "append-body-version",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "module": "@business-framework/entities/versions",
            "export": "appendVersion"
        }
    },
    {
        "id": "remove-body-version",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "module": "@business-framework/entities/versions",
            "export": "removeVersion"
        }
    },
    {
        "id": "body-at",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "@any" },
            "module": "@business-framework/entities/versions",
            "export": "bodyAt"
        }
    },
    {
        "id": "versioned-body-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entities/versions",
            "export": "versionedBodyProblems"
        }
    },
    {
        "id": "body-put-input",
        "kind": "schema",
        "data": { "!value": "object" }
    },
    {
        "id": "body-amend-input",
        "kind": "schema",
        "data": { "!validFrom": "@date", "!patch": "[object]" }
    },
    {
        "id": "body-remove-input",
        "kind": "schema",
        "data": { "!validFrom": "@date" }
    },
    {
        "id": "body-entity-type",
        "kind": "kind",
        "data": {
            "extends": "entity-type",
            "operations": {
                "update": {
                    "input": { "$data#&": ["@entity-revision-input", "@body-put-input"] },
                    "output": "@viewed-entity-record",
                    "implementation": { "exposes": { "key": "body", "operation": "put" } }
                }
            }
        }
    },
    {
        "id": "body-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait",
            "operations": {
                "put": { "input": { "$data#&": ["@trait-operation-input", { "!input": "@body-put-input" }] }, "output": "@trait-command" }
            }
        }
    },
    {
        "id": "plain-body-trait",
        "kind": "kind",
        "data": {
            "extends": "body-trait",
            "operations": {
                "initialize": {
                    "implementation": [
                        {
                            "if": { "$negate": "#.input.input" },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " needs a ", "#.input.key"] } } }
                        },
                        { "inputMap": { "schemaId": { "$str": ["#.input.entityType", "/", "#.input.key", "/schema"] }, "value": "#.input.input" }, "invoke": "ajv", "operation": "assert" },
                        { "set": "#.input.input" }
                    ]
                },
                "put": {
                    "implementation": [
                        { "inputMap": { "schemaId": { "$str": ["#.input.entityType", "/", "#.input.key", "/schema"] }, "value": "#.input.input.value" }, "invoke": "ajv", "operation": "assert" },
                        { "set": { "command": "put", "value": "#.input.input.value" } }
                    ]
                }
            }
        }
    },
    {
        "id": "versioned-body-trait",
        "kind": "kind",
        "data": {
            "extends": "body-trait",
            "lifecycle": {
                "validate": { "$func/versioned-body-problems": null }
            },
            "operations": {
                "initialize": {
                    "implementation": [
                        {
                            "if": { "$negate": "#.input.input" },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " needs a ", "#.input.key"] } } }
                        },
                        { "inputMap": { "schemaId": { "$str": ["#.input.entityType", "/", "#.input.key", "/schema"] }, "value": "#.input.input" }, "invoke": "ajv", "operation": "assert" },
                        { "set": { "$func/start-body-versions": { "configuration": "#.input.configuration", "body": "#.input.input" } } }
                    ]
                },
                "put": {
                    "implementation": [
                        { "inputMap": { "schemaId": { "$str": ["#.input.entityType", "/", "#.input.key", "/schema"] }, "value": "#.input.input.value" }, "invoke": "ajv", "operation": "assert" },
                        { "set": { "command": "put", "value": { "$func/replace-body-versions": { "timeline": "#.input.value", "configuration": "#.input.configuration", "body": "#.input.input.value" } } } }
                    ]
                },
                "amend": {
                    "input": { "$data#&": ["@trait-operation-input", { "!input": "@body-amend-input" }] },
                    "output": "@trait-command",
                    "implementation": [
                        {
                            "outputKey": "body",
                            "set": { "$func/amended-body": { "timeline": "#.input.value", "configuration": "#.input.configuration", "validFrom": "#.input.input.validFrom", "patch": "#.input.input.patch" } }
                        },
                        { "inputMap": { "schemaId": { "$str": ["#.input.entityType", "/", "#.input.key", "/schema"] }, "value": "#.body" }, "invoke": "ajv", "operation": "assert" },
                        {
                            "set": { "command": "amend", "value": { "$func/append-body-version": { "timeline": "#.input.value", "validFrom": "#.input.input.validFrom", "body": "#.body" } } }
                        }
                    ]
                },
                "remove": {
                    "input": { "$data#&": ["@trait-operation-input", { "!input": "@body-remove-input" }] },
                    "output": "@trait-command",
                    "implementation": { "set": { "command": "remove", "value": { "$func/remove-body-version": { "timeline": "#.input.value", "validFrom": "#.input.input.validFrom" } } } }
                }
            }
        }
    },
    {
        "id": "body",
        "kind": "plain-body-trait",
        "data": { "cardinality": "one", "configuration": { "!schema": "@schema" } }
    },
    {
        "id": "versioned-body",
        "kind": "versioned-body-trait",
        "data": {
            "cardinality": "one",
            "key": "body",
            "configuration": { "!schema": "@schema", "!versioned": { "!validFrom": "string:^(/([^/~]|~[01])*)+$" } },
            "view": { "$func/body-at": { "timeline": "#.value", "at": "#.at" } }
        }
    },
    {
        "id": "entity-body-writer",
        "kind": "kind",
        "data": {
            "lifecycle": {
                "load": {
                    "inputMap": { "$func/body-schemas": null },
                    "forEach": { "inputMap": "#.item", "invoke": "ajv", "operation": "add" }
                }
            }
        }
    },
    {
        "id": "entity-bodies",
        "kind": "entity-body-writer",
        "data": {}
    }
]
