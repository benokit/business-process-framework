[
    {
        "id": "trait-container",
        "kind": "kind",
        "data": {
            "context": { "manages": { "trait": { "!entityType": "string", "!businessKey": "string", "!key": "string", "caller": "object" } } },
            "shape": { "traits{}": "@entity-trait-entry" },
            "slots": {
                "traits": { "cardinality": "many", "value": "@entity-trait-use" }
            },
            "operations": {
                "guardTraits": {
                    "private": true,
                    "input": { "!change": "@entity-change" },
                    "implementation": [
                        { "outputKey": "change", "set": { "$func/viewed-change": { "change": "#.input.change", "entityType": "#.self.id" } } },
                        {
                            "inputMap": { "$func/entity-hooked-keys": { "entityType": "#.self.id", "operation": "guard" } },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                {
                                    "withContext": { "trait": { "entityType": "#.self.id", "businessKey": { "$coalesce": ["#.change.before.businessKey", "#.change.after.businessKey"] }, "key": "#.item", "caller": "#._ctx.trait" } },
                                    "do": {
                                        "inputMap": { "entityType": "#.self.id", "key": "#.item", "configuration": "#.use.configuration", "change": "#.change" },
                                        "invoke": "#.use.trait",
                                        "operation": "guard"
                                    }
                                }
                            ]
                        }
                    ]
                },
                "reactTraits": {
                    "private": true,
                    "input": { "!change": "@entity-change" },
                    "implementation": [
                        { "outputKey": "change", "set": { "$func/viewed-change": { "change": "#.input.change", "entityType": "#.self.id" } } },
                        {
                            "inputMap": { "$func/entity-hooked-keys": { "entityType": "#.self.id", "operation": "react" } },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                {
                                    "withContext": { "trait": { "entityType": "#.self.id", "businessKey": { "$coalesce": ["#.change.before.businessKey", "#.change.after.businessKey"] }, "key": "#.item", "caller": "#._ctx.trait" } },
                                    "do": {
                                        "inputMap": { "entityType": "#.self.id", "key": "#.item", "configuration": "#.use.configuration", "change": "#.change" },
                                        "invoke": "#.use.trait",
                                        "operation": "react"
                                    }
                                }
                            ]
                        } 
                    ]
                },
                "deliver": {
                    "input": { "!businessKey": "string", "!trait": "string", "!message": "string", "input": "@any" },
                    "output": "@viewed-entity-record",
                    "implementation": [
                        {
                            "if": { "$negate": "#._ctx.trait" },
                            "then": { "throw": { "code": "forbidden", "message": "a message is delivered by a trait" } }
                        },
                        { "outputKey": "sender", "set": "#._ctx.trait" },
                        {
                            "if": { "$negate": { "$includes": { "collection": { "$func/entity-hooked-keys": { "entityType": "#.self.id", "operation": "receive" } }, "value": "#.input.trait" } } },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.self.id", " has no trait ", "#.input.trait", " that receives messages"] } } }
                        },
                        { "outputKey": "record", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.input.trait" } } },
                        {
                            "outputKey": "operations",
                            "withContext": { "trait": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "key": "#.input.trait", "caller": "#._ctx.trait" } },
                            "do": {
                                "inputMap": {
                                    "entityType": "#.self.id",
                                    "key": "#.input.trait",
                                    "configuration": "#.use.configuration",
                                    "sender": "#.sender",
                                    "message": "#.input.message",
                                    "input": "#.input.input",
                                    "record": "#.record"
                                },
                                "invoke": "#.use.trait",
                                "operation": "receive"
                            }
                        },
                        {
                            "if": { "$gt": [{ "$count": { "collection": { "$coalesce": ["#.operations", { "$literal": [] }] } } }, 0] },
                            "then": {
                                "inputMap": {
                                    "businessKey": "#.input.businessKey",
                                    "revision": "#.record.revision",
                                    "entityOperation": { "$str": ["#.input.trait", "/", "#.input.message"] },
                                    "operations": "#.operations",
                                    "origin": { "sender": "#.sender", "trait": "#.input.trait", "message": "#.input.message" }
                                },
                                "invoke": "#.self.id",
                                "operation": "applyTraitOperations"
                            },
                            "else": { "set": { "$func/viewed-record": { "record": "#.record", "entityType": "#.self.id" } } }
                        }
                    ]
                },
                "enter": {
                    "input": { "!businessKey": "string", "!trait": "string", "!entry": "string", "input": "@any" },
                    "output": "@any",
                    "implementation": {
                        "inTransaction": [
                            {
                                "if": { "$negate": { "$includes": { "collection": { "$func/entity-trait-entries": { "entityType": "#.self.id", "key": "#.input.trait" } }, "value": "#.input.entry" } } },
                                "then": { "throw": { "code": "invalid", "message": { "$str": ["#.self.id", " has no trait ", "#.input.trait", " with the entry ", "#.input.entry"] } } }
                            },
                            { "outputKey": "stored", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "load" },
                            { "outputKey": "record", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                            {
                                "inputMap": { "change": { "operation": "trait", "entityOperation": { "$str": ["#.input.trait", "/", "#.input.entry"] }, "commands": { "$literal": [] }, "before": "#.stored" } },
                                "invoke": "#.self.id",
                                "operation": "guardTraits"
                            },
                            { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.input.trait" } } },
                            {
                                "withContext": { "trait": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "key": "#.input.trait", "caller": "#._ctx.trait" } },
                                "do": {
                                    "inputMap": {
                                        "entityType": "#.self.id",
                                        "key": "#.input.trait",
                                        "configuration": "#.use.configuration",
                                        "businessKey": "#.input.businessKey",
                                        "input": "#.input.input",
                                        "record": "#.record"
                                    },
                                    "invoke": "#.use.trait",
                                    "operation": "#.input.entry"
                                }
                            }
                        ]
                    }
                },
                "previewOperations": {
                    "input": { "!businessKey": "string", "!operations[]": { "!key": "string", "!operation": "string", "input": "@any" } },
                    "output": "[@any]",
                    "implementation": [
                        {
                            "if": { "$negate": "#._ctx.trait" },
                            "then": { "throw": { "code": "forbidden", "message": "the commands of operations are previewed by a trait" } }
                        },
                        { "outputKey": "stored", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "load" },
                            { "outputKey": "record", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "load" },
                        { "inputMap": { "data": "#.record.data", "operations": "#.input.operations" }, "invoke": "#.self.id", "operation": "traitCommands" }
                    ]
                },
                "initialTraitValues": {
                    "input": { "!traits": "object", "create": "@any" },
                    "output": "object",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "outputKey": "values",
                            "inputMap": { "$func/entity-valued-keys": "#.self.id" },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                {
                                    "outputKey": "value",
                                    "inputMap": {
                                        "entityType": "#.self.id",
                                        "key": "#.item",
                                        "configuration": "#.use.configuration",
                                        "input": { "$get": { "object": "#.input.traits", "path": "#.item" } },
                                        "create": "#.input.create"
                                    },
                                    "invoke": "#.use.trait",
                                    "operation": "initialize"
                                },
                                { "set": { "key": "#.item", "value": "#.value" } }
                            ]
                        },
                        { "set": { "$mapValues": { "of": { "$toDictionary": { "by": "#.key", "collection": "#.values" } }, "fn": "#.value" } } }
                    ]
                },
                "deriveData": {
                    "private": true,
                    "input": { "!businessKey": "string", "!data": "object" },
                    "output": "@derived-data",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "inputMap": { "businessKey": "#.input.businessKey", "data": "#.input.data", "keys": { "$keys": "#.traits" } },
                            "invoke": "#.self.id",
                            "operation": "deriveFrom"
                        }
                    ]
                },
                "deriveFrom": {
                    "private": true,
                    "input": { "!businessKey": "string", "!data": "object", "!keys[]": "string" },
                    "output": "@derived-data",
                    "implementation": {
                        "if": { "$eq": [{ "$count": { "collection": "#.input.keys" } }, 0] },
                        "then": { "set": { "data": "#.input.data", "commands": [] } },
                        "else": [
                            { "outputKey": "key", "set": { "$head": "#.input.keys" } },
                            { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                            { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.key" } } },
                            {
                                "outputKey": "derivation",
                                "if": { "$func/has-operation": { "element": "#.use.trait", "operation": "derive" } },
                                "then": {
                                    "inputMap": {
                                        "entityType": "#.self.id",
                                        "key": "#.key",
                                        "configuration": "#.use.configuration",
                                        "record": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "data": "#.input.data" }
                                    },
                                    "invoke": "#.use.trait",
                                    "operation": "derive"
                                }
                            },
                            { "outputKey": "ownCommand", "set": { "$if": ["#.derivation", [{ "key": "#.key", "command": "#.derivation.command", "value": "#.derivation.value" }], []] } },
                            {
                                "outputKey": "followed",
                                "inputMap": {
                                    "data": { "$func/data-with-commands": { "data": "#.input.data", "commands": "#.ownCommand" } },
                                    "operations": { "$coalesce": ["#.derivation.operations", []] }
                                },
                                "invoke": "#.self.id",
                                "operation": "traitCommands"
                            },
                            { "outputKey": "own", "set": { "$concat": ["#.ownCommand", "#.followed"] } },
                            {
                                "outputKey": "rest",
                                "inputMap": {
                                    "businessKey": "#.input.businessKey",
                                    "data": { "$func/data-with-commands": { "data": "#.input.data", "commands": "#.own" } },
                                    "keys": { "$tail": "#.input.keys" }
                                },
                                "invoke": "#.self.id",
                                "operation": "deriveFrom"
                            },
                            { "set": { "data": "#.rest.data", "commands": { "$concat": ["#.own", "#.rest.commands"] } } }
                        ]
                    }
                }
            }
        }
    }
]
