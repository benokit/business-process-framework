[
    {
        "id": "trait-container",
        "kind": "kind",
        "data": {
            "shape": { "traits{}": "@entity-trait-entry" },
            "settings": { "shape": { "!maxDerivationSteps": "integer" }, "defaults": { "maxDerivationSteps": 100 } },
            "slots": {
                "traits": { "cardinality": "many", "value": "@entity-trait-use" }
            },
            "operations": {
                "guardTraits": {
                    "private": true,
                    "input": { "!change": "@entity-change" },
                    "implementation": [
                        { "outputKey": "change", "set": { "$func/viewed-change": { "change": "#.input.change", "entityType": "#.self.id" } } },
                        {
                            "outputKey": "hooks",
                            "set": { "$func/instance-methods": { "kind": "entity-trait", "property": "guard" } }
                        },
                        {
                            "inputMap": { "$keys": { "$func/entity-traits": "#.self.id" } },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                { "outputKey": "hook", "set": { "$find": { "collection": "#.hooks", "predicate": { "$eq": ["@candidate.id", "#.use.trait"] }, "as": "candidate" } } },
                                {
                                    "if": "#.hook",
                                    "then": {
                                        "inputMap": { "entityType": "#.self.id", "key": "#.item", "configuration": "#.use.configuration", "change": "#.change" },
                                        "execute": "#.hook.method"
                                    }
                                }
                            ]
                        }
                    ]
                },
                "reactTraits": {
                    "private": true,
                    "input": { "!change": "@viewed-entity-change" },
                    "implementation": [
                        {
                            "outputKey": "hooks",
                            "set": { "$func/instance-methods": { "kind": "entity-trait", "property": "react" } }
                        },
                        {
                            "inputMap": { "$keys": { "$func/entity-traits": "#.self.id" } },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                { "outputKey": "hook", "set": { "$find": { "collection": "#.hooks", "predicate": { "$eq": ["@candidate.id", "#.use.trait"] }, "as": "candidate" } } },
                                {
                                    "if": "#.hook",
                                    "then": {
                                        "inputMap": { "entityType": "#.self.id", "key": "#.item", "configuration": "#.use.configuration", "change": "#.input.change" },
                                        "execute": "#.hook.method"
                                    }
                                }
                            ]
                        }
                    ]
                },
                "initialTraitValues": {
                    "input": { "!traits": "object", "create": "@any" },
                    "output": "object",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "outputKey": "values",
                            "inputMap": { "$func/entity-valued-keys": "#.self.id" },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                {
                                    "outputKey": "value",
                                    "inputMap": {
                                        "entityType": "#.self.id",
                                        "key": "#.item",
                                        "configuration": "#.use.configuration",
                                        "input": { "$get": { "object": "#.input.traits", "path": "#.item" } },
                                        "create": "#.input.create"
                                    },
                                    "invoke": "#.use.trait",
                                    "operation": "initialize"
                                },
                                { "set": { "key": "#.item", "value": "#.value" } }
                            ]
                        },
                        { "set": { "$mapValues": { "of": { "$toDictionary": { "by": "#.key", "collection": "#.values" } }, "fn": "#.value" } } }
                    ]
                },
                "deriveData": {
                    "private": true,
                    "input": { "!businessKey": "string", "!data": "object" },
                    "output": "@derived-data",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "data": "#.input.data", "queue": [], "commands": [], "command": null, "steps": 0 },
                        "invoke": "#.self.id",
                        "operation": "deriveFrom"
                    }
                },
                "deriveFrom": {
                    "private": true,
                    "input": { "!businessKey": "string", "!data": "object", "!queue[]": "@trait-operation-use", "!commands[]": "@any", "command": "@any", "!steps": "integer" },
                    "output": "@derived-data",
                    "implementation": [
                        { "outputKey": "limit", "set": { "$get": { "object": { "$func/settings": "#.self.id" }, "path": "maxDerivationSteps" } } },
                        {
                            "if": { "$gt": ["#.input.steps", "#.limit"] },
                            "then": {
                                "throw": {
                                    "code": "derivation-limit",
                                    "message": { "$str": ["the derivation of ", "#.self.id", " '", "#.input.businessKey", "' needs more than ", "#.limit", " steps"] },
                                    "data": { "commands": "#.input.commands" }
                                }
                            }
                        },
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        { "outputKey": "hooks", "set": { "$func/instance-methods": { "kind": "entity-trait", "property": "derive" } } },
                        {
                            "outputKey": "requests",
                            "inputMap": { "$keys": "#.traits" },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                { "outputKey": "hook", "set": { "$find": { "collection": "#.hooks", "predicate": { "$eq": ["@candidate.id", "#.use.trait"] }, "as": "candidate" } } },
                                {
                                    "outputKey": "operations",
                                    "if": "#.hook",
                                    "then": {
                                        "inputMap": {
                                            "entityType": "#.self.id",
                                            "key": "#.item",
                                            "configuration": "#.use.configuration",
                                            "record": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "data": "#.input.data" },
                                            "command": "#.input.command"
                                        },
                                        "execute": "#.hook.method"
                                    }
                                },
                                { "set": { "$coalesce": ["#.operations", []] } }
                            ]
                        },
                        { "outputKey": "queue", "set": { "$concat": ["#.input.queue", { "$concat": "#.requests" }] } },
                        {
                            "if": { "$eq": [{ "$count": { "collection": "#.queue" } }, 0] },
                            "then": { "set": { "data": "#.input.data", "commands": "#.input.commands" } },
                            "else": [
                                { "outputKey": "executed", "inputMap": { "data": "#.input.data", "operations": [{ "$head": "#.queue" }] }, "invoke": "#.self.id", "operation": "traitCommands" },
                                {
                                    "inputMap": {
                                        "businessKey": "#.input.businessKey",
                                        "data": { "$func/data-with-commands": { "data": "#.input.data", "commands": "#.executed" } },
                                        "queue": { "$tail": "#.queue" },
                                        "commands": { "$concat": ["#.input.commands", "#.executed"] },
                                        "command": { "$head": "#.executed" },
                                        "steps": { "$sum": ["#.input.steps", 1] }
                                    },
                                    "invoke": "#.self.id",
                                    "operation": "deriveFrom"
                                }
                            ]
                        }
                    ]
                }
            }
        }
    }
]
