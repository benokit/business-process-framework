[
    {
        "id": "trait-container",
        "kind": "kind",
        "data": {
            "shape": { "traits{}": "@entity-trait-entry" },
            "settings": { "shape": { "!maxDerivationSteps": "integer" }, "defaults": { "maxDerivationSteps": 100 } },
            "slots": {
                "traits": { "cardinality": "many", "value": "@entity-trait-use" }
            },
            "operations": {
                "runTraitGuards": {
                    "private": true,
                    "input": { "!change": "@entity-change" },
                    "implementation": [
                        { "outputKey": "change", "set": { "$func/viewed-change": { "change": "#.input.change", "entityType": "#.self.id" } } },
                        {
                            "outputKey": "hooks",
                            "set": { "$func/instance-methods": { "kind": "entity-trait", "property": "guard" } }
                        },
                        {
                            "inputMap": { "$keys": { "$func/entity-traits": "#.self.id" } },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                { "outputKey": "hook", "set": { "$find": { "collection": "#.hooks", "predicate": { "$eq": ["@candidate.id", "#.use.trait"] }, "as": "candidate" } } },
                                {
                                    "if": "#.hook",
                                    "then": {
                                        "inputMap": { "entityType": "#.self.id", "key": "#.item", "configuration": "#.use.configuration", "change": "#.change" },
                                        "execute": "#.hook.method"
                                    }
                                }
                            ]
                        }
                    ]
                },
                "runTraitReactions": {
                    "private": true,
                    "input": { "!change": "@viewed-entity-change" },
                    "implementation": [
                        {
                            "outputKey": "hooks",
                            "set": { "$func/instance-methods": { "kind": "entity-trait", "property": "react" } }
                        },
                        {
                            "inputMap": { "$keys": { "$func/entity-traits": "#.self.id" } },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                { "outputKey": "hook", "set": { "$find": { "collection": "#.hooks", "predicate": { "$eq": ["@candidate.id", "#.use.trait"] }, "as": "candidate" } } },
                                {
                                    "if": "#.hook",
                                    "then": {
                                        "inputMap": { "entityType": "#.self.id", "key": "#.item", "configuration": "#.use.configuration", "change": "#.input.change" },
                                        "execute": "#.hook.method"
                                    }
                                }
                            ]
                        }
                    ]
                },
                "initialValuesOfTraits": {
                    "input": { "!traits": "object", "create": "@any" },
                    "output": "object",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "outputKey": "values",
                            "inputMap": { "$func/entity-valued-keys": "#.self.id" },
                            "forEach": [
                                { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.item" } } },
                                {
                                    "outputKey": "value",
                                    "inputMap": {
                                        "entityType": "#.self.id",
                                        "key": "#.item",
                                        "configuration": "#.use.configuration",
                                        "input": { "$get": { "object": "#.input.traits", "path": "#.item" } },
                                        "create": "#.input.create"
                                    },
                                    "invoke": "#.use.trait",
                                    "operation": "initialize"
                                },
                                { "set": { "key": "#.item", "value": "#.value" } }
                            ]
                        },
                        { "set": { "$mapValues": { "of": { "$toDictionary": { "by": "#.key", "collection": "#.values" } }, "fn": "#.value" } } }
                    ]
                },
                "deriveTraitValues": {
                    "private": true,
                    "input": { "!businessKey": "string", "!data": "object", "seeds[]": "@any" },
                    "output": "@derived-data",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "outputKey": "dirty",
                            "set": {
                                "$filter": {
                                    "collection": { "$keys": "#.traits" },
                                    "as": "key",
                                    "predicate": {
                                        "$or": [
                                            { "$isNil": "#.input.seeds" },
                                            { "$eq": [{ "$count": { "collection": { "$coalesce": [{ "$get": { "object": "#.traits", "path": { "$str": ["@key", ".dependsOn"] } } }, []] } } }, 0] },
                                            {
                                                "$any": {
                                                    "collection": { "$coalesce": [{ "$get": { "object": "#.traits", "path": { "$str": ["@key", ".dependsOn"] } } }, []] },
                                                    "as": "dependency",
                                                    "predicate": { "$any": { "collection": "#.input.seeds", "as": "seed", "predicate": { "$eq": ["@seed.key", "@dependency"] } } }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        },
                        {
                            "inputMap": { "businessKey": "#.input.businessKey", "data": "#.input.data", "queue": [], "dirty": "#.dirty", "commands": [], "command": null, "steps": 0 },
                            "invoke": "#.self.id",
                            "operation": "continueDerivation"
                        }
                    ]
                },
                "continueDerivation": {
                    "private": true,
                    "input": { "!businessKey": "string", "!data": "object", "!queue[]": "@trait-operation-use", "!dirty[]": "string", "!commands[]": "@any", "command": "@any", "!steps": "integer" },
                    "output": "@derived-data",
                    "implementation": [
                        { "outputKey": "limit", "set": { "$get": { "object": { "$func/settings": "#.self.id" }, "path": "maxDerivationSteps" } } },
                        {
                            "if": { "$gt": ["#.input.steps", "#.limit"] },
                            "then": {
                                "throw": {
                                    "code": "derivation-limit",
                                    "message": { "$str": ["the derivation of ", "#.self.id", " '", "#.input.businessKey", "' needs more than ", "#.limit", " steps"] },
                                    "data": { "commands": "#.input.commands" }
                                }
                            }
                        },
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "if": { "$gt": [{ "$count": { "collection": "#.input.queue" } }, 0] },
                            "then": [
                                { "outputKey": "executed", "inputMap": { "data": "#.input.data", "operations": [{ "$head": "#.input.queue" }] }, "invoke": "#.self.id", "operation": "commandsOfTraitOperations" },
                                { "outputKey": "changed", "set": { "$get": { "object": { "$head": "#.executed" }, "path": "key" } } },
                                {
                                    "inputMap": {
                                        "businessKey": "#.input.businessKey",
                                        "data": { "$func/data-with-commands": { "data": "#.input.data", "commands": "#.executed" } },
                                        "queue": { "$tail": "#.input.queue" },
                                        "dirty": {
                                            "$filter": {
                                                "collection": { "$keys": "#.traits" },
                                                "as": "key",
                                                "predicate": {
                                                    "$or": [
                                                        { "$includes": { "collection": "#.input.dirty", "value": "@key" } },
                                                        {
                                                            "$includes": {
                                                                "collection": { "$coalesce": [{ "$get": { "object": "#.traits", "path": { "$str": ["@key", ".dependsOn"] } } }, []] },
                                                                "value": "#.changed"
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        },
                                        "commands": { "$concat": ["#.input.commands", "#.executed"] },
                                        "command": { "$head": "#.executed" },
                                        "steps": { "$sum": ["#.input.steps", 1] }
                                    },
                                    "invoke": "#.self.id",
                                    "operation": "continueDerivation"
                                }
                            ],
                            "else": {
                                "if": { "$eq": [{ "$count": { "collection": "#.input.dirty" } }, 0] },
                                "then": { "set": { "data": "#.input.data", "commands": "#.input.commands" } },
                                "else": [
                                    { "outputKey": "key", "set": { "$head": "#.input.dirty" } },
                                    { "outputKey": "use", "set": { "$func/entity-trait-use-of": { "entityType": "#.self.id", "key": "#.key" } } },
                                    { "outputKey": "hooks", "set": { "$func/instance-methods": { "kind": "entity-trait", "property": "derive" } } },
                                    { "outputKey": "hook", "set": { "$find": { "collection": "#.hooks", "predicate": { "$eq": ["@candidate.id", "#.use.trait"] }, "as": "candidate" } } },
                                    {
                                        "outputKey": "operations",
                                        "if": "#.hook",
                                        "then": {
                                            "inputMap": {
                                                "entityType": "#.self.id",
                                                "key": "#.key",
                                                "configuration": "#.use.configuration",
                                                "record": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "data": "#.input.data" },
                                                "command": "#.input.command"
                                            },
                                            "execute": "#.hook.method"
                                        }
                                    },
                                    {
                                        "inputMap": {
                                            "businessKey": "#.input.businessKey",
                                            "data": "#.input.data",
                                            "queue": { "$coalesce": ["#.operations", []] },
                                            "dirty": { "$tail": "#.input.dirty" },
                                            "commands": "#.input.commands",
                                            "command": "#.input.command",
                                            "steps": "#.input.steps"
                                        },
                                        "invoke": "#.self.id",
                                        "operation": "continueDerivation"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        }
    }
]
