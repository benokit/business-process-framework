[
    {
        "id": "entity-key",
        "kind": "schema",
        "data": { "!entityType": "string", "!businessKey": "string:^.+$", "revision": "number" }
    },
    {
        "id": "entity-create-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!businessKey": "string:^.+$", "!data": "object" }
    },
    {
        "id": "entity-update-input",
        "kind": "schema",
        "data": { "!before": "@entity-record", "!values": "object" }
    },
    {
        "id": "entity-delete-input",
        "kind": "schema",
        "data": { "!before": "@entity-record" }
    },
    {
        "id": "create-entity",
        "kind": "query",
        "data": {
            "input": "@entity-create-input",
            "output": "@entity-record",
            "errors": ["conflict"]
        }
    },
    {
        "id": "read-entity",
        "kind": "query",
        "data": { "input": "@entity-key", "output": "@entity-record", "errors": ["not-found"] }
    },
    {
        "id": "update-entity",
        "kind": "query",
        "data": { "input": "@entity-update-input", "output": "@entity-record", "errors": ["conflict"] }
    },
    {
        "id": "delete-entity",
        "kind": "query",
        "data": { "input": "@entity-delete-input", "output": "@entity-record", "errors": ["conflict"] }
    },
    {
        "id": "list-entities",
        "kind": "query",
        "data": {
            "input": { "!entityType": "string", "limit": "number", "offset": "number" },
            "output": { "!items[]": "@entity-record", "!total": "number" }
        }
    },
    {
        "id": "entity-store",
        "kind": "kind",
        "data": {
            "operations": {
                "create": { "input": "@entity-create-input", "output": "@entity-record", "implementation": { "invoke": "create-entity", "operation": "run" } },
                "read": { "input": "@entity-key", "output": "@entity-record", "implementation": { "invoke": "read-entity", "operation": "run" } },
                "update": { "input": "@entity-update-input", "output": "@entity-record", "implementation": { "invoke": "update-entity", "operation": "run" } },
                "delete": { "input": "@entity-delete-input", "output": "@entity-record", "implementation": { "invoke": "delete-entity", "operation": "run" } }
            }
        }
    },
    {
        "id": "entity-database",
        "kind": "entity-store",
        "data": {}
    }
]
