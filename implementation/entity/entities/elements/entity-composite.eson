[
    {
        "id": "composite-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "lifecycle": {
                "validate": { "$func/entity-trait-problems": "#.self.id" }
            },
            "operations": {
                "initialize": {
                    "implementation": {
                        "inputMap": { "traits": { "$coalesce": ["#.input.input", {}] }, "create": "#.input.create", "entityType": "#.input.entityType" },
                        "invoke": "#.self.id",
                        "operation": "initialTraitValues"
                    }
                },
                "derive": {
                    "input": "@trait-derive-input",
                    "output": "@trait-derivation",
                    "implementation": [
                        {
                            "outputKey": "derivation",
                            "inputMap": {
                                "businessKey": "#.input.record.businessKey",
                                "data": { "$coalesce": [{ "$get": { "object": "#.input.record.data", "path": "#.input.key" } }, {}] },
                                "entityType": "#.input.entityType"
                            },
                            "invoke": "#.self.id",
                            "operation": "deriveData"
                        },
                        {
                            "if": { "$eq": [{ "$count": { "collection": "#.derivation.commands" } }, 0] },
                            "then": { "set": null },
                            "else": { "set": { "command": "derive", "value": "#.derivation.data" } }
                        }
                    ]
                },
                "guard": {
                    "input": "@trait-hook-input",
                    "implementation": {
                        "inputMap": { "change": { "$func/scoped-change": { "change": "#.input.change", "key": "#.input.key" } }, "entityType": "#.input.entityType" },
                        "invoke": "#.self.id",
                        "operation": "guardTraits"
                    }
                },
                "react": {
                    "input": "@trait-hook-input",
                    "implementation": {
                        "inputMap": { "change": { "$func/scoped-change": { "change": "#.input.change", "key": "#.input.key" } }, "entityType": "#.input.entityType" },
                        "invoke": "#.self.id",
                        "operation": "reactTraits"
                    }
                }
            }
        }
    },
    {
        "id": "scoped-change",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!change": "@any", "!key": "string" }, "output": "@any" },
            "module": "@business-framework/entities/traits",
            "export": "scopedChange"
        }
    }
]
