[
    {
        "id": "trait-operation-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "value": "@any", "input": "@any" }
    },
    {
        "id": "entity-revision-input",
        "kind": "schema",
        "data": { "!businessKey": "string", "!revision": "number" }
    },
    {
        "id": "trait-hook-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "!change": "@viewed-entity-change" }
    },
    {
        "id": "trait-message-input",
        "kind": "schema",
        "data": {
            "!entityType": "string",
            "!key": "string",
            "!configuration": "@any",
            "!sender": { "!entityType": "string", "!businessKey": "string", "!key": "string" },
            "!message": "string",
            "input": "@any",
            "!record": "@entity-record"
        }
    },
    {
        "id": "trait-entry-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "!businessKey": "string", "input": "@any", "!record": "@entity-record" }
    },
    {
        "id": "trait-message-reply",
        "kind": "schema",
        "data": { "$data#": ["[@trait-message-operation]", "null"] }
    },
    {
        "id": "trait-message-operation",
        "kind": "schema",
        "data": { "!key": "string", "!operation": "string", "input": "@any" }
    },
    {
        "id": "trait-command",
        "kind": "schema",
        "data": { "!command": "string", "!value": "@any" }
    },
    {
        "id": "trait-derive-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "!record": { "!entityType": "string", "!businessKey": "string", "!data": "object" } }
    },
    {
        "id": "trait-derivation",
        "kind": "schema",
        "data": { "$data#": [{ "$data#&": ["@trait-command", { "operations[]": { "!key": "string", "!operation": "string", "input": "@any" } }] }, "null"] }
    },
    {
        "id": "trait-operation",
        "kind": "execution-node-template",
        "data": {
            "keyword": "traitOperation",
            "within": "entity-type",
            "node": { "!traitOperation": { "!key": "@mapping", "!operation": "string" } },
            "implementation": [
                { "outputKey": "key", "set": { "$func/apply-mapping": { "mapping": "#.node.traitOperation.key", "input": "#" } } },
                {
                    "inputMap": {
                        "businessKey": "#.input.businessKey",
                        "revision": "#.input.revision",
                        "entityOperation": "#.operation",
                        "operations": [{ "key": "#.key", "operation": "#.node.traitOperation.operation", "input": "#.input.input" }]
                    },
                    "invoke": "#.self.id",
                    "operation": "applyTraitOperations"
                }
            ]
        }
    },
    {
        "id": "trait-operations",
        "kind": "execution-node-template",
        "data": {
            "keyword": "traitOperations",
            "within": "entity-type",
            "node": { "!traitOperations[]": { "!key": "@mapping", "!operation": "string", "!input": "@mapping" } },
            "implementation": [
                {
                    "outputKey": "operations",
                    "set": {
                        "$map": {
                            "over": "#.node.traitOperations",
                            "as": "use",
                            "fn": {
                                "key": { "$func/apply-mapping": { "mapping": "@use.key", "input": "#" } },
                                "operation": "@use.operation",
                                "input": { "$func/apply-mapping": { "mapping": "@use.input", "input": "#" } }
                            }
                        }
                    }
                },
                {
                    "inputMap": {
                        "businessKey": "#.input.businessKey",
                        "revision": "#.input.revision",
                        "entityOperation": "#.operation",
                        "operations": "#.operations"
                    },
                    "invoke": "#.self.id",
                    "operation": "applyTraitOperations"
                }
            ]
        }
    },
    {
        "id": "exposed-trait-operation",
        "kind": "execution-node-template",
        "data": {
            "keyword": "exposes",
            "within": "entity-type",
            "node": { "!exposes": { "!key": "string", "!operation": "string" } },
            "implementation": {
                "inputMap": {
                    "businessKey": "#.input.businessKey",
                    "revision": "#.input.revision",
                    "entityOperation": "#.operation",
                    "operations": [{
                        "key": "#.node.exposes.key",
                        "operation": "#.node.exposes.operation",
                        "input": { "$omit": { "keys": ["businessKey", "revision"], "object": "#.input" } }
                    }]
                },
                "invoke": "#.self.id",
                "operation": "applyTraitOperations"
            }
        }
    },
    {
        "id": "trait-message-bus",
        "kind": "kind",
        "data": {
            "operations": {
                "enter": {
                    "input": { "!entityType": "@ref/trait-container", "!businessKey": "string", "!trait": "string", "!entry": "string", "input": "@any" },
                    "output": "@any",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "trait": "#.input.trait", "entry": "#.input.entry", "input": "#.input.input" },
                        "invoke": "#.input.entityType",
                        "operation": "enter"
                    }
                },
                "previewOperations": {
                    "input": { "!entityType": "@ref/trait-container", "!businessKey": "string", "!operations[]": "@trait-message-operation" },
                    "output": "[@any]",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "operations": "#.input.operations" },
                        "invoke": "#.input.entityType",
                        "operation": "previewOperations"
                    }
                },
                "deliver": {
                    "input": { "!entityType": "@ref/trait-container", "!businessKey": "string", "!trait": "string", "!message": "string", "input": "@any" },
                    "output": "@viewed-entity-record",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "trait": "#.input.trait", "message": "#.input.message", "input": "#.input.input" },
                        "invoke": "#.input.entityType",
                        "operation": "deliver"
                    }
                }
            }
        }
    },
    { "id": "trait-messages", "kind": "trait-message-bus", "data": {} },
    {
        "id": "deliver-message",
        "kind": "execution-node-template",
        "data": {
            "keyword": "deliver",
            "within": "entity-trait",
            "node": { "!deliver": { "!entityType": "@mapping", "!businessKey": "@mapping", "!trait": "@mapping", "!message": "@mapping", "input": "@mapping" } },
            "implementation": [
                {
                    "inputMap": {
                        "entityType": { "$func/apply-mapping": { "mapping": "#.node.deliver.entityType", "input": "#" } },
                        "businessKey": { "$func/apply-mapping": { "mapping": "#.node.deliver.businessKey", "input": "#" } },
                        "trait": { "$func/apply-mapping": { "mapping": "#.node.deliver.trait", "input": "#" } },
                        "message": { "$func/apply-mapping": { "mapping": "#.node.deliver.message", "input": "#" } },
                        "input": { "$func/apply-mapping": { "mapping": { "$coalesce": ["#.node.deliver.input", null] }, "input": "#" } }
                    },
                    "invoke": "trait-messages",
                    "operation": "deliver"
                }
            ]
        }
    }
]
