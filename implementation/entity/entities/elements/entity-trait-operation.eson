[
    {
        "id": "trait-operation-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "value": "@any", "input": "@any" }
    },
    {
        "id": "entity-revision-input",
        "kind": "schema",
        "data": { "!businessKey": "string", "!revision": "number" }
    },
    {
        "id": "trait-hook-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "!change": "@viewed-entity-change" }
    },
    {
        "id": "trait-process-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "!businessKey": "string", "input": "@any", "!record": "@entity-record" }
    },
    {
        "id": "trait-operation-use",
        "kind": "schema",
        "data": { "!key": "string", "!operation": "string", "input": "@any" }
    },
    {
        "id": "trait-command",
        "kind": "schema",
        "data": { "!command": "string", "!value": "@any" }
    },
    {
        "id": "trait-derive-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "!record": { "!entityType": "string", "!businessKey": "string", "!data": "object" } }
    },
    {
        "id": "trait-derivation",
        "kind": "schema",
        "data": { "$data#": [{ "$data#&": ["@trait-command", { "operations[]": { "!key": "string", "!operation": "string", "input": "@any" } }] }, "null"] }
    },
    {
        "id": "trait-operation",
        "kind": "execution-node-template",
        "data": {
            "keyword": "traitOperation",
            "within": "entity-type",
            "node": { "!traitOperation": { "!key": "@mapping", "!operation": "string" } },
            "implementation": [
                { "outputKey": "key", "set": { "$func/apply-mapping": { "mapping": "#.node.traitOperation.key", "input": "#" } } },
                {
                    "inputMap": {
                        "businessKey": "#.input.businessKey",
                        "revision": "#.input.revision",
                        "entityOperation": "#.operation",
                        "operations": [{ "key": "#.key", "operation": "#.node.traitOperation.operation", "input": "#.input.input" }]
                    },
                    "invoke": "#.self.id",
                    "operation": "applyTraitOperations"
                }
            ]
        }
    },
    {
        "id": "trait-operations",
        "kind": "execution-node-template",
        "data": {
            "keyword": "traitOperations",
            "within": "entity-type",
            "node": { "!traitOperations[]": { "!key": "@mapping", "!operation": "string", "!input": "@mapping" } },
            "implementation": [
                {
                    "outputKey": "operations",
                    "set": {
                        "$map": {
                            "over": "#.node.traitOperations",
                            "as": "use",
                            "fn": {
                                "key": { "$func/apply-mapping": { "mapping": "@use.key", "input": "#" } },
                                "operation": "@use.operation",
                                "input": { "$func/apply-mapping": { "mapping": "@use.input", "input": "#" } }
                            }
                        }
                    }
                },
                {
                    "inputMap": {
                        "businessKey": "#.input.businessKey",
                        "revision": "#.input.revision",
                        "entityOperation": "#.operation",
                        "operations": "#.operations"
                    },
                    "invoke": "#.self.id",
                    "operation": "applyTraitOperations"
                }
            ]
        }
    },
    {
        "id": "exposed-trait-operation",
        "kind": "execution-node-template",
        "data": {
            "keyword": "exposes",
            "within": "entity-type",
            "node": { "!exposes": { "!key": "string", "!operation": "string" } },
            "implementation": {
                "inputMap": {
                    "businessKey": "#.input.businessKey",
                    "revision": "#.input.revision",
                    "entityOperation": "#.operation",
                    "operations": [{
                        "key": "#.node.exposes.key",
                        "operation": "#.node.exposes.operation",
                        "input": { "$omit": { "keys": ["businessKey", "revision"], "object": "#.input" } }
                    }]
                },
                "invoke": "#.self.id",
                "operation": "applyTraitOperations"
            }
        }
    },
    {
        "id": "started-trait-process",
        "kind": "execution-node-template",
        "data": {
            "keyword": "starts",
            "within": "entity-type",
            "node": { "!starts": { "!key": "string", "!operation": "string" } },
            "implementation": {
                "inputMap": {
                    "businessKey": "#.input.businessKey",
                    "trait": "#.node.starts.key",
                    "process": "#.node.starts.operation",
                    "entityOperation": "#.operation",
                    "input": { "$omit": { "keys": ["businessKey"], "object": "#.input" } }
                },
                "invoke": "#.self.id",
                "operation": "enter"
            }
        }
    },
    {
        "id": "trait-write-bus",
        "kind": "kind",
        "data": {
            "operations": {
                "previewOperations": {
                    "input": { "!entityType": "@ref/trait-container", "!businessKey": "string", "!operations[]": "@trait-operation-use" },
                    "output": "[@any]",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "operations": "#.input.operations" },
                        "invoke": "#.input.entityType",
                        "operation": "previewOperations"
                    }
                },
                "write": {
                    "input": { "!entityType": "@ref/trait-container", "!businessKey": "string", "!entityOperation": "string", "!operations[]": "@trait-operation-use" },
                    "output": "@viewed-entity-record",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "entityOperation": "#.input.entityOperation", "operations": "#.input.operations" },
                        "invoke": "#.input.entityType",
                        "operation": "write"
                    }
                }
            }
        }
    },
    { "id": "trait-writes", "kind": "trait-write-bus", "data": {} },
    {
        "id": "write-by-trait",
        "kind": "execution-node-template",
        "data": {
            "keyword": "writes",
            "within": "entity-trait",
            "node": { "!writes": { "!entityType": "@mapping", "!businessKey": "@mapping", "!entityOperation": "@mapping", "!operations": "@mapping" } },
            "implementation": {
                "inputMap": {
                    "entityType": { "$func/apply-mapping": { "mapping": "#.node.writes.entityType", "input": "#" } },
                    "businessKey": { "$func/apply-mapping": { "mapping": "#.node.writes.businessKey", "input": "#" } },
                    "entityOperation": { "$func/apply-mapping": { "mapping": "#.node.writes.entityOperation", "input": "#" } },
                    "operations": { "$func/apply-mapping": { "mapping": "#.node.writes.operations", "input": "#" } }
                },
                "invoke": "trait-writes",
                "operation": "write"
            }
        }
    }
]
