[
    {
        "id": "trait-operation-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!key": "string", "!configuration": "@any", "value": "@any", "input": "@any" }
    },
    {
        "id": "trait-command",
        "kind": "schema",
        "data": { "!command": "string", "!value": "@any" }
    },
    {
        "id": "trait-operator",
        "kind": "kind",
        "data": {
            "operations": {
                "run": {
                    "input": { "!trait": "@ref/entity-trait", "!operation": "string", "!request": "@trait-operation-input" },
                    "output": "@trait-command",
                    "implementation": { "inputMap": "#.input.request", "invoke": "#.input.trait", "operation": "#.input.operation" }
                }
            }
        }
    },
    {
        "id": "entity-trait-operator",
        "kind": "trait-operator",
        "data": {}
    },
    {
        "id": "trait-operation",
        "kind": "execution-node-template",
        "data": {
            "keyword": "traitOperation",
            "within": "entity-type",
            "node": { "!traitOperation": { "!key": "@mapping", "!operation": "string" } },
            "implementation": [
                { "outputKey": "key", "set": { "$func/apply-mapping": { "mapping": "#.node.traitOperation.key", "input": "#" } } },
                {
                    "inputMap": {
                        "businessKey": "#.input.businessKey",
                        "revision": "#.input.revision",
                        "entityOperation": "#.operation",
                        "operations": [{ "key": "#.key", "operation": "#.node.traitOperation.operation", "input": "#.input.input" }]
                    },
                    "invoke": "#.self.id",
                    "operation": "applyTraitOperations"
                }
            ]
        }
    },
    {
        "id": "trait-operations",
        "kind": "execution-node-template",
        "data": {
            "keyword": "traitOperations",
            "within": "entity-type",
            "node": { "!traitOperations[]": { "!key": "@mapping", "!operation": "string", "!input": "@mapping" } },
            "implementation": [
                {
                    "outputKey": "operations",
                    "set": {
                        "$map": {
                            "over": "#.node.traitOperations",
                            "as": "use",
                            "fn": {
                                "key": { "$func/apply-mapping": { "mapping": "@use.key", "input": "#" } },
                                "operation": "@use.operation",
                                "input": { "$func/apply-mapping": { "mapping": "@use.input", "input": "#" } }
                            }
                        }
                    }
                },
                {
                    "inputMap": {
                        "businessKey": "#.input.businessKey",
                        "revision": "#.input.revision",
                        "entityOperation": "#.operation",
                        "operations": "#.operations"
                    },
                    "invoke": "#.self.id",
                    "operation": "applyTraitOperations"
                }
            ]
        }
    }
]
