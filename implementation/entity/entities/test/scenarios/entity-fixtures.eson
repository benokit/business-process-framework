                },
                "rewrite": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": {
                        "set": {
                            "command": "rewrite",
                            "value": "#.input.input.value"
                        }
                    }
                }
            }
        }
    },
    {
        "id": "counting-fixture",
        "kind": "counting-fixture-trait",
        "data": {
