        }
    },
    {"id": "order-fixture", "kind": "writing-fixture", "data": {"traits": {"body": {"configuration": {"schema": {"!amount": "number", "note": "string"}}}}}},
    {
        "id": "order-note-fixture",
        "kind": "slot-fill",
        "data": {
            "target": "order-fixture",
            "slot": "traits",
            "value": {
                "trait": "note-fixture",
                "configuration": {
                    "prefix": "order: "
                }
            }
        }
    },
    {
        "id": "positive-amount-fixture",
        "kind": "slot-fill",
        "data": {
            "target": "order-fixture",
            "slot": "requestGuards",
            "value": {
                "if": {
                    "$and": [
                        {
                            "$eq": [
                                "#.input.operation",
                                "create"
                            ]
                        },
                        {
                            "$lte": [
                                "#.input.after.data.body.amount",
                                0
                            ]
                        }
                    ]
                },
                "then": {
                    "throw": {
                        "code": "invalid",
                        "message": "amount must be positive"
                    }
                }
            }
        }
    },
    {
        "id": "hide-hidden-order-fixture",
        "kind": "slot-fill",
        "data": {
            "target": "order-fixture",
            "slot": "requestGuards",
            "value": {
                "if": {
                    "$eq": [
                        "#.input.before.businessKey",
                        "o-hidden"
                    ]
                },
                "then": {
                    "throw": {
                        "code": "not-found",
                        "message": "hidden"
                    }
                }
            },
            "on": [
                "read"
            ]
        }
    },
    {
        "id": "keep-kept-order-fixture",
        "kind": "slot-fill",
        "data": {
            "target": "order-fixture",
            "slot": "requestGuards",
            "value": {
                "if": {
                    "$eq": [
                        "#.input.before.businessKey",
                        "o-kept"
                    ]
                },
                "then": {
                    "throw": {
                        "code": "conflict",
                        "message": "kept"
                    }
                }
            },
            "on": [
                "delete"
            ]
        }
    },
    {
        "id": "refuse-derived-double-fixture",
        "kind": "slot-fill",
        "data": {
            "target": "reversed-fixture",
            "slot": "reactions",
            "value": {
                "if": {
                    "$any": {
