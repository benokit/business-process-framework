        }
    },
    {
        "id": "masked-fixture",
        "kind": "masked-fixture-trait",
        "data": {
            "configuration": {
                "!prefix": "string"
            },
            "view": {
                "$if": [
                    {
                        "$eq": [
                            "#.at",
                            "public"
                        ]
                    },
                    "***",
                    "#.value"
                ]
            }
        }
    },
    {
        "id": "masking-fixture",
        "kind": "entity-type",
        "data": {
            "traits": {
                "body": {
