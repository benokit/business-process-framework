    {
        "id": "note-fixture-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": {
                        "set": {
                            "$str": [
                                "#.input.configuration.prefix",
                                {
                                    "$coalesce": [
                                        "#.input.input",
                                        "new"
                                    ]
                                },
                                {
                                    "$coalesce": [
                                        "#.input.configuration.suffix",
                                        ""
                                    ]
                                }
                            ]
                        }
                    }
                },
                "rewrite": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": {
                        "set": {
                            "command": "rewrite",
                            "value": "#.input.input.value"
                        }
                    }
                }
            }
        }
    },
    {"id": "note-fixture", "kind": "note-fixture-trait", "data": {"configuration": {"!prefix": "string"}, "value": "string"}},
    {
        "id": "masked-fixture-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": {
                        "set": {
                            "$str": [
                                "#.input.configuration.prefix",
                                {
                                    "$coalesce": [
                                        "#.input.input",
                                        "new"
                                    ]
                                },
                                {
                                    "$coalesce": [
                                        "#.input.configuration.suffix",
                                        ""
                                    ]
                                }
                            ]
                        }
                    }
                },
                "rewrite": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": {
