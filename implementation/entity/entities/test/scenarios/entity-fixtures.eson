[
    {
        "id": "writing-fixture",
        "kind": "kind",
        "data": {
            "extends": "entity-type",
            "operations": {
                "writeTraits": {
                    "input": {
                        "!businessKey": "string",
                        "!revision": "number",
                        "!amount": "number",
                        "!note": "string"
                    },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision",
                            "amount": "#.input.amount",
                            "note": "#.input.note"
                        },
                        "traitOperations": [
                            {
                                "key": "body",
                                "operation": "update",
                                "input": {
                                    "value": {
                                        "amount": "#.input.amount"
                                    }
                                }
                            },
                            {
                                "key": "note-fixture",
                                "operation": "rewrite",
                                "input": {
                                    "value": "#.input.note"
                                }
                            }
                        ]
                    }
                },
                "writeTwice": {
                    "input": {
                        "!businessKey": "string",
                        "!revision": "number"
                    },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision"
                        },
                        "traitOperations": [
                            {
                                "key": "note-fixture",
                                "operation": "rewrite",
                                "input": {
                                    "value": "a"
                                }
                            },
                            {
                                "key": "note-fixture",
                                "operation": "rewrite",
                                "input": {
                                    "value": "b"
                                }
                            }
                        ]
                    }
                },
                "amend": {
                    "input": {
                        "!businessKey": "string",
                        "!revision": "number",
                        "!validFrom": "string",
                        "!ref": "string",
                        "!body": "object"
                    },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision",
                            "input": {
                                "validFrom": "#.input.validFrom",
                                "ref": "#.input.ref",
                                "body": "#.input.body"
                            }
                        },
                        "traitOperation": {
                            "key": "body",
                            "operation": "amend"
                        }
                    }
                },
                "unamend": {
                    "input": {
                        "!businessKey": "string",
                        "!revision": "number",
                        "!validFrom": "string",
                        "!ref": "string"
                    },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision",
                            "input": {
                                "validFrom": "#.input.validFrom",
                                "ref": "#.input.ref"
                            }
                        },
                        "traitOperation": {
                            "key": "body",
                            "operation": "remove"
                        }
                    }
                },
                "writeTrait": {
                    "input": {
                        "!businessKey": "string",
                        "!revision": "number",
                        "!key": "string",
                        "!command": "string",
                        "!value": "@any"
                    },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": {
                            "businessKey": "#.input.businessKey",
                            "revision": "#.input.revision",
                            "key": "#.input.key",
                            "input": {
                                "value": "#.input.value"
                            }
                        },
                        "traitOperation": {
                            "key": "#.input.key",
                            "operation": "rewrite"
                        }
                    }
                }
            }
        }
    },
    {
        "id": "total-fixture-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": {
                        "set": 0
                    }
                },
                "rewrite": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": {
                        "set": {
                            "command": "rewrite",
                            "value": "#.input.input.value"
                        }
                    }
                }
            }
        }
    },
    {
        "id": "total-fixture",
        "kind": "total-fixture-trait",
        "data": {
            "configuration": {},
            "derive": [
                {
                    "outputKey": "computed",
                    "set": "#.input.record.data.body.amount"
                },
                {
                    "if": {
                        "$eq": [
                            "#.computed",
                            {
                                "$get": {
                                    "object": "#.input.record.data",
                                    "path": "#.input.key"
                                }
                            }
                        ]
                    },
                    "then": {
                        "set": []
                    },
                    "else": {
                        "set": [
                            {
                                "key": "#.input.key",
                                "operation": "rewrite",
                                "input": {
                                    "value": "#.computed"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    },
    {
        "id": "double-fixture-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": {
                        "set": 0
                    }
                },
                "rewrite": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": {
                        "set": {
                            "command": "rewrite",
                            "value": "#.input.input.value"
                        }
                    }
                }
            }
        }
    },
    {
        "id": "double-fixture",
        "kind": "double-fixture-trait",
        "data": {
            "configuration": {},
            "derive": [
                {
                    "outputKey": "computed",
                    "set": {
                        "$multiply": [
                            2,
                            {
                                "$get": {
                                    "object": "#.input.record.data",
                                    "path": "total-fixture"
                                }
                            }
                        ]
                    }
                },
                {
                    "if": {
                        "$eq": [
                            "#.computed",
                            {
                                "$get": {
                                    "object": "#.input.record.data",
                                    "path": "#.input.key"
                                }
                            }
                        ]
                    },
                    "then": {
                        "set": []
                    },
                    "else": {
                        "set": [
                            {
                                "key": "#.input.key",
                                "operation": "rewrite",
                                "input": {
                                    "value": "#.computed"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    },
    {
        "id": "deriving-fixture",
        "kind": "writing-fixture",
        "data": {
            "traits": {
                "body": {
                    "configuration": {
                        "schema": {
                            "!amount": "number"
                        }
                    }
                },
                "total-fixture": {
                    "configuration": {},
                    "dependsOn": [
                        "body",
                        "total-fixture"
                    ]
                },
                "double-fixture": {
                    "configuration": {},
                    "dependsOn": [
                        "total-fixture"
                    ]
                }
            }
        }
    },
    {
        "id": "reversed-fixture",
        "kind": "writing-fixture",
        "data": {
            "traits": {
                "body": {
                    "configuration": {
                        "schema": {
                            "!amount": "number"
                        }
                    }
                },
                "double-fixture": {
                    "configuration": {},
                    "dependsOn": [
                        "total-fixture"
                    ]
                },
                "total-fixture": {
                    "configuration": {},
                    "dependsOn": [
                        "body",
                        "total-fixture"
                    ]
                }
            }
        }
    },
    {
        "id": "added-fixture-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": {
                        "set": 0
                    }
                },
                "add": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": {
                        "set": {
                            "command": "add",
                            "value": {
                                "$sum": [
                                    "#.input.value",
                                    "#.input.input"
                                ]
                            }
                        }
                    }
                }
            }
        }
    },
    {"id": "added-fixture", "kind": "added-fixture-trait", "data": {"configuration": {}}},
    {"id": "adding-fixture-trait", "kind": "kind", "data": {"extends": "valued-entity-trait", "operations": {"initialize": {"implementation": {"set": 0}}}}},
    {
        "id": "adding-fixture",
        "kind": "adding-fixture-trait",
        "data": {
            "configuration": {},
            "derive": {
                "if": {
                    "$eq": [
                        {
                            "$get": {
                                "object": "#.input.record.data",
                                "path": "added-fixture"
                            }
                        },
                        0
                    ]
                },
                "then": {
                    "set": [
                        {
                            "key": "added-fixture",
                            "operation": "add",
                            "input": 1
                        },
                        {
                            "key": "added-fixture",
                            "operation": "add",
                            "input": 2
                        }
                    ]
                },
                "else": {
                    "set": []
                }
            }
        }
    },
    {
        "id": "result-guarded-fixture",
        "kind": "writing-fixture",
        "data": {
            "traits": {
                "body": {
                    "configuration": {
                        "schema": {
                            "!amount": "number"
                        }
                    }
                },
                "total-fixture": {
                    "configuration": {},
                    "dependsOn": [
                        "body",
                        "total-fixture"
                    ]
                },
                "double-fixture": {
                    "configuration": {},
                    "dependsOn": [
                        "total-fixture"
                    ]
                }
            }
        }
    },
    {
        "id": "previewing-fixture-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait",
            "operations": {
                "preview": {
                    "public": true,
                    "input": {
                        "$data#&": [
                            "@trait-process-input",
                            {
                                "!input": {
                                    "!amount": "number"
                                }
                            }
                        ]
                    },
                    "output": "@trait-plan",
                    "implementation": {
                        "set": {
                            "operations": [
                                {
                                    "key": "body",
                                    "operation": "update",
                                    "input": {
                                        "value": {
                                            "amount": "#.input.input.amount"
                                        }
                                    }
                                }
                            ],
                            "commit": false
                        }
                    }
                }
            }
        }
    },
    {"id": "previewing-fixture", "kind": "previewing-fixture-trait", "data": {"configuration": {}}},
