                        "schema": {}
                    }
                },
                "masked-fixture": {
                    "configuration": {
                        "prefix": "secret: "
                    }
                }
            }
        }
    },
    {"id": "veto-fixture-trait", "kind": "kind", "data": {"extends": "valued-entity-trait", "operations": {"initialize": {"implementation": {"set": true}}}}},
    {
        "id": "veto-fixture",
        "kind": "veto-fixture-trait",
        "data": {
            "configuration": {
                "!reason": "string"
            },
            "guard": {
                "if": {
                    "$eq": [
                        "#.input.change.operation",
                        "delete"
                    ]
                },
                "then": {
                    "throw": {
                        "code": "conflict",
                        "message": "#.input.configuration.reason"
                    }
                }
            }
        }
    },
    {
        "id": "hooked-fixture",
        "kind": "entity-type",
        "data": {
            "traits": {
                "body": {
                    "configuration": {
                        "schema": {}
                    }
                },
                "veto-fixture": {
                    "configuration": {
                        "reason": "deletion vetoed"
                    }
                }
            }
        }
    },
    {"id": "bodyless-fixture", "kind": "entity-type", "data": {"traits": {"note-fixture": {"configuration": {"prefix": "plain: "}}}}},
    {"id": "noted-fixture", "kind": "kind", "data": {"extends": "entity-type", "fixed": {"traits": {"note-fixture": {"configuration": {"prefix": "class: "}}}}}},
    {"id": "configured-fixture", "kind": "noted-fixture", "data": {"traits": {"body": {"configuration": {"schema": {}}}}}},
    {"id": "specialised-fixture", "kind": "noted-fixture", "data": {"traits": {"body": {"configuration": {"schema": {}}}}}},
    {
        "id": "specialised-note-fixture",
        "kind": "slot-fill",
        "data": {
            "target": "specialised-fixture",
            "slot": "traits",
            "value": {
                "key": "note-fixture",
                "configuration": {
                    "suffix": "!"
                }
            }
        }
    },
    {
        "id": "versioned-fixture",
        "kind": "writing-fixture",
        "data": {
            "traits": {
                "body": {
                    "trait": "versioned-body",
                    "configuration": {
                        "schema": {
                            "!owner": "string",
                            "startDate": "string",
                            "!premium": "number"
                        },
                        "versioned": {
                            "validFrom": "/startDate"
                        }
                    }
                }
            }
        }
    },
    {"id": "handling-fixture-value", "kind": "schema", "data": {"!handler": "string", "team": "string"}},
    {
        "id": "handling-fixture-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": {
                        "set": {
                            "$coalesce": [
                                "#.input.input",
                                {}
                            ]
                        }
                    }
                },
                "reassign": {
                    "public": true,
                    "input": {
                        "$data#&": [
                            "@trait-operation-input",
                            {
                                "!input": {
                                    "!value": "@handling-fixture-value"
                                }
                            }
                        ]
                    },
                    "output": "@trait-command",
                    "implementation": {
                        "set": {
                            "command": "reassign",
                            "value": "#.input.input.value"
                        }
                    }
                }
            }
        }
    },
    {"id": "handling-fixture", "kind": "handling-fixture-trait", "data": {"configuration": {}}},
    {
        "id": "handled-fixture",
        "kind": "writing-fixture",
        "data": {
            "traits": {
                "body": {
                    "trait": "versioned-body",
                    "configuration": {
                        "schema": {
                            "!owner": "string",
                            "startDate": "string",
                            "!premium": "number"
                        },
                        "versioned": {
                            "validFrom": "/startDate"
                        }
                    }
                },
                "handling-fixture": {
                    "configuration": {}
