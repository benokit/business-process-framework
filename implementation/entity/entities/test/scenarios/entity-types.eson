                {"invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-6", "traits": {"body": {"amount": 1}}}},
                {"outputKey": "withoutRevision", "try": {"invoke": "order-fixture", "operation": "delete", "inputMap": {"$func/apply-mapping": {"mapping": {"$literal": {"businessKey": "o-6"}}, "input": null}}}, "catch": {"set": "#.error"}},
