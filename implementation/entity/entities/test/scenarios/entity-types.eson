    {
        "id": "entity-class-schema-traits-and-slots-inherited-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["note-fixture-trait", "note-fixture", "contract-body-fixture", "contract-fixture", "construction-fixture", "contract-note-fixture", "construction-note-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "construction-fixture", "operation": "create", "inputMap": {"traits": {"body": {"holder": "Ada", "project": "bridge"}}}},
                {"outputKey": "refused", "try": {"invoke": "construction-fixture", "operation": "create", "inputMap": {"traits": {"body": {"project": "no holder"}}}}, "catch": {"set": "#.error"}}
            ],
            "assert": [
                {"actual": "#.created.businessKey", "expected": "CON-bridge"},
                {"actual": "#.created.data.note-fixture", "expected": "contract: new (construction)"},
                {"actual": "#.refused", "expected": {"code": "invalid"}}
            ]
        }
    },
    {
        "id": "guard-given-data-of-the-entity-type-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["note-fixture-trait", "note-fixture", "contract-body-fixture", "contract-fixture", "construction-fixture", "contract-note-fixture", "construction-note-fixture", "keep-marine-contracts-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "construction-fixture", "operation": "create", "inputMap": {"traits": {"body": {"holder": "Ada", "project": "tunnel"}}}},
                {"outputKey": "refused", "try": {"invoke": "construction-fixture", "operation": "delete", "inputMap": {"businessKey": "#.created.businessKey", "revision": "#.created.revision"}}, "catch": {"set": "#.error"}}
            ],
            "assert": [
                {"actual": {"$isNil": "#.created.data.lineOfBusiness"}, "expected": true},
                {"actual": "#.refused", "expected": {"code": "conflict"}}
            ]
        }
    },
    {
        "id": "trait-configuration-united-from-chain-data-and-fills-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["note-fixture-trait", "note-fixture", "noted-fixture", "configured-fixture", "specialised-fixture", "specialised-note-fixture"],
            "act": [
                {"outputKey": "configured", "invoke": "configured-fixture", "operation": "create", "inputMap": {"businessKey": "c-1", "traits": {"body": {}}}},
                {"outputKey": "specialised", "invoke": "specialised-fixture", "operation": "create", "inputMap": {"businessKey": "c-1", "traits": {"body": {}}}}
            ],
            "assert": [
                {"actual": "#.configured.data.note-fixture", "expected": "class: new"},
                {"actual": "#.specialised.data.note-fixture", "expected": "class: new!"}
            ]
        }
    },
    {
        "id": "public-trait-operation-run-and-no-private-one-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "note-fixture-trait", "note-fixture", "order-fixture", "order-note-fixture"],
            "act": [
                {"invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-run", "traits": {"body": {"amount": 1}}}},
                {"outputKey": "updated", "invoke": "order-fixture", "operation": "run", "inputMap": {"businessKey": "o-run", "revision": 1, "trait": "body", "operation": "update", "input": {"value": {"amount": 2}}}},
                {"outputKey": "initialized", "try": {"invoke": "order-fixture", "operation": "run", "inputMap": {"businessKey": "o-run", "revision": 2, "trait": "body", "operation": "initialize", "input": {}}}, "catch": {"set": "#.error"}},
                {"outputKey": "unknownTrait", "try": {"invoke": "order-fixture", "operation": "run", "inputMap": {"businessKey": "o-run", "revision": 2, "trait": "nothing", "operation": "update", "input": {"value": {}}}}, "catch": {"set": "#.error"}},
                {"outputKey": "noRevision", "try": {"invoke": "order-fixture", "operation": "run", "inputMap": {"businessKey": "o-run", "trait": "body", "operation": "update", "input": {"value": {"amount": 3}}}}, "catch": {"set": "#.error"}},
                {"outputKey": "late", "try": {"invoke": "order-fixture", "operation": "run", "inputMap": {"businessKey": "o-run", "revision": 1, "trait": "body", "operation": "update", "input": {"value": {"amount": 3}}}}, "catch": {"set": "#.error"}}
            ],
            "assert": [
                {"actual": "#.updated", "expected": {"revision": 2, "data": {"body": {"amount": 2}}}},
                {"actual": "#.initialized", "expected": {"code": "private-operation"}},
                {"actual": "#.unknownTrait", "expected": {"code": "private-operation"}},
                {"actual": "#.noRevision", "expected": {"code": "invalid"}},
                {"actual": "#.late", "expected": {"code": "stale"}}
            ]
        }
    }
]
