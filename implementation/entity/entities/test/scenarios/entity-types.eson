[
    {
        "id": "order-created-with-body-and-initial-trait-values-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "note-fixture-trait", "note-fixture", "order-fixture", "order-note-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-1", "traits": {"body": {"amount": 5}}}},
                {"outputKey": "reloaded", "invoke": "order-fixture", "operation": "read", "inputMap": {"businessKey": "o-1"}}
            ],
            "assert": [
                {"actual": "#.created", "expected": {"entityType": "order-fixture", "businessKey": "o-1", "revision": 1}},
                {"actual": "#.created.data", "expected": {"business-key": "o-1", "body": {"amount": 5}, "note-fixture": "order: new"}},
                {"actual": "#.reloaded", "expected": "#.created"}
            ]
        }
    },
    {
        "id": "entity-without-body-created-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["note-fixture-trait", "note-fixture", "bodyless-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "bodyless-fixture", "operation": "create", "inputMap": {"businessKey": "b-1"}},
                {"outputKey": "reloaded", "invoke": "bodyless-fixture", "operation": "read", "inputMap": {"businessKey": "b-1"}}
            ],
            "assert": [
                {"actual": "#.created.data", "expected": {"business-key": "b-1", "note-fixture": "plain: new"}},
                {"actual": "#.reloaded", "expected": "#.created"}
            ]
        }
    },
    {
        "id": "trait-view-given-the-readers-at-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["masked-fixture-trait", "masked-fixture", "masking-fixture"],
            "act": [
                {"invoke": "masking-fixture", "operation": "create", "inputMap": {"businessKey": "m-1", "traits": {"body": {}}}},
                {"outputKey": "plain", "invoke": "masking-fixture", "operation": "read", "inputMap": {"businessKey": "m-1"}},
                {"outputKey": "masked", "invoke": "masking-fixture", "operation": "read", "inputMap": {"businessKey": "m-1", "at": "public"}}
            ],
            "assert": [
                {"actual": "#.plain.data.masked-fixture", "expected": "secret: new"},
                {"actual": "#.masked.data.masked-fixture", "expected": "***"}
            ]
        }
    },
    {
        "id": "trait-input-passed-on-create-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "note-fixture-trait", "note-fixture", "order-fixture", "order-note-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-2", "traits": {"body": {"amount": 5}, "note-fixture": "given"}}}
            ],
            "assert": [
                {"actual": "#.created.data.note-fixture", "expected": "order: given"}
            ]
        }
    },
    {
        "id": "invalid-create-duplicate-and-missing-record-refused-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "note-fixture-trait", "note-fixture", "order-fixture", "order-note-fixture"],
            "act": [
                {"invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-1", "traits": {"body": {"amount": 1}}}},
                {"outputKey": "badBody", "try": {"invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "bad", "traits": {"body": {"amount": "x"}}}}, "catch": {"set": "#.error"}},
                {"outputKey": "noKey", "try": {"invoke": "order-fixture", "operation": "create", "inputMap": {"traits": {"body": {"amount": 1}}}}, "catch": {"set": "#.error"}},
                {"outputKey": "duplicate", "try": {"invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-1", "traits": {"body": {"amount": 1}}}}, "catch": {"set": "#.error"}},
                {"outputKey": "missing", "try": {"invoke": "order-fixture", "operation": "read", "inputMap": {"businessKey": "nothing"}}, "catch": {"set": "#.error"}}
            ],
            "assert": [
                {"actual": "#.badBody", "expected": {"code": "invalid"}},
                {"actual": "#.noKey", "expected": {"code": "invalid"}},
                {"actual": "#.duplicate", "expected": {"code": "duplicate"}},
                {"actual": "#.missing", "expected": {"code": "not-found"}}
            ]
        }
    },
    {
        "id": "guard-runs-before-the-write-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "note-fixture-trait", "note-fixture", "order-fixture", "order-note-fixture", "positive-amount-fixture"],
            "act": [
                {"outputKey": "refused", "try": {"invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-neg", "traits": {"body": {"amount": -1}}}}, "catch": {"set": "#.error"}},
                {"outputKey": "afterwards", "try": {"invoke": "order-fixture", "operation": "read", "inputMap": {"businessKey": "o-neg"}}, "catch": {"set": "#.error"}}
            ],
            "assert": [
                {"actual": "#.refused", "expected": {"message": "amount must be positive"}},
                {"actual": "#.afterwards", "expected": {"code": "not-found"}}
            ]
        }
    },
    {
        "id": "record-visibility-judged-where-it-is-loaded-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "note-fixture-trait", "note-fixture", "order-fixture", "order-note-fixture", "hide-hidden-order-fixture"],
            "act": [
                {"invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-hidden", "traits": {"body": {"amount": 1}}}},
                {"outputKey": "read", "try": {"invoke": "order-fixture", "operation": "read", "inputMap": {"businessKey": "o-hidden"}}, "catch": {"set": "#.error"}},
                {"outputKey": "updated", "try": {"invoke": "order-fixture", "operation": "run", "inputMap": {"businessKey": "o-hidden", "revision": 1, "trait": "body", "operation": "update", "input": {"value": {"amount": "x"}}}}, "catch": {"set": "#.error"}},
                {"outputKey": "written", "try": {"invoke": "order-fixture", "operation": "writeTrait", "inputMap": {"businessKey": "o-hidden", "revision": 1, "key": "other", "command": "x", "value": {}}}, "catch": {"set": "#.error"}},
                {"outputKey": "deleted", "try": {"invoke": "order-fixture", "operation": "delete", "inputMap": {"businessKey": "o-hidden", "revision": 1}}, "catch": {"set": "#.error"}}
            ],
            "assert": [
                {"actual": "#.read", "expected": {"code": "not-found"}},
                {"actual": "#.updated", "expected": {"code": "not-found"}},
                {"actual": "#.written", "expected": {"code": "not-found"}},
                {"actual": "#.deleted", "expected": {"code": "not-found"}}
            ]
        }
    },
    {
        "id": "guard-runs-only-on-its-operations-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "note-fixture-trait", "note-fixture", "order-fixture", "order-note-fixture", "keep-kept-order-fixture"],
            "act": [
                {"invoke": "order-fixture", "operation": "create", "inputMap": {"businessKey": "o-kept", "traits": {"body": {"amount": 1}}}},
                {"outputKey": "read", "invoke": "order-fixture", "operation": "read", "inputMap": {"businessKey": "o-kept"}},
                {"outputKey": "updated", "invoke": "order-fixture", "operation": "run", "inputMap": {"businessKey": "o-kept", "revision": 1, "trait": "body", "operation": "update", "input": {"value": {"amount": 2}}}},
                {"outputKey": "refused", "try": {"invoke": "order-fixture", "operation": "delete", "inputMap": {"businessKey": "o-kept", "revision": 2}}, "catch": {"set": "#.error"}}
            ],
            "assert": [
                {"actual": "#.read.businessKey", "expected": "o-kept"},
                {"actual": "#.updated.revision", "expected": 2},
                {"actual": "#.refused", "expected": {"message": "kept"}}
            ]
        }
    },
    {
