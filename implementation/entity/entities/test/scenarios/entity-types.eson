                {"invoke": "deriving-fixture", "operation": "run", "inputMap": {"businessKey": "d-1", "revision": 1, "trait": "body", "operation": "update", "input": {"value": {"amount": 5}}}},
                {"outputKey": "written", "invoke": "deriving-fixture", "operation": "writeTrait", "inputMap": {"businessKey": "d-1", "revision": 2, "key": "total-fixture", "command": "rewrite", "value": 99}}
            ],
            "assert": [
