    {
        "id": "derived-traits-derive-in-order-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "total-fixture-trait", "total-fixture", "double-fixture-trait", "double-fixture", "deriving-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "deriving-fixture", "operation": "create", "inputMap": {"businessKey": "d-1", "traits": {"body": {"amount": 3}}}},
                {"outputKey": "updated", "invoke": "deriving-fixture", "operation": "run", "inputMap": {"businessKey": "d-1", "revision": 1, "trait": "body", "operation": "update", "input": {"value": {"amount": 5}}}}
            ],
            "assert": [
                {"actual": "#.created", "expected": {"revision": 1, "data": {"total-fixture": 3, "double-fixture": 6}}},
                {"actual": "#.updated", "expected": {"revision": 2, "data": {"total-fixture": 5, "double-fixture": 10}}}
            ]
        }
    },
    {
        "id": "derived-traits-converge-in-any-order-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "total-fixture-trait", "total-fixture", "double-fixture-trait", "double-fixture", "reversed-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "reversed-fixture", "operation": "create", "inputMap": {"businessKey": "r-1", "traits": {"body": {"amount": 3}}}}
            ],
            "assert": [
                {"actual": "#.created", "expected": {"revision": 1, "data": {"total-fixture": 3, "double-fixture": 6}}}
            ]
        }
    },
    {
        "id": "reaction-sees-derived-commands-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "total-fixture-trait", "total-fixture", "double-fixture-trait", "double-fixture", "reversed-fixture", "refuse-derived-double-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "reversed-fixture", "operation": "create", "inputMap": {"businessKey": "r-2", "traits": {"body": {"amount": 3}}}},
                {"outputKey": "refused", "try": {"invoke": "reversed-fixture", "operation": "run", "inputMap": {"businessKey": "r-2", "revision": "#.created.revision", "trait": "body", "operation": "update", "input": {"value": {"amount": 5}}}}, "catch": {"set": "#.error"}}
            ],
            "assert": [
                {"actual": "#.refused", "expected": {"message": "derived command seen"}}
            ]
        }
    },
    {
        "id": "result-guard-sees-whole-command-sequence-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "total-fixture-trait", "total-fixture", "double-fixture-trait", "double-fixture", "result-guarded-fixture", "refuse-derived-double-result-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "result-guarded-fixture", "operation": "create", "inputMap": {"businessKey": "g-1", "traits": {"body": {"amount": 3}}}},
                {"outputKey": "refused", "try": {"invoke": "result-guarded-fixture", "operation": "run", "inputMap": {"businessKey": "g-1", "revision": "#.created.revision", "trait": "body", "operation": "update", "input": {"value": {"amount": 5}}}}, "catch": {"set": "#.error"}},
                {"outputKey": "afterwards", "invoke": "result-guarded-fixture", "operation": "read", "inputMap": {"businessKey": "g-1"}}
            ],
            "assert": [
                {"actual": "#.refused", "expected": {"code": "forbidden", "message": "derived double refused"}},
                {"actual": "#.afterwards.revision", "expected": "#.created.revision"}
            ]
        }
    },
    {
        "id": "write-previewed-without-writing-scenario",
        "kind": "scenario",
        "data": {
            "environment": "entity-store-scenario-environment",
            "given": ["writing-fixture", "total-fixture-trait", "total-fixture", "double-fixture-trait", "double-fixture", "previewing-fixture-trait", "previewing-fixture", "previewed-fixture"],
            "act": [
                {"outputKey": "created", "invoke": "previewed-fixture", "operation": "create", "inputMap": {"businessKey": "p-1", "traits": {"body": {"amount": 3}}}},
                {"outputKey": "preview", "invoke": "previewed-fixture", "operation": "run", "inputMap": {"businessKey": "p-1", "revision": "#.created.revision", "trait": "previewing-fixture", "operation": "preview", "input": {"amount": 5}}},
                {"outputKey": "afterwards", "invoke": "previewed-fixture", "operation": "read", "inputMap": {"businessKey": "p-1"}}
            ],
            "assert": [
                {"actual": "#.preview.commands", "expected": [{"key": "body", "value": {"amount": 5}}, {"key": "total-fixture", "value": 5}, {"key": "double-fixture", "value": 10}]},
                {"actual": "#.preview.entity.data", "expected": {"total-fixture": 5, "double-fixture": 10}},
                {"actual": "#.afterwards.data.total-fixture", "expected": 3}
            ]
        }
    },
