[
    {
        "id": "entity-state-declaration",
        "kind": "schema",
        "data": { "$data#": ["boolean", { "initial": "boolean", "to[]": "string" }] }
    },
    {
        "id": "entity-states-model",
        "kind": "schema",
        "data": {
            "!states{}": "{@entity-state-declaration}",
            "transitions": { "*": { "*": { "*": "string" } } },
            "initialStates{}": "{string}",
            "operations": { "*": { "*": { "*": "boolean" } } },
            "processDimension": "string"
        }
    },
    {
        "id": "apply-transition",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!model": "object", "!state": "object", "!transition": "string" }, "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "applyTransition"
        }
    },
    {
        "id": "initial-state",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!model": "object", "name": "string" }, "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "initialState"
        }
    },
    {
        "id": "transition-names",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "transitionNames"
        }
    },
    {
        "id": "process-state",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!state": "object" }, "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "processState"
        }
    },
    {
        "id": "process-state-names",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "processStateNames"
        }
    },
    {
        "id": "process-states-of-type",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "processStatesOfType"
        }
    },
    {
        "id": "state-forbids-operation",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "entityOperation": "@entity-operation", "state": "object" }, "output": "boolean" },
            "module": "@business-framework/entity-states/states",
            "export": "forbidsOperation"
        }
    },
    {
        "id": "states-model-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "statesModelProblems"
        }
    },
    {
        "id": "states-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "operations": {
                "initialize": {
                    "implementation": [
                        { "outputKey": "state", "set": { "$func/initial-state": { "model": "#.input.configuration", "name": "#.input.input" } } },
                        {
                            "if": { "$negate": "#.state" },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " has no initial state ", "#.input.input"] } } }
                        },
                        { "set": "#.state" }
                    ]
                },
                "transition": {
                    "input": { "$data#&": ["@trait-operation-input", { "!input": "@state-transition-input" }] },
                    "output": "@trait-command",
                    "implementation": [
                        {
                            "if": { "$negate": { "$get": { "object": { "$coalesce": ["#.input.configuration.transitions", {}] }, "path": "#.input.input.transition" } } },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " has no transition ", "#.input.input.transition"] } } }
                        },
                        { "outputKey": "state", "set": { "$func/apply-transition": { "model": "#.input.configuration", "state": "#.input.value", "transition": "#.input.input.transition" } } },
                        {
                            "if": { "$negate": "#.state" },
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["transition ", "#.input.input.transition", " isn't allowed from the current state"] } } }
                        },
                        { "set": { "command": "#.input.input.transition", "value": "#.state" } }
                    ]
                }
            },
            "lifecycle": {
                "validate": { "$func/states-model-problems": "#.self.id" }
            }
        }
    },
    {
        "id": "state-machine",
        "kind": "kind",
        "data": { "shape": "@entity-states-model" }
    },
    {
        "id": "state",
        "kind": "states-trait",
        "data": { "configuration": "@entity-states-model" }
    },
    {
        "id": "state-transition-input",
        "kind": "schema",
        "data": { "!transition": "@entity-transition" }
    },
    {
        "id": "stateful-entity-type",
        "kind": "kind",
        "data": {
            "extends": "keyed-entity-type",
            "operations": {
                "transition": {
                    "input": { "$data#&": ["@entity-revision-input", "@state-transition-input"] },
                    "output": "@entity-record",
                    "implementation": { "exposes": { "key": "state", "operation": "transition" } }
                }
            }
        }
    },
    {
        "id": "stateful-body-entity-type",
        "kind": "kind",
        "data": {
            "extends": "stateful-entity-type",
            "operations": {
                "update": {
                    "input": { "$data#&": ["@entity-revision-input", "@body-put-input"] },
                    "output": "@viewed-entity-record",
                    "implementation": { "exposes": { "key": "body", "operation": "put" } }
                }
            }
        }
    },
    {
        "id": "entity-state-machine",
        "kind": "kind",
        "data": {
            "lifecycle": {
                "load": {
                    "inputMap": { "id": "entity-transition", "schema": { "\\$data=1": { "$func/transition-names": null } } },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "entity-states",
        "kind": "entity-state-machine",
        "data": {}
    },
    {
        "id": "refuse-operations-outside-their-states",
        "kind": "slot-fill",
        "data": {
            "target": "entity-type",
            "slot": "guards",
            "on": ["trait", "delete"],
            "value": {
                "if": { "$func/state-forbids-operation": { "entityType": "#.self.id", "entityOperation": "#.input.entityOperation", "state": { "$func/record-state": "#.input.before" } } },
                "then": {
                    "throw": {
                        "code": "conflict",
                        "message": { "$str": ["#.self.id", " doesn't allow ", "#.input.entityOperation", " in its current state"] }
                    }
                }
            }
        }
    },
    {
        "id": "record-state",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "stateOf"
        }
    },
    {
        "id": "state-moved",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!before": "@any", "!after": "@any", "!dimension": "string", "!from": "string", "!to": "string" }, "output": "boolean" },
            "module": "@business-framework/entity-states/states",
            "export": "stateMoved"
        }
    }
]
