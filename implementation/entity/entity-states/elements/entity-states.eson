[
    {
        "id": "entity-states-model",
        "kind": "schema",
        "data": {
            "!states{}": "{boolean}",
            "transitions": { "*": { "*": { "*": "string" } } },
            "initialStates{}": "{string}",
            "operations": { "*": { "*": { "*": "boolean" } } },
            "permissionDimension": "string"
        }
    },
    {
        "id": "apply-transition",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!model": "object", "!state": "object", "!transition": "string" }, "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "applyTransition"
        }
    },
    {
        "id": "initial-state",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!model": "object", "name": "string" }, "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "initialState"
        }
    },
    {
        "id": "transition-names",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "transitionNames"
        }
    },
    {
        "id": "permission-state",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!state": "object" }, "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "permissionState"
        }
    },
    {
        "id": "permission-state-names",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "permissionStateNames"
        }
    },
    {
        "id": "permission-states-of-type",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "permissionStatesOfType"
        }
    },
    {
        "id": "state-forbids-operation",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!entityType": "string", "!operation": "string", "key": "string", "state": "object" }, "output": "boolean" },
            "module": "@business-framework/entity-states/states",
            "export": "forbidsOperation"
        }
    },
    {
        "id": "states-model-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "statesModelProblems"
        }
    },
    {
        "id": "states-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait",
            "operations": {
                "initialize": {
                    "implementation": [
                        { "outputKey": "state", "set": { "$func/initial-state": { "model": "#.input.configuration", "name": "#.input.input" } } },
                        {
                            "if": { "$negate": "#.state" },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " has no initial state ", "#.input.input"] } } }
                        },
                        { "set": "#.state" }
                    ]
                },
                "transition": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": [
                        {
                            "if": { "$negate": { "$get": { "object": { "$coalesce": ["#.input.configuration.transitions", {}] }, "path": "#.input.input.transition" } } },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " has no transition ", "#.input.input.transition"] } } }
                        },
                        { "outputKey": "state", "set": { "$func/apply-transition": { "model": "#.input.configuration", "state": "#.input.value", "transition": "#.input.input.transition" } } },
                        {
                            "if": { "$negate": "#.state" },
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["transition ", "#.input.input.transition", " isn't allowed from the current state"] } } }
                        },
                        { "set": { "command": "#.input.input.transition", "value": "#.state" } }
                    ]
                }
            },
            "lifecycle": {
                "validate": { "$func/states-model-problems": "#.self.id" }
            }
        }
    },
    {
        "id": "state",
        "kind": "states-trait",
        "data": { "configuration": "@entity-states-model" }
    },
    {
        "id": "stateful-entity-type",
        "kind": "kind",
        "data": {
            "extends": "entity-type",
            "operations": {
                "transition": {
                    "input": { "!businessKey": "string", "!revision": "number", "!transition": "@entity-transition" },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "input": { "transition": "#.input.transition" } },
                        "traitOperation": { "key": "state", "operation": "transition" }
                    }
                }
            }
        }
    },
    {
        "id": "entity-state-machine",
        "kind": "kind",
        "data": {
            "lifecycle": {
                "load": {
                    "inputMap": { "id": "entity-transition", "schema": { "\\$data=1": { "$func/transition-names": null } } },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "entity-states",
        "kind": "entity-state-machine",
        "data": {}
    },
    {
        "id": "refuse-operations-outside-their-states",
        "kind": "slot-fill",
        "data": {
            "target": "entity-type",
            "slot": "guards",
            "value": {
                "if": { "$func/state-forbids-operation": { "entityType": "#.self.id", "operation": "#.input.operation", "key": "#.input.key", "state": "#.input.before.data.state" } },
                "then": {
                    "throw": {
                        "code": "conflict",
                        "message": { "$str": ["#.self.id", " doesn't allow ", "#.input.operation", " ", { "$coalesce": ["#.input.key", ""] }, " in its current state"] }
                    }
                }
            }
        }
    }
]
