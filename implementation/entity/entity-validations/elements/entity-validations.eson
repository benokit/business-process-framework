[
    {
        "id": "entity-validation-input",
        "kind": "schema",
        "data": { "!entityType": "string", "!businessKey": "string", "!data": "object" }
    },
    {
        "id": "entity-validation-errors",
        "kind": "schema",
        "data": { "*": "string" }
    },
    {
        "id": "entity-validations-slot",
        "kind": "slot-declaration",
        "data": { "target": "entity-type", "slot": "validations", "cardinality": "many", "value": "@mapping", "input": "@entity-validation-input" }
    },
    {
        "id": "validation-derivation",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!record": "@any", "!key": "string", "!errors": "@entity-validation-errors", "!operations": "[@any]" }, "output": "@trait-derivation" },
            "module": "@business-framework/entity-validations/validations",
            "export": "validationDerivation"
        }
    },
    {
        "id": "validation-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-validations/validations",
            "export": "validationProblems"
        }
    },
    {
        "id": "validation-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "lifecycle": { "validate": { "$func/validation-problems": "#.self.id" } },
            "operations": {
                "initialize": {
                    "implementation": [
                        {
                            "if": "#.input.input",
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " derives ", "#.input.key", " from its data and takes no input"] } } }
                        },
                        { "set": {} }
                    ]
                }
            }
        }
    },
    {
        "id": "validation",
        "kind": "validation-trait",
        "data": {
            "configuration": { "onValidation": "@mapping" },
            "derive": [
                {
                    "outputKey": "errors",
                    "set": {
                        "$merge": {
                            "$map": {
                                "over": { "$func/slot-values": { "element": "#.input.entityType", "slot": "validations" } },
                                "as": "rule",
                                "fn": { "$func/apply-mapping": { "mapping": "@rule", "input": "#.input.record" } }
                            }
                        }
                    }
                },
                {
                    "set": {
                        "$func/validation-derivation": {
                            "record": "#.input.record",
                            "key": "#.input.key",
                            "errors": "#.errors",
                            "operations": {
                                "$if": [
                                    "#.input.configuration.onValidation",
                                    { "$func/apply-mapping": { "mapping": "#.input.configuration.onValidation", "input": { "entityType": "#.input.entityType", "businessKey": "#.input.record.businessKey", "errors": "#.errors" } } },
                                    []
                                ]
                            }
                        }
                    }
                }
            ]
        }
    }
]
