[
    {
        "id": "ownership-value-schema",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!dimensions": "@schema" }, "output": "@schema" },
            "module": "@business-framework/entity-ownership/ownership",
            "export": "ownershipValueSchema"
        }
    },
    {
        "id": "derived-ownership",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!rule": "@any", "!record": "@any" }, "output": "object" },
            "module": "@business-framework/entity-ownership/ownership",
            "export": "derivedOwnership"
        }
    },
    {
        "id": "ownership-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entity-ownership/ownership",
            "export": "ownershipProblems"
        }
    },
    {
        "id": "scope-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-ownership/ownership",
            "export": "scopeProblems"
        }
    },
    {
        "id": "ownership-explanation",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "@any" },
            "module": "@business-framework/entity-ownership/ownership",
            "export": "ownershipExplanation"
        }
    },
    {
        "id": "ownership-backfiller",
        "kind": "kind",
        "data": {
            "operations": {
                "run": {
                    "input": { "!entityType": "@ref/entity-type" },
                    "output": { "!updated": "number" },
                    "implementation": {
                        "asSystem": {
                            "low": { "module": "@business-framework/entity-ownership/ownership", "export": "backfillOwnership", "effects": ["read", "write"] }
                        },
                        "inputMap": { "entityType": "#.input.entityType" }
                    }
                }
            }
        }
    },
    {
        "id": "entity-ownership-backfiller",
        "kind": "ownership-backfiller",
        "data": {}
    },
    {
        "id": "ownership-trait",
        "kind": "kind",
        "data": {
            "extends": "valued-entity-trait",
            "lifecycle": {
                "validate": { "$func/ownership-problems": null },
                "explain": { "$func/ownership-explanation": "#.element" }
            },
            "operations": {
                "initialize": {
                    "implementation": [
                        {
                            "if": "#.input.input",
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " derives ", "#.input.key", " from its data and takes no input"] } } }
                        },
                        { "set": {} }
                    ]
                },
                "assign": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": { "set": { "command": "derive", "value": "#.input.input" } }
                }
            }
        }
    },
    {
        "id": "ownership",
        "kind": "ownership-trait",
        "data": {
            "configuration": { "!dimensions": "@schema", "!rule": "@mapping" },
            "value": { "$func/ownership-value-schema": { "dimensions": "#.configuration.dimensions" } },
            "derive": [
                { "outputKey": "ownership", "set": { "$func/derived-ownership": { "rule": "#.input.configuration.rule", "record": "#.input.record" } } },
                {
                    "inputMap": { "schemaId": { "$str": ["#.input.entityType", "/", "#.input.key", "/value"] }, "value": "#.ownership" },
                    "invoke": "ajv",
                    "operation": "assert"
                },
                {
                    "if": { "$eq": ["#.ownership", { "$get": { "object": "#.input.record.data", "path": "#.input.key" } }] },
                    "then": { "set": [] },
                    "else": { "set": [{ "key": "#.input.key", "operation": "assign", "input": "#.ownership" }] }
                }
            ]
        }
    },
    {
        "id": "ownership-scope",
        "kind": "kind",
        "data": {
            "shape": { "!filter": "@mapping" },
            "lifecycle": {
                "validate": { "$func/scope-problems": "#.self.id" }
            }
        }
    },
    {
        "id": "record-ownership",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "@any" },
            "module": "@business-framework/entity-ownership/ownership",
            "export": "ownershipOf"
        }
    }
]
