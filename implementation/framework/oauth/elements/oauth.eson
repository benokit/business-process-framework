[
    {
        "kind": "app-config",
        "data": { "oauth": { "issuer": "http://localhost:8080/default" } }
    },
    {
        "id": "authenticate",
        "kind": "principal-execution-node-wrapper",
        "data": {
            "keyword": "authenticated",
            "node": { "!authenticated": "@method" },
            "implementation": [
                { "outputKey": "config", "set": { "$func/app-config-section": "oauth" } },
                {
                    "outputKey": "claims",
                    "inputMap": { "header": "#.input.headers.authorization", "issuer": "#.config.issuer", "audience": "#.config.audience" },
                    "low": { "module": "@business-framework/oauth", "export": "verifyToken", "effects": ["read"] }
                },
                {
                    "if": { "$negate": "#.claims" },
                    "then": { "next": true },
                    "else": [
                        {
                            "outputKey": "user",
                            "inputMap": { "businessKey": "#.claims.sub" },
                            "withCache": {
                                "asSystem": {
                                    "try": { "invoke": "user", "operation": "read" },
                                    "catch": { "if": { "$eq": ["#.error.code", "not-found"] }, "then": { "set": null }, "else": { "throw": "#.error" } }
                                }
                            },
                            "cache": "user-cache",
                            "key": "#.input.businessKey"
                        },
                        {
                            "if": { "$or": [{ "$negate": "#.user" }, { "$eq": ["#.user.data.state.status", "suspended"] }] },
                            "then": { "next": true },
                            "else": {
                                "withContext": {
                                    "user": {
                                        "userId": "#.user.businessKey",
                                        "username": "#.user.data.body.username",
                                        "email": "#.user.data.body.email",
                                        "roles": { "$coalesce": ["#.user.data.body.roles", []] }
                                    }
                                },
                                "do": { "next": true }
                            }
                        }
                    ]
                }
            ]
        }
    },
    {
        "id": "user-cache",
        "kind": "in-memory-cache",
        "data": { "ttl": 60000 }
    },
    {
        "id": "user-cache-eviction",
        "kind": "message-consumer",
        "data": {
            "channel": "entity-events",
            "broadcast": true,
            "filter": ["user"],
            "handler": { "inputMap": { "key": "#.input.businessKey" }, "invoke": "user-cache", "operation": "evict" }
        }
    },
    {
        "id": "authenticate-requests",
        "kind": "slot-fill",
        "data": {
            "target": "http-endpoint",
            "slot": "requestMiddleware",
            "position": "first",
            "value": { "authenticated": { "next": true } }
        }
    }
]
