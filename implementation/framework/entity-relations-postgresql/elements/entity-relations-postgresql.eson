[
    {
        "id": "set-entity-relations-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "set-entity-relations",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": [
                    {
                        "outputKey": "missing",
                        "statement": "SELECT w.\"targetEntityType\", w.\"targetEntityBusinessKey\" FROM jsonb_to_recordset($1::jsonb->'relations') AS w(\"targetEntityType\" text, \"targetEntityBusinessKey\" text) WHERE NOT EXISTS (SELECT 1 FROM entities e WHERE e.entity_type = w.\"targetEntityType\" AND e.business_key = w.\"targetEntityBusinessKey\") LIMIT 1",
                        "read": true,
                        "parameters": [
                            {
                                "relations": "#.relations"
                            }
                        ]
                    },
                    {
                        "outputKey": "target",
                        "set": {
                            "$head": "#.missing"
                        }
                    },
                    {
                        "if": "#.target",
                        "then": {
                            "throw": {
                                "code": "not-found",
                                "message": {
                                    "$join": {
                                        "_strings": [
                                            "related ",
                                            "#.target.targetEntityType",
                                            " '",
                                            "#.target.targetEntityBusinessKey",
                                            "' doesn't exist"
                                        ]
                                    }
                                },
                                "data": "#.target"
                            }
                        }
                    },
                    {
                        "statement": "WITH wanted AS (SELECT DISTINCT e.id AS target_entity_id, w.\"relationType\" AS relation_type FROM jsonb_to_recordset($2::jsonb->'relations') AS w(\"targetEntityType\" text, \"targetEntityBusinessKey\" text, \"relationType\" text) JOIN entities e ON e.entity_type = w.\"targetEntityType\" AND e.business_key = w.\"targetEntityBusinessKey\"), removed AS (DELETE FROM entity_relations r WHERE r.source_entity_id = $1::uuid AND NOT EXISTS (SELECT 1 FROM wanted w WHERE w.target_entity_id = r.target_entity_id AND w.relation_type = r.relation_type)) INSERT INTO entity_relations (source_entity_id, target_entity_id, relation_type) SELECT $1::uuid, target_entity_id, relation_type FROM wanted ON CONFLICT DO NOTHING",
                        "parameters": [
                            "#.sourceEntityId",
                            {
                                "relations": "#.relations"
                            }
                        ]
                    },
                    {
                        "set": null
                    }
                ]
            }
        }
    },
    {
        "id": "entity-relations-of-postgresql",
        "kind": "slot-fill",
        "data": {
            "target": "entity-relations-of",
            "slot": "implementations",
            "value": {
                "provider": "postgresql-database",
                "implementation": {
                    "statement": "SELECT target_entity_id AS \"targetEntityId\", relation_type AS \"relationType\" FROM entity_relations WHERE source_entity_id = $1",
                    "read": true,
                    "parameters": [
                        "#.sourceEntityId"
                    ]
                }
            }
        }
    },
    {
        "id": "entity-relations-table",
        "kind": "slot-fill",
        "data": {
            "target": "postgresql-database",
            "slot": "models",
            "after": [
                "entities-table"
            ],
            "value": {
                "command": "CREATE TABLE IF NOT EXISTS entity_relations (source_entity_id UUID NOT NULL REFERENCES entities(id) ON DELETE CASCADE, target_entity_id UUID NOT NULL REFERENCES entities(id) ON DELETE CASCADE, relation_type TEXT NOT NULL, PRIMARY KEY (source_entity_id, target_entity_id, relation_type))"
            }
        }
    }
]
