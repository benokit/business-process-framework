[
    {
        "id": "entity-event",
        "kind": "schema",
        "data": {
            "!eventType=1": ["create", "update", "trait", "delete"],
            "!entityType": "string",
            "!id": "string",
            "!businessKey": "string",
            "!revision": "number",
            "trait": "string",
            "command": "string"
        }
    },
    {
        "id": "entity-events",
        "kind": "message-channel",
        "data": {
            "broker": { "instanceOf": "message-broker" },
            "topology": "topic",
            "name": "entity-events",
            "publisher": { "transactionalOutbox": true, "retry": { "attempts": 5, "backoff": 500 } }
        }
    },
    {
        "id": "entity-event-group-slot",
        "kind": "slot-declaration",
        "data": { "target": "entity-type", "slot": "eventGroup", "cardinality": "one", "value": "@mapping" }
    },
    {
        "id": "entity-event-group",
        "kind": "slot-fill",
        "data": {
            "target": "entity-type",
            "slot": "eventGroup",
            "value": { "$join": { "strings": ["#.entityType", "#.businessKey"], "separator": "/" } }
        }
    },
    {
        "id": "publish-entity-events",
        "kind": "slot-fill",
        "data": {
            "target": "entity-type",
            "slot": "reactions",
            "value": [
                { "outputKey": "record", "set": { "$coalesce": ["#.input.after", "#.input.before"] } },
                {
                    "inputMap": {
                        "message": {
                            "eventType": "#.input.operation",
                            "entityType": "#.record.entityType",
                            "id": "#.record.id",
                            "businessKey": "#.record.businessKey",
                            "revision": "#.record.revision",
                            "trait": "#.input.trait",
                            "command": "#.input.command"
                        },
                        "subject": "#.record.entityType",
                        "messageId": { "$join": { "strings": ["#.record.id", "#.record.revision", "#.input.operation"], "separator": "-" } },
                        "group": { "$func/apply-mapping": { "mapping": { "$func/slot-values": { "element": "#.self.id", "slot": "eventGroup" } }, "input": "#.record" } }
                    },
                    "publish": "entity-events"
                }
            ]
        }
    }
]
