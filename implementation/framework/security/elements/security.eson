[
    {
        "id": "principal",
        "kind": "schema",
        "data": { "!userId": "string", "username": "string", "email": "string", "roles[]": "string" }
    },
    {
        "id": "principal-execution-node-wrapper",
        "kind": "kind",
        "data": {
            "extends": "execution-node-wrapper",
            "context": { "manages": { "user": "@principal" } }
        }
    },
    {
        "id": "as-system",
        "kind": "principal-execution-node-wrapper",
        "data": {
            "keyword": "asSystem",
            "implementation": { "withContext": { "user": { "userId": "system", "roles": ["system"] } }, "do": { "next": true } }
        }
    }
]
