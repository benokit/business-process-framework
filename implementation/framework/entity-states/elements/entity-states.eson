[
    {
        "id": "entity-states-model",
        "kind": "schema",
        "data": {
            "!states{}": "{boolean}",
            "transitions": { "*": { "*": { "*": "string" } } },
            "initialStates{}": "{string}"
        }
    },
    {
        "id": "apply-transition",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!model": "object", "!state": "object", "!transition": "string" }, "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "applyTransition"
        }
    },
    {
        "id": "initial-state",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!model": "object", "name": "string" }, "output": "@any" },
            "module": "@business-framework/entity-states/states",
            "export": "initialState"
        }
    },
    {
        "id": "transition-names",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "transitionNames"
        }
    },
    {
        "id": "states-model-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entity-states/states",
            "export": "statesModelProblems"
        }
    },
    {
        "id": "states-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait",
            "operations": {
                "initialize": {
                    "implementation": [
                        { "outputKey": "state", "set": { "$func/initial-state": { "model": "#.input.configuration", "name": "#.input.input" } } },
                        {
                            "if": { "$negate": "#.state" },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " has no initial state ", "#.input.input"] } } }
                        },
                        { "set": "#.state" }
                    ]
                }
            },
            "lifecycle": {
                "validate": { "$func/states-model-problems": "#.self.id" }
            }
        }
    },
    {
        "id": "state",
        "kind": "states-trait",
        "data": { "configuration": "@entity-states-model" }
    },
    {
        "id": "entity-state-machine",
        "kind": "kind",
        "data": {
            "operations": {
                "transition": {
                    "input": { "!entityType": "@ref/entity-type", "!businessKey": "string", "!revision": "number", "!transition": "@entity-transition" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "if": { "$negate": { "$func/is-instance-of": { "element": "#.input.entityType", "kind": "entity-type" } } },
                            "then": { "throw": { "code": "not-found", "message": { "$str": ["no entity type ", "#.input.entityType"] } } }
                        },
                        { "outputKey": "model", "set": { "$get": { "object": { "$func/entity-traits": "#.input.entityType" }, "path": "state.configuration" } } },
                        {
                            "if": { "$negate": { "$get": { "object": { "$coalesce": ["#.model.transitions", {}] }, "path": "#.input.transition" } } },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.input.entityType", " has no transition ", "#.input.transition"] } } }
                        },
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.input.entityType", "operation": "read" },
                        { "outputKey": "state", "set": { "$func/apply-transition": { "model": "#.model", "state": "#.before.data.state", "transition": "#.input.transition" } } },
                        {
                            "if": { "$negate": "#.state" },
                            "then": { "throw": { "code": "conflict", "message": { "$str": ["transition ", "#.input.transition", " isn't allowed from the current state"] } } }
                        },
                        {
                            "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "key": "state", "command": "#.input.transition", "value": "#.state" },
                            "invoke": "#.input.entityType",
                            "operation": "writeTrait"
                        }
                    ]
                }
            },
            "lifecycle": {
                "load": {
                    "inputMap": { "id": "entity-transition", "schema": { "\\$data=1": { "$func/transition-names": null } } },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "entity-states",
        "kind": "entity-state-machine",
        "data": {}
    }
]
