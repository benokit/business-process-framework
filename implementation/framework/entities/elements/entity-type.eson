[
    {
        "id": "entity-type",
        "kind": "kind",
        "data": {
            "shape": { "!bodySchema": "@schema" },
            "slots": {
                "traits": { "cardinality": "many", "value": "@entity-trait-use" },
                "businessKey": { "cardinality": "one", "value": "@method", "input": "@entity-type/create/input" },
                "guards": { "cardinality": "many", "value": "@method", "effects": ["read", "trace"], "input": "@entity-change" },
                "interceptors": { "cardinality": "many", "value": "@method", "input": { "!operation": "string", "!input": "object" } },
                "reactions": { "cardinality": "many", "value": "@method", "input": "@entity-change" }
            },
            "operations": {
                "read": {
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "revision": "#.input.revision" },
                        "invoke": "entity-database",
                        "operation": "read"
                    }
                },
                "list": {
                    "input": { "limit": "number", "offset": "number" },
                    "output": { "!items[]": "@entity-record", "!total": "number" },
                    "implementation": {
                        "inputMap": { "entityType": "#.self.id", "limit": "#.input.limit", "offset": "#.input.offset" },
                        "invoke": "entity-database",
                        "operation": "list"
                    }
                },
                "initialTraitValues": {
                    "input": { "!traits": "object" },
                    "output": "object",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "outputKey": "values",
                            "inputMap": { "$keys": "#.traits" },
                            "forEach": [
                                { "outputKey": "use", "set": { "$get": { "object": "#.traits", "path": "#.item" } } },
                                {
                                    "outputKey": "value",
                                    "inputMap": {
                                        "trait": "#.use.trait",
                                        "entityType": "#.self.id",
                                        "key": "#.item",
                                        "configuration": "#.use.configuration",
                                        "input": { "$get": { "object": "#.input.traits", "path": "#.item" } }
                                    },
                                    "invoke": "entity-trait-initializer",
                                    "operation": "initialize"
                                },
                                { "set": { "key": "#.item", "value": "#.value" } }
                            ]
                        },
                        { "set": { "$mapValues": { "of": { "$toDictionary": { "by": "#.key", "collection": "#.values" } }, "fn": "#.value" } } }
                    ]
                },
                "applyChange": {
                    "input": { "!change": "@entity-change", "revision": "number" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "if": { "$and": ["#.input.revision", { "$neq": ["#.input.revision", "#.input.change.before.revision"] }] },
                            "then": {
                                "throw": {
                                    "code": "conflict",
                                    "message": { "$str": ["#.self.id", " '", "#.input.change.before.businessKey", "' is not at revision ", "#.input.revision"] }
                                }
                            }
                        },
                        {
                            "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "guards" } },
                            "forEach": { "inputMap": "#.input.change", "execute": "#.item" }
                        },
                        {
                            "outputKey": "store",
                            "set": {
                                "$cond": [
                                    [{ "$eq": ["#.input.change.operation", "create"] }, { "operation": "create", "input": { "entityType": "#.self.id", "businessKey": "#.input.change.after.businessKey", "data": "#.input.change.after.data" } }],
                                    [{ "$eq": ["#.input.change.operation", "delete"] }, { "operation": "delete", "input": { "before": "#.input.change.before" } }],
                                    ["else", { "operation": "update", "input": { "before": "#.input.change.before", "key": "#.input.change.key", "value": "#.input.change.value" } }]
                                ]
                            }
                        },
                        {
                            "inTransaction": [
                                {
                                    "outputKey": "record",
                                    "inputMap": "#.store",
                                    "middleware": { "$func/slot-values": { "element": "#.self.id", "slot": "interceptors" } },
                                    "action": { "inputMap": "#.input.input", "invoke": "entity-database", "operation": "#.store.operation" }
                                },
                                {
                                    "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "reactions" } },
                                    "forEach": {
                                        "inputMap": {
                                            "$if": [{ "$eq": ["#.input.change.operation", "delete"] }, "#.input.change", { "$merge": ["#.input.change", { "after": "#.record" }] }]
                                        },
                                        "execute": "#.item"
                                    }
                                },
                                { "return": "#.record" }
                            ]
                        }
                    ]
                },
                "create": {
                    "input": { "businessKey": "string", "!body": "object", "traits": "object" },
                    "output": "@entity-record",
                    "implementation": [
                        { "inputMap": { "schemaId": { "$str": ["#.self.id", "/bodySchema"] }, "value": "#.input.body" }, "invoke": "ajv", "operation": "assert" },
                        { "outputKey": "businessKeyRule", "set": { "$func/slot-values": { "element": "#.self.id", "slot": "businessKey" } } },
                        {
                            "outputKey": "businessKey",
                            "if": "#.input.businessKey",
                            "then": { "set": "#.input.businessKey" },
                            "else": {
                                "if": "#.businessKeyRule",
                                "then": { "execute": "#.businessKeyRule" },
                                "else": { "throw": { "code": "invalid", "message": "businessKey is required" } }
                            }
                        },
                        {
                            "outputKey": "traits",
                            "inputMap": { "traits": { "$coalesce": ["#.input.traits", {}] } },
                            "invoke": "#.self.id",
                            "operation": "initialTraitValues"
                        },
                        { "outputKey": "data", "set": { "$merge": ["#.traits", { "body": "#.input.body" }] } },
                        {
                            "inputMap": {
                                "change": { "operation": "create", "after": { "businessKey": "#.businessKey", "data": "#.data" } }
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "update": {
                    "input": { "!businessKey": "string", "!revision": "number", "!body": "object" },
                    "output": "@entity-record",
                    "implementation": [
                        { "inputMap": { "schemaId": { "$str": ["#.self.id", "/bodySchema"] }, "value": "#.input.body" }, "invoke": "ajv", "operation": "assert" },
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        {
                            "inputMap": {
                                "change": { "operation": "update", "key": "body", "value": "#.input.body", "before": "#.before" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "writeTrait": {
                    "input": { "!businessKey": "string", "!revision": "number", "!key": "string", "!command": "string", "!value": "@any" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "if": { "$negate": { "$get": { "object": { "$func/entity-traits": "#.self.id" }, "path": "#.input.key" } } },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.self.id", " has no trait under the key ", "#.input.key"] } } }
                        },
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        {
                            "inputMap": {
                                "change": { "operation": "trait", "key": "#.input.key", "command": "#.input.command", "value": "#.input.value", "before": "#.before" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "delete": {
                    "input": { "!businessKey": "string", "!revision": "number" },
                    "output": "@entity-record",
                    "implementation": [
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        {
                            "inputMap": {
                                "change": { "operation": "delete", "before": "#.before" },
                                "revision": "#.input.revision"
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                }
            },
            "lifecycle": {
                "load": {
                    "if": "#.self.data.bodySchema",
                    "then": { "inputMap": { "id": { "$str": ["#.self.id", "/bodySchema"] }, "schema": "#.self.data.bodySchema" }, "invoke": "ajv", "operation": "add" }
                },
                "validate": { "$func/entity-trait-problems": "#.self.id" }
            }
        }
    }
]
