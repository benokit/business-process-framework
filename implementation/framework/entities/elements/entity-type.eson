[
    {
        "id": "entity-type",
        "kind": "kind",
        "data": {
            "shape": { "!bodySchema": "@schema" },
            "slots": {
                "traits": { "cardinality": "many", "value": "@entity-trait-use" },
                "businessKey": { "cardinality": "one", "value": "@method" },
                "guards": { "cardinality": "many", "value": "@method" },
                "interceptors": { "cardinality": "many", "value": "@method" },
                "reactions": { "cardinality": "many", "value": "@method" }
            },
            "operations": {
                "read": {
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": { "entityType": "#.self.id", "businessKey": "#.input.businessKey", "revision": "#.input.revision" },
                        "invoke": "entity-database",
                        "operation": "read"
                    }
                },
                "list": {
                    "input": { "limit": "number", "offset": "number" },
                    "output": { "!items[]": "@entity-record", "!total": "number" },
                    "implementation": {
                        "inputMap": { "entityType": "#.self.id", "limit": "#.input.limit", "offset": "#.input.offset" },
                        "invoke": "entity-database",
                        "operation": "list"
                    }
                },
                "initialTraitValues": {
                    "input": { "!traits": "object" },
                    "output": "object",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/entity-traits": "#.self.id" } },
                        {
                            "outputKey": "values",
                            "inputMap": { "$keys": "#.traits" },
                            "forEach": [
                                {
                                    "outputKey": "value",
                                    "inputMap": {
                                        "entityType": "#.self.id",
                                        "configuration": { "$get": { "_object": "#.traits", "_path": "#.item" } },
                                        "input": { "$get": { "_object": "#.input.traits", "_path": "#.item" } }
                                    },
                                    "invoke": "#.item",
                                    "operation": "initialize"
                                },
                                { "set": { "trait": "#.item", "value": "#.value" } }
                            ]
                        },
                        { "set": { "$mapValues": { "_of": { "$toDictionary": { "_by": "#.trait", "_collection": "#.values" } }, "_fn": "#.value" } } }
                    ]
                },
                "applyChange": {
                    "input": { "!change": "@entity-change", "!storeOperation=1": ["create", "update", "delete"], "!storeInput": "object" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "guards" } },
                            "forEach": { "inputMap": "#.input.change", "execute": "#.item" }
                        },
                        {
                            "inTransaction": [
                                { "outputKey": "storeOperation", "set": "#.input.storeOperation" },
                                {
                                    "outputKey": "record",
                                    "inputMap": { "$merge": ["#.input.storeInput", { "entityType": "#.self.id" }] },
                                    "middleware": { "$func/slot-values": { "element": "#.self.id", "slot": "interceptors" } },
                                    "action": { "invoke": "entity-database", "operation": "#.storeOperation" }
                                },
                                {
                                    "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "reactions" } },
                                    "forEach": {
                                        "inputMap": {
                                            "$conditional": {
                                                "_if": { "$eq": ["#.input.change.operation", "delete"] },
                                                "_then": "#.input.change",
                                                "_else": { "$merge": ["#.input.change", { "after": "#.record" }] }
                                            }
                                        },
                                        "execute": "#.item"
                                    }
                                },
                                { "return": "#.record" }
                            ]
                        }
                    ]
                },
                "create": {
                    "input": { "businessKey": "string", "!body": "object", "traits": "object" },
                    "output": "@entity-record",
                    "implementation": [
                        { "inputMap": { "schemaId": { "$join": { "_strings": ["#.self.id", "/bodySchema"] } }, "value": "#.input.body" }, "invoke": "ajv", "operation": "assert" },
                        { "outputKey": "businessKeyRule", "set": { "$func/slot-values": { "element": "#.self.id", "slot": "businessKey" } } },
                        {
                            "outputKey": "businessKey",
                            "if": "#.input.businessKey",
                            "then": { "set": "#.input.businessKey" },
                            "else": {
                                "if": "#.businessKeyRule",
                                "then": { "execute": "#.businessKeyRule" },
                                "else": { "throw": { "code": "invalid", "message": "businessKey is required" } }
                            }
                        },
                        {
                            "outputKey": "traits",
                            "inputMap": { "traits": { "$coalesce": ["#.input.traits", {}] } },
                            "invoke": "#.self.id",
                            "operation": "initialTraitValues"
                        },
                        { "outputKey": "data", "set": { "$merge": ["#.traits", { "body": "#.input.body" }] } },
                        {
                            "inputMap": {
                                "change": { "operation": "create", "after": { "businessKey": "#.businessKey", "data": "#.data" } },
                                "storeOperation": "create",
                                "storeInput": { "businessKey": "#.businessKey", "data": "#.data" }
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "update": {
                    "input": { "!businessKey": "string", "!revision": "number", "!body": "object" },
                    "output": "@entity-record",
                    "implementation": [
                        { "inputMap": { "schemaId": { "$join": { "_strings": ["#.self.id", "/bodySchema"] } }, "value": "#.input.body" }, "invoke": "ajv", "operation": "assert" },
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        {
                            "inputMap": {
                                "change": { "operation": "update", "trait": "body", "value": "#.input.body", "before": "#.before" },
                                "storeOperation": "update",
                                "storeInput": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "trait": "body", "value": "#.input.body" }
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "writeTrait": {
                    "input": { "!businessKey": "string", "revision": "number", "!trait": "string", "!command": "string", "!value": "@any" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "if": { "$negate": { "$get": { "_object": { "$func/entity-traits": "#.self.id" }, "_path": "#.input.trait" } } },
                            "then": { "throw": { "code": "invalid", "message": { "$join": { "_strings": ["#.self.id", "\\ has no trait ", "#.input.trait"] } } } }
                        },
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        {
                            "inputMap": {
                                "change": { "operation": "trait", "trait": "#.input.trait", "command": "#.input.command", "value": "#.input.value", "before": "#.before" },
                                "storeOperation": "update",
                                "storeInput": {
                                    "businessKey": "#.input.businessKey",
                                    "revision": { "$coalesce": ["#.input.revision", "#.before.revision"] },
                                    "trait": "#.input.trait",
                                    "value": "#.input.value"
                                }
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                },
                "delete": {
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@entity-record",
                    "implementation": [
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        {
                            "inputMap": {
                                "change": { "operation": "delete", "before": "#.before" },
                                "storeOperation": "delete",
                                "storeInput": { "businessKey": "#.input.businessKey", "revision": "#.input.revision" }
                            },
                            "invoke": "#.self.id",
                            "operation": "applyChange"
                        }
                    ]
                }
            },
            "lifecycle": {
                "load": { "inputMap": { "id": { "$join": { "_strings": ["#.self.id", "/bodySchema"] } }, "schema": "#.self.data.bodySchema" }, "invoke": "ajv", "operation": "add" },
                "validate": { "$func/entity-trait-problems": "#.self.id" }
            }
        }
    }
]
