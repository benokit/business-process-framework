[
    {
        "id": "entity-trait-use",
        "kind": "schema",
        "data": { "!trait": "string", "!configuration": "@any" }
    },
    {
        "id": "entity-trait",
        "kind": "kind",
        "data": {
            "shape": { "!configuration": "@schema" },
            "operations": {
                "initialize": { "input": { "!entityType": "string", "!configuration": "@any", "input": "@any" }, "output": "@any" }
            },
            "lifecycle": {
                "load": {
                    "inputMap": { "id": { "$join": { "_strings": ["#.self.id", "/configuration"] } }, "schema": "#.self.data.configuration" },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "entity-traits",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "object" },
            "module": "@business-framework/entities/traits",
            "export": "traitsOf"
        }
    },
    {
        "id": "entity-trait-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entities/traits",
            "export": "traitProblems"
        }
    }
]
