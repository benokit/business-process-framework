[
    {
        "id": "entity-trait-use",
        "kind": "schema",
        "data": { "!trait": "@ref/entity-trait", "key": "string", "!configuration": "@any" }
    },
    {
        "id": "entity-trait",
        "kind": "kind",
        "data": {
            "shape": { "!configuration": "@schema", "cardinality=1": ["one", "many"] },
            "operations": {
                "initialize": { "input": { "!entityType": "string", "!key": "string", "!configuration": "@any", "input": "@any" }, "output": "@any" }
            },
            "lifecycle": {
                "load": {
                    "inputMap": { "id": { "$str": ["#.self.id", "/configuration"] }, "schema": "#.self.data.configuration" },
                    "invoke": "ajv",
                    "operation": "add"
                }
            }
        }
    },
    {
        "id": "trait-initializer",
        "kind": "kind",
        "data": {
            "operations": {
                "initialize": {
                    "input": { "!trait": "@ref/entity-trait", "!entityType": "string", "!key": "string", "!configuration": "@any", "input": "@any" },
                    "output": "@any",
                    "implementation": {
                        "inputMap": { "entityType": "#.input.entityType", "key": "#.input.key", "configuration": "#.input.configuration", "input": "#.input.input" },
                        "invoke": "#.input.trait",
                        "operation": "initialize"
                    }
                }
            }
        }
    },
    {
        "id": "entity-trait-initializer",
        "kind": "trait-initializer",
        "data": {}
    },
    {
        "id": "entity-traits",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": { "*": { "!trait": "@ref/entity-trait", "!configuration": "@any" } } },
            "module": "@business-framework/entities/traits",
            "export": "traitsOf"
        }
    },
    {
        "id": "entity-trait-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/entities/traits",
            "export": "traitProblems"
        }
    }
]
