[
    {
        "id": "entity-relation",
        "kind": "schema",
        "data": { "!targetEntityType": "string", "!targetEntityBusinessKey": "string", "!relationType": "string" }
    },
    {
        "id": "entity-relations",
        "kind": "schema",
        "data": { "!relations[]": "@entity-relation" }
    },
    {
        "id": "entity-relations-slot",
        "kind": "slot-declaration",
        "data": { "target": "entity-type", "slot": "relations", "cardinality": "many", "value": "@method" }
    },
    {
        "id": "entity-relation-target",
        "kind": "schema",
        "data": { "!targetEntityId": "string", "!relationType": "string" }
    },
    {
        "id": "set-entity-relations",
        "kind": "query",
        "data": { "input": { "!sourceEntityId": "string", "!relations[]": "@entity-relation" }, "output": "@any", "errors": ["not-found"] }
    },
    {
        "id": "entity-relations-of",
        "kind": "query",
        "data": { "input": { "!sourceEntityId": "string" }, "output": "[@entity-relation-target]" }
    },
    {
        "id": "maintain-entity-relations",
        "kind": "slot-fill",
        "data": {
            "target": "entity-type",
            "slot": "reactions",
            "value": {
                "if": { "$neq": ["#.input.operation", "delete"] },
                "then": [
                    { "outputKey": "record", "set": "#.input.after" },
                    {
                        "outputKey": "results",
                        "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "relations" } },
                        "forEach": { "inputMap": "#.record", "execute": "#.item" }
                    },
                    {
                        "inputMap": {
                            "sourceEntityId": "#.record.id",
                            "relations": { "$concat": { "$map": { "over": "#.results", "fn": "#.relations" } } }
                        },
                        "invoke": "set-entity-relations",
                        "operation": "run"
                    }
                ]
            }
        }
    }
]
