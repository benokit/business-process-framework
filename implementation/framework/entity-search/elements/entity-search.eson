[
    {
        "id": "entity-search-index",
        "kind": "schema",
        "data": { "!index": "@ref/search-index", "!mapping": "@method" }
    },
    {
        "id": "entity-search-index-slot",
        "kind": "slot-declaration",
        "data": { "target": "entity-type", "slot": "searchIndex", "cardinality": "one", "value": "@entity-search-index" }
    },
    {
        "id": "entity-search-service",
        "kind": "kind",
        "data": {
            "operations": {
                "indexRecord": {
                    "input": { "!index": "@entity-search-index", "!record": "@entity-record" },
                    "implementation": [
                        { "outputKey": "document", "inputMap": "#.input.record", "execute": "#.input.index.mapping" },
                        {
                            "inputMap": { "document": { "$merge": ["#.document", { "id": "#.input.record.id" }] } },
                            "invoke": "#.input.index.index",
                            "operation": "insertDocument"
                        }
                    ]
                },
                "index": {
                    "input": "@entity-event",
                    "implementation": [
                        { "if": { "$negate": { "$func/is-instance-of": { "element": "#.input.entityType", "kind": "entity-type" } } }, "then": { "return": null } },
                        { "outputKey": "index", "set": { "$func/slot-values": { "element": "#.input.entityType", "slot": "searchIndex" } } },
                        {
                            "if": "#.index",
                            "then": {
                                "if": { "$eq": ["#.input.eventType", "delete"] },
                                "then": { "inputMap": { "id": "#.input.id" }, "invoke": "#.index.index", "operation": "removeDocument" },
                                "else": [
                                    {
                                        "outputKey": "record",
                                        "try": { "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.input.entityType", "operation": "read" },
                                        "catch": { "if": { "$eq": ["#.error.code", "not-found"] }, "then": { "set": null }, "else": { "throw": "#.error" } }
                                    },
                                    { "if": "#.record", "then": { "inputMap": { "index": "#.index", "record": "#.record" }, "invoke": "#.self.id", "operation": "indexRecord" } }
                                ]
                            }
                        }
                    ]
                },
                "reindex": {
                    "input": { "!entityType": "string" },
                    "implementation": [
                        { "outputKey": "index", "set": { "$func/slot-values": { "element": "#.input.entityType", "slot": "searchIndex" } } },
                        { "outputKey": "records", "inputMap": { "limit": 200 }, "invoke": "#.input.entityType", "operation": "list" },
                        { "inputMap": "#.records.items", "forEach": { "inputMap": { "index": "#.index", "record": "#.item" }, "invoke": "#.self.id", "operation": "indexRecord" } },
                        { "set": null }
                    ]
                },
                "search": {
                    "input": { "!entityType": "string", "query": "string", "offset": "number", "limit": "number" },
                    "output": "@search-result",
                    "implementation": [
                        {
                            "if": { "$negate": { "$func/is-instance-of": { "element": "#.input.entityType", "kind": "entity-type" } } },
                            "then": { "throw": { "code": "not-found", "message": { "$str": ["no entity type ", "#.input.entityType"] } } }
                        },
                        { "outputKey": "index", "set": { "$func/slot-values": { "element": "#.input.entityType", "slot": "searchIndex" } } },
                        {
                            "if": { "$negate": "#.index" },
                            "then": { "throw": { "code": "not-found", "message": { "$str": ["#.input.entityType", " has no search index"] } } }
                        },
                        {
                            "inputMap": { "query": "#.input.query", "offset": "#.input.offset", "limit": "#.input.limit" },
                            "invoke": "#.index.index",
                            "operation": "search"
                        }
                    ]
                }
            }
        }
    },
    {
        "id": "entity-search",
        "kind": "entity-search-service",
        "data": {}
    },
    {
        "id": "entity-search-indexer",
        "kind": "message-consumer",
        "data": {
            "channel": "entity-events",
            "name": "entity-search-indexer",
            "handler": { "invoke": "entity-search", "operation": "index" }
        }
    }
]
