[
    {
        "id": "search-result",
        "kind": "schema",
        "data": { "!hits[]": "object", "total": "number", "offset": "number", "limit": "number" }
    },
    {
        "id": "search-query",
        "kind": "schema",
        "data": { "!indexName": "string", "query": "string", "filter": "@any", "sort[]": "string", "offset": "number", "limit": "number" }
    },
    {
        "id": "search-engine",
        "kind": "kind",
        "data": {
            "operations": {
                "configureIndex": { "input": { "!indexName": "string", "settings": "object" } },
                "deleteIndex": { "input": { "!indexName": "string" } },
                "insertDocument": { "input": { "!indexName": "string", "!document": { "!id": "string" } } },
                "removeDocument": { "input": { "!indexName": "string", "!id": "string" } },
                "search": { "input": "@search-query", "output": "@search-result" }
            },
            "lifecycle": { "startPosition": "first" }
        }
    }
]
