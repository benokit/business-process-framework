[
    {
        "id": "user",
        "kind": "entity-type",
        "data": {
            "traits": {
                "body": { "configuration": { "schema": { "!subject": "string", "username": "string", "email": "string", "roles[]": "string", "access[]": "string", "*": "@any" } } },
                "state": { "configuration": {
                    "states": { "status": { "active": true, "suspended": true } },
                    "transitions": {
                        "suspend": { "status": { "active": "suspended" } },
                        "reactivate": { "status": { "suspended": "active" } }
                    },
                    "initialStates": { "default": { "status": "active" } }
                } }
            }
        }
    },
    {
        "id": "user-administrator-actor",
        "kind": "actor",
        "data": { "grants": [{ "area": ["entities", "states"], "resource": "user" }] }
    },
    {
        "id": "known-roles",
        "kind": "slot-fill",
        "data": {
            "target": "user",
            "slot": "guards",
            "value": [
                {
                    "outputKey": "unknown",
                    "set": {
                        "$filter": {
                            "collection": {
                                "$coalesce": [
                                    {
                                        "$cond": [
                                            [{ "$eq": ["#.input.operation", "create"] }, "#.input.after.data.body.roles"],
                                            [{ "$and": [{ "$eq": ["#.input.operation", "trait"] }, { "$eq": ["#.input.key", "body"] }] }, "#.input.value.roles"],
                                            ["else", []]
                                        ]
                                    },
                                    []
                                ]
                            },
                            "as": "role",
                            "predicate": { "$not": { "$func/is-instance-of": { "element": "@role", "kind": "role" } } }
                        }
                    }
                },
                {
                    "if": { "$head": "#.unknown" },
                    "then": { "throw": { "code": "invalid", "message": { "$str": ["unknown roles: ", { "$join": { "strings": "#.unknown", "separator": ", " } }] } } }
                }
            ]
        }
    },
    {
        "id": "subject-is-business-key",
        "kind": "slot-fill",
        "data": { "target": "user", "slot": "businessKey", "value": { "set": "#.input.traits.body.subject" } }
    }
]
