[
    {
        "id": "user",
        "kind": "entity-type",
        "data": {
            "bodySchema": { "!subject": "string", "username": "string", "email": "string", "roles[]": "string" }
        }
    },
    {
        "id": "user-lifecycle",
        "kind": "slot-fill",
        "data": {
            "target": "user",
            "slot": "traits",
            "value": {
                "trait": "state",
                "configuration": {
                    "states": { "status": ["active", "suspended"] },
                    "transitions": {
                        "suspend": { "from": { "status": ["active"] }, "to": { "status": "suspended" } },
                        "reactivate": { "from": { "status": ["suspended"] }, "to": { "status": "active" } }
                    },
                    "initialStates": { "default": { "status": "active" } }
                }
            }
        }
    },
    {
        "id": "known-roles",
        "kind": "slot-fill",
        "data": {
            "target": "user",
            "slot": "guards",
            "value": [
                {
                    "outputKey": "unknown",
                    "set": {
                        "$filter": {
                            "collection": {
                                "$coalesce": [
                                    {
                                        "$cond": [
                                            [{ "$eq": ["#.input.operation", "create"] }, "#.input.after.data.body.roles"],
                                            [{ "$eq": ["#.input.operation", "update"] }, "#.input.value.roles"],
                                            ["else", []]
                                        ]
                                    },
                                    []
                                ]
                            },
                            "as": "role",
                            "predicate": { "$not": { "$func/is-instance-of": { "element": "@role", "kind": "role" } } }
                        }
                    }
                },
                {
                    "if": { "$head": "#.unknown" },
                    "then": { "throw": { "code": "invalid", "message": { "$str": ["unknown roles: ", { "$join": { "strings": "#.unknown", "separator": ", " } }] } } }
                }
            ]
        }
    },
    {
        "id": "subject-is-business-key",
        "kind": "slot-fill",
        "data": { "target": "user", "slot": "businessKey", "value": { "set": "#.input.body.subject" } }
    }
]
