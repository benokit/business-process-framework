[
    {
        "id": "user",
        "kind": "entity-type",
        "data": {
            "bodySchema": { "!subject": "string", "username": "string", "email": "string", "roles[]": "string" }
        }
    },
    {
        "id": "user-lifecycle",
        "kind": "slot-fill",
        "data": {
            "target": "user",
            "slot": "traits",
            "value": {
                "trait": "state",
                "configuration": {
                    "states": { "status": ["active", "suspended"] },
                    "transitions": {
                        "suspend": { "from": { "status": ["active"] }, "to": { "status": "suspended" } },
                        "reactivate": { "from": { "status": ["suspended"] }, "to": { "status": "active" } }
                    },
                    "initialStates": { "default": { "status": "active" } }
                }
            }
        }
    },
    {
        "id": "subject-is-business-key",
        "kind": "slot-fill",
        "data": { "target": "user", "slot": "businessKey", "value": { "set": "#.input.body.subject" } }
    }
]
