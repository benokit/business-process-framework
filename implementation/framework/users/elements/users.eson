[
    {
        "id": "user-entity-type",
        "kind": "kind",
        "data": {
            "extends": "entity-type",
            "operations": {
                "identify": {
                    "input": { "!subject": "string", "username": "string", "email": "string" },
                    "output": "@entity-record",
                    "implementation": {
                        "try": { "inputMap": { "businessKey": "#.input.subject" }, "invoke": "#.self.id", "operation": "read" },
                        "catch": {
                            "if": { "$neq": ["#.error.code", "not-found"] },
                            "then": { "throw": "#.error" },
                            "else": {
                                "try": { "inputMap": { "body": "#.input" }, "invoke": "#.self.id", "operation": "create" },
                                "catch": {
                                    "if": { "$neq": ["#.error.code", "conflict"] },
                                    "then": { "throw": "#.error" },
                                    "else": { "inputMap": { "businessKey": "#.input.subject" }, "invoke": "#.self.id", "operation": "read" }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    {
        "id": "user",
        "kind": "user-entity-type",
        "data": {
            "bodySchema": { "!subject": "string", "username": "string", "email": "string", "roles[]": "string" }
        }
    },
    {
        "id": "user-lifecycle",
        "kind": "slot-fill",
        "data": {
            "target": "user",
            "slot": "traits",
            "value": {
                "trait": "state",
                "configuration": {
                    "states": { "status": ["active", "suspended"] },
                    "transitions": {
                        "suspend": { "from": { "status": ["active"] }, "to": { "status": "suspended" } },
                        "reactivate": { "from": { "status": ["suspended"] }, "to": { "status": "active" } }
                    },
                    "initialStates": { "default": { "status": "active" } }
                }
            }
        }
    },
    {
        "id": "subject-is-business-key",
        "kind": "slot-fill",
        "data": { "target": "user", "slot": "businessKey", "value": { "set": "#.input.body.subject" } }
    }
]
