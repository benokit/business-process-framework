[
    {
        "id": "entity-transition-endpoint",
        "kind": "http-endpoint",
        "data": {
            "method": "POST",
            "path": "/entities/:entityType/:businessKey/transitions/:transition",
            "target": { "element": "entity-states", "operation": "transition" },
            "operation": { "area": "states", "resource": "#.input.entityType", "action": "#.input.transition" },
            "request": {
                "entityType": "#.params.entityType",
                "businessKey": "#.params.businessKey",
                "revision": { "$func/if-match-revision": "#.headers.if-match" },
                "transition": "#.params.transition"
            },
            "response": { "headers": { "ETag": { "$func/revision-etag": "#.output.revision" } }, "body": "#.output" }
        }
    }
]
