[
    {
        "id": "sequence-generator",
        "kind": "kind",
        "data": {
            "operations": {
                "next": {
                    "input": { "!sequence": "string:^[a-zA-Z0-9_-]+$" },
                    "output": { "!value": "number" },
                    "implementation": { "invoke": "next-sequence-value", "operation": "run" }
                }
            }
        }
    },
    {
        "id": "next-sequence-value",
        "kind": "query",
        "data": { "input": { "!sequence": "string:^[a-zA-Z0-9_-]+$" }, "output": { "!value": "number" } }
    },
    {
        "id": "default-sequence-generator",
        "kind": "sequence-generator",
        "data": {}
    },
    {
        "id": "next-from-sequence",
        "kind": "execution-node-template",
        "data": {
            "keyword": "nextFromSequence",
            "node": { "!nextFromSequence": "string" },
            "implementation": [
                { "outputKey": "next", "inputMap": { "sequence": "#.node.nextFromSequence" }, "invoke": "default-sequence-generator", "operation": "next" },
                { "set": "#.next.value" }
            ]
        }
    }
]
