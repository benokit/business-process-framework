[
    {
        "id": "transaction-manager",
        "kind": "kind",
        "data": {
            "shape": { "!isolation=1": ["read committed", "repeatable read", "serializable"] },
            "operations": {
                "begin": {
                    "input": "@any",
                    "output": "@database-session",
                    "implementation": { "inputMap": { "isolation": "#.self.data.isolation" }, "invoke": { "instanceOf": "database" }, "operation": "begin" }
                },
                "commit": {
                    "input": "@database-session",
                    "implementation": [
                        { "invoke": { "instanceOf": "database" }, "operation": "commit" },
                        { "low": { "module": "@business-framework/transaction", "export": "runAfterCommit", "effects": [] } }
                    ]
                },
                "rollback": {
                    "input": "@database-session",
                    "implementation": [
                        { "low": { "module": "@business-framework/transaction", "export": "dropAfterCommit", "effects": [] } },
                        { "invoke": { "instanceOf": "database" }, "operation": "rollback" }
                    ]
                }
            }
        }
    },
    {
        "id": "transaction",
        "kind": "transaction-manager",
        "data": { "isolation": "read committed" }
    },
    {
        "id": "in-transaction",
        "kind": "transaction-execution-node-wrapper",
        "data": {
            "keyword": "inTransaction",
            "node": { "!inTransaction": "@method" },
            "effects": { "bound": ["read", "write", "trace"] },
            "implementation": {
                "if": "#._ctx.transaction",
                "then": { "next": true },
                "else": [
                    { "outputKey": "session", "invoke": "transaction", "operation": "begin" },
                    {
                        "try": [
                            { "outputKey": "result", "withContext": { "transaction": "#.session" }, "do": { "next": true } },
                            { "inputMap": "#.session", "invoke": "transaction", "operation": "commit" },
                            { "return": "#.result" }
                        ],
                        "catch": [
                            { "inputMap": "#.session", "invoke": "transaction", "operation": "rollback" },
                            { "throw": "#.error" }
                        ]
                    }
                ]
            }
        }
    },
    {
        "id": "after-commit",
        "kind": "execution-node-template",
        "data": {
            "keyword": "afterCommit",
            "node": { "!afterCommit": "@method" },
            "effects": { "defers": true },
            "implementation": {
                "inputMap": { "method": "#.node.afterCommit", "input": "#.input", "self": "#.self" },
                "low": { "module": "@business-framework/transaction", "export": "afterCommit", "effects": [] }
            }
        }
    }
]
