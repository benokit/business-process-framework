[
    {
        "id": "express-http-server",
        "kind": "kind",
        "data": {
            "settings": { "shape": { "port": "integer" }, "defaults": { "port": 3000 } },
            "operations": {
                "registerRoute": {
                    "input": { "!method": "string", "!path": "string", "!endpoint": "string" },
                    "implementation": { "low": { "module": "@business-framework/http-server", "export": "registerRoute", "effects": ["irreversible"] } }
                },
                "address": {
                    "input": "@any",
                    "output": { "!port": "number" },
                    "implementation": { "low": { "module": "@business-framework/http-server", "export": "address", "effects": ["read"] } }
                }
            },
            "lifecycle": {
                "start": {
                    "inputMap": { "$func/settings": "#.self.id" },
                    "low": { "module": "@business-framework/http-server", "export": "listen", "effects": ["irreversible"] }
                },
                "stop": { "low": { "module": "@business-framework/http-server", "export": "close", "effects": ["irreversible"] } },
                "startPosition": "last"
            }
        }
    },
    {
        "id": "http-server",
        "kind": "express-http-server",
        "data": {}
    }
]
