[
    {
        "id": "http-request",
        "kind": "schema",
        "data": { "!headers": "object", "params": "object", "query": "object", "body": "@any" }
    },
    {
        "id": "http-response",
        "kind": "schema",
        "data": { "status": "number", "headers": "object", "body": "@any" }
    },
    {
        "id": "http-endpoint",
        "kind": "kind",
        "data": {
            "extends": "entry-point",
            "shape": {
                "!method=1": ["GET", "POST", "PUT", "PATCH", "DELETE"],
                "!path": "string",
                "!target": { "!element": "@ref", "!operation": "string" },
                "body": "@schema",
                "operation": "@mapping",
                "public": "boolean",
                "request": "@mapping",
                "response": "@mapping"
            },
            "slots": {
                "requestMiddleware": { "cardinality": "many", "value": "@method", "input": "@http-request" }
            },
            "operations": {
                "handle": {
                    "input": "@http-request",
                    "output": "@http-response",
                    "implementation": [
                        {
                            "outputKey": "correlation",
                            "inputMap": "#.input.headers",
                            "low": { "module": "@business-framework/http-server", "export": "correlationOf", "effects": ["read"] }
                        },
                        {
                            "withContext": { "trace": { "correlation": "#.correlation" } },
                            "do": {
                                "middleware": { "$func/slot-values": { "element": "#.self.id", "slot": "requestMiddleware" } },
                                "action": [
                                    {
                                        "if": "#.self.data.body",
                                        "then": {
                                            "inputMap": { "schemaId": { "$str": ["#.self.id", "/body"] }, "value": "#.input.body" },
                                            "invoke": "ajv",
                                            "operation": "assert"
                                        }
                                    },
                                    {
                                        "outputKey": "output",
                                        "inputMap": { "$func/apply-mapping": { "mapping": { "$coalesce": ["#.self.data.request", { "$literal": "#.body" }] }, "input": "#.input" } },
                                        "invoke": "#.self.data.target.element",
                                        "operation": "#.self.data.target.operation"
                                    },
                                    {
                                        "set": {
                                            "$func/apply-mapping": {
                                                "mapping": { "$coalesce": ["#.self.data.response", { "$literal": { "body": "#.output" } }] },
                                                "input": { "output": "#.output", "request": "#.input" }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            "lifecycle": {
                "validate": {
                    "$concat": [
                        {
                            "$cond": [
                                [{ "$not": { "$func/has-operation": "#.self.data.target" } }, [{ "$str": ["target ", "#.self.data.target.element", " has no operation ", "#.self.data.target.operation"] }]],
                                [{ "$eq": ["#.self.data.method", "GET"] }, { "$map": { "over": { "$func/changes-of": "#.self.data.target" }, "as": "change", "fn": { "$str": ["a GET target changes state, ", "@change"] } } }],
                                ["else", []]
                            ]
                        },
                        {
                            "$cond": [
                                [{ "$and": [{ "$not": "#.self.data.body" }, { "$neq": ["#.self.data.method", "GET"] }, { "$neq": ["#.self.data.method", "DELETE"] }] }, ["declares no body schema"]],
                                ["else", []]
                            ]
                        },
                        {
                            "$cond": [
                                [{ "$and": ["#.self.data.operation", "#.self.data.public"] }, ["declares both an operation and public"]],
                                [{ "$or": ["#.self.data.operation", "#.self.data.public"] }, []],
                                ["else", ["declares neither an operation nor public"]]
                            ]
                        }
                    ]
                },
                "load": {
                    "if": "#.self.data.body",
                    "then": { "inputMap": { "id": { "$str": ["#.self.id", "/body"] }, "schema": "#.self.data.body" }, "invoke": "ajv", "operation": "add" }
                },
                "start": {
                    "inputMap": { "method": "#.self.data.method", "path": "#.self.data.path", "endpoint": "#.self.id" },
                    "invoke": "http-server",
                    "operation": "registerRoute"
                }
            }
        }
    }
]
