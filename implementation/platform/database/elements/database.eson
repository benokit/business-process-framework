[
    {
        "id": "sql-command",
        "kind": "schema",
        "data": { "!command": "string", "parameters": { "$data#": ["[@any]", "object"] } }
    },
    {
        "id": "sql-result",
        "kind": "schema",
        "data": { "!rows[]": "object", "rowCount": { "$data#": ["number", "null"] } }
    },
    {
        "id": "database-session",
        "kind": "schema",
        "data": { "!sessionId": "number" }
    },
    {
        "id": "migration",
        "kind": "schema",
        "data": { "command": "string", "run": "@method" }
    },
    {
        "id": "identified-migration",
        "kind": "schema",
        "data": { "!id": "string", "command": "string", "run": "@method" }
    },
    {
        "id": "migrations-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[@identified-migration]" },
            "module": "@business-framework/database/migrations",
            "export": "migrationsOf"
        }
    },
    {
        "id": "migration-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[string]" },
            "module": "@business-framework/database/migrations",
            "export": "migrationProblems"
        }
    },
    {
        "id": "database",
        "kind": "kind",
        "data": {
            "operations": {
                "read": { "input": "@sql-command", "output": "@sql-result" },
                "execute": { "input": "@sql-command", "output": "@sql-result" },
                "executeIrreversible": { "input": "@sql-command", "output": "@sql-result" },
                "begin": { "input": { "!isolation=1": ["read committed", "repeatable read", "serializable"] }, "output": "@database-session" },
                "commit": { "input": "@database-session" },
                "rollback": { "input": "@database-session" },
                "migrate": {
                    "input": "@any",
                    "output": { "!applied[]": "string" },
                    "implementation": [
                        {
                            "inputMap": { "command": "CREATE TABLE IF NOT EXISTS migrations (id TEXT PRIMARY KEY, applied_utc TIMESTAMPTZ NOT NULL DEFAULT now())" },
                            "invoke": "#.self.id",
                            "operation": "executeIrreversible"
                        },
                        { "outputKey": "recorded", "inputMap": { "command": "SELECT id FROM migrations" }, "invoke": "#.self.id", "operation": "read" },
                        {
                            "outputKey": "pending",
                            "set": {
                                "$filter": {
                                    "collection": { "$func/migrations-of": "#.self.id" },
                                    "as": "migration",
                                    "predicate": { "$not": { "$includes": { "collection": { "$map": { "over": "#.recorded.rows", "as": "row", "fn": "@row.id" } }, "value": "@migration.id" } } }
                                }
                            }
                        },
                        {
                            "inputMap": "#.pending",
                            "forEach": [
                                {
                                    "if": "#.item.command",
                                    "then": { "inputMap": { "command": "#.item.command" }, "invoke": "#.self.id", "operation": "executeIrreversible" },
                                    "else": { "execute": "#.item.run" }
                                },
                                { "inputMap": { "command": "INSERT INTO migrations (id) VALUES ($1)", "parameters": ["#.item.id"] }, "invoke": "#.self.id", "operation": "executeIrreversible" }
                            ]
                        },
                        { "set": { "applied": { "$map": { "over": "#.pending", "as": "migration", "fn": "@migration.id" } } } }
                    ]
                }
            },
            "slots": {
                "migrations": { "cardinality": "many", "value": "@migration" }
            },
            "lifecycle": {
                "startPosition": "first",
                "validate": { "$func/migration-problems": "#.self.id" }
            }
        }
    },
    {
        "id": "transaction-execution-node-wrapper",
        "kind": "kind",
        "data": {
            "extends": "execution-node-wrapper",
            "context": { "manages": { "transaction": "@database-session" } }
        }
    },
    {
        "id": "query",
        "kind": "kind",
        "data": { "extends": "integration", "fixed": { "provider": "database" } }
    },
    {
        "id": "statement",
        "kind": "execution-node-template",
        "data": {
            "keyword": "statement",
            "node": { "!statement": "@mapping", "parameters": "@mapping", "row": "@mapping", "read": "boolean", "irreversible": "boolean" },
            "implementation": [
                {
                    "outputKey": "command",
                    "set": {
                        "command": { "$func/apply-mapping": { "mapping": "#.node.statement", "input": "#.input" } },
                        "parameters": { "$coalesce": [{ "$func/apply-mapping": { "mapping": "#.node.parameters", "input": "#.input" } }, []] }
                    }
                },
                {
                    "outputKey": "result",
                    "if": "#.node.read",
                    "then": { "inputMap": "#.command", "invoke": { "instanceOf": "database" }, "operation": "read" },
                    "else": {
                        "if": "#.node.irreversible",
                        "then": { "inputMap": "#.command", "invoke": { "instanceOf": "database" }, "operation": "executeIrreversible" },
                        "else": { "inputMap": "#.command", "invoke": { "instanceOf": "database" }, "operation": "execute" }
                    }
                },
                {
                    "if": "#.node.row",
                    "then": { "inputMap": "#.result.rows", "forEach": { "set": { "$func/apply-mapping": { "mapping": "#.node.row", "input": "#.item" } } } },
                    "else": { "set": "#.result.rows" }
                }
            ]
        }
    }
]
