[
    {
        "id": "authorization-dimension",
        "kind": "schema",
        "data": { "!name": "string", "default": "@mapping", "parents": "@mapping", "values": "@mapping" }
    },
    {
        "id": "grant-box",
        "kind": "schema",
        "data": { "*": { "$data#": ["string", "[string]"] } }
    },
    {
        "id": "grant",
        "kind": "schema",
        "data": { "except[]": "@grant-box", "*": { "$data#": ["string", "[string]"] } }
    },
    {
        "id": "actor",
        "kind": "kind",
        "data": { "shape": { "!grants[]": "@grant" } }
    },
    {
        "id": "role",
        "kind": "kind",
        "data": { "shape": { "actors[]": "@ref/actor", "roles[]": "@ref/role", "grants[]": "@grant" } }
    },
    {
        "id": "authorization-problems",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[@any]" },
            "module": "@business-framework/authorization/authorization",
            "export": "authorizationProblems"
        }
    },
    {
        "id": "authorization-explanation",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!authorization": "string", "!element": "string" }, "output": "@any" },
            "module": "@business-framework/authorization/authorization",
            "export": "authorizationExplanation"
        }
    },
    {
        "id": "endpoint-operation",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!endpoint": "string", "!request": "@http-request" }, "output": "{string}" },
            "module": "@business-framework/authorization/authorization",
            "export": "endpointOperation"
        }
    },
    {
        "id": "permits",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!operation": "object", "!roles[]": "string" }, "output": "boolean" },
            "module": "@business-framework/authorization/authorization",
            "export": "permits"
        }
    },
    {
        "id": "authorization-execution-node-wrapper",
        "kind": "kind",
        "data": {
            "extends": "execution-node-wrapper",
            "context": { "manages": { "operation": "object" } }
        }
    },
    {
        "id": "authorize",
        "kind": "authorization-execution-node-wrapper",
        "data": {
            "keyword": "authorized",
            "node": { "!authorized": "@method" },
            "implementation": {
                "if": "#.self.data.public",
                "then": { "next": true },
                "else": [
                    {
                        "if": { "$negate": "#._ctx.user" },
                        "then": { "throw": { "code": "unauthorized", "message": "authentication required" } }
                    },
                    { "outputKey": "operation", "set": { "$func/endpoint-operation": { "endpoint": "#.self.id", "request": "#.input" } } },
                    {
                        "if": { "$negate": { "$func/permits": { "operation": "#.operation", "roles": { "$coalesce": ["#._ctx.user.roles", []] } } } },
                        "then": { "throw": { "code": "forbidden", "message": "no role of the user permits the operation", "data": { "operation": "#.operation" } } }
                    },
                    { "withContext": { "operation": "#.operation" }, "do": { "next": true } }
                ]
            }
        }
    },
    {
        "id": "authorize-requests",
        "kind": "slot-fill",
        "data": {
            "target": "http-endpoint",
            "slot": "requestMiddleware",
            "position": "first",
            "after": ["authenticate-requests"],
            "value": { "authorized": { "next": true } }
        }
    },
    {
        "id": "authorization",
        "kind": "kind",
        "data": {
            "slots": {
                "dimensions": { "cardinality": "many", "value": "@authorization-dimension" }
            },
            "lifecycle": {
                "validate": { "$func/authorization-problems": "#.self.id" },
                "explain": { "$func/authorization-explanation": { "authorization": "#.self.id", "element": "#.element" } }
            }
        }
    },
    {
        "id": "default-authorization",
        "kind": "authorization",
        "data": {}
    },
    {
        "id": "area-dimension",
        "kind": "slot-fill",
        "data": { "target": "authorization", "slot": "dimensions", "value": { "name": "area" } }
    },
    {
        "id": "resource-dimension",
        "kind": "slot-fill",
        "data": {
            "target": "authorization",
            "slot": "dimensions",
            "after": ["area-dimension"],
            "value": { "name": "resource", "parents": { "$func/kind-chain": "#" } }
        }
    },
    {
        "id": "action-dimension",
        "kind": "slot-fill",
        "data": {
            "target": "authorization",
            "slot": "dimensions",
            "after": ["resource-dimension"],
            "value": {
                "name": "action",
                "parents": {
                    "$cond": [
                        [{ "$includes": { "collection": ["query", "command"], "value": "#" } }, []],
                        [{ "$includes": { "collection": ["read", "search"], "value": "#" } }, ["query"]],
                        ["else", ["command"]]
                    ]
                }
            }
        }
    }
]
