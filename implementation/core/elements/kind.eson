[
    {
        "id": "kind",
        "kind": "kind",
        "data": {
            "shape": {
                "extends": "@ref/kind",
                "shape": "@schema",
                "defaults": "object",
                "operations{}": "@operation",
                "slots{}": "@slot",
                "context": { "manages": "@schema" },
                "lifecycle": {
                    "load": "@method",
                    "start": "@method",
                    "stop": "@method",
                    "validate": "@mapping",
                    "explain": "@mapping",
                    "startAfter[]": "@ref/kind",
                    "startBefore[]": "@ref/kind",
                    "startPosition=1": ["first", "last"]
                }
            },
            "lifecycle": {
                "load": [
                    { "outputKey": "problems", "set": { "$func/check-kind": "#.self" } },
                    {
                        "if": { "$head": "#.problems" },
                        "then": { "throw": { "$str": ["kind ", "#.self.id", ": ", { "$join": { "strings": "#.problems", "separator": "; " } }] } }
                    },
                    { "inputMap": { "id": { "$str": ["ref/", "#.self.id"] }, "schema": "\\@element-ref" }, "invoke": "ajv", "operation": "add" },
                    { "inputMap": { "id": { "$str": ["ref/kind/", "#.self.id"] }, "schema": "string" }, "invoke": "ajv", "operation": "add" },
                    {
                        "if": "#.self.data.shape",
                        "then": { "inputMap": { "id": "#.self.id", "schema": "#.self.data.shape" }, "invoke": "ajv", "operation": "add" }
                    },
                    {
                        "inputMap": { "$keys": { "$coalesce": ["#.self.data.operations", {}] } },
                        "forEach": [
                            { "outputKey": "contract", "set": { "$get": { "object": "#.self.data.operations", "path": "#.item" } } },
                            { "outputKey": "prefix", "set": { "$str": ["#.self.id", "/", "#.item", "/"] } },
                            {
                                "if": "#.contract.input",
                                "then": {
                                    "inputMap": { "id": { "$str": ["#.prefix", "input"] }, "schema": "#.contract.input" },
                                    "invoke": "ajv", "operation": "add"
                                }
                            },
                            {
                                "if": "#.contract.output",
                                "then": {
                                    "inputMap": { "id": { "$str": ["#.prefix", "output"] }, "schema": "#.contract.output" },
                                    "invoke": "ajv", "operation": "add"
                                }
                            }
                        ]
                    },
                    {
                        "if": "#.self.data.context.manages",
                        "then": {
                            "inputMap": { "id": { "$str": ["#.self.id", "/context/manages"] }, "schema": "#.self.data.context.manages" },
                            "invoke": "ajv", "operation": "add"
                        }
                    },
                    {
                        "inputMap": { "$keys": { "$coalesce": ["#.self.data.slots", {}] } },
                        "forEach": [
                            { "outputKey": "slot", "set": { "$get": { "object": "#.self.data.slots", "path": "#.item" } } },
                            { "inputMap": { "id": { "$str": ["#.self.id", "/slots/", "#.item"] }, "schema": "#.slot.value" }, "invoke": "ajv", "operation": "add" },
                            {
                                "if": "#.slot.input",
                                "then": { "inputMap": { "id": { "$str": ["#.self.id", "/slots/", "#.item", "/input"] }, "schema": "#.slot.input" }, "invoke": "ajv", "operation": "add" }
                            }
                        ]
                    }
                ]
            }
        }
    },
    {
        "id": "data",
        "kind": "kind",
        "data": {}
    },
    {
        "id": "check-kind",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "module": "@business-framework/core/kinds",
            "export": "checkKind"
        }
    },
    {
        "id": "operation",
        "kind": "schema",
        "data": { "input": "@schema", "output": "@schema", "implementation": "@method" }
    },
    {
        "id": "slot",
        "kind": "schema",
        "data": { "!cardinality=1": ["one", "many"], "!value": "@schema", "effects[]": "@effect", "input": "@schema" }
    },
    {
        "id": "effect",
        "kind": "schema",
        "data": { "$data=1": ["read", "write", "irreversible", "trace"] }
    },
    {
        "id": "method",
        "kind": "schema",
        "data": { "$data#": ["object", "[object]"] }
    },
    {
        "id": "any",
        "kind": "schema",
        "data": {}
    },
    {
        "id": "mapping",
        "kind": "schema",
        "data": {}
    }
]
