[
    {
        "id": "pure-function",
        "kind": "kind",
        "data": {
            "shape": {
                "$data#&": [
                    { "signature": { "!input": "@schema", "!output": "@schema" } },
                    { "$data#1": ["@js-export", { "!mapping": "@mapping" }] }
                ]
            }
        }
    },
    {
        "id": "js-export",
        "kind": "schema",
        "data": { "!module": "string", "!export": "string" }
    },
    {
        "id": "execution-node-template",
        "kind": "kind",
        "data": {
            "shape": { "!keyword": "string", "node": "@schema", "effects": { "bound[]": "@effect", "defers": "boolean" }, "!implementation": "@method" },
            "lifecycle": {
                "load": {
                    "if": "#.self.data.node",
                    "then": { "inputMap": { "id": { "$join": { "_strings": ["#.self.id", "/node"] } }, "schema": "#.self.data.node" }, "invoke": "ajv", "operation": "add" }
                }
            }
        }
    },
    {
        "id": "execution-node-wrapper",
        "kind": "kind",
        "data": { "extends": "execution-node-template" }
    },
    {
        "id": "apply-mapping",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!mapping": "@any", "input": "@any" }, "output": "@any" },
            "module": "@business-framework/core/mappings",
            "export": "applyMapping"
        }
    },
    {
        "id": "is-instance-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!element": "string", "!kind": "string" }, "output": "boolean" },
            "module": "@business-framework/core/kinds",
            "export": "isInstanceOf"
        }
    },
    {
        "id": "has-operation",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!element": "string", "!operation": "string" }, "output": "boolean" },
            "module": "@business-framework/core/kinds",
            "export": "hasOperation"
        }
    },
    {
        "id": "changes-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!element": "string", "!operation": "string" }, "output": "[string]" },
            "module": "@business-framework/core/effects",
            "export": "changesOf"
        }
    },
    {
        "id": "instances-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[object]" },
            "module": "@business-framework/core/kinds",
            "export": "selvesOf"
        }
    }
]
