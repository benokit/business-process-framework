[
    {
        "id": "executable",
        "kind": "kind",
        "data": { "shape": "@method" }
    },
    {
        "id": "pure-function",
        "kind": "kind",
        "data": { "shape": { "signature": { "!input": "@schema", "!output": "@schema" }, "!implementation": "@any" } }
    },
    {
        "id": "execution-node-template",
        "kind": "kind",
        "data": { "shape": { "!keyword": "string", "!implementation": "@method" } }
    },
    {
        "id": "execution-node-wrapper",
        "kind": "kind",
        "data": { "extends": "execution-node-template" }
    },
    {
        "id": "apply-mapping",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!mapping": "@any", "input": "@any" }, "output": "@any" },
            "implementation": { "module": "@business-framework/core/mappings", "export": "applyMapping" }
        }
    },
    {
        "id": "is-instance-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!element": "string", "!kind": "string" }, "output": "boolean" },
            "implementation": { "module": "@business-framework/core/kinds", "export": "isInstanceOf" }
        }
    },
    {
        "id": "instances-of",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "string", "output": "[object]" },
            "implementation": { "module": "@business-framework/core/kinds", "export": "selvesOf" }
        }
    },
    {
        "id": "assert-valid",
        "kind": "executable",
        "data": [
            { "outputKey": "result", "set": { "$func/schema-validate": { "schemaId": "#.input.schemaId", "value": "#.input.value" } } },
            {
                "if": { "$negate": "#.result.isValid" },
                "then": { "throw": { "code": "invalid", "message": { "$join": { "_strings": ["\\value doesn't match ", "#.input.schemaId"] } }, "data": { "errors": "#.result.errors" } } }
            },
            { "set": "#.input.value" }
        ]
    }
]
