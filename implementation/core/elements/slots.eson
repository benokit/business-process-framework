[
    {
        "id": "slot-declaration",
        "kind": "kind",
        "data": {
            "shape": { "!target": "@ref", "!slot": "string", "!cardinality=1": ["one", "many"], "!value": "@schema", "input": "@schema" },
            "lifecycle": {
                "load": [
                    {
                        "inputMap": { "id": { "$str": ["#.self.data.target", "/slots/", "#.self.data.slot"] }, "schema": "#.self.data.value" },
                        "invoke": "ajv", "operation": "add"
                    },
                    {
                        "if": "#.self.data.input",
                        "then": {
                            "inputMap": { "id": { "$str": ["#.self.data.target", "/slots/", "#.self.data.slot", "/input"] }, "schema": "#.self.data.input" },
                            "invoke": "ajv", "operation": "add"
                        }
                    }
                ]
            }
        }
    },
    {
        "id": "slot-fill",
        "kind": "kind",
        "data": {
            "shape": {
                "!target": "@ref",
                "!slot": "string",
                "!value": "@any",
                "position=1": ["first", "last"],
                "after[]": "string",
                "before[]": "string"
            }
        }
    },
    {
        "id": "slot-values",
        "kind": "pure-function",
        "data": {
            "signature": { "input": { "!element": "string", "!slot": "string" }, "output": "@any" },
            "module": "@business-framework/core/slots",
            "export": "slotValues"
        }
    }
]
