[
    {
        "kind": "schema",
        "id": "transaction-session",
        "data": { "!sessionId": "number" }
    },

    {
        "id": "transaction-manager",
        "kind": "kind",
        "meta": { "note": "A singleton kind (P10) wrapping the native session store (low). It neither manages nor reads the transaction context: it only opens and closes sessions." },
        "data": {
            "shape": { "isolation": "string" },
            "operations": {
                "begin": {
                    "output": "@transaction-session",
                    "implementation": {
                        "inputMap": { "isolation": "#.self.data.isolation" },
                        "low": { "module": "@business-framework/transaction", "functionName": "beginTransaction" }
                    }
                },
                "commit": {
                    "input": "@transaction-session",
                    "implementation": { "inputMap": "#.input", "low": { "module": "@business-framework/transaction", "functionName": "commitTransaction" } }
                },
                "rollback": {
                    "input": "@transaction-session",
                    "implementation": { "inputMap": "#.input", "low": { "module": "@business-framework/transaction", "functionName": "rollbackTransaction" } }
                }
            }
        }
    },
    {
        "id": "transaction",
        "kind": "transaction-manager",
        "data": { "isolation": "read committed" }
    },

    {
        "id": "transaction-scope",
        "kind": "kind",
        "meta": { "note": "The only manager of 'transaction' (P13): only code written in this kind or its instances may bind it. Readers (entity-database, entity-relations, the outbox) declare 'reads: [transaction]' on their kinds and work without it (autocommit)." },
        "data": {
            "extends": "execution-node-wrapper",
            "context": { "manages": { "transaction": "@transaction-session" } }
        }
    },
    {
        "id": "in-transaction",
        "kind": "transaction-scope",
        "meta": { "note": "Wraps the pipeline written at the call site: next runs it in the caller's context (its #.self, #.change, #.record), with the _ctx current at the call to next. Inside an enclosing transaction it joins it. The binding ends when next returns: there is no 'reset' step. Compare today's transaction.eson, which sets _ctx.transaction and then resets it to false in 'finally'." },
        "data": {
            "keyword": "inTransaction",
            "implementation": {
                "if": "#._ctx.transaction",
                "then": { "next": true },
                "else": [
                    { "outputKey": "session", "invoke": "transaction", "operation": "begin" },
                    {
                        "try": [
                            {
                                "outputKey": "result",
                                "withContext": { "transaction": "#.session" },
                                "do": { "next": true }
                            },
                            { "inputMap": "#.session", "invoke": "transaction", "operation": "commit" },
                            { "return": "#.result" }
                        ],
                        "catch": [
                            { "inputMap": "#.session", "invoke": "transaction", "operation": "rollback" },
                            { "throw": "#.error" }
                        ]
                    }
                ]
            }
        }
    },

    {
        "kind": "schema",
        "id": "principal",
        "data": { "!userId": "string", "roles[]": "string" }
    },
    {
        "id": "user-scope",
        "kind": "kind",
        "meta": { "note": "The only manager of 'user' (P13). Anyone who needs a user bound uses one of its wrappers; nobody else can bind it, so a pipeline can't grant itself roles with withContext. A second manager of 'user' outside this tree would be a validation error." },
        "data": {
            "extends": "execution-node-wrapper",
            "context": { "manages": { "user": "@principal" } }
        }
    },
    {
        "id": "authenticate",
        "kind": "user-scope",
        "meta": { "note": "Binds the principal from a JWT bearer token, if there is a valid one, for the wrapped pipeline. Its input is the caller's #.input: the request, when used as request middleware." },
        "data": {
            "keyword": "authenticated",
            "implementation": [
                {
                    "outputKey": "claims",
                    "inputMap": "#.input.headers.authorization",
                    "low": { "module": "@business-framework/authorization-basic", "functionName": "verifyToken" }
                },
                {
                    "if": "#.claims",
                    "then": { "withContext": { "user": "#.claims" }, "do": { "next": true } },
                    "else": { "next": true }
                }
            ]
        }
    },
    {
        "id": "as-system",
        "kind": "user-scope",
        "meta": { "note": "Runs the wrapped pipeline as the system principal: the explicit, privileged 'run as' (04). Same tree as 'authenticate', so both may manage 'user'." },
        "data": {
            "keyword": "asSystem",
            "implementation": {
                "withContext": { "user": { "userId": "system", "roles": ["system"] } },
                "do": { "next": true }
            }
        }
    },

    {
        "kind": "slot-fill",
        "id": "authenticate-requests",
        "meta": { "note": "Request middleware on every endpoint. The fill binds nothing itself: it wraps the rest of the chain in 'authenticated', whose kind manages 'user'. In the wrapped pipeline, next is the request middleware's continuation. 'first': every other request middleware sees the user." },
        "data": {
            "target": "http-endpoint",
            "slot": "requestMiddleware",
            "position": "first",
            "value": { "authenticated": { "next": true } }
        }
    }
]
