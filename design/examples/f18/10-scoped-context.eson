[
    {
        "kind": "schema",
        "id": "transaction-session",
        "data": { "!sessionId": "number" }
    },

    {
        "id": "transaction-manager",
        "kind": "kind",
        "meta": { "note": "A singleton kind (P10) wrapping the native session store (low). The session is a handle: native code (entity-database, the outbox) finds its client by sessionId." },
        "data": {
            "shape": { "isolation": "string" },
            "operations": {
                "begin": {
                    "output": "@transaction-session",
                    "implementation": {
                        "inputMap": { "isolation": "#.self.data.isolation" },
                        "low": { "module": "@business-framework/transaction", "functionName": "beginTransaction" }
                    }
                },
                "commit": {
                    "input": "@transaction-session",
                    "implementation": { "inputMap": "#.input", "low": { "module": "@business-framework/transaction", "functionName": "commitTransaction" } }
                },
                "rollback": {
                    "input": "@transaction-session",
                    "implementation": { "inputMap": "#.input", "low": { "module": "@business-framework/transaction", "functionName": "rollbackTransaction" } }
                }
            }
        }
    },
    {
        "id": "transaction",
        "kind": "transaction-manager",
        "data": { "isolation": "read committed" }
    },

    {
        "id": "in-transaction",
        "kind": "execution-node-wrapper",
        "meta": { "note": "Wraps the pipeline written at the call site: next runs it in the caller's context (its #.self, #.change, #.record), with the _ctx current at the call to next. So inTransaction is a one-method middleware around that pipeline, defined in data. Inside an enclosing transaction it joins it. The binding ends when next returns: there is no 'reset' step, and an outer transaction can't be clobbered. Compare today's transaction.eson, which sets _ctx.transaction and then resets it to false in 'finally'." },
        "data": {
            "keyword": "inTransaction",
            "implementation": {
                "if": "#._ctx.transaction",
                "then": { "next": true },
                "else": [
                    { "outputKey": "session", "invoke": "transaction", "operation": "begin" },
                    {
                        "try": [
                            {
                                "outputKey": "result",
                                "withContext": { "transaction": "#.session" },
                                "do": { "next": true }
                            },
                            { "inputMap": "#.session", "invoke": "transaction", "operation": "commit" },
                            { "return": "#.result" }
                        ],
                        "catch": [
                            { "inputMap": "#.session", "invoke": "transaction", "operation": "rollback" },
                            { "throw": "#.error" }
                        ]
                    }
                ]
            }
        }
    },

    {
        "kind": "slot-fill",
        "id": "authenticate-jwt",
        "meta": { "note": "Binds _ctx.user for the rest of the request: the guard in 07 and the middleware in 09 read it. Replaces jwt-auth-middleware, which wrote _ctx with outputKey and had ordering 5. 'first': every other request middleware sees the user." },
        "data": {
            "target": "http-endpoint",
            "slot": "requestMiddleware",
            "position": "first",
            "value": [
                {
                    "outputKey": "claims",
                    "inputMap": "#.input.headers.authorization",
                    "low": { "module": "@business-framework/authorization-basic", "functionName": "verifyToken" }
                },
                {
                    "if": "#.claims",
                    "then": { "withContext": { "user": "#.claims" }, "do": { "next": true } },
                    "else": { "next": true }
                }
            ]
        }
    }
]
