[
    {
        "id": "kind",
        "kind": "kind",
        "meta": { "note": "The fixed point: its own kind. The native driver runs kind.lifecycle for every element of kind 'kind', including this one, with no special case. Operations are a primitive property of a kind, invoked through its instances (P8). On load, a kind checks its own definition and adds its shape (as '<kindId>', so '@<kindId>' works in any schema), its operation contracts (as '<kindId>/<operation>/input|output') and the value schema of each slot it declares (as '<kindId>/slots/<slot>') to AJV." },
        "data": {
            "shape": {
                "extends": "string",
                "shape": "@schema",
                "defaults": "object",
                "operations{}": "@operation",
                "slots{}": "@slot",
                "lifecycle": { "load": "@method", "start": "@method", "stop": "@method" }
            },
            "lifecycle": {
                "load": [
                    { "outputKey": "problems", "set": { "$func/check-kind": "#.self" } },
                    {
                        "if": { "$head": "#.problems" },
                        "then": { "throw": { "$join": { "_strings": ["kind ", "#.self.id", ": ", { "$join": { "_strings": "#.problems", "_separator": "; " } }] } } }
                    },
                    {
                        "if": "#.self.data.shape",
                        "then": { "inputMap": { "id": "#.self.id", "schema": "#.self.data.shape" }, "invoke": "ajv", "operation": "add" }
                    },
                    { "inputMap": { "owner": "#.self.id", "contracts": "#.self.data.operations" }, "call": "add-contracts" },
                    {
                        "inputMap": { "$keys": { "$coalesce": ["#.self.data.slots", {}] } },
                        "forEach": {
                            "inputMap": {
                                "id": { "$join": { "_strings": ["#.self.id", "/slots/", "#.input"] } },
                                "schema": { "$get": { "_object": "#.self.data.slots", "_path": { "$join": { "_strings": ["#.input", ".value"] } } } }
                            },
                            "invoke": "ajv", "operation": "add"
                        }
                    }
                ]
            }
        }
    },
    {
        "kind": "pure-function",
        "id": "check-kind",
        "meta": { "note": "Native (JS). Structural checks a schema can't express: 'extends' names an element of kind 'kind'; no cycle along 'extends'; no operation or slot redefined along the chain (Q7). Returns a list of problems." },
        "data": {
            "signature": { "input": "@any", "output": "[string]" },
            "implementation": { "module": "@business-framework/runtime/kinds", "export": "checkKind" }
        }
    },
    {
        "id": "add-contracts",
        "kind": "executable",
        "meta": { "note": "Used by kind's load hook: adds '<owner>/<name>/input|output' for every operation in a map." },
        "data": [
            { "outputKey": "args", "set": "#.input" },
            {
                "inputMap": { "$keys": { "$coalesce": ["#.args.contracts", {}] } },
                "forEach": [
                    { "outputKey": "contract", "set": { "$get": { "_object": "#.args.contracts", "_path": "#.input" } } },
                    { "outputKey": "prefix", "set": { "$join": { "_strings": ["#.args.owner", "/", "#.input", "/"] } } },
                    {
                        "inputMap": { "id": { "$join": { "_strings": ["#.prefix", "input"] } }, "schema": "#.contract.input" },
                        "invoke": "ajv", "operation": "add"
                    },
                    {
                        "if": "#.contract.output",
                        "then": {
                            "inputMap": { "id": { "$join": { "_strings": ["#.prefix", "output"] } }, "schema": "#.contract.output" },
                            "invoke": "ajv", "operation": "add"
                        }
                    }
                ]
            }
        ]
    },

    {
        "id": "data",
        "kind": "kind",
        "meta": { "note": "The trivial kind: no shape, no operations. An element without a 'kind' has kind 'data' (P1)." },
        "data": {}
    },

    {
        "kind": "schema",
        "id": "operation",
        "data": { "!input": "@schema", "output": "@schema", "!implementation": "@method" }
    },
    {
        "kind": "schema",
        "id": "slot",
        "meta": { "note": "A slot is a typed contribution point (Q16): fills contribute values matching 'value', which is any schema: plain data, or '@method' when the contribution is behaviour. Reading a slot is pure ($func/slot-values). cardinality 'one': the value of the most specific fill; 'many': all values, ordered. What happens to the values is up to the consumer: data is read, methods are run, typically with the middleware node." },
        "data": { "!cardinality": "string", "!value": "@schema" }
    },

    {
        "id": "schema-registry",
        "kind": "kind",
        "meta": { "note": "Native operations (low) over the single AJV instance. 'add' (ajv.addSchema) never compiles and doesn't depend on order. AJV resolves every $ref; the framework doesn't (P7)." },
        "data": {
            "shape": { "options": "object" },
            "operations": {
                "add": {
                    "input": { "!id": "string", "!schema": "@schema" },
                    "implementation": { "inputMap": "#.input", "low": { "module": "@business-framework/runtime/schema", "functionName": "add" } }
                }
            }
        }
    },
    {
        "id": "ajv",
        "kind": "schema-registry",
        "meta": { "note": "The singleton instance (P8, P10): the receiver for schema-registry operations, holding its configuration." },
        "data": { "options": { "strict": true, "allErrors": true } }
    },
    {
        "kind": "pure-function",
        "id": "schema-validate",
        "meta": { "note": "Native (JS). Validates a value by schema id with ajv.getSchema(schemaId), which compiles on the first request and returns the cached function after that. The validateSchema node with '@id' calls this too." },
        "data": {
            "signature": { "input": { "!schemaId": "string", "value": "@any" }, "output": { "!isValid": "boolean", "errors[]": "object" } },
            "implementation": { "module": "@business-framework/runtime/schema", "export": "validate" }
        }
    },
    {
        "kind": "pure-function",
        "id": "schema-to-json-schema",
        "meta": { "note": "Native (JS). Converts compact schema to standard JSON Schema (compactToStandard), for OpenAPI, UI form generators and external tools." },
        "data": {
            "signature": { "input": { "!id": "string", "!schema": "@schema" }, "output": "object" },
            "implementation": { "module": "@business-framework/runtime/schema", "export": "toJsonSchema" }
        }
    },

    {
        "id": "schema",
        "kind": "kind",
        "meta": { "note": "Defined, not native. Its data is the compact schema itself; its operations are on the kind. A schema is added to AJV on load and compiled lazily, exactly once, on its first validation." },
        "data": {
            "shape": { "$data#": ["object", "string"] },

            "operations": {
                "validate": {
                    "input": "@any",
                    "output": { "!isValid": "boolean", "errors[]": "object" },
                    "implementation": {
                        "set": { "$func/schema-validate": { "schemaId": "#.self.id", "value": "#.input" } }
                    }
                },
                "toJsonSchema": {
                    "input": {},
                    "output": "object",
                    "implementation": {
                        "set": { "$func/schema-to-json-schema": { "id": "#.self.id", "schema": "#.self.data" } }
                    }
                }
            },

            "lifecycle": {
                "load": {
                    "inputMap": { "id": "#.self.id", "schema": "#.self.data" },
                    "invoke": "ajv", "operation": "add"
                }
            }
        }
    },

    {
        "id": "executable",
        "kind": "kind",
        "meta": { "note": "A named pipeline, run with the 'call' node. No operations." },
        "data": { "shape": "@method" }
    },
    {
        "id": "pure-function",
        "kind": "kind",
        "meta": { "note": "No load hook: $func/<id> is a native lazy view that finds the element when it is first called and caches the compiled function. The implementation is a LambdaJSON tree or a JS { module, export } (F11)." },
        "data": { "shape": { "signature": { "!input": "@schema", "!output": "@schema" }, "!implementation": "object" } }
    },
    {
        "id": "execution-node-template",
        "kind": "kind",
        "meta": { "note": "Defines a pipeline node keyword in data. No load hook: when the executor meets a key it doesn't know natively, it looks up the template by keyword through a native lazy index. The implementation runs with #.input (the node's input: its inputMap result, or the full context), #.node (the node itself), #._ctx, and #.self (bound for the whole invocation). The keyword's value is configuration, read through #.node; the caller's outputs are not visible. To wrap code written at the call site, use execution-node-wrapper." },
        "data": { "shape": { "!keyword": "string", "!implementation": "@method" } }
    },
    {
        "id": "execution-node-wrapper",
        "kind": "kind",
        "meta": { "note": "A node keyword whose value is a pipeline written at the call site, which the implementation wraps (F8): the implementation is a middleware around that pipeline, and { next: true } runs it in the caller's context (its #.self and earlier outputs), with the _ctx current at the call to next. It adds nothing to the shape; the kind itself tells the executor how to run it. Found through the same lazy keyword index as its parent, so keywords are unique across both. inTransaction (10) is one." },
        "data": { "extends": "execution-node-template" }
    },

    {
        "kind": "pure-function",
        "id": "slot-values",
        "meta": { "note": "Native (JS), because it reads the registry; pure, because the registry is immutable after load. The values of a slot for an element: targets are its kind chain plus the element. For 'one': the value of the single fill on the most specific target, or null if there is none (two there is an error). For 'many': all values, in order: general to specific target, then fill id; 'position' bands (first, unpositioned, last) and 'after'/'before' are applied by one stable topological sort (a cycle is an error)." },
        "data": {
            "signature": { "input": { "!element": "string", "!slot": "string" }, "output": "@any" },
            "implementation": { "module": "@business-framework/runtime/slots", "export": "slotValues" }
        }
    },

    {
        "kind": "pure-function",
        "id": "apply-mapping",
        "meta": { "note": "Native (JS), pure: evaluates a LambdaJSON mapping held in data (such as an endpoint's 'request') against an input. It reads no context." },
        "data": {
            "signature": { "input": { "!mapping": {}, "input": {} }, "output": {} },
            "implementation": { "module": "@business-framework/runtime/execution", "export": "applyMapping" }
        }
    },

    {
        "id": "slot-declaration",
        "kind": "kind",
        "meta": { "note": "Declares a slot on a kind from outside it, for example from another package (P11). It counts as declared on 'target' and is inherited along the chain like the kind's own slots; redeclaring an existing slot is an error. The kind's operations don't read it, so the declaring package provides the consumer, usually through a fill of an existing slot. Kind resolution finds declarations through a native lazy index; on load, the declaration adds its value schema as '<target>/slots/<slot>'." },
        "data": {
            "shape": { "!target": "string", "!slot": "string", "!cardinality": "string", "!value": "@schema" },
            "lifecycle": {
                "load": {
                    "inputMap": {
                        "id": { "$join": { "_strings": ["#.self.data.target", "/slots/", "#.self.data.slot"] } },
                        "schema": "#.self.data.value"
                    },
                    "invoke": "ajv", "operation": "add"
                }
            }
        }
    },
    {
        "id": "slot-fill",
        "kind": "kind",
        "meta": { "note": "Contributes a value to a slot (Q16): any data matching the slot's value schema, including a method. No load hook: slot-values finds fills by (target, slot) through a native lazy index. Values of a 'many' slot come in a deterministic order: general to specific target, then fill id, never load order. 'position' ('first' or 'last') puts the value in a band ahead of or behind all unpositioned values, without naming any other fill; several fills in one band keep the base order among themselves. 'after' and 'before' name other fills of the same slot when there is a real dependency on them; 'X before Y' means 'Y after X' (Q15). For middleware, 'first' is outermost and 'last' innermost (closest to the action). After load, the native checks verify: the target exists and its kind chain declares the slot; the value matches '<owner>/slots/<slot>'; every id in after/before is a fill of that slot; no cycles (including an after/before that contradicts the bands); no two fills of a 'one' slot on the same target; no position on a fill of a 'one' slot." },
        "data": {
            "shape": {
                "!target": "string",
                "!slot": "string",
                "!value": "@any",
                "position": { "$data#1": ["first=", "last="] },
                "after[]": "string",
                "before[]": "string"
            }
        }
    },

    {
        "id": "on-startup",
        "kind": "kind",
        "meta": { "note": "Defined, not native. Today this is a special case in bootstrap.js." },
        "data": {
            "shape": "@method",
            "lifecycle": {
                "start": { "inputMap": {}, "execute": "#.self.data" }
            }
        }
    },
    {
        "id": "http-endpoint",
        "kind": "kind",
        "meta": { "note": "Defined, not native. Each endpoint registers its own route when the server starts. Per request, the native server invokes the endpoint's handle operation with the request and a fresh root _ctx ({ correlation, timestampUTC }); that is the only place a root context is created. Request middleware (authentication, 10) runs around the target and binds context for it with withContext + next." },
        "data": {
            "shape": {
                "!method": "string",
                "!path": "string",
                "!target": { "!element": "string", "!operation": "string" },
                "request": "object"
            },
            "slots": {
                "requestMiddleware": { "cardinality": "many", "value": "@method" }
            },
            "operations": {
                "handle": {
                    "input": { "!headers": "object", "params": "object", "query": "object", "body": {} },
                    "implementation": {
                        "middleware": { "$func/slot-values": { "element": "#.self.id", "slot": "requestMiddleware" } },
                        "action": [
                            { "outputKey": "targetInput", "set": { "$func/apply-mapping": { "mapping": { "$coalesce": ["#.self.data.request", "#"] }, "input": "#.input" } } },
                            { "inputMap": "#.targetInput", "invoke": "#.self.data.target.element", "operation": "#.self.data.target.operation" }
                        ]
                    }
                }
            },
            "lifecycle": {
                "start": {
                    "inputMap": { "method": "#.self.data.method", "path": "#.self.data.path", "endpoint": "#.self.id" },
                    "invoke": "http-server", "operation": "registerRoute"
                }
            }
        }
    },

    {
        "id": "entity-record-json-schema",
        "kind": "http-endpoint",
        "meta": { "note": "A use of a schema operation: publish the entity record contract as standard JSON Schema." },
        "data": {
            "method": "GET",
            "path": "/schemas/entity-record",
            "target": { "element": "entity-record", "operation": "toJsonSchema" }
        }
    }
]
