[
    {
        "kind": "schema",
        "id": "entity-relations",
        "data": {
            "!relations[]": { "!targetEntityType": "string", "!targetEntityBusinessKey": "string", "!relationType": "string" }
        }
    },

    {
        "id": "entity-relations-slot",
        "kind": "slot-declaration",
        "meta": { "note": "The relations package adds a slot to a kind it doesn't own (P11). Every entity type now has a 'relations' slot; each one fills it with rules: methods from an entity record to @entity-relations." },
        "data": {
            "target": "entity-type",
            "slot": "relations",
            "cardinality": "many",
            "value": "@method"
        }
    },

    {
        "kind": "slot-fill",
        "id": "maintain-entity-relations",
        "meta": { "note": "The consumer of the new slot: a reaction on every entity type, inside the transaction, after the write. It runs every rule with the written record, collects their relations, and writes the minimal changes. This replaces the relations middleware at ordering 75." },
        "data": {
            "target": "entity-type",
            "slot": "reactions",
            "value": {
                "if": { "$includes": { "_collection": ["create", "update"], "_value": "#.input.operation" } },
                "then": [
                    { "outputKey": "record", "set": "#.input.after" },
                    {
                        "outputKey": "results",
                        "inputMap": { "$func/slot-values": { "element": "#.self.id", "slot": "relations" } },
                        "forEach": { "inputMap": "#.record", "execute": "#.input" }
                    },
                    {
                        "inputMap": {
                            "sourceEntityId": "#.record.id",
                            "relations": { "$concat": { "$map": { "_over": "#.results", "_fn": "#.relations" } } }
                        },
                        "invoke": "entity-relations", "operation": "setRelations"
                    }
                ]
            }
        }
    },

    {
        "kind": "slot-fill",
        "id": "construction-policyholder-relation",
        "meta": { "note": "An entity type's rule: a method contributed to the new slot. This replaces the demo's entity-rule/relations/construction." },
        "data": {
            "target": "construction",
            "slot": "relations",
            "value": {
                "return": {
                    "relations": [
                        { "targetEntityType": "party", "targetEntityBusinessKey": "#.input.data.policyholder", "relationType": "policyholder" }
                    ]
                }
            }
        }
    }
]
