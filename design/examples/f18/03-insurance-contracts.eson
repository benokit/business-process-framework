[
    {
        "id": "insurance-contract",
        "kind": "kind",
        "meta": { "note": "A class is a kind that extends another kind. Its defaults are merged under each instance's data; this replaces the demo's insurance-contract-base-config plus /merge." },
        "data": {
            "extends": "entity-type",
            "defaults": {
                "dataSchema": {
                    "!policyholder": "string",
                    "!currency": "string",
                    "!startDate": "@date",
                    "!endDate": "@date"
                },
                "statesModel": {
                    "states": { "status": ["draft", "discarded", "issued", "active", "cancelled"] },
                    "transitions": {
                        "discard":  { "from": { "status": ["draft"] },            "to": { "status": "discarded" } },
                        "issue":    { "from": { "status": ["draft"] },            "to": { "status": "issued" } },
                        "activate": { "from": { "status": ["issued"] },           "to": { "status": "active" } },
                        "cancel":   { "from": { "status": ["issued", "active"] }, "to": { "status": "cancelled" } }
                    },
                    "initialStates": { "default": { "status": "draft" } }
                }
            }
        }
    },

    {
        "id": "construction",
        "kind": "insurance-contract",
        "data": {
            "dataSchema": { "!project": "string" }
        }
    },
    {
        "id": "travel",
        "kind": "insurance-contract",
        "data": {
            "dataSchema": { "!destination": "string" }
        }
    },

    {
        "kind": "slot-fill",
        "id": "contract-default-business-key",
        "meta": { "note": "Default for every insurance contract: <type>-<uuid>." },
        "data": {
            "target": "insurance-contract",
            "slot": "businessKey",
            "value": [
                { "outputKey": "uuid", "getRandom": {} },
                { "return": { "$join": { "_strings": ["#.self.id", "#.uuid"], "_separator": "-" } } }
            ]
        }
    },
    {
        "kind": "slot-fill",
        "id": "construction-business-key",
        "meta": { "note": "More specific than the default above, so it wins for construction. Travel keeps the default. The year comes from the clock singleton (an effect), not from context: the rule reads no context, so it works the same inside and outside a request." },
        "data": {
            "target": "construction",
            "slot": "businessKey",
            "value": [
                { "outputKey": "seq", "nextFromSequence": "construction-seq" },
                { "outputKey": "now", "invoke": "clock", "operation": "now" },
                {
                    "return": {
                        "$join": {
                            "_strings": [
                                "CON",
                                { "$head": { "$split": { "_string": "#.now", "_separator": "-" } } },
                                { "$printf": { "_template": "%04d", "_args": ["#.seq"] } }
                            ],
                            "_separator": "-"
                        }
                    }
                }
            ]
        }
    },

    {
        "kind": "slot-fill",
        "id": "contract-updates-only-in-draft",
        "meta": { "note": "Class-level guard: applies to construction, travel, and any future insurance contract." },
        "data": {
            "target": "insurance-contract",
            "slot": "guards",
            "value": {
                "if": { "$eq": ["#.input.operation", "update"] },
                "then": {
                    "if": { "$neq": ["#.input.before.state.dimensions.status", "draft"] },
                    "then": { "throw": "insurance contracts can only be updated in draft" }
                }
            }
        }
    },

    {
        "id": "contract-events",
        "kind": "message-channel",
        "data": { "broker": "entity-events-broker", "topology": "topic", "name": "contract-events" }
    },
    {
        "kind": "slot-fill",
        "id": "contract-activation-events",
        "meta": { "note": "Replaces the demo's dead handler. Both the slot and the channel are declared, so the loader can check this fill. 'after': contract-activated is published after the generic entity event from the entity-events package (05), so consumers can rely on that order." },
        "data": {
            "target": "insurance-contract",
            "slot": "reactions",
            "after": ["publish-entity-events"],
            "value": {
                "if": { "$eq": ["#.input.transition", "activate"] },
                "then": {
                    "execute": {
                        "publish": {
                            "channel": "contract-events",
                            "envelope": {
                                "message": {
                                    "type": "contract-activated",
                                    "contractType": "#.self.id",
                                    "contractKey": "#.input.after.businessKey"
                                }
                            }
                        }
                    }
                }
            }
        }
    },

    {
        "id": "create-construction",
        "kind": "http-endpoint",
        "data": {
            "method": "POST",
            "path": "/contracts/construction",
            "target": { "element": "construction", "operation": "create" },
            "request": { "data": "#.body" }
        }
    }
]
