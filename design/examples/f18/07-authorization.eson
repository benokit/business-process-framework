[
    {
        "kind": "slot-fill",
        "id": "contract-update-authority",
        "meta": { "note": "From an authorization package that doesn't own the insurance guards (P11). 'position: first': an unauthorized user must get 'forbidden' before any business guard can answer, for example with 'contracts can only be updated in draft', which would reveal the contract's state. The constraint is about authorization, not about any particular guard, so it names none." },
        "data": {
            "target": "insurance-contract",
            "slot": "guards",
            "position": "first",
            "value": {
                "if": { "$eq": ["#.input.operation", "update"] },
                "then": {
                    "if": { "$negate": { "$includes": { "_collection": { "$coalesce": ["#._ctx.user.roles", []] }, "_value": "underwriter" } } },
                    "then": { "throw": "forbidden" }
                }
            }
        }
    }
]
