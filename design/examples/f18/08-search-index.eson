[
    {
        "kind": "schema",
        "id": "entity-search-index-config",
        "data": {
            "!searchEngine": "string",
            "!indexName": "string",
            "settings": "object",
            "!mapping": "@method"
        }
    },

    {
        "id": "entity-search-index-slot",
        "kind": "slot-declaration",
        "meta": { "note": "A data slot (Q16): the search package lets each entity type contribute its index configuration. This replaces the entity-search-index/{type} naming convention." },
        "data": {
            "target": "entity-type",
            "slot": "searchIndex",
            "cardinality": "one",
            "value": "@entity-search-index-config"
        }
    },

    {
        "kind": "slot-fill",
        "id": "construction-search-index",
        "meta": { "note": "Configuration, not behaviour: checked against @entity-search-index-config by validate(). Only 'mapping' inside it is a method." },
        "data": {
            "target": "construction",
            "slot": "searchIndex",
            "value": {
                "searchEngine": "meilisearch",
                "indexName": "construction-contracts",
                "settings": {
                    "searchableAttributes": ["businessKey", "policyholder", "project"],
                    "filterableAttributes": ["currency"]
                },
                "mapping": {
                    "return": {
                        "businessKey": "#.input.businessKey",
                        "policyholder": "#.input.data.policyholder",
                        "project": "#.input.data.project",
                        "currency": "#.input.data.currency"
                    }
                }
            }
        }
    },

    {
        "kind": "slot-fill",
        "id": "index-entity-documents",
        "meta": { "note": "The consumer: a reaction on every entity type that reads the data slot. Entity types without a searchIndex value are skipped. Simplified: today indexing is asynchronous, through the entity-events consumer." },
        "data": {
            "target": "entity-type",
            "slot": "reactions",
            "value": [
                { "outputKey": "index", "set": { "$func/slot-values": { "element": "#.self.id", "slot": "searchIndex" } } },
                {
                    "if": "#.index",
                    "then": [
                        { "outputKey": "document", "inputMap": "#.input.after", "execute": "#.index.mapping" },
                        {
                            "inputMap": {
                                "indexName": "#.index.indexName",
                                "document": { "$merge": ["#.document", { "id": "#.input.after.id" }] }
                            },
                            "invoke": "meilisearch", "operation": "insertDocument"
                        }
                    ]
                }
            ]
        }
    }
]
