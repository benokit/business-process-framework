[
    {
        "kind": "schema",
        "id": "message-context",
        "meta": { "note": "What a consumer knows about the message it is handling, taken from the envelope. The publisher decided what the envelope carries (P13)." },
        "data": { "!channel": "string", "!messageId": "string", "!correlation": "string" }
    },

    {
        "id": "message-consumer",
        "kind": "kind",
        "meta": { "note": "Defined, not native, like http-endpoint. The consumer manages its own key, 'message' (P13): it can't bind 'request' or 'user', which other trees manage. On start it subscribes; per message, the native broker invokes its handle operation with the envelope and an empty _ctx. Code that needs the correlation reads 'message' (and 'request', when it can run in both). Replaces today's on-startup + startConsumers and the schema-only message-consumer." },
        "data": {
            "shape": { "!channel": "string", "name": "string", "!handler": "@method" },
            "context": { "manages": { "message": "@message-context" } },
            "operations": {
                "handle": {
                    "input": "@message-envelope",
                    "implementation": {
                        "withContext": {
                            "message": { "channel": "#.self.data.channel", "messageId": "#.input.messageId", "correlation": "#.input.correlation" }
                        },
                        "do": { "inputMap": "#.input.message", "execute": "#.self.data.handler" }
                    }
                }
            },
            "lifecycle": {
                "start": {
                    "inputMap": { "channel": "#.self.data.channel", "name": { "$coalesce": ["#.self.data.name", "#.self.id"] }, "consumer": "#.self.id" },
                    "invoke": "messaging", "operation": "subscribe"
                }
            }
        }
    },

    {
        "id": "open-commission-account",
        "kind": "message-consumer",
        "meta": { "note": "Reacts to contract-activated (03) in another process. The handler binds nothing: the create below runs with 'message' bound, so publish-entity-events propagates the original request's correlation, and stamp-modified-by (09) records 'system' because no user is bound. A consumer that must act as someone uses a user-scope wrapper (asSystem, 10); it can't bind 'user' itself." },
        "data": {
            "channel": "contract-events",
            "handler": {
                "if": { "$eq": ["#.input.type", "contract-activated"] },
                "then": {
                    "inputMap": { "data": { "contractType": "#.input.contractType", "contractKey": "#.input.contractKey" } },
                    "invoke": "commission-account", "operation": "create"
                }
            }
        }
    },
    {
        "id": "commission-account",
        "kind": "entity-type",
        "data": {
            "dataSchema": { "!contractType": "string", "!contractKey": "string" },
            "statesModel": {
                "states": { "status": ["open", "closed"] },
                "transitions": { "close": { "from": { "status": ["open"] }, "to": { "status": "closed" } } },
                "initialStates": { "default": { "status": "open" } }
            }
        }
    },
    {
        "kind": "slot-fill",
        "data": { "target": "commission-account", "slot": "businessKey", "value": { "return": { "$join": { "_strings": ["COM", "#.input.data.contractKey"], "_separator": "-" } } } }
    }
]
