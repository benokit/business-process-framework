[
    {
        "id": "region",
        "kind": "schema",
        "data": "string:^[a-z]{2}$"
    },
    {
        "id": "department",
        "kind": "schema",
        "data": "string:^[a-z]+$"
    },
    {
        "id": "contract-terms",
        "kind": "schema",
        "data": { "startDate": "@date", "!premium": "number", "!sumInsured": "number", "!endDate": "@date" }
    }
]
