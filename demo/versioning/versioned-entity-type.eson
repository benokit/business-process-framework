[
    {
        "id": "versioned-entity-type",
        "kind": "kind",
        "data": {
            "extends": "stateful-entity-type",
            "fixed": { "traits": { "timeline": { "trait": "versionable" }, "amendment-ledger": {} } },
            "slots": { "amendmentTypes": { "cardinality": "many", "value": "@ref/amendment-entity-type" } },
            "operations": {
                "isAmendable": { "input": { "!record": "@entity-record" }, "output": "boolean" },
                "putSegment": {
                    "input": { "!businessKey": "string", "!revision": "number", "!key": "string", "!validFrom": "string", "!data": "object" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "if": { "$negate": { "$func/is-versionable": { "entityType": "#.self.id", "key": "#.input.key" } } },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.self.id", " has no versionable trait under the key ", "#.input.key"] } } }
                        },
                        {
                            "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "key": "#.input.key", "input": { "validFrom": "#.input.validFrom", "data": "#.input.data" } },
                            "traitOperation": { "key": "#.input.key", "operation": "put" }
                        }
                    ]
                },
                "removeSegment": {
                    "input": { "!businessKey": "string", "!revision": "number", "!key": "string", "!validFrom": "string" },
                    "output": "@entity-record",
                    "implementation": [
                        {
                            "if": { "$negate": { "$func/is-versionable": { "entityType": "#.self.id", "key": "#.input.key" } } },
                            "then": { "throw": { "code": "invalid", "message": { "$str": ["#.self.id", " has no versionable trait under the key ", "#.input.key"] } } }
                        },
                        {
                            "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "key": "#.input.key", "input": { "validFrom": "#.input.validFrom" } },
                            "traitOperation": { "key": "#.input.key", "operation": "remove" }
                        }
                    ]
                },
                "writeLedger": {
                    "input": { "!businessKey": "string", "!revision": "number", "!command": "string", "!value": "object" },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "input": { "command": "#.input.command", "value": "#.input.value" } },
                        "traitOperation": { "key": "amendment-ledger", "operation": "write" }
                    }
                }
            }
        }
    },
    {
        "id": "ledger-trait",
        "kind": "kind",
        "data": {
            "extends": "entity-trait",
            "operations": {
                "initialize": {
                    "implementation": { "set": { "last": 0, "open": null } }
                },
                "write": {
                    "input": "@trait-operation-input",
                    "output": "@trait-command",
                    "implementation": { "set": { "command": "#.input.input.command", "value": "#.input.input.value" } }
                }
            }
        }
    },
    {
        "id": "amendment-ledger",
        "kind": "ledger-trait",
        "data": { "configuration": { "*": "never" } }
    },
    {
        "id": "amendment-ledger-value",
        "kind": "schema",
        "data": { "!last": "integer", "!open": { "$data#": ["string", "null"] } }
    },
    {
        "id": "versioned-entity-ledger-writes",
        "kind": "slot-fill",
        "data": {
            "target": "versioned-entity-type",
            "slot": "guards",
            "value": {
                "if": { "$and": [{ "$eq": ["#.input.operation", "trait"] }, { "$eq": ["#.input.key", "amendment-ledger"] }] },
                "then": [
                    {
                        "if": { "$negate": { "$includes": { "collection": ["open", "close"], "value": "#.input.command" } } },
                        "then": { "throw": { "code": "invalid", "message": { "$str": ["the amendment ledger has no command ", "#.input.command"] } } }
                    },
                    { "outputKey": "check", "set": { "$func/schema-validate": { "schemaId": "amendment-ledger-value", "value": "#.input.value" } } },
                    {
                        "if": { "$negate": "#.check.isValid" },
                        "then": { "throw": { "code": "invalid", "message": "the amendment ledger is { last, open }" } }
                    }
                ]
            }
        }
    },
    {
        "id": "versioned-entity-timeline-writes",
        "kind": "slot-fill",
        "data": {
            "target": "versioned-entity-type",
            "slot": "guards",
            "value": {
                "if": { "$and": [{ "$eq": ["#.input.operation", "trait"] }, { "$eq": ["#.input.key", "timeline"] }] },
                "then": {
                    "if": { "$negate": { "$includes": { "collection": ["put", "remove"], "value": "#.input.command" } } },
                    "then": { "throw": { "code": "invalid", "message": { "$str": ["the timeline has no command ", "#.input.command"] } } }
                }
            }
        }
    }
]
