[
    {
        "id": "approval-state-machine",
        "kind": "state-machine",
        "data": {
            "states": { "status": { "draft": true, "submitted": true, "approved": true, "rejected": true } },
            "transitions": {
                "submit": { "status": { "draft": "submitted" } },
                "approve": { "status": { "submitted": "approved" } },
                "reject": { "status": { "submitted": "rejected" } }
            },
            "initialStates": { "default": { "status": "draft" } }
        }
    },
    {
        "id": "expense-claim",
        "kind": "entity-type",
        "/data": {
            "traits": {
                "body": { "configuration": { "schema": { "!employee": "string", "!amount": "number", "justification": "string" } } },
                "validation": { "dependsOn": ["body"], "configuration": { "onValidation": [{
                    "key": "state",
                    "operation": "transition",
                    "input": { "transition": { "$if": [{ "$eq": [{ "$count": { "collection": { "$keys": "#.errors" } } }, 0] }, "markValid", "markInvalid"] } }
                }] } },
                "state": { "configuration": { "/merge": [
                    { "/ref": "approval-state-machine" },
                    {
                        "states": { "validity": { "valid": true, "invalid": true } },
                        "transitions": {
                            "markValid": { "validity": { "valid": "valid", "invalid": "valid" } },
                            "markInvalid": { "validity": { "valid": "invalid", "invalid": "invalid" } },
                            "submit": { "validity": { "valid": true } }
                        },
                        "initialStates": { "default": { "validity": "valid" } }
                    }
                ] } }
            }
        }
    },
    {
        "id": "expense-claim-amount-validation",
        "kind": "slot-fill",
        "data": {
            "target": "expense-claim",
            "slot": "validations",
            "value": { "$if": [{ "$gt": ["#.data.body.amount", 0] }, {}, { "amount": "must be positive" }] }
        }
    },
    {
        "id": "expense-claim-justification-validation",
        "kind": "slot-fill",
        "data": {
            "target": "expense-claim",
            "slot": "validations",
            "value": { "$if": [{ "$or": [{ "$lte": ["#.data.body.amount", 1000] }, "#.data.body.justification"] }, {}, { "justification": "is required above 1000" }] }
        }
    },
    {
        "id": "leave-request",
        "kind": "entity-type",
        "/data": {
            "traits": {
                "body": { "configuration": { "schema": { "!employee": "string", "!from": "string", "!to": "string" } } },
                "state": { "configuration": { "/merge": [
                    { "/ref": "approval-state-machine" },
                    {
                        "states": { "status": { "cancelled": true } },
                        "transitions": { "cancel": { "status": { "draft": "cancelled", "submitted": "cancelled" } } }
                    }
                ] } }
            }
        }
    }
]
