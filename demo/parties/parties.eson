[
    {
        "id": "party",
        "kind": "entity-type",
        "data": {
            "dataSchema": {
                "!partyType": "string",
                "!name": "string",
                "taxId": "string",
                "registrationNumber": "string",
                "email": "string",
                "phone": "string",
                "address": { "street": "string", "city": "string", "country": "string" }
            },
            "statesModel": {
                "states": { "status": ["prospect", "verified", "blacklisted"] },
                "transitions": {
                    "verify": { "from": { "status": ["prospect"] }, "to": { "status": "verified" } },
                    "blacklist": { "from": { "status": ["prospect", "verified"] }, "to": { "status": "blacklisted" } },
                    "reactivate": { "from": { "status": ["blacklisted"] }, "to": { "status": "prospect" } }
                },
                "initialStates": { "default": { "status": "prospect" } }
            }
        }
    },
    {
        "id": "party-search-index",
        "kind": "slot-fill",
        "data": {
            "target": "party",
            "slot": "searchIndex",
            "value": {
                "searchEngine": { "instanceOf": "search-engine" },
                "indexName": "parties",
                "settings": {
                    "searchableAttributes": ["name", "email", "partyType", "businessKey"],
                    "filterableAttributes": ["partyType"]
                },
                "mapping": { "set": { "businessKey": "#.input.businessKey", "partyType": "#.input.data.partyType", "name": "#.input.data.name", "email": "#.input.data.email" } }
            }
        }
    },
    {
        "id": "reindex-parties",
        "kind": "on-startup",
        "data": { "inputMap": { "entityType": "party" }, "invoke": "entity-search", "operation": "reindex" }
    }
]
