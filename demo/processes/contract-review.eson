[
    {
        "id": "contract-review-task",
        "kind": "entity-type",
        "data": {
            "traits": {
                "task": {
                    "configuration": {
                        "actor": "underwriter-role",
                        "outcomes": {
                            "approved": { "answer": true },
                            "rejected": { "answer": { "!reason": "string" } }
                        }
                    }
                },
                "body": { "configuration": { "schema": { "!contract": "string" } } }
            }
        }
    },
    {
        "id": "contract-review-process",
        "kind": "process-definition",
        "data": {
            "entities": { "contract": { "entityType": "construction" } },
            "tasks": { "review": { "type": "contract-review-task", "about": ["contract"] } },
            "variables": { "reason": "string", "failure": "string" },
            "start": "request-review",
            "steps": {
                "request-review": {
                    "open": { "review": { "body": { "contract": "#.entities.contract.businessKey" } } },
                    "next": "await-review"
                },
                "await-review": {
                    "wait": {
                        "when": [
                            { "test": { "$eq": ["#.tasks.review.data.task.answer.outcome", "approved"] }, "resolve": { "review": "approved" }, "then": "activate" },
                            { "test": { "$eq": ["#.tasks.review.data.task.answer.outcome", "rejected"] }, "resolve": { "review": "rejected" }, "then": "discard" }
                        ],
                        "until": { "after": { "days": 3 }, "then": "expired" }
                    }
                },
                "expired": { "set": { "reason": "no review within three days" }, "end": true },
                "activate": {
                    "transition": { "contract": "activate" },
                    "onError": [{ "catches": ["state-refused"], "set": { "failure": "#.error.message" }, "then": "not-activated" }],
                    "end": true
                },
                "discard": {
                    "set": { "reason": "#.tasks.review.data.task.answer.result.reason" },
                    "transition": { "contract": "discard" },
                    "onError": [{ "catches": ["state-refused"], "set": { "failure": "#.error.message" }, "then": "not-activated" }],
                    "end": true
                },
                "not-activated": { "end": true }
            }
        }
    },
    { "id": "contract-review-processes", "kind": "process-entity-type", "data": { "definition": "contract-review-process" } },
    {
        "id": "issued-contract-review-trigger",
        "kind": "state-process-trigger",
        "data": { "entityType": "construction", "transition": "issue", "process": "contract-review-processes", "role": "contract" }
    }
]
