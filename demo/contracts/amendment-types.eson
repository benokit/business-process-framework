[
    {
        "id": "underwriting-amendment-type",
        "kind": "kind",
        "data": {
            "extends": "amendment-entity-type",
            "fixed": { "traits": { "state": { "configuration": {
                "states": { "status": { "draft": true, "issued": true, "active": true, "cancelled": true, "annulled": true } },
                "transitions": {
                    "issue": { "status": { "draft": "issued" } },
                    "activate": { "status": { "issued": "active" }, "versionStatus": { "pending": "applied" } },
                    "cancel": { "status": { "draft": "cancelled", "issued": "cancelled" }, "versionStatus": { "pending": "discarded" } },
                    "annul": { "status": { "active": "annulled" }, "versionStatus": { "applied": "discarded" } }
                },
                "initialStates": { "default": { "status": "draft" } },
                "operations": { "update": { "status": { "draft": true } } }
            } } } }
        }
    },
    {
        "id": "premium-adjustment",
        "kind": "underwriting-amendment-type",
        "data": { "traits": { "body": { "configuration": { "schema": { "!reason": "string", "!changes": { "!premium": "number" } } } } } }
    },
    {
        "id": "cancellation",
        "kind": "underwriting-amendment-type",
        "data": { "traits": { "body": { "configuration": { "schema": { "!reason": "string", "!changes": { "!endDate": "@date" } } } } } }
    },
    {
        "id": "extension",
        "kind": "underwriting-amendment-type",
        "data": { "traits": { "body": { "configuration": { "schema": { "!reason": "string", "!changes": { "!endDate": "@date" } } } } } }
    }
]
