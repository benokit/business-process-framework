[
    {
        "id": "underwriting-amendment-type",
        "kind": "kind",
        "data": {
            "extends": "entity-type",
            "fixed": { "traits": { "amending": { "configuration": {
                "target": { "entityType": "#.data.body.target.entityType", "businessKey": "#.data.body.target.businessKey" },
                "apply": { "dimension": "status", "from": "issued", "to": "active" },
                "revert": { "dimension": "status", "from": "active", "to": "annulled" }
            } }, "state": { "configuration": {
                "states": { "status": { "draft": true, "issued": true, "active": true, "annulled": true } },
                "transitions": {
                    "issue": { "status": { "draft": "issued" } },
                    "activate": { "status": { "issued": "active" } },
                    "annul": { "status": { "active": "annulled" } }
                },
                "initialStates": { "default": { "status": "draft" } },
                "operations": { "update": { "status": { "draft": true } } }
            } } } }
        }
    },
    {
        "id": "change-underwriting-amendment-type",
        "kind": "kind",
        "data": {
            "extends": "underwriting-amendment-type",
            "shape": { "!changes": "@schema" },
            "mapping": {
                "traits": {
                    "body": {
                        "configuration": {
                            "schema": { "!target": "\\@amendment-target", "!reason": "string", "!changes": "#.data.changes" }
                        }
                    }
                }
            }
        }
    },
    { "id": "premium-adjustment", "kind": "change-underwriting-amendment-type", "data": { "changes": { "!premium": "number" } } },
    { "id": "cancellation", "kind": "change-underwriting-amendment-type", "data": { "changes": { "!endDate": "@date" } } },
    { "id": "extension", "kind": "change-underwriting-amendment-type", "data": { "changes": { "!endDate": "@date" } } },
    {
        "id": "amendment-target",
        "kind": "schema",
        "data": { "!entityType": "@ref/entity-type", "!businessKey": "string", "*": "never" }
    }
]
