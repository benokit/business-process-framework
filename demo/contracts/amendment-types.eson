[
    {
        "id": "underwriting-amendment-type",
        "kind": "kind",
        "data": {
            "extends": "stateful-body-entity-type",
            "fixed": { "traits": { "state": { "configuration": {
                "states": { "status": { "draft": true, "issued": true } },
                "transitions": { "issue": { "status": { "draft": "issued" } } },
                "initialStates": { "default": { "status": "draft" } },
                "operations": { "update": { "status": { "draft": true } } }
            } } } }
        }
    },
    {
        "id": "premium-adjustment",
        "kind": "underwriting-amendment-type",
        "data": { "traits": { "body": { "configuration": { "schema": { "!reason": "string", "!changes": { "!premium": "number" } } } } } }
    },
    {
        "id": "cancellation",
        "kind": "underwriting-amendment-type",
        "data": { "traits": { "body": { "configuration": { "schema": { "!reason": "string", "!changes": { "!endDate": "@date" } } } } } }
    },
    {
        "id": "extension",
        "kind": "underwriting-amendment-type",
        "data": { "traits": { "body": { "configuration": { "schema": { "!reason": "string", "!changes": { "!endDate": "@date" } } } } } }
    }
]
