[
    {
        "id": "changes-patch",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "object", "output": "[object]" },
            "mapping": {
                "$map": {
                    "over": { "$keys": "#" },
                    "as": "name",
                    "fn": { "op": "add", "path": { "$str": ["/", "@name"] }, "value": { "$get": { "object": "#", "path": "@name" } } }
                }
            }
        }
    },
    {
        "id": "change-version",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "mapping": { "$func/patched-body": { "body": { "$func/record-body": "#.entity" }, "patch": { "$func/changes-patch": "#.amendment.data.body.changes" } } }
        }
    },
    {
        "id": "issued-amendment",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "boolean" },
            "mapping": { "$eq": ["#.amendment.data.state.status", "issued"] }
        }
    },
    {
        "id": "change-amendment-operations",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "[@trait-operation-use]" },
            "mapping": [{ "key": "body", "operation": "amend", "input": { "validFrom": "#.effectiveFrom", "ref": "#.amendment.businessKey", "body": { "$func/change-version": "#" } } }]
        }
    },
    {
        "id": "entity-amendment-endpoint",
        "kind": "http-endpoint",
        "data": {
            "method": "POST",
            "path": "/entities/:entityType/:businessKey/amendments",
            "target": { "element": "entity-amendment-gateway", "operation": "propose" },
            "body": { "!amendmentType": "string", "!effectiveFrom": "@date", "!reason": "string", "!changes": "object", "*": "never" },
            "operation": { "area": "amendments", "resource": "#.input.entityType", "action": "propose" },
            "request": {
                "entityType": "#.params.entityType",
                "businessKey": "#.params.businessKey",
                "amendmentType": "#.body.amendmentType",
                "effectiveFrom": "#.body.effectiveFrom",
                "input": { "reason": "#.body.reason", "changes": "#.body.changes" }
            },
            "response": { "status": 201, "headers": { "ETag": { "$func/revision-etag": "#.output.revision" } }, "body": "#.output" }
        }
    },
    {
        "id": "entity-amendment-action-endpoint",
        "kind": "http-endpoint",
        "data": {
            "method": "POST",
            "path": "/entities/:entityType/:businessKey/amendments/:amendment/:action",
            "target": { "element": "entity-amendment-gateway", "operation": "settle" },
            "body": { "*": "never" },
            "operation": { "area": "amendments", "resource": "#.input.entityType", "action": "#.input.action" },
            "request": {
                "entityType": "#.params.entityType",
                "businessKey": "#.params.businessKey",
                "amendment": "#.params.amendment",
                "action": "#.params.action"
            },
            "response": { "headers": { "ETag": { "$func/revision-etag": "#.output.revision" } }, "body": "#.output" }
        }
    }
]
