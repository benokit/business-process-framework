[
    {
        "id": "changes-patch",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "object", "output": "[object]" },
            "mapping": {
                "$map": {
                    "over": { "$keys": "#" },
                    "as": "name",
                    "fn": { "op": "add", "path": { "$str": ["/", "@name"] }, "value": { "$get": { "object": "#", "path": "@name" } } }
                }
            }
        }
    },
    {
        "id": "change-version",
        "kind": "pure-function",
        "data": {
            "signature": { "input": "@any", "output": "object" },
            "mapping": { "$func/patched-body": { "body": { "$func/record-body": "#.source" }, "patch": { "$func/changes-patch": "#.generated.data.body.changes" } } }
        }
    },
    {
        "id": "entity-amendment-endpoint",
        "kind": "http-endpoint",
        "data": {
            "method": "POST",
            "path": "/entities/:entityType/:businessKey/amendments",
            "target": { "element": "trait-messages", "operation": "enter" },
            "body": { "!amendmentType": "string", "!effectiveFrom": "@date", "!reason": "string", "!changes": "object", "*": "never" },
            "operation": { "area": "amendments", "resource": "#.input.entityType", "action": "propose" },
            "request": {
                "entityType": "#.params.entityType",
                "businessKey": "#.params.businessKey",
                "trait": "generator",
                "entry": "generate",
                "input": {
                    "generator": "#.body.amendmentType",
                    "input": { "reason": "#.body.reason", "changes": "#.body.changes" },
                    "context": { "effectiveFrom": "#.body.effectiveFrom" }
                }
            },
            "response": { "status": 201, "headers": { "ETag": { "$func/revision-etag": "#.output.revision" } }, "body": "#.output" }
        }
    }
]
