[
    {
        "id": "construction",
        "kind": "insurance-contract-type",
        "data": {
            "lineOfBusiness": "construction",
            "maxSumInsured": 50000000,
            "traits": {
                "body": {
                    "configuration": {
                        "schema": {
                            "$data#&": [
                                "@contract-terms",
                                {
                                    "!policyholder": "string",
                                    "!project": "string",
                                    "!currency": "string",
                                    "!region": "@region",
                                    "confidential": "boolean"
                                }
                            ]
                        }
                    }
                },
                "amendable": {
                    "configuration": {
                        "premium-adjustment": { "apply": { "$func/change-amendment-operations": "#" } },
                        "extension": { "apply": { "$func/change-amendment-operations": "#" } },
                        "cancellation": {
                            "apply": { "$concat": [{ "$func/change-amendment-operations": "#" }, [{ "key": "state", "operation": "transition", "input": { "transition": "cancel" } }]] },
                            "revert": [
                                { "key": "body", "operation": "remove", "input": { "validFrom": "#.effectiveFrom", "ref": "#.amendment.businessKey" } },
                                { "key": "state", "operation": "transition", "input": { "transition": "reactivate" } }
                            ]
                        }
                    }
                },
                "business-key": {
                    "configuration": {
                        "rule": [
                            { "outputKey": "seq", "nextFromSequence": "construction-seq" },
                            { "outputKey": "now", "invoke": "clock", "operation": "now" },
                            {
                                "set": {
                                    "$join": {
                                        "strings": [
                                            "CON",
                                            { "$head": { "$split": { "string": "#.now", "separator": "-" } } },
                                            { "$printf": { "template": "%04d", "args": ["#.seq"] } }
                                        ],
                                        "separator": "-"
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        }
    },
    {
        "id": "construction-policyholder",
        "kind": "slot-fill",
        "data": {
            "target": "construction",
            "slot": "relations",
            "value": {
                "set": {
                    "relations": [
                        {
                            "targetEntityType": "party",
                            "targetEntityBusinessKey": "#.input.data.body.policyholder",
                            "relationType": "policyholder"
                        }
                    ]
                }
            }
        }
    }
]
