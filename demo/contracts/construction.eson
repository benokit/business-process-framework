[
    {
        "id": "construction",
        "kind": "insurance-contract-type",
        "data": {
            "characteristics": { "lineOfBusiness": "construction", "maxSumInsured": 50000000 },
            "traits": { "body": { "configuration": { "schema": { "$data#&": ["@contract-terms", {
                "!policyholder": "string",
                "!project": "string",
                "!currency": "string",
                "!region": "@region",
                "confidential": "boolean"
            }] } } },
            "business-key": { "configuration": { "rule": [
                { "outputKey": "seq", "nextFromSequence": "construction-seq" },
                { "outputKey": "now", "invoke": "clock", "operation": "now" },
                {
                    "set": {
                        "$join": {
                            "strings": ["CON", { "$head": { "$split": { "string": "#.now", "separator": "-" } } }, { "$printf": { "template": "%04d", "args": ["#.seq"] } }],
                            "separator": "-"
                        }
                    }
                }
            ] } } }
        }
    },
    {
        "id": "construction-premium-adjustment",
        "kind": "slot-fill",
        "data": {
            "target": "construction",
            "slot": "amendmentTypes",
            "value": {
                "type": "premium-adjustment",
                "apply": [{
                    "key": "body",
                    "operation": "amend",
                    "input": { "validFrom": "#.link.effectiveFrom", "ref": "#.amendment.businessKey", "body": { "$func/change-version": "#" } }
                }]
            }
        }
    },
    {
        "id": "construction-extension",
        "kind": "slot-fill",
        "data": {
            "target": "construction",
            "slot": "amendmentTypes",
            "value": {
                "type": "extension",
                "apply": [{
                    "key": "body",
                    "operation": "amend",
                    "input": { "validFrom": "#.link.effectiveFrom", "ref": "#.amendment.businessKey", "body": { "$func/change-version": "#" } }
                }]
            }
        }
    },
    {
        "id": "construction-cancellation",
        "kind": "slot-fill",
        "data": {
            "target": "construction",
            "slot": "amendmentTypes",
            "value": {
                "type": "cancellation",
                "apply": [
                    {
                        "key": "body",
                        "operation": "amend",
                        "input": { "validFrom": "#.link.effectiveFrom", "ref": "#.amendment.businessKey", "body": { "$func/change-version": "#" } }
                    },
                    { "key": "state", "operation": "transition", "input": { "transition": "cancel" } }
                ],
                "revert": [
                    { "key": "body", "operation": "remove", "input": { "validFrom": "#.link.effectiveFrom", "ref": "#.amendment.businessKey" } },
                    { "key": "state", "operation": "transition", "input": { "transition": "reactivate" } }
                ]
            }
        }
    },
    {
        "id": "construction-policyholder",
        "kind": "slot-fill",
        "data": {
            "target": "construction",
            "slot": "relations",
            "value": { "set": { "relations": [{ "targetEntityType": "party", "targetEntityBusinessKey": "#.input.data.body.policyholder", "relationType": "policyholder" }] } }
        }
    }
]
