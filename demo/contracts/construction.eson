[
    {
        "id": "construction",
        "kind": "insurance-contract-type",
        "data": {
            "characteristics": { "lineOfBusiness": "construction", "maxSumInsured": 50000000 },
            "traits": { "body": { "configuration": { "schema": { "$data#&": ["@contract-terms", {
                "!policyholder": "string",
                "!project": "string",
                "!currency": "string",
                "!region": "@region",
                "confidential": "boolean"
            }] } } },
            "business-key": { "configuration": { "rule": [
                { "outputKey": "seq", "nextFromSequence": "construction-seq" },
                { "outputKey": "now", "invoke": "clock", "operation": "now" },
                {
                    "set": {
                        "$join": {
                            "strings": ["CON", { "$head": { "$split": { "string": "#.now", "separator": "-" } } }, { "$printf": { "template": "%04d", "args": ["#.seq"] } }],
                            "separator": "-"
                        }
                    }
                }
            ] } } }
        }
    },
    {
        "id": "construction-premium-adjustment",
        "kind": "slot-fill",
        "data": { "target": "construction", "slot": "amendmentTypes", "value": { "type": "premium-adjustment", "apply": { "$func/change-version": "#" } } }
    },
    {
        "id": "construction-extension",
        "kind": "slot-fill",
        "data": { "target": "construction", "slot": "amendmentTypes", "value": { "type": "extension", "apply": { "$func/change-version": "#" } } }
    },
    {
        "id": "construction-policyholder",
        "kind": "slot-fill",
        "data": {
            "target": "construction",
            "slot": "relations",
            "value": { "set": { "relations": [{ "targetEntityType": "party", "targetEntityBusinessKey": "#.input.data.body.policyholder", "relationType": "policyholder" }] } }
        }
    }
]
