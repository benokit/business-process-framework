            "traits": {
                "body": { "configuration": { "schema": { "$data#&": ["@contract-terms", { "!policyholder": "string", "!vessel": "string", "!currency": "string", "!region": "@region", "confidential": "boolean" }] } } },
                "state": { "configuration": {
                    "states": { "status": { "suspended": true } },
                    "transitions": {
                        "suspend": { "status": { "active": "suspended" } },
                        "cancel": { "status": { "suspended": "cancelled" } }
                    }
                } }
            }
        }
    },
    {
        "id": "marine-premium-adjustment",
        "kind": "slot-fill",
        "data": {
