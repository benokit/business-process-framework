[
    {
        "id": "insurance-contract-type",
        "kind": "kind",
        "data": { "extends": "entity-type" }
    },
    {
        "id": "contract-lifecycle",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "traits",
            "value": {
                "trait": "state",
                "configuration": {
                    "states": { "status": ["draft", "discarded", "issued", "active", "cancelled"] },
                    "transitions": {
                        "discard": { "from": { "status": ["draft"] }, "to": { "status": "discarded" } },
                        "issue": { "from": { "status": ["draft"] }, "to": { "status": "issued" } },
                        "activate": { "from": { "status": ["issued"] }, "to": { "status": "active" } },
                        "cancel": { "from": { "status": ["issued", "active"] }, "to": { "status": "cancelled" } }
                    },
                    "initialStates": { "default": { "status": "draft" } }
                }
            }
        }
    },
    {
        "id": "contract-updates-only-in-draft",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "guards",
            "value": {
                "if": { "$eq": ["#.input.operation", "update"] },
                "then": {
                    "if": { "$neq": ["#.input.before.data.state.status", "draft"] },
                    "then": { "throw": { "code": "conflict", "message": "insurance contracts can only be updated in draft" } }
                }
            }
        }
    },
    {
        "id": "contract-events",
        "kind": "message-channel",
        "data": { "broker": "nats", "topology": "topic", "name": "contract-events", "publisher": { "transactionalOutbox": true } }
    },
    {
        "id": "contract-activation-events",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "reactions",
            "after": ["publish-entity-events"],
            "value": {
                "if": { "$eq": ["#.input.trait", "state"] },
                "then": {
                    "if": { "$eq": ["#.input.command", "activate"] },
                    "then": {
                        "inputMap": {
                            "message": { "type": "contract-activated", "contractType": "#.self.id", "contractKey": "#.input.after.businessKey" },
                            "group": "#.input.after.businessKey"
                        },
                        "publish": "contract-events"
                    }
                }
            }
        }
    }
]
