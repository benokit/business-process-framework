[
    {
        "id": "insurance-contract-type",
        "kind": "kind",
        "data": {
            "extends": "versioned-entity-type",
            "fixed": {
                "traits": {
                    "state": {
                        "configuration": {
                            "states": {
                                "status": {
                                    "draft": true,
                                    "discarded": true,
                                    "issued": true,
                                    "active": true,
                                    "cancelled": true
                                }
                            },
                            "transitions": {
                                "discard": {
                                    "status": {
                                        "draft": "discarded"
                                    }
                                },
                                "issue": {
                                    "status": {
                                        "draft": "issued"
                                    }
                                },
                                "activate": {
                                    "status": {
                                        "issued": "active"
                                    }
                                },
                                "cancel": {
                                    "status": {
                                        "issued": "cancelled",
                                        "active": "cancelled"
                                    }
                                }
                            },
                            "initialStates": {
                                "default": {
                                    "status": "draft"
                                }
                            },
                            "operations": { "update": { "status": { "draft": true } }, "updateContract": { "status": { "draft": true } } }
                        }
                    },
                    "timeline": {
                        "configuration": {
                            "schema": "@contract-terms"
                        }
                    },
                    "ownership": {
                        "configuration": {
                            "dimensions": { "!region": "string", "!confidential": "boolean" },
                            "rule": {
                                "region": "#.data.body.region",
                                "confidential": { "$coalesce": ["#.data.body.confidential", false] }
                            }
                        }
                    }
                }
            },
            "operations": {
                "createContract": {
                    "input": { "businessKey": "string", "!contract": "@contract-data" },
                    "output": "@contract-view-data",
                    "implementation": [
                        {
                            "outputKey": "record",
                            "inputMap": { "businessKey": "#.input.businessKey", "traits": { "$func/contract-to-traits": "#.input.contract" } },
                            "invoke": "#.self.id",
                            "operation": "create"
                        },
                        { "set": { "$func/contract-view": "#.record" } }
                    ]
                },
                "readContract": {
                    "input": { "!businessKey": "string", "revision": "number" },
                    "output": "@contract-view-data",
                    "implementation": [
                        { "outputKey": "record", "inputMap": "#.input", "invoke": "#.self.id", "operation": "read" },
                        { "set": { "$func/contract-view": "#.record" } }
                    ]
                },
                "updateContract": {
                    "input": { "!businessKey": "string", "!revision": "number", "!contract": "@contract-data" },
                    "output": "@contract-view-data",
                    "implementation": [
                        { "outputKey": "traits", "set": { "$func/contract-to-traits": "#.input.contract" } },
                        { "outputKey": "before", "inputMap": { "businessKey": "#.input.businessKey" }, "invoke": "#.self.id", "operation": "read" },
                        { "outputKey": "current", "set": { "$func/resolve-segment": { "timeline": "#.before.data.timeline" } } },
                        {
                            "if": { "$neq": ["#.traits.timeline.validFrom", "#.current.validFrom"] },
                            "then": { "throw": { "code": "invalid", "message": "the start date of a contract can't be changed" } }
                        },
                        {
                            "outputKey": "record",
                            "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "body": "#.traits.body", "timeline": "#.traits.timeline" },
                            "traitOperations": [
                                { "key": "body", "operation": "put", "input": { "value": "#.input.body" } },
                                { "key": "timeline", "operation": "put", "input": "#.input.timeline" }
                            ]
                        },
                        { "set": { "$func/contract-view": "#.record" } }
                    ]
                },
                "isAmendable": { "implementation": { "set": { "$eq": ["#.input.record.data.state.status", "active"] } } },
                "deriveOwnership": {
                    "input": { "!businessKey": "string", "!revision": "number", "!value": "object" },
                    "output": "@entity-record",
                    "implementation": {
                        "inputMap": { "businessKey": "#.input.businessKey", "revision": "#.input.revision", "input": { "value": "#.input.value" } },
                        "traitOperation": { "key": "ownership", "operation": "derive" }
                    }
                }
            }
        }
    },
    {
        "id": "contract-terms-end-after-start",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "guards",
            "value": [
                { "outputKey": "command", "set": { "$func/change-command": { "commands": "#.input.commands", "key": "timeline" } } },
                {
                    "outputKey": "timeline",
                    "set": {
                        "$cond": [
                            [{ "$eq": ["#.input.operation", "create"] }, "#.input.after.data.timeline"],
                            ["else", "#.command.value"]
                        ]
                    }
                },
                {
                    "if": "#.timeline",
                    "then": [
                        { "outputKey": "current", "set": { "$func/resolve-segment": { "timeline": "#.timeline" } } },
                        {
                            "if": { "$lte": ["#.current.data.endDate", "#.current.validFrom"] },
                            "then": { "throw": { "code": "invalid", "message": "the end date must be after the start of the terms" } }
                        }
                    ]
                }
            ]
        }
    },
    {
        "id": "contract-events",
        "kind": "message-channel",
        "data": { "broker": "default-nats-broker", "topology": "topic", "name": "contract-events", "publisher": { "transactionalOutbox": true } }
    },
    {
        "id": "contract-activation-events",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "reactions",
            "after": ["publish-entity-events"],
            "value": [
                { "outputKey": "transition", "set": { "$func/change-command": { "commands": "#.input.commands", "key": "state" } } },
                {
                    "if": { "$eq": ["#.transition.command", "activate"] },
                    "then": {
                        "inputMap": {
                            "message": { "type": "contract-activated", "contractType": "#.self.id", "contractKey": "#.input.after.businessKey" },
                            "group": "#.input.after.businessKey"
                        },
                        "publish": "contract-events"
                    }
                }
            ]
        }
    }
]
