[
    {
        "id": "insurance-contract-type",
        "kind": "kind",
        "data": {
            "extends": "versioned-entity-type",
            "fixed": {
                "traits": {
                    "state": {
                        "configuration": {
                            "states": {
                                "status": {
                                    "draft": true,
                                    "discarded": true,
                                    "issued": true,
                                    "active": true,
                                    "cancelled": true
                                }
                            },
                            "transitions": {
                                "discard": {
                                    "status": {
                                        "draft": "discarded"
                                    }
                                },
                                "issue": {
                                    "status": {
                                        "draft": "issued"
                                    }
                                },
                                "activate": {
                                    "status": {
                                        "issued": "active"
                                    }
                                },
                                "cancel": {
                                    "status": {
                                        "issued": "cancelled",
                                        "active": "cancelled"
                                    }
                                }
                            },
                            "initialStates": {
                                "default": {
                                    "status": "draft"
                                }
                            }
                        }
                    },
                    "timeline": {
                        "configuration": {
                            "schema": "@contract-terms"
                        }
                    }
                }
            },
            "operations": {
                "isAmendable": { "implementation": { "set": { "$eq": ["#.input.record.data.state.status", "active"] } } }
            }
        }
    },
    {
        "id": "contract-terms-end-after-start",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "guards",
            "value": [
                {
                    "outputKey": "timeline",
                    "set": {
                        "$cond": [
                            [{ "$eq": ["#.input.operation", "create"] }, "#.input.after.data.timeline"],
                            [{ "$and": [{ "$eq": ["#.input.operation", "trait"] }, { "$eq": ["#.input.key", "timeline"] }] }, "#.input.value"],
                            ["else", null]
                        ]
                    }
                },
                {
                    "if": "#.timeline",
                    "then": [
                        { "outputKey": "current", "set": { "$func/resolve-segment": { "timeline": "#.timeline" } } },
                        {
                            "if": { "$lte": ["#.current.data.endDate", "#.current.validFrom"] },
                            "then": { "throw": { "code": "invalid", "message": "the end date must be after the start of the terms" } }
                        }
                    ]
                }
            ]
        }
    },
    {
        "id": "contract-updates-only-in-draft",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "guards",
            "value": {
                "if": { "$and": [{ "$eq": ["#.input.operation", "trait"] }, { "$eq": ["#.input.key", "body"] }] },
                "then": {
                    "if": { "$neq": ["#.input.before.data.state.status", "draft"] },
                    "then": { "throw": { "code": "conflict", "message": "insurance contracts can only be updated in draft" } }
                }
            }
        }
    },
    {
        "id": "contract-events",
        "kind": "message-channel",
        "data": { "broker": "default-nats-broker", "topology": "topic", "name": "contract-events", "publisher": { "transactionalOutbox": true } }
    },
    {
        "id": "contract-activation-events",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "reactions",
            "after": ["publish-entity-events"],
            "value": {
                "if": { "$eq": ["#.input.key", "state"] },
                "then": {
                    "if": { "$eq": ["#.input.command", "activate"] },
                    "then": {
                        "inputMap": {
                            "message": { "type": "contract-activated", "contractType": "#.self.id", "contractKey": "#.input.after.businessKey" },
                            "group": "#.input.after.businessKey"
                        },
                        "publish": "contract-events"
                    }
                }
            }
        }
    }
]
