[
    {
        "id": "insurance-contract-type",
        "kind": "kind",
        "data": {
            "extends": "entity-type",
            "shape": { "lineOfBusiness": "string", "!maxSumInsured": "number", "traits{}": "@entity-trait-entry" },
            "mapping": { "traits": "#.data.traits" },
            "fixed": {
                "traits": {
                    "amendable": { "configuration": {} },
                    "state": {
                        "configuration": {
                            "states": {
                                "status": {
                                    "draft": true,
                                    "discarded": true,
                                    "issued": true,
                                    "active": true,
                                    "cancelled": true
                                }
                            },
                            "transitions": {
                                "discard": {
                                    "status": {
                                        "draft": "discarded",
                                        "issued": "discarded"
                                    }
                                },
                                "issue": {
                                    "status": {
                                        "draft": "issued"
                                    }
                                },
                                "activate": {
                                    "status": {
                                        "issued": "active"
                                    }
                                },
                                "cancel": {
                                    "status": {
                                        "active": "cancelled"
                                    }
                                },
                                "reactivate": {
                                    "status": {
                                        "cancelled": "active"
                                    }
                                }
                            },
                            "initialStates": {
                                "default": {
                                    "status": "draft"
                                }
                            },
                            "operations": { "update": { "status": { "draft": true } }, "propose": { "status": { "active": true } }, "apply": { "status": { "active": true } } }
                        }
                    },
                    "body": { "trait": "versioned-body", "configuration": { "versioned": { "validFrom": "/startDate" } } },
                    "ownership": {
                        "dependsOn": ["body"],
                        "configuration": {
                            "dimensions": { "!region": "string", "!confidential": "boolean" },
                            "rule": {
                                "region": "#.data.body.region",
                                "confidential": { "$coalesce": ["#.data.body.confidential", false] }
                            }
                        }
                    }
                }
            }
        }
    },
    {
        "id": "contract-terms-end-after-start",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "reactions",
            "value": {
                "if": { "$and": ["#.input.after.data.body.startDate", { "$lte": ["#.input.after.data.body.endDate", "#.input.after.data.body.startDate"] }] },
                "then": { "throw": { "code": "invalid", "message": "the end date must be after the start of the terms" } }
            }
        }
    },
    {
        "id": "contract-sum-insured-within-line-limit",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "reactions",
            "value": [
                {
                    "if": { "$gt": ["#.input.after.data.body.sumInsured", "#.self.data.maxSumInsured"] },
                    "then": { "throw": { "code": "invalid", "message": { "$str": ["the sum insured exceeds the limit of ", "#.self.data.maxSumInsured", " of the line of business"] } } }
                }
            ]
        }
    },
    {
        "id": "contract-events",
        "kind": "message-channel",
        "data": { "broker": "default-nats-broker", "topology": "topic", "name": "contract-events", "publisher": { "transactionalOutbox": true } }
    },
    {
        "id": "contract-activation-events",
        "kind": "slot-fill",
        "data": {
            "target": "insurance-contract-type",
            "slot": "reactions",
            "after": ["publish-entity-events"],
            "value": [
                { "outputKey": "transitions", "set": { "$func/change-command": { "commands": "#.input.commands", "key": "state" } } },
                {
                    "if": { "$any": { "collection": "#.transitions", "as": "transition", "predicate": { "$eq": ["@transition.command", "activate"] } } },
                    "then": {
                        "inputMap": {
                            "message": { "type": "contract-activated", "contractType": "#.self.id", "contractKey": "#.input.after.businessKey", "lineOfBusiness": "#.self.data.lineOfBusiness" },
                            "group": "#.input.after.businessKey"
                        },
                        "publish": "contract-events"
                    }
                }
            ]
        }
    }
]
